# Papers (copyrighted; only the bibliographic data is in the READMEs)
*.pdf
# except the generated FM-style paper of the Mizar article
!mizar/acn.pdf
# and the (a,b)-additive coloring paper
!abadditive/abadditive.pdf

# (a,b)-additive colorings: working notes, scripts and LaTeX build files stay local
abadditive/AB.md
abadditive/*.py
abadditive/*.aux
abadditive/*.log
abadditive/*.out

# OS files
.DS_Store

# Isabelle: the AFP entries are downloaded separately (see isabelle/README.md);
# only the list of entries is kept
isabelle/afp/*
!isabelle/afp/ROOTS

# Mizar: local installation, library files and verifier outputs
mizar/system/
mizar/prel/
mizar/text/*
!mizar/text/*.miz
mizar/fm/body.tex
mizar/fm/refs.tex
mizar/fm/acn.build.log
mizar/fm/__pycache__/

# Lean: lake build directory and downloaded packages
lean/.lake

# Rocq: generated makefiles and compiled files
rocq/Makefile
rocq/Makefile.conf
rocq/.Makefile.d
rocq/**/*.vo
rocq/**/*.vok
rocq/**/*.vos
rocq/**/*.glob
rocq/**/.*.aux
rocq/.lia.cache
rocq/.nia.cache
