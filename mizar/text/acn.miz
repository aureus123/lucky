environ

 vocabularies NUMBERS, SUBSET_1, XBOOLE_0, TARSKI, RELAT_1, FUNCT_1, FUNCT_2,
   CARD_1, FINSET_1, ORDINAL1, STRUCT_0, ORDERS_2, NECKLACE, XXREAL_0,
   ARYTM_3, ARYTM_1, NAT_1, CARD_3, PRE_POLY, UPROOTS, ZFMISC_1, NEWTON,
   RELAT_2, WELLORD2, REWRITE1, XXREAL_2, FINSEQ_1, VALUED_0, MEMBERED,
   ORDINAL2, DILWORTH, MYCIELSK, INT_1, FUNCT_7, EQREL_1, SETFAM_1, ABIAN,
   XTUPLE_0, ACN;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
   XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, FINSET_1, RELAT_1, FUNCT_1, RELSET_1,
   FUNCT_2, VALUED_0, PRE_POLY, UPROOTS, NAT_5, STRUCT_0, ORDERS_2, NECKLACE,
   NEWTON, RELAT_2, WELLORD2, FINSEQ_1, REWRITE1, XXREAL_2, MEMBERED,
   DILWORTH, MYCIELSK, INT_1, NAT_D, FINSEQ_2, EQREL_1, SETFAM_1, ABIAN,
   XTUPLE_0;
 constructors NAT_1, NAT_5, UPROOTS, PRE_POLY, FINSET_1, RELSET_1, FUNCT_2,
   XXREAL_0, ORDERS_2, NECKLACE, NEWTON, REWRITE1, XXREAL_2, MEMBERED,
   DILWORTH, MYCIELSK, NAT_D, SUBSET_1, FINSEQ_2, EQREL_1, SETFAM_1, ABIAN,
   ENUMSET1;
 registrations XBOOLE_0, SUBSET_1, ORDINAL1, RELAT_1, FUNCT_1, FUNCT_2,
   RELSET_1, NUMBERS, XREAL_0, NAT_1, FINSET_1, CARD_1, VALUED_0, PRE_POLY,
   NAT_5, STRUCT_0, NECKLACE, NEWTON, NECKLA_3, XXREAL_2, FINSEQ_1, MEMBERED,
   DILWORTH, MYCIELSK, INT_1, FINSEQ_2, ABIAN, XTUPLE_0;
 requirements NUMERALS, SUBSET, ARITHM, REAL, BOOLE;
 definitions TARSKI;
 theorems TARSKI, XBOOLE_0, XBOOLE_1, ZFMISC_1, SUBSET_1, FUNCT_1, FUNCT_2,
   NAT_1, NAT_5, XREAL_1, XCMPLX_1, XXREAL_0, CARD_1, CARD_2, FINSET_1,
   ORDINAL1, NECKLACE, ENUMSET1, NEWTON, RELAT_1, RELAT_2, WELLORD2,
   REWRITE1, FINSEQ_3, XXREAL_2, DILWORTH, MYCIELSK, ORDERS_2, NAT_D,
   FINSEQ_2, XREAL_0, FINSEQ_1, STRUCT_0, EQREL_1, ABIAN, XTUPLE_0, NAT_2,
   INT_1;
 schemes FINSET_1, NAT_1, FUNCT_2, RELSET_1, FINSEQ_1, FINSEQ_2;

begin

:: D. Severin, "On the additive chromatic number of several families of
:: graphs", Inf. Process. Lett. 158 (2020) 105937.

:: Section 0. Sums of natural labels over finite sets: Sum(f|J) is the
:: sum of f over J (NAT_5).

reserve I for set;
reserve f,g for Function of I,NAT;
reserve J,K for finite Subset of I;
reserve i,j,k,n,m for Nat;

theorem SumEmpty:
  for J being finite Subset of I st J = {} holds Sum(f|J) = 0
proof
  let J be finite Subset of I;
  assume J = {};
  then Sum(f|(J \/ J)) = Sum(f|J) + Sum(f|J) by NAT_5:26, XBOOLE_1:65;
  then Sum(f|J) + 0 = Sum(f|J) + Sum(f|J);
  hence thesis by XCMPLX_1:2;
end;

theorem SumSingle:
  for x being object st J = {x} holds Sum(f|J) = f.x by NAT_5:27;

theorem SumUnion:
  J misses K implies Sum(f|(J \/ K)) = Sum(f|J) + Sum(f|K) by NAT_5:26;

theorem SumAdd1:
  for x being object st x in I & not x in J holds
  for K st K = J \/ {x} holds Sum(f|K) = Sum(f|J) + f.x
proof
  let x be object;
  assume A1: x in I & not x in J;
  let K;
  assume A2: K = J \/ {x};
  reconsider X = {x} as finite Subset of I by A1, ZFMISC_1:31;
  J misses X by A1, ZFMISC_1:50;
  then Sum(f|K) = Sum(f|J) + Sum(f|X) by A2, NAT_5:26;
  hence thesis by NAT_5:27;
end;

theorem SumCong:
  (for x being object st x in J holds f.x = g.x) implies Sum(f|J) = Sum(g|J)
proof
  assume A1: for x being object st x in J holds f.x = g.x;
  A2: dom f = I & dom g = I by FUNCT_2:def 1;
  A3: for x being set st x in J holds f.x = g.x by A1;
  f|J = g|J by A2, A3, FUNCT_1:96;
  hence thesis;
end;

:: Induction over the finite subsets of J

scheme SumInd{I() -> set, J() -> finite Subset of I(), P[set]}: P[J()]
provided
A1: P[{}] and
A2: for x being object, B being finite Subset of I() st x in J() & B c= J()
  & not x in B & P[B] holds P[B \/ {x}]
proof
  A3: for x,B being set st x in J() & B c= J() & P[B] holds P[B \/ {x}]
  proof
    let x,B be set;
    assume B1: x in J() & B c= J() & P[B];
    then reconsider B1 = B as finite Subset of I() by XBOOLE_1:1;
    per cases;
    suppose x in B1;
      then {x} c= B by ZFMISC_1:31;
      hence thesis by B1, XBOOLE_1:12;
    end;
    suppose not x in B1;
      hence thesis by A2, B1;
    end;
  end;
  A4: J() is finite;
  thus P[J()] from FINSET_1:sch 2(A4, A1, A3);
end;

theorem SumMono:
  (for x being object st x in J holds f.x <= g.x) implies Sum(f|J) <= Sum(g|J)
proof
  assume A1: for x being object st x in J holds f.x <= g.x;
  defpred P[set] means
    for B being finite Subset of I st B = $1 holds Sum(f|B) <= Sum(g|B);
  A2: P[{}]
  proof
    let B be finite Subset of I;
    assume B = {};
    then Sum(f|B) = 0 & Sum(g|B) = 0 by SumEmpty;
    hence thesis;
  end;
  A3: for x being object, B being finite Subset of I st x in J & B c= J
    & not x in B & P[B] holds P[B \/ {x}]
  proof
    let x be object, B be finite Subset of I;
    assume B1: x in J & B c= J & not x in B & P[B];
    let C be finite Subset of I;
    assume C = B \/ {x};
    then B2: Sum(f|C) = Sum(f|B) + f.x & Sum(g|C) = Sum(g|B) + g.x
      by B1, SumAdd1;
    Sum(f|B) <= Sum(g|B) & f.x <= g.x by A1, B1;
    hence thesis by B2, XREAL_1:7;
  end;
  P[J] from SumInd(A2, A3);
  hence thesis;
end;

theorem SumBounds:
  for a,b being Nat st for x being object st x in J holds a <= f.x & f.x <= b
  holds a * card J <= Sum(f|J) & Sum(f|J) <= b * card J
proof
  let a,b be Nat;
  assume A1: for x being object st x in J holds a <= f.x & f.x <= b;
  defpred P[set] means
    for B being finite Subset of I st B = $1 holds
      a * card B <= Sum(f|B) & Sum(f|B) <= b * card B;
  A2: P[{}]
  proof
    let B be finite Subset of I;
    assume B1: B = {};
    then Sum(f|B) = 0 by SumEmpty;
    hence thesis by B1;
  end;
  A3: for x being object, B being finite Subset of I st x in J & B c= J
    & not x in B & P[B] holds P[B \/ {x}]
  proof
    let x be object, B be finite Subset of I;
    assume B1: x in J & B c= J & not x in B & P[B];
    let C be finite Subset of I;
    assume B2: C = B \/ {x};
    then B3: Sum(f|C) = Sum(f|B) + f.x by B1, SumAdd1;
    B4: card C = card B + 1 by B1, B2, CARD_2:41;
    B5: a * card B <= Sum(f|B) & Sum(f|B) <= b * card B by B1;
    B6: a <= f.x & f.x <= b by A1, B1;
    a * card C = a * card B + a by B4;
    hence a * card C <= Sum(f|C) by B3, B5, B6, XREAL_1:7;
    b * card C = b * card B + b by B4;
    hence thesis by B3, B5, B6, XREAL_1:7;
  end;
  P[J] from SumInd(A2, A3);
  hence thesis;
end;

theorem SumConst:
  for c being Nat st for x being object st x in J holds f.x = c
  holds Sum(f|J) = c * card J
proof
  let c be Nat;
  assume for x being object st x in J holds f.x = c;
  then for x being object st x in J holds c <= f.x & f.x <= c;
  then c * card J <= Sum(f|J) & Sum(f|J) <= c * card J by SumBounds;
  hence thesis by XXREAL_0:1;
end;

theorem SumSplit:
  J c= K implies Sum(f|K) = Sum(f|J) + Sum(f|(K \ J))
proof
  assume J c= K;
  then K = J \/ (K \ J) by XBOOLE_1:45;
  hence thesis by SumUnion, XBOOLE_1:79;
end;

theorem SumSubset:
  J c= K implies Sum(f|J) <= Sum(f|K)
proof
  assume J c= K;
  then Sum(f|K) = Sum(f|J) + Sum(f|(K \ J)) by SumSplit;
  hence thesis by NAT_1:11;
end;

theorem SumMember:
  for x being object st x in J holds f.x <= Sum(f|J)
proof
  let x be object;
  assume A1: x in J;
  then reconsider X = {x} as finite Subset of I by ZFMISC_1:31, XBOOLE_1:1;
  X c= J by A1, ZFMISC_1:31;
  then Sum(f|X) <= Sum(f|J) by SumSubset;
  hence thesis by SumSingle;
end;

theorem SumPair:
  for x,y being object st x <> y & J = {x,y} holds Sum(f|J) = f.x + f.y
proof
  let x,y be object;
  assume A1: x <> y & J = {x,y};
  then A2: x in J & y in J by TARSKI:def 2;
  then reconsider X = {x} as finite Subset of I by ZFMISC_1:31, XBOOLE_1:1;
  A3: not y in X by A1, TARSKI:def 1;
  X \/ {y} = J by A1, ENUMSET1:1;
  then Sum(f|J) = Sum(f|X) + f.y by A2, A3, SumAdd1;
  hence thesis by SumSingle;
end;

:: Distinct labels 2^h(x) give distinct sums (used for the existence of
:: additive colorings).

reserve h for Function of I,NAT;

theorem Pow2Lt:
  (for x being object st x in I holds f.x = 2|^(h.x)) & h is one-to-one
  implies for m being Nat, J being finite Subset of I st
  (for x being object st x in J holds h.x < m) holds Sum(f|J) < 2|^m
proof
  assume A1: (for x being object st x in I holds f.x = 2|^(h.x)) &
    h is one-to-one;
  A0: dom h = I by FUNCT_2:def 1;
  defpred P[Nat] means for J being finite Subset of I st
    (for x being object st x in J holds h.x < $1) holds Sum(f|J) < 2|^$1;
  A2: P[0]
  proof
    let J be finite Subset of I;
    assume B1: for x being object st x in J holds h.x < 0;
    J = {}
    proof
      assume J <> {};
      then consider x being object such that C1: x in J by XBOOLE_0:def 1;
      h.x < 0 by B1, C1;
      hence contradiction;
    end;
    then Sum(f|J) = 0 by SumEmpty;
    hence thesis by NEWTON:4;
  end;
  A3: for m being Nat st P[m] holds P[m+1]
  proof
    let m be Nat;
    assume B0: P[m];
    let J be finite Subset of I;
    assume B1: for x being object st x in J holds h.x < m+1;
    set H = h"{m};
    reconsider J1 = J \ H, J2 = J /\ H as finite Subset of I;
    B2: for x being object st x in J1 holds h.x < m
    proof
      let x be object;
      assume C1: x in J1;
      then C2: x in J & not x in H by XBOOLE_0:def 5;
      then x in dom h by A0;
      then not h.x in {m} by C2, FUNCT_1:def 7;
      then C3: h.x <> m by TARSKI:def 1;
      h.x < m+1 by B1, C2;
      then h.x <= m by NAT_1:13;
      hence thesis by C3, XXREAL_0:1;
    end;
    B3: Sum(f|J1) < 2|^m by B0, B2;
    B4: Sum(f|J2) <= 2|^m
    proof
      per cases;
      suppose J2 = {};
        then Sum(f|J2) = 0 by SumEmpty;
        hence thesis;
      end;
      suppose J2 <> {};
        then consider x being object such that C1: x in J2 by XBOOLE_0:def 1;
        C2: x in J & x in H by C1, XBOOLE_0:def 4;
        then h.x in {m} by FUNCT_1:def 7;
        then C3: h.x = m by TARSKI:def 1;
        J2 = {x}
        proof
          for y being object holds y in J2 iff y = x
          proof
            let y be object;
            thus y in J2 implies y = x
            proof
              assume y in J2;
              then y in H by XBOOLE_0:def 4;
              then D1: y in dom h & h.y in {m} by FUNCT_1:def 7;
              then h.y = h.x by C3, TARSKI:def 1;
              hence thesis by A1, A0, C2, D1, FUNCT_1:def 4;
            end;
            thus thesis by C1;
          end;
          hence thesis by TARSKI:def 1;
        end;
        then Sum(f|J2) = f.x by SumSingle;
        hence thesis by A1, C2, C3;
      end;
    end;
    J2 c= J by XBOOLE_1:17;
    then B7: Sum(f|J) = Sum(f|J2) + Sum(f|(J \ J2)) by SumSplit;
    J \ J2 = J1 by XBOOLE_1:47;
    then B5: Sum(f|J) = Sum(f|J2) + Sum(f|J1) by B7;
    B6: Sum(f|J2) + Sum(f|J1) < 2|^m + 2|^m by B3, B4, XREAL_1:8;
    2|^(m+1) = 2|^m * 2 by NEWTON:6;
    hence thesis by B5, B6;
  end;
  thus for m being Nat holds P[m] from NAT_1:sch 2(A2, A3);
end;

theorem Pow2Inj:
  (for x being object st x in I holds f.x = 2|^(h.x)) & h is one-to-one
  implies for J,K st Sum(f|J) = Sum(f|K) holds J = K
proof
  assume A1: (for x being object st x in I holds f.x = 2|^(h.x)) &
    h is one-to-one;
  A0: dom h = I by FUNCT_2:def 1;
  defpred P[Nat] means for J,K being finite Subset of I st
    (for x being object st x in J \/ K holds h.x < $1) &
    Sum(f|J) = Sum(f|K) holds J = K;
  A2: P[0]
  proof
    let J,K be finite Subset of I;
    assume B1: (for x being object st x in J \/ K holds h.x < 0) &
      Sum(f|J) = Sum(f|K);
    J \/ K = {}
    proof
      assume J \/ K <> {};
      then consider x being object such that C1: x in J \/ K
        by XBOOLE_0:def 1;
      h.x < 0 by B1, C1;
      hence contradiction;
    end;
    then J = {} & K = {} by XBOOLE_1:15;
    hence thesis;
  end;
  :: an element with the top value m belongs to both sets or to none
  A4: for m being Nat, J,K being finite Subset of I, x being object st
    (for y being object st y in J \/ K holds h.y < m+1) &
    Sum(f|J) = Sum(f|K) & x in J & h.x = m holds x in K
  proof
    let m be Nat, J,K be finite Subset of I, x be object;
    assume B1: (for y being object st y in J \/ K holds h.y < m+1) &
      Sum(f|J) = Sum(f|K) & x in J & h.x = m;
    assume B2: not x in K;
    B3: for y being object st y in K holds h.y < m
    proof
      let y be object;
      assume C1: y in K;
      then y in J \/ K by XBOOLE_0:def 3;
      then h.y < m+1 by B1;
      then C2: h.y <= m by NAT_1:13;
      h.y <> m by A1, A0, B1, B2, C1, FUNCT_1:def 4;
      hence thesis by C2, XXREAL_0:1;
    end;
    B4: Sum(f|K) < 2|^m by A1, B3, Pow2Lt;
    f.x <= Sum(f|J) by B1, SumMember;
    hence contradiction by A1, B1, B4;
  end;
  A3: for m being Nat st P[m] holds P[m+1]
  proof
    let m be Nat;
    assume B0: P[m];
    let J,K be finite Subset of I;
    assume B1: (for x being object st x in J \/ K holds h.x < m+1) &
      Sum(f|J) = Sum(f|K);
    set H = h"{m};
    reconsider J1 = J \ H, J2 = J /\ H, K1 = K \ H, K2 = K /\ H
      as finite Subset of I;
    B1a: for x being object st x in K \/ J holds h.x < m+1 by B1;
    B2: J2 = K2
    proof
      for x being object holds x in J2 iff x in K2
      proof
        let x be object;
        thus x in J2 implies x in K2
        proof
          assume x in J2;
          then C1: x in J & x in H by XBOOLE_0:def 4;
          then h.x in {m} by FUNCT_1:def 7;
          then h.x = m by TARSKI:def 1;
          then x in K by A4, B1, C1;
          hence thesis by C1, XBOOLE_0:def 4;
        end;
        assume x in K2;
        then C1: x in K & x in H by XBOOLE_0:def 4;
        then h.x in {m} by FUNCT_1:def 7;
        then h.x = m by TARSKI:def 1;
        then x in J by A4, B1, B1a, C1;
        hence thesis by C1, XBOOLE_0:def 4;
      end;
      hence thesis by TARSKI:2;
    end;
    J2 c= J by XBOOLE_1:17;
    then B7: Sum(f|J) = Sum(f|J2) + Sum(f|(J \ J2)) by SumSplit;
    J \ J2 = J1 by XBOOLE_1:47;
    then B3: Sum(f|J) = Sum(f|J2) + Sum(f|J1) by B7;
    K2 c= K by XBOOLE_1:17;
    then B8: Sum(f|K) = Sum(f|K2) + Sum(f|(K \ K2)) by SumSplit;
    K \ K2 = K1 by XBOOLE_1:47;
    then Sum(f|K) = Sum(f|K2) + Sum(f|K1) by B8;
    then B4: Sum(f|J1) = Sum(f|K1) by B1, B2, B3, XCMPLX_1:2;
    for x being object st x in J1 \/ K1 holds h.x < m
    proof
      let x be object;
      assume x in J1 \/ K1;
      then x in J1 or x in K1 by XBOOLE_0:def 3;
      then C1: (x in J & not x in H) or (x in K & not x in H)
        by XBOOLE_0:def 5;
      then C2: x in J \/ K by XBOOLE_0:def 3;
      x in dom h by A0, C1;
      then not h.x in {m} by C1, FUNCT_1:def 7;
      then C3: h.x <> m by TARSKI:def 1;
      h.x < m+1 by B1, C2;
      then h.x <= m by NAT_1:13;
      hence thesis by C3, XXREAL_0:1;
    end;
    then J1 = K1 by B0, B4;
    then J = K1 \/ K2 by B2, XBOOLE_1:51;
    hence thesis by XBOOLE_1:51;
  end;
  A5: for m being Nat holds P[m] from NAT_1:sch 2(A2, A3);
  let J,K;
  assume A6: Sum(f|J) = Sum(f|K);
  reconsider L = J \/ K as finite Subset of I;
  set m = Sum(h|L) + 1;
  for x being object st x in J \/ K holds h.x < m
  proof
    let x be object;
    assume x in J \/ K;
    then h.x <= Sum(h|L) by SumMember;
    hence thesis by NAT_1:13;
  end;
  hence thesis by A5, A6;
end;

:: n distinct naturals in [a,b] need n + a <= b + 1

theorem Spread:
  for X being finite Subset of NAT, a,b being Nat st X <> {} &
  (for x being Nat st x in X holds a <= x & x <= b) holds card X + a <= b + 1
proof
  let X be finite Subset of NAT, a,b be Nat;
  defpred P[Nat] means for X being finite Subset of NAT st X <> {} &
    (for x being Nat st x in X holds a <= x & x <= $1) holds
    card X + a <= $1 + 1;
  A1: P[0]
  proof
    let X be finite Subset of NAT;
    assume B1: X <> {} & for x being Nat st x in X holds a <= x & x <= 0;
    then consider y being object such that B2: y in X by XBOOLE_0:def 1;
    reconsider y as Nat by B2;
    B3: a <= y & y <= 0 by B1, B2;
    for z being object st z in X holds z in {0}
    proof
      let z be object;
      assume C1: z in X;
      then reconsider z as Nat;
      z <= 0 by B1, C1;
      then z = 0;
      hence thesis by TARSKI:def 1;
    end;
    then X c= {0} by TARSKI:def 3;
    then X = {0} by B1, ZFMISC_1:33;
    then B4: card X = 1 by CARD_1:30;
    a <= 0 by B3, XXREAL_0:2;
    hence thesis by B4, XREAL_1:6;
  end;
  A2: for b being Nat st P[b] holds P[b+1]
  proof
    let b be Nat;
    assume B0: P[b];
    let X be finite Subset of NAT;
    assume B1: X <> {} & for x being Nat st x in X holds a <= x & x <= b+1;
    then consider y being object such that B2: y in X by XBOOLE_0:def 1;
    reconsider y as Nat by B2;
    B3: a <= y & y <= b+1 by B1, B2;
    set Y = X \ {b+1};
    B4: X c= Y \/ {b+1} by XBOOLE_1:44, XBOOLE_1:39, XBOOLE_1:7;
    B5: not b+1 in Y by ZFMISC_1:56;
    B6: card X <= card (Y \/ {b+1}) by B4, NAT_1:43;
    B7: card (Y \/ {b+1}) = card Y + 1 by B5, CARD_2:41;
    per cases;
    suppose Y = {};
      then C1: card X <= 0 + 1 by B6, B7, CARD_1:27;
      a <= b+1 by B3, XXREAL_0:2;
      then card X + a <= 1 + (b+1) by C1, XREAL_1:7;
      hence thesis;
    end;
    suppose C0: Y <> {};
      for x being Nat st x in Y holds a <= x & x <= b
      proof
        let x be Nat;
        assume x in Y;
        then D1: x in X & x <> b+1 by ZFMISC_1:56;
        then x <= b+1 by B1;
        then x < b+1 by D1, XXREAL_0:1;
        hence thesis by B1, D1, NAT_1:13;
      end;
      then card Y + a <= b + 1 by B0, C0;
      then C2: card Y + a + 1 <= b + 1 + 1 by XREAL_1:6;
      card X + a <= card Y + 1 + a by B6, B7, XREAL_1:6;
      then card X + a <= card Y + a + 1 & card Y + a + 1 <= b + 1 + 1 by C2;
      hence thesis by XXREAL_0:2;
    end;
  end;
  for b being Nat holds P[b] from NAT_1:sch 2(A1, A2);
  hence thesis;
end;

theorem SpreadF:
  for a,b being Nat st J <> {} &
  (for x,y being object st x in J & y in J & h.x = h.y holds x = y) &
  (for x being object st x in J holds a <= h.x & h.x <= b)
  holds card J + a <= b + 1
proof
  let a,b be Nat;
  assume A1: J <> {} &
    (for x,y being object st x in J & y in J & h.x = h.y holds x = y) &
    (for x being object st x in J holds a <= h.x & h.x <= b);
  A2: dom h = I by FUNCT_2:def 1;
  then A3: dom (h|J) = J by RELAT_1:62;
  for x,y being object st x in dom (h|J) & y in dom (h|J) &
    (h|J).x = (h|J).y holds x = y
  proof
    let x,y be object;
    assume B1: x in dom (h|J) & y in dom (h|J) & (h|J).x = (h|J).y;
    then h.x = (h|J).x & h.y = (h|J).y by FUNCT_1:47;
    hence thesis by A1, A3, B1;
  end;
  then h|J is one-to-one by FUNCT_1:def 4;
  then card J = card rng (h|J) by A3, CARD_1:70;
  then A4: card J = card (h.:J) by RELAT_1:115;
  consider x being object such that A5: x in J by A1, XBOOLE_0:def 1;
  A6: h.x in h.:J by A2, A5, FUNCT_1:def 6;
  for y being Nat st y in h.:J holds a <= y & y <= b
  proof
    let y be Nat;
    assume y in h.:J;
    then ex z being object st z in dom h & z in J & y = h.z
      by FUNCT_1:def 6;
    hence thesis by A1;
  end;
  hence thesis by A4, A6, Spread;
end;

:: Section 1. Graphs, additive colorings and the additive chromatic number

:: A graph G = (V,E) is a finite simple graph: an irreflexive symmetric
:: relation on a finite set. The paper's graphs have at least one vertex.

definition
  mode Graph is non empty finite irreflexive symmetric RelStr;
end;

definition
  let G be irreflexive symmetric RelStr;
  let u,v be Element of G;
  pred u,v are_adjacent means
  :DefAdj:
  [u,v] in the InternalRel of G;
  symmetry
  proof
    let u,v be Element of G;
    assume A1: [u,v] in the InternalRel of G;
    then [u,v] in [:the carrier of G, the carrier of G:];
    then A2: u in the carrier of G & v in the carrier of G by ZFMISC_1:87;
    the InternalRel of G is_symmetric_in the carrier of G by NECKLACE:def 3;
    hence thesis by A1, A2, RELAT_2:def 3;
  end;
  irreflexivity
  proof
    let u be Element of G;
    assume A1: [u,u] in the InternalRel of G;
    then [u,u] in [:the carrier of G, the carrier of G:];
    then u in the carrier of G by ZFMISC_1:87;
    hence contradiction by A1, NECKLACE:def 5;
  end;
end;

reserve G for Graph;
reserve u,v,w for Element of G;

:: N(v), the open neighborhood, and d(v) = |N(v)|

definition
  let G, v;
  func Nb v -> Subset of G equals
  (the InternalRel of G).:{v};
  coherence;
end;

registration
  let G, v;
  cluster Nb v -> finite;
  coherence
  proof
    the carrier of G is finite;
    hence thesis;
  end;
end;

definition
  let G, v;
  func deg v -> Nat equals
  card Nb v;
  coherence;
end;

theorem NbIff:
  w in Nb v iff v,w are_adjacent
proof
  thus w in Nb v implies v,w are_adjacent
  proof
    assume w in Nb v;
    then consider x being object such that
    A1: [x,w] in the InternalRel of G & x in {v} by RELAT_1:def 13;
    x = v by A1, TARSKI:def 1;
    hence thesis by A1;
  end;
  assume A2: v,w are_adjacent;
  v in {v} by TARSKI:def 1;
  hence thesis by A2, RELAT_1:def 13;
end;

theorem NbNotSelf:
  not v in Nb v by NbIff;

theorem NbSym:
  w in Nb v iff v in Nb w
proof
  w in Nb v iff v,w are_adjacent by NbIff;
  hence thesis by NbIff;
end;

:: f(N(v)) for a labeling f

definition
  let G;
  let f be Function of the carrier of G, NAT;
  let v;
  func SumN(f,v) -> Element of NAT equals
  Sum(f|Nb v);
  coherence by ORDINAL1:def 12;
end;

:: f : V -> [k] is a labeling; it is an additive coloring if moreover
:: f(N(u)) <> f(N(v)) for every edge uv.

definition
  let G be RelStr, k be Nat;
  let f be Function of the carrier of G, NAT;
  attr f is k-labeling means
  for v being Element of G holds 1 <= f.v & f.v <= k;
end;

definition
  let G;
  let f be Function of the carrier of G, NAT;
  attr f is additive means
  for u,v st u,v are_adjacent holds SumN(f,u) <> SumN(f,v);
end;

reserve f,g for Function of the carrier of G, NAT;

theorem LabelingMono:
  f is k-labeling & k <= n implies f is n-labeling
proof
  assume A1: f is k-labeling & k <= n;
  let v;
  1 <= f.v & f.v <= k by A1;
  hence thesis by A1, XXREAL_0:2;
end;

:: Every graph has an additive coloring: label the vertices with distinct
:: powers of two.

theorem ExAdditive:
  ex k being Nat, f st f is k-labeling additive
proof
  set C = the carrier of G;
  C, card C are_equipotent by CARD_1:def 2;
  then consider h0 being Function such that
  A1: h0 is one-to-one & dom h0 = C & rng h0 = card C by WELLORD2:def 4;
  rng h0 c= NAT by A1, ORDINAL1:def 2;
  then reconsider h = h0 as Function of C, NAT by A1, FUNCT_2:2;
  deffunc F(Element of C) = 2|^(h.$1);
  consider f being Function of C, NAT such that
  A2: for x being Element of C holds f.x = F(x) from FUNCT_2:sch 4;
  A3: for x being object st x in C holds f.x = 2|^(h.x) by A2;
  reconsider CC = [#]C as finite Subset of C;
  reconsider k = Sum(f|CC) as Element of NAT by ORDINAL1:def 12;
  take k, f;
  thus f is k-labeling
  proof
    let v;
    f.v = 2|^(h.v) by A2;
    then f.v > 0 by NEWTON:83;
    hence 1 <= f.v by NAT_1:14;
    v in the carrier of G;
    then v in CC by SUBSET_1:def 3;
    hence thesis by SumMember;
  end;
  let u,v;
  assume A4: u,v are_adjacent;
  assume SumN(f,u) = SumN(f,v);
  then Nb u = Nb v by A1, A3, Pow2Inj;
  then v in Nb v by A4, NbIff;
  hence contradiction by NbNotSelf;
end;

:: eta(G): the least k with an additive k-coloring

definition
  let G;
  func eta G -> Nat means
  :DefEta:
  (ex f st f is it-labeling additive) &
  for k being Nat, f st f is k-labeling additive holds it <= k;
  existence
  proof
    defpred P[Nat] means ex f st f is $1-labeling additive;
    A1: ex k being Nat st P[k] by ExAdditive;
    consider k being Nat such that
    A2: P[k] & for n being Nat st P[n] holds k <= n from NAT_1:sch 5(A1);
    take k;
    thus thesis by A2;
  end;
  uniqueness
  proof
    let k1,k2 be Nat;
    assume A1: ((ex f st f is k1-labeling additive) &
      for k being Nat, f st f is k-labeling additive holds k1 <= k) &
      ((ex f st f is k2-labeling additive) &
      for k being Nat, f st f is k-labeling additive holds k2 <= k);
    then k1 <= k2 & k2 <= k1;
    hence thesis by XXREAL_0:1;
  end;
end;

theorem EtaLe:
  f is k-labeling additive implies eta G <= k by DefEta;

theorem EtaAtt:
  ex f st f is (eta G)-labeling additive by DefEta;

theorem EtaPos:
  1 <= eta G
proof
  consider f such that A1: f is (eta G)-labeling additive by EtaAtt;
  set v = the Element of G;
  1 <= f.v & f.v <= eta G by A1;
  hence thesis by XXREAL_0:2;
end;

theorem EtaGe:
  (for k being Nat, f st f is k-labeling additive holds n <= k)
  implies n <= eta G
proof
  assume A1: for k being Nat, f st f is k-labeling additive holds n <= k;
  ex f st f is (eta G)-labeling additive by EtaAtt;
  hence thesis by A1;
end;

:: Acyclic orientations and topological additive numberings.
:: An orientation of G is a set A of arcs that contains, for every edge,
:: exactly one of its two directions. The digraph D = (V,A) represents the
:: orientation, and N_D(v) = N(v).

definition
  let G;
  let A be Relation;
  pred A is_orientation_of G means
  A c= the InternalRel of G &
  (for u,v st u,v are_adjacent holds [u,v] in A or [v,u] in A) &
  for x,y being object st [x,y] in A holds not [y,x] in A;
end;

:: A is acyclic: every closed directed walk is trivial

definition
  let A be Relation;
  attr A is acyclic means
  for p being RedSequence of A st p.1 = p.(len p) holds len p = 1;
end;

:: A rank that grows along the arcs proves acyclicity

theorem RankAcyclic:
  for A being Relation, s being natural-valued Function st
  for x,y being object st [x,y] in A holds s.x < s.y
  holds A is acyclic
proof
  let A be Relation, s be natural-valued Function;
  assume A1: for x,y being object st [x,y] in A holds s.x < s.y;
  let p be RedSequence of A;
  assume A2: p.1 = p.(len p);
  assume A3: len p <> 1;
  A4: len p > 0 by REWRITE1:def 2;
  then len p >= 0 + 1 by NAT_1:13;
  then A5: len p > 1 by A3, XXREAL_0:1;
  A6: for i being Nat st 1 <= i & i < len p holds [p.i, p.(i+1)] in A
  proof
    let i be Nat;
    assume B1: 1 <= i & i < len p;
    then B2: i in dom p by FINSEQ_3:25;
    1 <= i+1 & i+1 <= len p by B1, NAT_1:13;
    then i+1 in dom p by FINSEQ_3:25;
    hence thesis by B2, REWRITE1:def 2;
  end;
  defpred P[Nat] means 1 <= $1 & $1 < len p implies s.(p.1) < s.(p.($1+1));
  A7: P[0];
  A8: for i being Nat st P[i] holds P[i+1]
  proof
    let i be Nat;
    assume B0: P[i];
    assume B1: 1 <= i+1 & i+1 < len p;
    then [p.(i+1), p.(i+1+1)] in A by A6;
    then B2: s.(p.(i+1)) < s.(p.(i+1+1)) by A1;
    per cases;
    suppose i = 0;
      hence thesis by B2;
    end;
    suppose i <> 0;
      then C1: 1 <= i by NAT_1:14;
      i < len p by B1, NAT_1:13;
      then s.(p.1) < s.(p.(i+1)) by B0, C1;
      hence thesis by B2, XXREAL_0:2;
    end;
  end;
  A9: for i being Nat holds P[i] from NAT_1:sch 2(A7, A8);
  consider j being Nat such that A10: len p = j + 1 by A4, NAT_1:6;
  j <> 0 by A3, A10;
  then A11: 1 <= j by NAT_1:14;
  j < len p by A10, NAT_1:13;
  then s.(p.1) < s.(p.(j+1)) by A9, A11;
  hence contradiction by A2, A10;
end;

definition
  let G;
  let A be Relation;
  let f;
  pred f is_topological_for A means
  for u,v st [u,v] in A holds SumN(f,u) < SumN(f,v);
end;

:: eta_t(D): the least k with a topological additive k-numbering, or
:: +infty (the infimum of the empty set) if there is none

definition
  let G;
  let A be Relation;
  func NumSet(G,A) -> Subset of NAT equals
  {k where k is Element of NAT: ex f st f is k-labeling &
    f is_topological_for A};
  coherence
  proof
    {k where k is Element of NAT: ex f st f is k-labeling &
      f is_topological_for A} c= NAT
    proof
      let x be object;
      assume x in {k where k is Element of NAT: ex f st f is k-labeling &
        f is_topological_for A};
      then ex k being Element of NAT st x = k & ex f st f is k-labeling &
        f is_topological_for A;
      hence thesis;
    end;
    hence thesis;
  end;
end;

definition
  let G;
  let A be Relation;
  func eta_t(G,A) -> ExtReal equals
  inf NumSet(G,A);
  coherence;
end;

reserve A for Relation;

theorem EtaTLe:
  f is k-labeling & f is_topological_for A implies eta_t(G,A) <= k
proof
  assume A1: f is k-labeling & f is_topological_for A;
  reconsider k1 = k as Element of NAT by ORDINAL1:def 12;
  k1 in NumSet(G,A) by A1;
  hence thesis by XXREAL_2:3;
end;

theorem EtaTAtt:
  eta_t(G,A) <> +infty implies
  ex k being Nat, f st eta_t(G,A) = k & f is k-labeling &
  f is_topological_for A
proof
  assume A1: eta_t(G,A) <> +infty;
  set X = NumSet(G,A);
  defpred P[Nat] means $1 in X;
  A2: ex k being Nat st P[k]
  proof
    X <> {} by A1, XXREAL_2:38;
    then consider x being object such that B1: x in X by XBOOLE_0:def 1;
    reconsider x as Nat by B1;
    take x;
    thus thesis by B1;
  end;
  consider k being Nat such that
  A3: P[k] & for n being Nat st P[n] holds k <= n from NAT_1:sch 5(A2);
  for y being ExtReal st y in X holds k <= y by A3;
  then k is LowerBound of X by XXREAL_2:def 2;
  then A4: k = eta_t(G,A) by A3, XXREAL_2:56;
  consider k1 being Element of NAT such that
  A5: k = k1 & ex f st f is k1-labeling & f is_topological_for A by A3;
  thus thesis by A4, A5;
end;

theorem TopAdditive:
  A is_orientation_of G & f is_topological_for A implies f is additive
proof
  assume A1: A is_orientation_of G & f is_topological_for A;
  let u,v;
  assume u,v are_adjacent;
  then [u,v] in A or [v,u] in A by A1;
  hence thesis by A1;
end;

theorem EtaLeEtaT:
  A is_orientation_of G implies eta G <= eta_t(G,A)
proof
  assume A1: A is_orientation_of G;
  per cases;
  suppose eta_t(G,A) = +infty;
    hence thesis by XXREAL_0:3;
  end;
  suppose eta_t(G,A) <> +infty;
    then consider k being Nat, f such that
    A2: eta_t(G,A) = k & f is k-labeling & f is_topological_for A
      by EtaTAtt;
    f is additive by A1, A2, TopAdditive;
    hence thesis by A2, EtaLe;
  end;
end;

:: The orientation induced by an additive coloring: every edge goes from
:: the smaller to the larger sum.

theorem InducedOrientation:
  f is additive implies ex A being Relation of the carrier of G st
  A is_orientation_of G & A is acyclic & f is_topological_for A
proof
  assume A1: f is additive;
  set C = the carrier of G;
  defpred P[object,object] means
    ex u,v being Element of G st u = $1 & v = $2 & u,v are_adjacent &
    SumN(f,u) < SumN(f,v);
  consider A being Relation of C such that
  A2: for x,y being object holds [x,y] in A iff x in C & y in C & P[x,y]
    from RELSET_1:sch 1;
  take A;
  thus A is_orientation_of G
  proof
    thus A c= the InternalRel of G
    proof
      let z be object;
      assume B1: z in A;
      then consider x,y being object such that B2: z = [x,y]
        by RELAT_1:def 1;
      consider u,v being Element of G such that
      B3: u = x & v = y & u,v are_adjacent & SumN(f,u) < SumN(f,v)
        by A2, B1, B2;
      thus thesis by B2, B3;
    end;
    thus for u,v st u,v are_adjacent holds [u,v] in A or [v,u] in A
    proof
      let u,v;
      assume B1: u,v are_adjacent;
      then SumN(f,u) <> SumN(f,v) by A1;
      then SumN(f,u) < SumN(f,v) or SumN(f,v) < SumN(f,u) by XXREAL_0:1;
      then P[u,v] or P[v,u] by B1;
      hence thesis by A2;
    end;
    let x,y be object;
    assume [x,y] in A;
    then consider u,v being Element of G such that
    B1: u = x & v = y & u,v are_adjacent & SumN(f,u) < SumN(f,v) by A2;
    assume [y,x] in A;
    then consider v1,u1 being Element of G such that
    B2: v1 = y & u1 = x & v1,u1 are_adjacent & SumN(f,v1) < SumN(f,u1)
      by A2;
    thus contradiction by B1, B2;
  end;
  deffunc F(Element of C) = SumN(f,$1);
  consider s being Function of C, NAT such that
  A3: for x being Element of C holds s.x = F(x) from FUNCT_2:sch 4;
  for x,y being object st [x,y] in A holds s.x < s.y
  proof
    let x,y be object;
    assume [x,y] in A;
    then consider u,v being Element of G such that
    B1: u = x & v = y & u,v are_adjacent & SumN(f,u) < SumN(f,v) by A2;
    s.u = SumN(f,u) & s.v = SumN(f,v) by A3;
    hence thesis by B1;
  end;
  hence A is acyclic by RankAcyclic;
  let u,v;
  assume [u,v] in A;
  then ex u1,v1 being Element of G st u1 = u & v1 = v & u1,v1 are_adjacent &
    SumN(f,u1) < SumN(f,v1) by A2;
  hence thesis;
end;

:: eta(G) = min { eta_t(D) : D represents an acyclic orientation of G }

theorem EtaMinEtaT:
  (for A st A is_orientation_of G & A is acyclic holds
    eta G <= eta_t(G,A)) &
  ex A st A is_orientation_of G & A is acyclic & eta_t(G,A) = eta G
proof
  thus for A st A is_orientation_of G & A is acyclic holds
    eta G <= eta_t(G,A) by EtaLeEtaT;
  consider f such that A1: f is (eta G)-labeling additive by EtaAtt;
  consider A being Relation of the carrier of G such that
  A2: A is_orientation_of G & A is acyclic & f is_topological_for A
    by A1, InducedOrientation;
  take A;
  A3: eta_t(G,A) <= eta G by A1, A2, EtaTLe;
  eta G <= eta_t(G,A) by A2, EtaLeEtaT;
  hence thesis by A2, A3, XXREAL_0:1;
end;

:: Cliques and the chromatic number chi(G) = chromatic# G (MYCIELSK):
:: the least number of classes of a partition of V into stable sets.

theorem CliqueAdj:
  for Q being Clique of G st u in Q & v in Q & u <> v holds u,v are_adjacent
proof
  let Q be Clique of G;
  assume u in Q & v in Q & u <> v;
  then u <= v or v <= u by DILWORTH:6;
  then [u,v] in the InternalRel of G or [v,u] in the InternalRel of G
    by ORDERS_2:def 5;
  then u,v are_adjacent or v,u are_adjacent by DefAdj;
  hence thesis;
end;

theorem CliqueI:
  for Q being Subset of G st
  for u,v st u in Q & v in Q & u <> v holds u,v are_adjacent
  holds Q is Clique of G
proof
  let Q be Subset of G;
  assume A1: for u,v st u in Q & v in Q & u <> v holds u,v are_adjacent;
  for u,v st u in Q & v in Q & u <> v holds u <= v or v <= u
  proof
    let u,v;
    assume u in Q & v in Q & u <> v;
    then u,v are_adjacent by A1;
    then [u,v] in the InternalRel of G;
    hence thesis by ORDERS_2:def 5;
  end;
  hence thesis by DILWORTH:6;
end;

theorem CliqueLeChi:
  for Q being finite Clique of G holds card Q <= chromatic# G
proof
  let Q be finite Clique of G;
  consider C being finite Coloring of G such that
  A1: card C = chromatic# G by MYCIELSK:def 3;
  A2: card C >= clique# G by DILWORTH:50;
  card Q <= clique# G by DILWORTH:def 4;
  hence thesis by A1, A2, XXREAL_0:2;
end;

:: f(N(v)) when f is constant on N(v)

theorem SumNConst:
  for c being Nat st for w st w in Nb v holds f.w = c
  holds SumN(f,v) = c * deg v
proof
  let c be Nat;
  assume A1: for w st w in Nb v holds f.w = c;
  for x being object st x in Nb v holds f.x = c by A1;
  hence thesis by SumConst;
end;

theorem SumNBounds:
  f is k-labeling implies deg v <= SumN(f,v) & SumN(f,v) <= k * deg v
proof
  assume A1: f is k-labeling;
  for x being object st x in Nb v holds 1 <= f.x & f.x <= k by A1;
  then 1 * deg v <= SumN(f,v) & SumN(f,v) <= k * deg v by SumBounds;
  hence thesis;
end;

:: Ceiling division: cdiv(a,b) is the paper's ceiling of a/b

definition
  let a,b be Nat;
  func cdiv(a,b) -> Nat equals
  (a + b -' 1) div b;
  coherence;
end;

reserve a,b,c for Nat;

theorem CdivLe:
  0 < b implies (cdiv(a,b) <= k iff a <= k * b)
proof
  assume A1: 0 < b;
  then 1 <= b by NAT_1:14;
  then 1 <= a + b by NAT_1:12, XXREAL_0:2;
  then A2: a + b -' 1 = a + b - 1 by XREAL_1:233;
  set c = a + b -' 1;
  set q = c div b, r = c mod b;
  A3: c = b * q + r by A1, NAT_D:2;
  A4: r < b by A1, NAT_D:1;
  thus cdiv(a,b) <= k implies a <= k * b
  proof
    assume cdiv(a,b) <= k;
    then q * b <= k * b by XREAL_1:64;
    then B1: b * q + b <= b * k + b by XREAL_1:6;
    b * q + r < b * q + b by A4, XREAL_1:6;
    then a + b - 1 < b * k + b by A2, A3, B1, XXREAL_0:2;
    then (a - 1) + b < b * k + b;
    then a - 1 < b * k by XREAL_1:6;
    then a < b * k + 1 by XREAL_1:19;
    hence thesis by NAT_1:13;
  end;
  assume A5: a <= k * b;
  assume cdiv(a,b) > k;
  then k + 1 <= q by NAT_1:13;
  then A6: b * (k + 1) <= b * q by XREAL_1:64;
  b * q <= c by A3, NAT_1:11;
  then b * (k + 1) <= a + b - 1 by A2, A6, XXREAL_0:2;
  then b * k + b <= a + b - 1;
  then b * k + b - b <= a + b - 1 - b by XREAL_1:9;
  then b * k <= a - 1;
  then b * k < a by XREAL_1:146, XXREAL_0:2;
  hence contradiction by A5;
end;

theorem CdivMul:
  0 < b implies a <= cdiv(a,b) * b by CdivLe;

:: Labelings given by a formula

scheme LabEx{G() -> Graph, F(Element of G()) -> Nat}:
  ex f being Function of the carrier of G(), NAT st
  for v being Element of G() holds f.v = F(v)
proof
  deffunc H(Element of G()) = In(F($1), NAT);
  consider f being Function of the carrier of G(), NAT such that
  A1: for v being Element of G() holds f.v = H(v) from FUNCT_2:sch 4;
  take f;
  let v be Element of G();
  F(v) in NAT by ORDINAL1:def 12;
  then In(F(v), NAT) = F(v) by SUBSET_1:def 8;
  hence thesis by A1;
end;

:: Section 2. Regular bipartite and complete multipartite graphs

theorem Observation1:
  eta G = 1 iff for u,v st u,v are_adjacent holds deg u <> deg v
proof
  thus eta G = 1 implies for u,v st u,v are_adjacent holds deg u <> deg v
  proof
    assume A1: eta G = 1;
    consider f such that A2: f is (eta G)-labeling additive by EtaAtt;
    A3: for v holds SumN(f,v) = deg v
    proof
      let v;
      for w st w in Nb v holds f.w = 1
      proof
        let w;
        1 <= f.w & f.w <= 1 by A1, A2;
        hence thesis by XXREAL_0:1;
      end;
      then SumN(f,v) = 1 * deg v by SumNConst;
      hence thesis;
    end;
    let u,v;
    assume u,v are_adjacent;
    then SumN(f,u) <> SumN(f,v) by A2;
    then deg u <> SumN(f,v) by A3;
    hence thesis by A3;
  end;
  assume A1: for u,v st u,v are_adjacent holds deg u <> deg v;
  deffunc F(Element of G) = 1;
  consider f such that A2: for v holds f.v = F(v) from LabEx;
  A3: for v holds SumN(f,v) = deg v
  proof
    let v;
    for w st w in Nb v holds f.w = 1 by A2;
    then SumN(f,v) = 1 * deg v by SumNConst;
    hence thesis;
  end;
  A4: f is 1-labeling by A2;
  f is additive
  proof
    let u,v;
    assume u,v are_adjacent;
    then deg u <> deg v by A1;
    then SumN(f,u) <> deg v by A3;
    hence thesis by A3;
  end;
  then A5: eta G <= 1 by A4, EtaLe;
  1 <= eta G by EtaPos;
  hence thesis by A5, XXREAL_0:1;
end;

:: A bipartite graph with stable sets U and W (the paper's U and V): every
:: edge has one end in each set.

theorem Lemma1:
  for U,W being Subset of G st U misses W &
  U \/ W = the carrier of G &
  (for u,v st u,v are_adjacent holds (u in U iff v in W)) &
  (for u,v st v in W & u in Nb v holds deg u < 2 * deg v)
  holds ((for u,v st u,v are_adjacent holds deg u <> deg v) implies
    eta G = 1) &
  ((ex u,v st u,v are_adjacent & deg u = deg v) implies eta G = 2)
proof
  let U,W be Subset of G;
  assume that
  A1: U misses W and
  A2: U \/ W = the carrier of G and
  A3: for u,v st u,v are_adjacent holds (u in U iff v in W) and
  A4: for u,v st v in W & u in Nb v holds deg u < 2 * deg v;
  defpred C[object] means $1 in U;
  deffunc F(object) = 2;
  deffunc H(object) = 1;
  A5: for x being object st x in the carrier of G holds
    (C[x] implies F(x) in NAT) & (not C[x] implies H(x) in NAT);
  consider f being Function of the carrier of G, NAT such that
  A6: for x being object st x in the carrier of G holds
    (C[x] implies f.x = F(x)) & (not C[x] implies f.x = H(x))
    from FUNCT_2:sch 5(A5);
  A7: for v st v in U holds SumN(f,v) = deg v
  proof
    let v;
    assume B1: v in U;
    for w st w in Nb v holds f.w = 1
    proof
      let w;
      assume w in Nb v;
      then v,w are_adjacent by NbIff;
      then w in W by A3, B1;
      then not w in U by A1, XBOOLE_0:3;
      hence thesis by A6;
    end;
    then SumN(f,v) = 1 * deg v by SumNConst;
    hence thesis;
  end;
  A8: for v st v in W holds SumN(f,v) = 2 * deg v
  proof
    let v;
    assume B1: v in W;
    then B2: not v in U by A1, XBOOLE_0:3;
    for w st w in Nb v holds f.w = 2
    proof
      let w;
      assume w in Nb v;
      then v,w are_adjacent by NbIff;
      then not w in W by A3, B2;
      then w in U by A2, XBOOLE_0:def 3;
      hence thesis by A6;
    end;
    hence thesis by SumNConst;
  end;
  A9: for u,v st u in U & v in W & u,v are_adjacent holds
    SumN(f,u) < SumN(f,v)
  proof
    let u,v;
    assume B1: u in U & v in W & u,v are_adjacent;
    then u in Nb v by NbIff;
    then deg u < 2 * deg v by A4, B1;
    then SumN(f,u) < 2 * deg v by A7, B1;
    hence thesis by A8, B1;
  end;
  A10: f is 2-labeling
  proof
    let v;
    v in U or not v in U;
    then f.v = 2 or f.v = 1 by A6;
    hence thesis;
  end;
  f is additive
  proof
    let u,v;
    assume B1: u,v are_adjacent;
    per cases;
    suppose B2: u in U;
      then v in W by A3, B1;
      hence thesis by A9, B1, B2;
    end;
    suppose B2: not u in U;
      then not v in W by A3, B1;
      then B3: v in U by A2, XBOOLE_0:def 3;
      u in W by A2, B2, XBOOLE_0:def 3;
      hence thesis by A9, B1, B3;
    end;
  end;
  then A11: eta G <= 2 by A10, EtaLe;
  thus (for u,v st u,v are_adjacent holds deg u <> deg v) implies
    eta G = 1 by Observation1;
  assume ex u,v st u,v are_adjacent & deg u = deg v;
  then A12: eta G <> 1 by Observation1;
  1 <= eta G by EtaPos;
  then 1 < eta G by A12, XXREAL_0:1;
  then 1 + 1 <= eta G by NAT_1:13;
  hence thesis by A11, XXREAL_0:1;
end;

theorem Corollary1:
  for U,W being Subset of G st U misses W &
  U \/ W = the carrier of G &
  (for u,v st u,v are_adjacent holds (u in U iff v in W)) &
  (for u,v holds deg u = deg v) &
  (ex u,v st u,v are_adjacent)
  holds eta G = 2
proof
  let U,W be Subset of G;
  assume that
  A1: U misses W & U \/ W = the carrier of G and
  A2: for u,v st u,v are_adjacent holds (u in U iff v in W) and
  A3: for u,v holds deg u = deg v and
  A4: ex u,v st u,v are_adjacent;
  A5: for u,v st v in W & u in Nb v holds deg u < 2 * deg v
  proof
    let u,v;
    assume v in W & u in Nb v;
    then {u} c= Nb v by ZFMISC_1:31;
    then card {u} <= deg v by NAT_1:43;
    then 1 <= deg v by CARD_1:30;
    then deg v + 0 < deg v + deg v by XREAL_1:6;
    then deg u < 2 * deg v by A3;
    hence thesis;
  end;
  consider u,v such that A6: u,v are_adjacent by A4;
  deg u = deg v by A3;
  hence thesis by A1, A2, A5, A6, Lemma1;
end;

:: The sequence s_i and the bound max ceil(s_i/|V_i|).
:: For part sizes n = <*n_1,...,n_r*>: s_r = n_r and
:: s_i = max {1 + s_(i+1), n_i}; in closed form
:: s_i = max {n_t + (t - i) : i <= t <= r} (SseqLast, SseqRec below).

theorem NatBound:
  for X being finite Subset of NAT ex m being Nat st
  for k being Nat st k in X holds k <= m
proof
  let X be finite Subset of NAT;
  deffunc F(Element of NAT) = $1;
  consider f being Function of NAT, NAT such that
  A0: for x being Element of NAT holds f.x = F(x) from FUNCT_2:sch 4;
  reconsider m = Sum(f|X) as Element of NAT by ORDINAL1:def 12;
  take m;
  let k be Nat;
  assume A1: k in X;
  then f.k <= Sum(f|X) by SumMember;
  hence thesis by A0, A1;
end;

reserve n for FinSequence of NAT;

definition
  let n be FinSequence of NAT, i be Nat;
  assume A0: 1 <= i & i <= len n;
  func sseq(n,i) -> Nat means
  :DefSseq:
  (ex t being Nat st i <= t & t <= len n & it + i = n.t + t) &
  for t being Nat st i <= t & t <= len n holds n.t + t <= it + i;
  existence
  proof
    defpred P[Nat] means ex t being Nat st i <= t & t <= len n &
      $1 = n.t + t;
    consider B being Nat such that
    A1: for k being Nat st k in rng n holds k <= B by NatBound;
    A2: for k being Nat st P[k] holds k <= B + len n
    proof
      let k be Nat;
      assume P[k];
      then consider t being Nat such that
      B1: i <= t & t <= len n & k = n.t + t;
      1 <= t by A0, B1, XXREAL_0:2;
      then t in dom n by B1, FINSEQ_3:25;
      then n.t in rng n by FUNCT_1:def 3;
      then n.t <= B by A1;
      hence thesis by B1, XREAL_1:7;
    end;
    P[n.i + i] by A0;
    then A3: ex k being Nat st P[k];
    consider M being Nat such that
    A4: P[M] & for k being Nat st P[k] holds k <= M from NAT_1:sch 6(A2, A3);
    A5: n.i + i <= M by A0, A4;
    i <= i + n.i by NAT_1:11;
    then i <= M by A5, XXREAL_0:2;
    then reconsider s = M - i as Nat by NAT_1:21;
    take s;
    thus thesis by A4;
  end;
  uniqueness
  proof
    let s1,s2 be Nat;
    assume A1: ((ex t being Nat st i <= t & t <= len n & s1 + i = n.t + t) &
      for t being Nat st i <= t & t <= len n holds n.t + t <= s1 + i) &
      ((ex t being Nat st i <= t & t <= len n & s2 + i = n.t + t) &
      for t being Nat st i <= t & t <= len n holds n.t + t <= s2 + i);
    then consider t1 being Nat such that
    A2: i <= t1 & t1 <= len n & s1 + i = n.t1 + t1;
    consider t2 being Nat such that
    A3: i <= t2 & t2 <= len n & s2 + i = n.t2 + t2 by A1;
    s1 + i <= s2 + i & s2 + i <= s1 + i by A1, A2, A3;
    then s1 <= s2 & s2 <= s1 by XREAL_1:6;
    hence thesis by XXREAL_0:1;
  end;
end;

theorem SseqLe:
  for i,x being Nat st 1 <= i & i <= len n holds
  sseq(n,i) <= x iff
  for t being Nat st i <= t & t <= len n holds n.t + t <= x + i
proof
  let i,x be Nat;
  assume A1: 1 <= i & i <= len n;
  then consider t0 being Nat such that
  A2: i <= t0 & t0 <= len n & sseq(n,i) + i = n.t0 + t0 by DefSseq;
  thus sseq(n,i) <= x implies
    for t being Nat st i <= t & t <= len n holds n.t + t <= x + i
  proof
    assume B1: sseq(n,i) <= x;
    let t be Nat;
    assume i <= t & t <= len n;
    then B2: n.t + t <= sseq(n,i) + i by A1, DefSseq;
    sseq(n,i) + i <= x + i by B1, XREAL_1:6;
    hence thesis by B2, XXREAL_0:2;
  end;
  assume for t being Nat st i <= t & t <= len n holds n.t + t <= x + i;
  then sseq(n,i) + i <= x + i by A2;
  hence thesis by XREAL_1:6;
end;

theorem SseqGe:
  for i being Nat st 1 <= i & i <= len n holds n.i <= sseq(n,i)
proof
  let i be Nat;
  assume A1: 1 <= i & i <= len n;
  then n.i + i <= sseq(n,i) + i by DefSseq;
  hence thesis by XREAL_1:6;
end;

theorem SseqLast:
  1 <= len n implies sseq(n,len n) = n.(len n)
proof
  assume A1: 1 <= len n;
  then consider t being Nat such that
  A2: len n <= t & t <= len n & sseq(n,len n) + len n = n.t + t by DefSseq;
  t = len n by A2, XXREAL_0:1;
  hence thesis by A2;
end;

theorem SseqRec:
  for i being Nat st 1 <= i & i < len n holds
  sseq(n,i) = max(sseq(n,i+1) + 1, n.i)
proof
  let i be Nat;
  assume A1: 1 <= i & i < len n;
  then A2: i + 1 <= len n by NAT_1:13;
  A3: 1 <= i + 1 by NAT_1:12;
  reconsider m = max(sseq(n,i+1) + 1, n.i) as Nat by XXREAL_0:16;
  A4: sseq(n,i+1) + 1 <= m & n.i <= m by XXREAL_0:25;
  A5: sseq(n,i) <= m
  proof
    for t being Nat st i <= t & t <= len n holds n.t + t <= m + i
    proof
      let t be Nat;
      assume B1: i <= t & t <= len n;
      per cases by B1, XXREAL_0:1;
      suppose t = i;
        hence thesis by A4, XREAL_1:6;
      end;
      suppose i < t;
        then i + 1 <= t by NAT_1:13;
        then n.t + t <= sseq(n,i+1) + (i+1) by A2, A3, B1, DefSseq;
        then B2: n.t + t <= (sseq(n,i+1) + 1) + i;
        (sseq(n,i+1) + 1) + i <= m + i by A4, XREAL_1:6;
        hence thesis by B2, XXREAL_0:2;
      end;
    end;
    hence thesis by A1, SseqLe;
  end;
  m <= sseq(n,i)
  proof
    consider t being Nat such that
    B1: i+1 <= t & t <= len n & sseq(n,i+1) + (i+1) = n.t + t
      by A2, A3, DefSseq;
    i <= i + 1 by NAT_1:11;
    then i <= t by B1, XXREAL_0:2;
    then n.t + t <= sseq(n,i) + i by A1, B1, DefSseq;
    then (sseq(n,i+1) + 1) + i <= sseq(n,i) + i by B1;
    then B2: sseq(n,i+1) + 1 <= sseq(n,i) by XREAL_1:6;
    n.i <= sseq(n,i) by A1, SseqGe;
    hence thesis by B2, XXREAL_0:28;
  end;
  hence thesis by A5, XXREAL_0:1;
end;

theorem SseqDec:
  for i,j being Nat st 1 <= i & i < j & j <= len n holds
  sseq(n,j) + (j - i) <= sseq(n,i)
proof
  let i,j be Nat;
  assume A1: 1 <= i & i < j & j <= len n;
  then A2: 1 <= j by XXREAL_0:2;
  then consider t being Nat such that
  A3: j <= t & t <= len n & sseq(n,j) + j = n.t + t by A1, DefSseq;
  A4: i <= t by A1, A3, XXREAL_0:2;
  i <= len n by A1, XXREAL_0:2;
  then n.t + t <= sseq(n,i) + i by A1, A3, A4, DefSseq;
  then sseq(n,j) + (j - i) + i <= sseq(n,i) + i by A3;
  hence thesis by XREAL_1:6;
end;

:: The bound max {ceil(s_i/n_i) : 1 <= i <= r} (0 for the empty sequence)

definition
  let n;
  func cmBound n -> Nat means
  :DefBound:
  (for i being Nat st 1 <= i & i <= len n holds
    cdiv(sseq(n,i), n.i) <= it) &
  (1 <= len n implies ex i being Nat st 1 <= i & i <= len n &
    it = cdiv(sseq(n,i), n.i)) &
  (len n = 0 implies it = 0);
  existence
  proof
    per cases;
    suppose A1: len n = 0;
      take 0;
      thus thesis by A1;
    end;
    suppose A1: len n <> 0;
      then A2: 1 <= len n by NAT_1:14;
      defpred P[Nat] means ex i being Nat st 1 <= i & i <= len n &
        $1 = cdiv(sseq(n,i), n.i);
      deffunc F(Nat) = cdiv(sseq(n,$1), n.$1);
      defpred Q[Nat] means 1 <= $1;
      set X = {F(i) where i is Nat: i <= len n & Q[i]};
      A3: X is finite from FINSEQ_1:sch 6;
      X c= NAT
      proof
        let x be object;
        assume x in X;
        then ex i being Nat st x = F(i) & i <= len n & Q[i];
        hence thesis by ORDINAL1:def 12;
      end;
      then consider B being Nat such that
      A4: for k being Nat st k in X holds k <= B by A3, NatBound;
      A5: for k being Nat st P[k] holds k <= B
      proof
        let k be Nat;
        assume P[k];
        then k in X;
        hence thesis by A4;
      end;
      A6: ex k being Nat st P[k]
      proof
        take F(1), 1;
        thus thesis by A2;
      end;
      consider M being Nat such that
      A7: P[M] & for k being Nat st P[k] holds k <= M
        from NAT_1:sch 6(A5, A6);
      take M;
      thus thesis by A1, A7;
    end;
  end;
  uniqueness
  proof
    let b1,b2 be Nat;
    assume A1: ((for i being Nat st 1 <= i & i <= len n holds
      cdiv(sseq(n,i), n.i) <= b1) &
      (1 <= len n implies ex i being Nat st 1 <= i & i <= len n &
      b1 = cdiv(sseq(n,i), n.i)) & (len n = 0 implies b1 = 0)) &
      ((for i being Nat st 1 <= i & i <= len n holds
      cdiv(sseq(n,i), n.i) <= b2) &
      (1 <= len n implies ex i being Nat st 1 <= i & i <= len n &
      b2 = cdiv(sseq(n,i), n.i)) & (len n = 0 implies b2 = 0));
    per cases;
    suppose len n = 0;
      hence thesis by A1;
    end;
    suppose len n <> 0;
      then A2: 1 <= len n by NAT_1:14;
      then consider i1 being Nat such that
      A3: 1 <= i1 & i1 <= len n & b1 = cdiv(sseq(n,i1), n.i1) by A1;
      consider i2 being Nat such that
      A4: 1 <= i2 & i2 <= len n & b2 = cdiv(sseq(n,i2), n.i2) by A1, A2;
      b1 <= b2 & b2 <= b1 by A1, A3, A4;
      hence thesis by XXREAL_0:1;
    end;
  end;
end;

:: The bound is at most K iff s_i <= K n_i for every i, that is, iff
:: n_t + (t - i) <= K n_i whenever i <= t.

theorem BoundLe:
  (for i being Nat st 1 <= i & i <= len n holds 1 <= n.i) implies
  for K being Nat holds cmBound n <= K iff
  for i,t being Nat st 1 <= i & i <= t & t <= len n holds
    n.t + t <= K * n.i + i
proof
  assume A1: for i being Nat st 1 <= i & i <= len n holds 1 <= n.i;
  let K be Nat;
  A2: for i being Nat st 1 <= i & i <= len n holds
    (cdiv(sseq(n,i), n.i) <= K iff
    for t being Nat st i <= t & t <= len n holds n.t + t <= K * n.i + i)
  proof
    let i be Nat;
    assume B1: 1 <= i & i <= len n;
    then 0 < n.i by A1;
    then cdiv(sseq(n,i), n.i) <= K iff sseq(n,i) <= K * n.i by CdivLe;
    hence thesis by B1, SseqLe;
  end;
  thus cmBound n <= K implies
    for i,t being Nat st 1 <= i & i <= t & t <= len n holds
    n.t + t <= K * n.i + i
  proof
    assume B1: cmBound n <= K;
    let i,t be Nat;
    assume B2: 1 <= i & i <= t & t <= len n;
    then B3: i <= len n by XXREAL_0:2;
    then cdiv(sseq(n,i), n.i) <= cmBound n by B2, DefBound;
    then cdiv(sseq(n,i), n.i) <= K by B1, XXREAL_0:2;
    hence thesis by A2, B2, B3;
  end;
  assume B1: for i,t being Nat st 1 <= i & i <= t & t <= len n holds
    n.t + t <= K * n.i + i;
  per cases;
  suppose len n = 0;
    hence thesis by DefBound;
  end;
  suppose len n <> 0;
    then 1 <= len n by NAT_1:14;
    then consider i being Nat such that
    B2: 1 <= i & i <= len n & cmBound n = cdiv(sseq(n,i), n.i) by DefBound;
    for t being Nat st i <= t & t <= len n holds n.t + t <= K * n.i + i
      by B1, B2;
    hence thesis by A2, B2;
  end;
end;

theorem SseqLeBound:
  (for i being Nat st 1 <= i & i <= len n holds 1 <= n.i) implies
  for i being Nat st 1 <= i & i <= len n holds
  sseq(n,i) <= cmBound n * n.i
proof
  assume A1: for i being Nat st 1 <= i & i <= len n holds 1 <= n.i;
  let i be Nat;
  assume A2: 1 <= i & i <= len n;
  then A3: 0 < n.i by A1;
  cdiv(sseq(n,i), n.i) <= cmBound n by A2, DefBound;
  hence thesis by A3, CdivLe;
end;

:: Complete multipartite graphs. P = <*V_1,...,V_r*> lists the parts.

reserve P,Q for FinSequence of bool the carrier of G;

definition
  let G, P;
  pred P is_cm_of G means
  :DefCm:
  (for i st i in dom P holds P.i <> {}) &
  (for i,j st i in dom P & j in dom P & i <> j holds P.i misses P.j) &
  (for v ex i st i in dom P & v in P.i) &
  for u,v holds u,v are_adjacent iff
    ex i,j st i in dom P & j in dom P & i <> j & u in P.i & v in P.j;
end;

theorem PartSub:
  i in dom P implies P.i c= the carrier of G
proof
  assume i in dom P;
  then P.i in rng P by FUNCT_1:def 3;
  hence thesis;
end;

theorem PartUnique:
  P is_cm_of G & i in dom P & j in dom P & v in P.i & v in P.j
  implies i = j
proof
  assume A1: P is_cm_of G & i in dom P & j in dom P & v in P.i & v in P.j;
  assume i <> j;
  then P.i misses P.j by A1;
  hence contradiction by A1, XBOOLE_0:3;
end;

definition
  let G, P;
  func Sizes P -> FinSequence of NAT means
  :DefSizes:
  len it = len P & for i st i in dom P holds it.i = card (P.i);
  existence
  proof
    deffunc F(set) = In(card (P.$1), NAT);
    consider z being FinSequence of NAT such that
    A1: len z = len P & for j being Nat st j in dom z holds z.j = F(j)
      from FINSEQ_2:sch 1;
    take z;
    thus len z = len P by A1;
    let i;
    assume A3: i in dom P;
    then A2: i in dom z by A1, FINSEQ_3:29;
    P.i c= the carrier of G by A3, PartSub;
    then card (P.i) in NAT by ORDINAL1:def 12;
    then In(card (P.i), NAT) = card (P.i) by SUBSET_1:def 8;
    hence thesis by A1, A2;
  end;
  uniqueness
  proof
    let z1,z2 be FinSequence of NAT;
    assume A1: (len z1 = len P & for i st i in dom P holds z1.i = card (P.i))
      & (len z2 = len P & for i st i in dom P holds z2.i = card (P.i));
    A2: dom z1 = dom P & dom z2 = dom P by A1, FINSEQ_3:29;
    for i st i in dom z1 holds z1.i = z2.i
    proof
      let i;
      assume i in dom z1;
      then z1.i = card (P.i) & z2.i = card (P.i) by A1, A2;
      hence thesis;
    end;
    hence thesis by A1, FINSEQ_2:9;
  end;
end;

theorem SizesPos:
  P is_cm_of G implies
  for i st 1 <= i & i <= len (Sizes P) holds 1 <= (Sizes P).i
proof
  assume A1: P is_cm_of G;
  let i;
  assume 1 <= i & i <= len (Sizes P);
  then A2: i in dom (Sizes P) by FINSEQ_3:25;
  len (Sizes P) = len P by DefSizes;
  then A3: i in dom P by A2, FINSEQ_3:29;
  then P.i <> {} by A1;
  then consider x being object such that A4: x in P.i by XBOOLE_0:def 1;
  P.i c= the carrier of G by A3, PartSub;
  then reconsider X = P.i as finite set;
  {x} c= X by A4, ZFMISC_1:31;
  then card {x} <= card X by NAT_1:43;
  then 1 <= card X by CARD_1:30;
  hence thesis by A3, DefSizes;
end;

:: In a complete multipartite graph, N(w) = V \ V_j for w in V_j, hence
:: f(N(w)) + f(V_j) = f(V).

theorem CmNb:
  P is_cm_of G & j in dom P & w in P.j implies
  Nb w = (the carrier of G) \ P.j
proof
  assume A1: P is_cm_of G & j in dom P & w in P.j;
  for x being object holds x in Nb w iff x in (the carrier of G) \ P.j
  proof
    let x be object;
    thus x in Nb w implies x in (the carrier of G) \ P.j
    proof
      assume B1: x in Nb w;
      then reconsider x as Element of G;
      w,x are_adjacent by B1, NbIff;
      then consider i1,j1 being Nat such that
      B2: i1 in dom P & j1 in dom P & i1 <> j1 & w in P.i1 & x in P.j1
        by A1;
      i1 = j by A1, B2, PartUnique;
      then not x in P.j by A1, B2, PartUnique;
      hence thesis by XBOOLE_0:def 5;
    end;
    assume B1: x in (the carrier of G) \ P.j;
    then reconsider x as Element of G by XBOOLE_0:def 5;
    consider i such that B2: i in dom P & x in P.i by A1;
    B3: not x in P.j by B1, XBOOLE_0:def 5;
    then i <> j by B2;
    then w,x are_adjacent by A1, B2;
    hence thesis by NbIff;
  end;
  hence thesis by TARSKI:2;
end;

theorem CmSumN:
  P is_cm_of G & j in dom P & w in P.j implies
  for J being finite Subset of the carrier of G st J = P.j holds
  SumN(f,w) + Sum(f|J) = Sum(f|[#]the carrier of G)
proof
  assume A1: P is_cm_of G & j in dom P & w in P.j;
  let J be finite Subset of the carrier of G;
  assume A2: J = P.j;
  reconsider C = [#]the carrier of G as finite Subset of the carrier of G;
  A4: C = the carrier of G by SUBSET_1:def 3;
  then A3: Nb w = C \ J by A1, A2, CmNb;
  Sum(f|C) = Sum(f|J) + Sum(f|(C \ J)) by A4, SumSplit;
  hence thesis by A3;
end;

theorem PartSub1:
  P.i c= the carrier of G
proof
  per cases;
  suppose i in dom P;
    hence thesis by PartSub;
  end;
  suppose not i in dom P;
    then P.i = {} by FUNCT_1:def 2;
    hence thesis by XBOOLE_1:2;
  end;
end;

:: f(V_i), the sum of f over the i-th part

definition
  let G, f, P, i;
  func PSum(f,P,i) -> Element of NAT means
  :DefPSum:
  for J being finite Subset of the carrier of G st J = P.i holds
  it = Sum(f|J);
  existence
  proof
    reconsider J = P.i as finite Subset of the carrier of G by PartSub1;
    reconsider s = Sum(f|J) as Element of NAT by ORDINAL1:def 12;
    take s;
    thus thesis;
  end;
  uniqueness
  proof
    let s1,s2 be Element of NAT;
    assume A1: (for J being finite Subset of the carrier of G st J = P.i
      holds s1 = Sum(f|J)) & (for J being finite Subset of the carrier of G
      st J = P.i holds s2 = Sum(f|J));
    reconsider J = P.i as finite Subset of the carrier of G by PartSub1;
    s1 = Sum(f|J) & s2 = Sum(f|J) by A1;
    hence thesis;
  end;
end;

theorem PSumBounds:
  f is k-labeling & i in dom P implies
  (Sizes P).i <= PSum(f,P,i) & PSum(f,P,i) <= k * (Sizes P).i
proof
  assume A1: f is k-labeling & i in dom P;
  reconsider J = P.i as finite Subset of the carrier of G by PartSub1;
  A2: PSum(f,P,i) = Sum(f|J) by DefPSum;
  A3: (Sizes P).i = card J by A1, DefSizes;
  for x being object st x in J holds 1 <= f.x & f.x <= k by A1;
  then 1 * card J <= Sum(f|J) & Sum(f|J) <= k * card J by SumBounds;
  hence thesis by A2, A3;
end;

theorem CmSumP:
  P is_cm_of G & j in dom P & w in P.j implies
  SumN(f,w) + PSum(f,P,j) = Sum(f|[#]the carrier of G)
proof
  assume A1: P is_cm_of G & j in dom P & w in P.j;
  reconsider J = P.j as finite Subset of the carrier of G by PartSub1;
  PSum(f,P,j) = Sum(f|J) by DefPSum;
  hence thesis by A1, CmSumN;
end;

:: An orientation is monotone for the order P of the parts if all arcs go
:: forward.

definition
  let G, P;
  let A be Relation;
  pred A is_monotone_for P means
  for x,y being object st [x,y] in A holds
  ex i,j st i in dom P & j in dom P & i < j & x in P.i & y in P.j;
end;

theorem ArcForward:
  P is_cm_of G & A is_orientation_of G & A is_monotone_for P &
  i in dom P & j in dom P & i < j & u in P.i & w in P.j implies [u,w] in A
proof
  assume A1: P is_cm_of G & A is_orientation_of G & A is_monotone_for P &
    i in dom P & j in dom P & i < j & u in P.i & w in P.j;
  then u,w are_adjacent by A1;
  then A2: [u,w] in A or [w,u] in A by A1;
  assume A3: not [u,w] in A;
  then consider i1,j1 being Nat such that
  A4: i1 in dom P & j1 in dom P & i1 < j1 & w in P.i1 & u in P.j1 by A1, A2;
  i1 = j & j1 = i by A1, A4, PartUnique;
  hence contradiction by A1, A4;
end;

:: A strictly decreasing sequence drops by at least t - i from i to t

theorem DecGap:
  for key being natural-valued Function, r being Nat st
  for i,j being Nat st 1 <= i & i < j & j <= r holds key.j < key.i
  holds for i,t being Nat st 1 <= i & i <= t & t <= r holds
  key.t + t <= key.i + i
proof
  let key be natural-valued Function, r be Nat;
  assume A1: for i,j being Nat st 1 <= i & i < j & j <= r holds key.j < key.i;
  let i be Nat;
  defpred P[Nat] means 1 <= i & i + $1 <= r implies
    key.(i + $1) + (i + $1) <= key.i + i;
  A2: P[0];
  A3: for d being Nat st P[d] holds P[d+1]
  proof
    let d be Nat;
    assume B0: P[d];
    assume B1: 1 <= i & i + (d+1) <= r;
    B2: i + d < i + d + 1 by NAT_1:13;
    then B3: i + d <= r by B1, XXREAL_0:2;
    i <= i + d by NAT_1:11;
    then 1 <= i + d by B1, XXREAL_0:2;
    then key.(i + d + 1) < key.(i + d) by A1, B1, B2;
    then key.(i + d + 1) + 1 <= key.(i + d) by NAT_1:13;
    then key.(i + d + 1) + 1 + (i + d) <= key.(i + d) + (i + d)
      by XREAL_1:6;
    hence thesis by B0, B1, B3, XXREAL_0:2;
  end;
  A4: for d being Nat holds P[d] from NAT_1:sch 2(A2, A3);
  let t be Nat;
  assume A5: 1 <= i & i <= t & t <= r;
  then consider d being Nat such that A6: t = i + d by NAT_1:10;
  thus thesis by A4, A5, A6;
end;

:: Lemma 2 (ref. [6], Prop. 3), lower bound: along a monotone orientation
:: the part sums f(V_i) decrease strictly.

theorem PartElem:
  P is_cm_of G & i in dom P implies ex u st u in P.i
proof
  assume A1: P is_cm_of G & i in dom P;
  then P.i <> {} by DefCm;
  then consider x being object such that A2: x in P.i by XBOOLE_0:def 1;
  P.i c= the carrier of G by PartSub1;
  then reconsider x as Element of G by A2;
  take x;
  thus thesis by A2;
end;

theorem PSumDec:
  P is_cm_of G & A is_orientation_of G & A is_monotone_for P &
  f is_topological_for A & i in dom P & j in dom P & i < j
  implies PSum(f,P,j) < PSum(f,P,i)
proof
  assume A1: P is_cm_of G & A is_orientation_of G & A is_monotone_for P &
    f is_topological_for A & i in dom P & j in dom P & i < j;
  then consider u such that A2: u in P.i by PartElem;
  consider w such that A3: w in P.j by A1, PartElem;
  [u,w] in A by A1, A2, A3, ArcForward;
  then A4: SumN(f,u) < SumN(f,w) by A1;
  SumN(f,u) + PSum(f,P,i) = Sum(f|[#]the carrier of G) by A1, A2, CmSumP;
  then A5: SumN(f,u) + PSum(f,P,i) = SumN(f,w) + PSum(f,P,j)
    by A1, A3, CmSumP;
  assume PSum(f,P,i) <= PSum(f,P,j);
  hence contradiction by A4, A5, XREAL_1:8;
end;

theorem Lemma2Lower:
  P is_cm_of G & A is_orientation_of G & A is_monotone_for P &
  f is k-labeling & f is_topological_for A implies cmBound (Sizes P) <= k
proof
  assume A1: P is_cm_of G & A is_orientation_of G & A is_monotone_for P &
    f is k-labeling & f is_topological_for A;
  set n = Sizes P;
  A2: len n = len P by DefSizes;
  deffunc F(Element of NAT) = PSum(f,P,$1);
  consider key being Function of NAT, NAT such that
  A3: for i being Element of NAT holds key.i = F(i) from FUNCT_2:sch 4;
  A4: for i being Nat holds key.i = PSum(f,P,i)
  proof
    let i be Nat;
    i in NAT by ORDINAL1:def 12;
    hence thesis by A3;
  end;
  A5: for i,j being Nat st 1 <= i & i < j & j <= len P holds key.j < key.i
  proof
    let i,j be Nat;
    assume B1: 1 <= i & i < j & j <= len P;
    then 1 <= j & i <= len P by XXREAL_0:2;
    then B2: i in dom P & j in dom P by B1, FINSEQ_3:25;
    key.i = PSum(f,P,i) & key.j = PSum(f,P,j) by A4;
    hence thesis by A1, B1, B2, PSumDec;
  end;
  A6: for i,t being Nat st 1 <= i & i <= t & t <= len n holds
    n.t + t <= k * n.i + i
  proof
    let i,t be Nat;
    assume B1: 1 <= i & i <= t & t <= len n;
    then 1 <= t & i <= len n by XXREAL_0:2;
    then B2: i in dom P & t in dom P by A2, B1, FINSEQ_3:25;
    then n.t <= PSum(f,P,t) by A1, PSumBounds;
    then B3: n.t + t <= PSum(f,P,t) + t by XREAL_1:6;
    key.t + t <= key.i + i by A2, A5, B1, DecGap;
    then PSum(f,P,t) + t <= key.i + i by A4;
    then B4: PSum(f,P,t) + t <= PSum(f,P,i) + i by A4;
    PSum(f,P,i) <= k * n.i by A1, B2, PSumBounds;
    then PSum(f,P,i) + i <= k * n.i + i by XREAL_1:6;
    then PSum(f,P,t) + t <= k * n.i + i by B4, XXREAL_0:2;
    hence thesis by B3, XXREAL_0:2;
  end;
  for i being Nat st 1 <= i & i <= len n holds 1 <= n.i by A1, SizesPos;
  hence thesis by A6, BoundLe;
end;

:: A finite set S can be labeled from [K] with any sum T between |S| and
:: K |S|; the labels outside S are kept.

theorem ExLabelingSum:
  for I being set, S being finite Subset of I, K,T being Nat,
  h being Function of I,NAT st card S <= T & T <= K * card S
  ex g being Function of I,NAT st
  (for x being object st x in S holds 1 <= g.x & g.x <= K) &
  (for x being object st x in I & not x in S holds g.x = h.x) &
  Sum(g|S) = T
proof
  let I be set, S be finite Subset of I, K be Nat;
  defpred P[set] means for B being finite Subset of I st B = $1 holds
    for T being Nat, h being Function of I,NAT st
    card B <= T & T <= K * card B
    ex g being Function of I,NAT st
    (for x being object st x in B holds 1 <= g.x & g.x <= K) &
    (for x being object st x in I & not x in B holds g.x = h.x) &
    Sum(g|B) = T;
  A1: P[{}]
  proof
    let B be finite Subset of I;
    assume B1: B = {};
    let T be Nat, h be Function of I,NAT;
    assume card B <= T & T <= K * card B;
    then B2: T = 0 by B1;
    take h;
    thus thesis by B1, B2, SumEmpty;
  end;
  A2: for x being object, B being finite Subset of I st x in S & B c= S
    & not x in B & P[B] holds P[B \/ {x}]
  proof
    let x be object, B be finite Subset of I;
    assume B1: x in S & B c= S & not x in B & P[B];
    let C be finite Subset of I;
    assume B2: C = B \/ {x};
    let T be Nat, h be Function of I,NAT;
    assume B3: card C <= T & T <= K * card C;
    B4: card C = card B + 1 by B1, B2, CARD_2:41;
    then card B + 1 <= T by B3;
    then B5: card B < T by NAT_1:13;
    then reconsider d = T - card B as Nat by NAT_1:21;
    B6: 1 <= d by B4, B3, XREAL_1:19;
    B7: 1 <= K
    proof
      assume K < 1;
      then K = 0 by NAT_1:14;
      hence contradiction by B3, B4;
    end;
    B8a: ex a being Nat st
      1 <= a & a <= K & a <= d & card B <= T - a & T - a <= K * card B
    proof
      per cases;
      suppose C1: d <= K;
        take d;
        thus 1 <= d & d <= K & d <= d by B6, C1;
        thus card B <= T - d;
        card B * 1 <= card B * K by B7, XREAL_1:64;
        hence T - d <= K * card B;
      end;
      suppose C1: not d <= K;
        take K;
        thus 1 <= K & K <= K & K <= d by B7, C1;
        T - K >= T - d by C1, XREAL_1:10;
        hence card B <= T - K;
        T - K <= K * (card B + 1) - K by B3, B4, XREAL_1:9;
        hence T - K <= K * card B;
      end;
    end;
    consider a being Nat such that
    B8: 1 <= a & a <= K & a <= d & card B <= T - a & T - a <= K * card B
      by B8a;
    d <= T by XREAL_1:43;
    then a <= T by B8, XXREAL_0:2;
    then reconsider T1 = T - a as Nat by NAT_1:21;
    consider g being Function of I,NAT such that
    B9: (for y being object st y in B holds 1 <= g.y & g.y <= K) &
      (for y being object st y in I & not y in B holds g.y = h.y) &
      Sum(g|B) = T1 by B1, B8;
    defpred Cx[object] means $1 = x;
    deffunc Fa(object) = a;
    deffunc Fg(object) = g.$1;
    B10: for y being object st y in I holds
      (Cx[y] implies Fa(y) in NAT) & (not Cx[y] implies Fg(y) in NAT)
    proof
      let y be object;
      assume y in I;
      then g.y in NAT by FUNCT_2:5;
      hence thesis by ORDINAL1:def 12;
    end;
    consider g1 being Function of I,NAT such that
    B11: for y being object st y in I holds
      (Cx[y] implies g1.y = Fa(y)) & (not Cx[y] implies g1.y = Fg(y))
      from FUNCT_2:sch 5(B10);
    take g1;
    B12: x in I by B1;
    thus for y being object st y in C holds 1 <= g1.y & g1.y <= K
    proof
      let y be object;
      assume y in C;
      then C1: y in B or y in {x} by B2, XBOOLE_0:def 3;
      per cases by C1, TARSKI:def 1;
      suppose C2: y in B;
        then y <> x by B1;
        then g1.y = g.y by B11, C2;
        hence thesis by B9, C2;
      end;
      suppose y = x;
        hence thesis by B8, B11, B12;
      end;
    end;
    thus for y being object st y in I & not y in C holds g1.y = h.y
    proof
      let y be object;
      assume C1: y in I & not y in C;
      then C2: not y in B & not y in {x} by B2, XBOOLE_0:def 3;
      then y <> x by TARSKI:def 1;
      then g1.y = g.y by B11, C1;
      hence thesis by B9, C1, C2;
    end;
    for y being object st y in B holds g1.y = g.y
    proof
      let y be object;
      assume C1: y in B;
      then y <> x by B1;
      hence thesis by B11, C1;
    end;
    then B13: Sum(g1|B) = T1 by B9, SumCong;
    Sum(g1|C) = Sum(g1|B) + g1.x by B1, B2, B12, SumAdd1;
    then Sum(g1|C) = T1 + a by B11, B12, B13;
    hence thesis;
  end;
  A3: P[S] from SumInd(A1, A2);
  let T be Nat, h be Function of I,NAT;
  assume card S <= T & T <= K * card S;
  hence thesis by A3;
end;

:: Lemma 2, upper bound: label each part V_i with sum s_i

theorem Lemma2Upper:
  P is_cm_of G & A is_monotone_for P implies
  ex f st f is (cmBound (Sizes P))-labeling & f is_topological_for A
proof
  assume A1: P is_cm_of G & A is_monotone_for P;
  set n = Sizes P, K = cmBound n, C = the carrier of G;
  A2: len n = len P by DefSizes;
  A3: for i being Nat st 1 <= i & i <= len n holds 1 <= n.i
    by A1, SizesPos;
  defpred Q[Nat] means $1 <= len P implies ex f st
    for i being Nat st 1 <= i & i <= $1 holds
    (for x being object st x in P.i holds 1 <= f.x & f.x <= K) &
    PSum(f,P,i) = sseq(n,i);
  A4: Q[0]
  proof
    assume 0 <= len P;
    take the Function of C, NAT;
    thus thesis;
  end;
  A5: for m being Nat st Q[m] holds Q[m+1]
  proof
    let m be Nat;
    assume B0: Q[m];
    assume B1: m + 1 <= len P;
    m <= m + 1 by NAT_1:11;
    then consider f such that
    B2: for i being Nat st 1 <= i & i <= m holds
      (for x being object st x in P.i holds 1 <= f.x & f.x <= K) &
      PSum(f,P,i) = sseq(n,i) by B0, B1, XXREAL_0:2;
    B3: 1 <= m + 1 by NAT_1:11;
    then B4: m + 1 in dom P by B1, FINSEQ_3:25;
    reconsider S = P.(m+1) as finite Subset of C by PartSub1;
    B5: n.(m+1) = card S by B4, DefSizes;
    then B6: card S <= sseq(n,m+1) by A2, B1, B3, SseqGe;
    sseq(n,m+1) <= K * card S by A2, A3, B1, B3, B5, SseqLeBound;
    then consider g being Function of C,NAT such that
    B7: (for x being object st x in S holds 1 <= g.x & g.x <= K) &
      (for x being object st x in C & not x in S holds g.x = f.x) &
      Sum(g|S) = sseq(n,m+1) by B6, ExLabelingSum;
    take g;
    let i be Nat;
    assume B8: 1 <= i & i <= m + 1;
    per cases by B8, NAT_1:8;
    suppose C1: i <= m;
      then i < m + 1 by NAT_1:13;
      then C2: i <> m + 1;
      m <= m + 1 by NAT_1:11;
      then m <= len P by B1, XXREAL_0:2;
      then i <= len P by C1, XXREAL_0:2;
      then i in dom P by B8, FINSEQ_3:25;
      then C3: P.i misses S by A1, B4, C2;
      reconsider J = P.i as finite Subset of C by PartSub1;
      C4: for x being object st x in J holds g.x = f.x
      proof
        let x be object;
        assume D1: x in J;
        then not x in S by C3, XBOOLE_0:3;
        hence thesis by B7, D1;
      end;
      thus for x being object st x in P.i holds 1 <= g.x & g.x <= K
      proof
        let x be object;
        assume x in P.i;
        then g.x = f.x & 1 <= f.x & f.x <= K by B2, B8, C1, C4;
        hence thesis;
      end;
      PSum(g,P,i) = Sum(g|J) & PSum(f,P,i) = Sum(f|J) by DefPSum;
      then PSum(g,P,i) = PSum(f,P,i) by C4, SumCong;
      hence thesis by B2, B8, C1;
    end;
    suppose C1: i = m + 1;
      thus for x being object st x in P.i holds 1 <= g.x & g.x <= K
        by B7, C1;
      thus thesis by B7, C1, DefPSum;
    end;
  end;
  A6: for m being Nat holds Q[m] from NAT_1:sch 2(A4, A5);
  consider f such that
  A7: for i being Nat st 1 <= i & i <= len P holds
    (for x being object st x in P.i holds 1 <= f.x & f.x <= K) &
    PSum(f,P,i) = sseq(n,i) by A6;
  take f;
  thus f is K-labeling
  proof
    let v;
    consider i such that B1: i in dom P & v in P.i by A1;
    1 <= i & i <= len P by B1, FINSEQ_3:25;
    hence thesis by A7, B1;
  end;
  let u,w;
  assume [u,w] in A;
  then consider i,j such that
  B1: i in dom P & j in dom P & i < j & u in P.i & w in P.j by A1;
  B2: 1 <= i & i <= len P & 1 <= j & j <= len P by B1, FINSEQ_3:25;
  then B3: sseq(n,j) + (j - i) <= sseq(n,i) by A2, B1, SseqDec;
  0 < j - i by B1, XREAL_1:50;
  then sseq(n,j) + 0 < sseq(n,j) + (j - i) by XREAL_1:6;
  then B4a: sseq(n,j) < sseq(n,i) by B3, XXREAL_0:2;
  PSum(f,P,j) = sseq(n,j) & PSum(f,P,i) = sseq(n,i) by A7, B2;
  then B4: PSum(f,P,j) < PSum(f,P,i) by B4a;
  SumN(f,u) + PSum(f,P,i) = Sum(f|[#]C) by A1, B1, CmSumP;
  then B5: SumN(f,u) + PSum(f,P,i) = SumN(f,w) + PSum(f,P,j)
    by A1, B1, CmSumP;
  assume SumN(f,w) <= SumN(f,u);
  then SumN(f,w) + PSum(f,P,j) < SumN(f,u) + PSum(f,P,i) by B4, XREAL_1:8;
  hence contradiction by B5;
end;

:: Lemma 2: for a monotone orientation, eta_t(D) = max ceil(s_i/|V_i|)

theorem Lemma2Value:
  P is_cm_of G & A is_orientation_of G & A is_monotone_for P implies
  eta_t(G,A) = cmBound (Sizes P)
proof
  assume A1: P is_cm_of G & A is_orientation_of G & A is_monotone_for P;
  set K = cmBound (Sizes P);
  consider f such that
  A2: f is K-labeling & f is_topological_for A by A1, Lemma2Upper;
  A3: eta_t(G,A) <= K by A2, EtaTLe;
  K in REAL by XREAL_0:def 1;
  then eta_t(G,A) <> +infty by A3, XXREAL_0:9;
  then consider k being Nat, g such that
  A4: eta_t(G,A) = k & g is k-labeling & g is_topological_for A by EtaTAtt;
  K <= eta_t(G,A) by A1, A4, Lemma2Lower;
  hence thesis by A3, XXREAL_0:1;
end;

theorem CardEqSub:
  for X,Y being finite set st X c= Y & card X = card Y holds X = Y
proof
  let X,Y be finite set;
  assume A1: X c= Y & card X = card Y;
  then A2: card (Y \ X) = card Y - card X by CARD_2:44;
  Y \ X = {}
  proof
    assume Y \ X <> {};
    then consider x being object such that B1: x in Y \ X by XBOOLE_0:def 1;
    {x} c= Y \ X by B1, ZFMISC_1:31;
    then card {x} <= card (Y \ X) by NAT_1:43;
    then 1 <= card (Y \ X) by CARD_1:30;
    hence contradiction by A1, A2;
  end;
  then Y c= X by XBOOLE_1:37;
  hence thesis by A1, XBOOLE_0:def 10;
end;

theorem CardLtSub:
  for X,Y being finite set, y being object st X c= Y & y in Y & not y in X
  holds card X < card Y
proof
  let X,Y be finite set, y be object;
  assume A1: X c= Y & y in Y & not y in X;
  {y} c= Y by A1, ZFMISC_1:31;
  then X \/ {y} c= Y by A1, XBOOLE_1:8;
  then card (X \/ {y}) <= card Y by NAT_1:43;
  then card X + 1 <= card Y by A1, CARD_2:41;
  hence thesis by NAT_1:13;
end;

:: Lemma 2, finiteness: eta_t(D) is finite iff the orientation is monotone
:: for some order of the parts. The order is by decreasing part sums.

theorem Lemma2Finite:
  P is_cm_of G & A is_orientation_of G & A is acyclic implies
  (eta_t(G,A) <> +infty iff ex Q st Q is_cm_of G & A is_monotone_for Q)
proof
  assume A1: P is_cm_of G & A is_orientation_of G & A is acyclic;
  thus eta_t(G,A) <> +infty implies
    ex Q st Q is_cm_of G & A is_monotone_for Q
  proof
    assume eta_t(G,A) <> +infty;
    then consider k being Nat, f such that
    B1: eta_t(G,A) = k & f is k-labeling & f is_topological_for A
      by EtaTAtt;
    set C = the carrier of G;
    deffunc F(Element of NAT) = PSum(f,P,$1);
    consider key being Function of NAT, NAT such that
    B2: for i being Element of NAT holds key.i = F(i) from FUNCT_2:sch 4;
    B3: for i being Nat holds key.i = PSum(f,P,i)
    proof
      let i be Nat;
      i in NAT by ORDINAL1:def 12;
      hence thesis by B2;
    end;
    :: an arc from V_i to V_j means f(V_j) < f(V_i)
    B4: for x,y being object, i,j st [x,y] in A & i in dom P & j in dom P &
      x in P.i & y in P.j holds key.j < key.i
    proof
      let x,y be object, i,j;
      assume C1: [x,y] in A & i in dom P & j in dom P & x in P.i & y in P.j;
      A c= the InternalRel of G by A1;
      then [x,y] in the InternalRel of G by C1;
      then [x,y] in [:C,C:];
      then reconsider u = x, w = y as Element of G by ZFMISC_1:87;
      C2: SumN(f,u) < SumN(f,w) by B1, C1;
      SumN(f,u) + PSum(f,P,i) = Sum(f|[#]C) by A1, C1, CmSumP;
      then C3: SumN(f,u) + PSum(f,P,i) = SumN(f,w) + PSum(f,P,j)
        by A1, C1, CmSumP;
      C4: key.i = PSum(f,P,i) & key.j = PSum(f,P,j) by B3;
      assume key.i <= key.j;
      then SumN(f,u) + PSum(f,P,i) < SumN(f,w) + PSum(f,P,j)
        by C2, C4, XREAL_1:8;
      hence contradiction by C3;
    end;
    B5: for i,j st i in dom P & j in dom P & i <> j holds key.i <> key.j
    proof
      let i,j;
      assume C1: i in dom P & j in dom P & i <> j;
      then consider u such that C2: u in P.i by A1, PartElem;
      consider w such that C3: w in P.j by A1, C1, PartElem;
      u,w are_adjacent by A1, C1, C2, C3;
      then [u,w] in A or [w,u] in A by A1;
      hence thesis by B4, C1, C2, C3;
    end;
    :: the rank of V_i: one plus the number of parts with a larger sum
    deffunc R(object) = dom P /\ {j where j is Nat: key.$1 < key.j};
    B6: for x being object holds R(x) c= dom P by XBOOLE_1:17;
    B6a: for x being object, j being Nat holds j in R(x) iff
      j in dom P & key.x < key.j
    proof
      let x be object, j be Nat;
      thus j in R(x) implies j in dom P & key.x < key.j
      proof
        assume D1: j in R(x);
        then j in {l where l is Nat: key.x < key.l} by XBOOLE_0:def 4;
        then ex l being Nat st j = l & key.x < key.l;
        hence thesis by D1, XBOOLE_0:def 4;
      end;
      assume D1: j in dom P & key.x < key.j;
      then j in {l where l is Nat: key.x < key.l};
      hence thesis by D1, XBOOLE_0:def 4;
    end;
    deffunc F1(object) = card (R($1)) + 1;
    B7: for x being object st x in dom P holds F1(x) in dom P
    proof
      let x be object;
      assume C1: x in dom P;
      then reconsider i = x as Nat;
      not i in R(i) by B6a;
      then C2: card (R(i)) < card dom P by B6, C1, CardLtSub;
      card dom P = card Seg len P by FINSEQ_1:def 3
        .= len P by FINSEQ_1:57;
      then C3: card (R(i)) + 1 <= len P by C2, NAT_1:13;
      1 <= card (R(i)) + 1 by NAT_1:11;
      hence thesis by C3, FINSEQ_3:25;
    end;
    consider s being Function of dom P, dom P such that
    B8: for x being object st x in dom P holds s.x = F1(x)
      from FUNCT_2:sch 2(B7);
    B9: for i,j st i in dom P & j in dom P & key.i < key.j holds s.j < s.i
    proof
      let i,j;
      assume C1: i in dom P & j in dom P & key.i < key.j;
      C2: R(j) c= R(i)
      proof
        let y be object;
        assume D0: y in R(j);
        then y in dom P by B6, TARSKI:def 3;
        then reconsider l = y as Nat;
        D1: l in dom P & key.j < key.l by B6a, D0;
        then key.i < key.l by C1, XXREAL_0:2;
        hence thesis by B6a, D1;
      end;
      C3: j in R(i) by B6a, C1;
      not j in R(j) by B6a;
      then card (R(j)) < card (R(i)) by B6, C2, C3, CardLtSub;
      then card (R(j)) + 1 < card (R(i)) + 1 by XREAL_1:6;
      then s.j < card (R(i)) + 1 by B8, C1;
      hence thesis by B8, C1;
    end;
    for x,y being object st x in dom s & y in dom s & s.x = s.y holds x = y
    proof
      let x,y be object;
      assume C1: x in dom s & y in dom s & s.x = s.y;
      C2: dom s = dom P by FUNCT_2:52;
      then reconsider i = x, j = y as Nat by C1;
      assume x <> y;
      then key.i <> key.j by B5, C1, C2;
      then key.i < key.j or key.j < key.i by XXREAL_0:1;
      hence contradiction by B9, C1, C2;
    end;
    then B10: s is one-to-one by FUNCT_1:def 4;
    A11: dom s = dom P by FUNCT_2:52;
    card rng s = card dom s by B10, CARD_1:70;
    then rng s = dom P by A11, CardEqSub;
    then reconsider s as Permutation of dom P by B10, FUNCT_2:57;
    reconsider t = s" as Function of dom P, dom P;
    B12: dom t = dom P by FUNCT_2:52;
    deffunc FQ(set) = In(P.(t.$1), bool C);
    consider Q being FinSequence of bool C such that
    B12a: len Q = len P & for l being Nat st l in dom Q holds Q.l = FQ(l)
      from FINSEQ_2:sch 1;
    B13: dom Q = dom P by B12a, FINSEQ_3:29;
    B14: for l being Nat st l in dom Q holds Q.l = P.(t.l) & t.l in dom P
    proof
      let l be Nat;
      assume C1: l in dom Q;
      then C2: t.l in dom P by B13, FUNCT_2:5;
      then P.(t.l) in rng P by FUNCT_1:def 3;
      then In(P.(t.l), bool C) = P.(t.l) by SUBSET_1:def 8;
      hence thesis by B12a, C1, C2;
    end;
    B15: for i st i in dom P holds s.i in dom Q & Q.(s.i) = P.i
    proof
      let i;
      assume C1: i in dom P;
      then C2: s.i in dom P by FUNCT_2:5;
      hence s.i in dom Q by B13;
      t.(s.i) = i by A11, C1, FUNCT_1:34;
      hence thesis by B13, B14, C2;
    end;
    take Q;
    thus Q is_cm_of G
    proof
      thus for l being Nat st l in dom Q holds Q.l <> {}
      proof
        let l be Nat;
        assume l in dom Q;
        then Q.l = P.(t.l) & t.l in dom P by B14;
        hence thesis by A1;
      end;
      thus for l,m being Nat st l in dom Q & m in dom Q & l <> m holds
        Q.l misses Q.m
      proof
        let l,m be Nat;
        assume C1: l in dom Q & m in dom Q & l <> m;
        then C2: Q.l = P.(t.l) & t.l in dom P & Q.m = P.(t.m) & t.m in dom P
          by B14;
        t.l <> t.m by B12, B13, C1, FUNCT_1:def 4;
        hence thesis by A1, C2;
      end;
      thus for v ex l being Nat st l in dom Q & v in Q.l
      proof
        let v;
        consider i such that C1: i in dom P & v in P.i by A1;
        reconsider l = s.i as Nat;
        take l;
        thus thesis by B15, C1;
      end;
      let u,v;
      thus u,v are_adjacent implies ex l,m being Nat st l in dom Q &
        m in dom Q & l <> m & u in Q.l & v in Q.m
      proof
        assume u,v are_adjacent;
        then consider i,j such that
        C1: i in dom P & j in dom P & i <> j & u in P.i & v in P.j by A1;
        reconsider l = s.i, m = s.j as Nat;
        take l, m;
        s.i <> s.j by A11, C1, FUNCT_1:def 4;
        hence thesis by B15, C1;
      end;
      given l,m being Nat such that
      C1: l in dom Q & m in dom Q & l <> m & u in Q.l & v in Q.m;
      C2: Q.l = P.(t.l) & t.l in dom P & Q.m = P.(t.m) & t.m in dom P
        by B14, C1;
      reconsider i = t.l, j = t.m as Nat;
      i <> j by B12, B13, C1, FUNCT_1:def 4;
      hence thesis by A1, C1, C2;
    end;
    let x,y be object;
    assume C1: [x,y] in A;
    A c= the InternalRel of G by A1;
    then [x,y] in the InternalRel of G by C1;
    then [x,y] in [:C,C:];
    then reconsider u = x, w = y as Element of G by ZFMISC_1:87;
    consider i such that C2: i in dom P & u in P.i by A1;
    consider j such that C3: j in dom P & w in P.j by A1;
    key.j < key.i by B4, C1, C2, C3;
    then C4: s.i < s.j by B9, C2, C3;
    reconsider l = s.i, m = s.j as Nat;
    take l, m;
    thus thesis by B15, C2, C3, C4;
  end;
  given Q such that A2: Q is_cm_of G & A is_monotone_for Q;
  eta_t(G,A) = cmBound (Sizes Q) by A1, A2, Lemma2Value;
  then eta_t(G,A) in REAL by XREAL_0:def 1;
  hence thesis by XXREAL_0:9;
end;

:: Helpers for Theorem 1

theorem NatMax:
  for X being finite Subset of NAT st X <> {} holds
  ex M being Nat st M in X & for k being Nat st k in X holds k <= M
proof
  let X be finite Subset of NAT;
  assume A1: X <> {};
  consider B being Nat such that A2: for k being Nat st k in X holds k <= B
    by NatBound;
  defpred P[Nat] means $1 in X;
  A3: for k being Nat st P[k] holds k <= B by A2;
  consider x being object such that A4: x in X by A1, XBOOLE_0:def 1;
  reconsider x as Nat by A4;
  A5: ex k being Nat st P[k] by A4;
  consider M being Nat such that
  A6: P[M] & for k being Nat st P[k] holds k <= M from NAT_1:sch 6(A3, A5);
  take M;
  thus thesis by A6;
end;

theorem NatMin:
  for X being Subset of NAT st X <> {} holds
  ex m being Nat st m in X & for k being Nat st k in X holds m <= k
proof
  let X be Subset of NAT;
  assume A1: X <> {};
  defpred P[Nat] means $1 in X;
  consider x being object such that A4: x in X by A1, XBOOLE_0:def 1;
  reconsider x as Nat by A4;
  A5: ex k being Nat st P[k] by A4;
  consider m being Nat such that
  A6: P[m] & for k being Nat st P[k] holds m <= k from NAT_1:sch 5(A5);
  take m;
  thus thesis by A6;
end;

theorem IntervalCard:
  for i,t being Nat st 1 <= i & i <= t holds
  card (Seg t \ Seg (i -' 1)) = t + 1 - i &
  for l being Nat holds l in Seg t \ Seg (i -' 1) iff i <= l & l <= t
proof
  let i,t be Nat;
  assume A1: 1 <= i & i <= t;
  then A2: i -' 1 = i - 1 by XREAL_1:233;
  i - 1 <= t - 0 by A1, XREAL_1:13;
  then Seg (i -' 1) c= Seg t by A2, FINSEQ_1:5;
  then card (Seg t \ Seg (i -' 1)) = card Seg t - card Seg (i -' 1)
    by CARD_2:44
  .= t - card Seg (i -' 1) by FINSEQ_1:57
  .= t - (i - 1) by A2, FINSEQ_1:57;
  hence card (Seg t \ Seg (i -' 1)) = t + 1 - i;
  let l be Nat;
  thus l in Seg t \ Seg (i -' 1) implies i <= l & l <= t
  proof
    assume l in Seg t \ Seg (i -' 1);
    then B1: l in Seg t & not l in Seg (i -' 1) by XBOOLE_0:def 5;
    then B2: 1 <= l & l <= t by FINSEQ_1:1;
    then not l <= i - 1 by A2, B1, FINSEQ_1:1;
    then i - 1 < l;
    then i - 1 + 1 < l + 1 by XREAL_1:6;
    hence thesis by B2, NAT_1:13;
  end;
  assume B1: i <= l & l <= t;
  then 1 <= l by A1, XXREAL_0:2;
  then B2: l in Seg t by B1, FINSEQ_1:1;
  i - 1 < l by B1, XREAL_1:147;
  then not l in Seg (i -' 1) by A2, FINSEQ_1:1;
  hence thesis by B2, XBOOLE_0:def 5;
end;

:: The orientation from earlier to later parts

theorem ForwardOrientation:
  P is_cm_of G implies ex A being Relation of the carrier of G st
  A is_orientation_of G & A is acyclic & A is_monotone_for P
proof
  assume A1: P is_cm_of G;
  set C = the carrier of G;
  defpred F[object,object] means ex i,j st i in dom P & j in dom P & i < j &
    $1 in P.i & $2 in P.j;
  consider A being Relation of C such that
  A2: for x,y being object holds [x,y] in A iff x in C & y in C & F[x,y]
    from RELSET_1:sch 1;
  take A;
  A3: for x,y being object, i,j st [x,y] in A & i in dom P & j in dom P &
    x in P.i & y in P.j holds i < j
  proof
    let x,y be object, i,j;
    assume B1: [x,y] in A & i in dom P & j in dom P & x in P.i & y in P.j;
    then consider i1,j1 being Nat such that
    B2: i1 in dom P & j1 in dom P & i1 < j1 & x in P.i1 & y in P.j1 by A2;
    reconsider u = x, w = y as Element of G by A2, B1;
    B3: u in P.i & u in P.i1 & w in P.j & w in P.j1 by B1, B2;
    then i1 = i by A1, B1, B2, PartUnique;
    hence thesis by A1, B1, B2, B3, PartUnique;
  end;
  thus A is_orientation_of G
  proof
    thus A c= the InternalRel of G
    proof
      let z be object;
      assume B1: z in A;
      then consider x,y being object such that B2: z = [x,y] by RELAT_1:def 1;
      B3: x in C & y in C & F[x,y] by A2, B1, B2;
      reconsider u = x, w = y as Element of G by B3;
      consider i,j such that
      B4: i in dom P & j in dom P & i < j & x in P.i & y in P.j by B3;
      u,w are_adjacent by A1, B4;
      hence thesis by B2;
    end;
    thus for u,v st u,v are_adjacent holds [u,v] in A or [v,u] in A
    proof
      let u,v;
      assume u,v are_adjacent;
      then consider i,j such that
      B1: i in dom P & j in dom P & i <> j & u in P.i & v in P.j by A1;
      i < j or j < i by B1, XXREAL_0:1;
      then F[u,v] or F[v,u] by B1;
      hence thesis by A2;
    end;
    let x,y be object;
    assume B1: [x,y] in A;
    then consider i,j such that
    B2: i in dom P & j in dom P & i < j & x in P.i & y in P.j by A2;
    assume [y,x] in A;
    then j < i by A3, B2;
    hence contradiction by B2;
  end;
  defpred R[object,object] means ex i st i in dom P & $1 in P.i & $2 = i;
  A4: for x being object st x in C ex y being object st y in NAT & R[x,y]
  proof
    let x be object;
    assume x in C;
    then consider i such that B1: i in dom P & x in P.i by A1;
    take i;
    thus thesis by B1, ORDINAL1:def 12;
  end;
  consider s being Function of C, NAT such that
  A5: for x being object st x in C holds R[x,s.x] from FUNCT_2:sch 1(A4);
  for x,y being object st [x,y] in A holds s.x < s.y
  proof
    let x,y be object;
    assume B1: [x,y] in A;
    then B2: x in C & y in C by A2;
    then consider i such that B3: i in dom P & x in P.i & s.x = i by A5;
    consider j such that B4: j in dom P & y in P.j & s.y = j by A5, B2;
    thus thesis by A3, B1, B3, B4;
  end;
  hence A is acyclic by RankAcyclic;
  let x,y be object;
  assume [x,y] in A;
  hence thesis by A2;
end;

:: Theorem 1: if |V_1| >= ... >= |V_r|, then eta(G) = max ceil(s_i/|V_i|)
:: and eta(G) <= r.

theorem Theorem1:
  P is_cm_of G &
  (for i,j st 1 <= i & i <= j & j <= len P holds
    (Sizes P).j <= (Sizes P).i)
  implies eta G = cmBound (Sizes P) & eta G <= len P
proof
  assume that
  A1: P is_cm_of G and
  A2: for i,j st 1 <= i & i <= j & j <= len P holds
    (Sizes P).j <= (Sizes P).i;
  set n = Sizes P, K = cmBound n, r = len P;
  A3: len n = r by DefSizes;
  A4: for i being Nat st 1 <= i & i <= len n holds 1 <= n.i by A1, SizesPos;
  :: upper bound, through the forward orientation
  consider F being Relation of the carrier of G such that
  A5: F is_orientation_of G & F is acyclic & F is_monotone_for P
    by A1, ForwardOrientation;
  eta G <= eta_t(G,F) by A5, EtaLeEtaT;
  then A6: eta G <= K by A1, A5, Lemma2Value;
  :: lower bound: the part sums of an optimal coloring are distinct
  consider f such that A7: f is (eta G)-labeling additive by EtaAtt;
  set e = eta G;
  deffunc FK(Element of NAT) = PSum(f,P,$1);
  consider key being Function of NAT, NAT such that
  A8: for i being Element of NAT holds key.i = FK(i) from FUNCT_2:sch 4;
  A9: for i being Nat holds key.i = PSum(f,P,i)
  proof
    let i be Nat;
    i in NAT by ORDINAL1:def 12;
    hence thesis by A8;
  end;
  A10: for i,j st i in dom P & j in dom P & key.i = key.j holds i = j
  proof
    let i,j;
    assume B1: i in dom P & j in dom P & key.i = key.j;
    assume B2: i <> j;
    consider u such that B3: u in P.i by A1, B1, PartElem;
    consider w such that B4: w in P.j by A1, B1, PartElem;
    u,w are_adjacent by A1, B1, B2, B3, B4;
    then B5: SumN(f,u) <> SumN(f,w) by A7;
    SumN(f,u) + PSum(f,P,i) = Sum(f|[#]the carrier of G)
      by A1, B1, B3, CmSumP;
    then SumN(f,u) + PSum(f,P,i) = SumN(f,w) + PSum(f,P,j)
      by A1, B1, B4, CmSumP;
    then B6: SumN(f,u) + key.i = SumN(f,w) + PSum(f,P,j) by A9;
    key.j = PSum(f,P,j) by A9;
    then SumN(f,u) + key.i = SumN(f,w) + key.j by B6;
    hence contradiction by B1, B5;
  end;
  A11: for i,t being Nat st 1 <= i & i <= t & t <= len n holds
    n.t + t <= e * n.i + i
  proof
    let i,t be Nat;
    assume B1: 1 <= i & i <= t & t <= len n;
    then B1a: 1 <= t & i <= r by A3, XXREAL_0:2;
    then B2: i in dom P & t in dom P by A3, B1, FINSEQ_3:25;
    set J = {j where j is Nat: j in dom P & n.t <= n.j & n.j <= n.i};
    B3: J c= dom P
    proof
      let x be object;
      assume x in J;
      then ex j being Nat st x = j & j in dom P & n.t <= n.j & n.j <= n.i;
      hence thesis;
    end;
    then reconsider J as finite Subset of NAT by XBOOLE_1:1;
    :: the parts V_i, ..., V_t have sizes between n_t and n_i
    B4: Seg t \ Seg (i -' 1) c= J
    proof
      let x be object;
      assume C1: x in Seg t \ Seg (i -' 1);
      then reconsider l = x as Nat;
      C2: i <= l & l <= t by B1, C1, IntervalCard;
      then C3a: 1 <= l by B1, XXREAL_0:2;
      l <= r by A3, B1, C2, XXREAL_0:2;
      then C3: 1 <= l & l <= r by C3a;
      then C4: l in dom P by FINSEQ_3:25;
      n.t <= n.l & n.l <= n.i by A2, A3, B1, C2, C3;
      hence thesis by C4;
    end;
    then card (Seg t \ Seg (i -' 1)) <= card J by NAT_1:43;
    then B5: t + 1 - i <= card J by B1, B1a, IntervalCard;
    n.t <= n.i by A2, A3, B1;
    then B6: i in J by B2;
    set X = key.:J;
    reconsider X as finite Subset of NAT;
    B7: dom key = NAT by FUNCT_2:def 1;
    then key.i in X by B6, FUNCT_1:def 6;
    then consider M being Nat such that
    B8: M in X & for k being Nat st k in X holds k <= M by NatMax;
    consider m being Nat such that
    B9: m in X & for k being Nat st k in X holds m <= k by B8, NatMin;
    consider a being object such that
    B10: a in dom key & a in J & M = key.a by B8, FUNCT_1:def 6;
    consider b being object such that
    B11: b in dom key & b in J & m = key.b by B9, FUNCT_1:def 6;
    consider a1 being Nat such that
    B12: a = a1 & a1 in dom P & n.t <= n.a1 & n.a1 <= n.i by B10;
    consider b1 being Nat such that
    B13: b = b1 & b1 in dom P & n.t <= n.b1 & n.b1 <= n.i by B11;
    :: the |J| distinct sums lie between m and M
    B14: for x,y being object st x in J & y in J & key.x = key.y holds x = y
    proof
      let x,y be object;
      assume C1: x in J & y in J & key.x = key.y;
      then reconsider x1 = x, y1 = y as Nat;
      thus thesis by A10, B3, C1;
    end;
    for x being object st x in J holds m <= key.x & key.x <= M
    proof
      let x be object;
      assume x in J;
      then key.x in X by B7, FUNCT_1:def 6;
      hence thesis by B8, B9;
    end;
    then card J + m <= M + 1 by B6, B14, SpreadF;
    then B15a: card J + m <= M + 1;
    t + 1 - i + m <= card J + m by B5, XREAL_1:6;
    then (t - i) + (m + 1) <= M + 1 by B15a, XXREAL_0:2;
    then t - i <= M + 1 - (m + 1) by XREAL_1:19;
    then B15: n.t + (t - i) <= n.t + (M - m) by XREAL_1:6;
    n.b1 <= PSum(f,P,b1) by A7, B13, PSumBounds;
    then n.t <= PSum(f,P,b1) by B13, XXREAL_0:2;
    then n.t <= m by A9, B11, B13;
    then n.t + (M - m) <= m + (M - m) by XREAL_1:6;
    then B16: n.t + (t - i) <= M by B15, XXREAL_0:2;
    PSum(f,P,a1) <= e * n.a1 by A7, B12, PSumBounds;
    then B17: M <= e * n.a1 by A9, B10, B12;
    e * n.a1 <= e * n.i by B12, XREAL_1:64;
    then M <= e * n.i by B17, XXREAL_0:2;
    then n.t + (t - i) <= e * n.i by B16, XXREAL_0:2;
    then n.t + (t - i) + i <= e * n.i + i by XREAL_1:6;
    hence thesis;
  end;
  K <= e by A4, A11, BoundLe;
  then A12: eta G = K by A6, XXREAL_0:1;
  thus eta G = K by A12;
  :: eta(G) <= r
  for i,t being Nat st 1 <= i & i <= t & t <= len n holds
    n.t + t <= r * n.i + i
  proof
    let i,t be Nat;
    assume B1: 1 <= i & i <= t & t <= len n;
    then B2: n.t <= n.i by A2, A3;
    i <= len n by B1, XXREAL_0:2;
    then B3: 1 <= n.i by A4, B1;
    B3a: t - i <= r - 1 by A3, B1, XREAL_1:13;
    i <= len n by B1, XXREAL_0:2;
    then 1 <= r by A3, B1, XXREAL_0:2;
    then 0 <= r - 1 by XREAL_1:48;
    then r - 1 <= (r - 1) * n.i by B3, XREAL_1:151;
    then B4: t - i <= (r - 1) * n.i by B3a, XXREAL_0:2;
    0 <= t - i by B1, XREAL_1:48;
    then n.t + (t - i) <= n.i + (r - 1) * n.i by B2, B4, XREAL_1:7;
    then n.t + (t - i) + i <= r * n.i + i by XREAL_1:6;
    hence thesis;
  end;
  then K <= r by A4, BoundLe;
  hence thesis by A12;
end;

:: One vertex from each part forms a clique, so chi(G) >= r

theorem CmChi:
  P is_cm_of G implies len P <= chromatic# G
proof
  assume A1: P is_cm_of G;
  set C = the carrier of G;
  defpred R[object,object] means $2 in P.$1;
  A2: for x being object st x in dom P ex y being object st y in C & R[x,y]
  proof
    let x be object;
    assume B1: x in dom P;
    then reconsider i = x as Nat;
    consider u such that B2: u in P.i by A1, B1, PartElem;
    take u;
    thus thesis by B2;
  end;
  consider g being Function of dom P, C such that
  A3: for x being object st x in dom P holds R[x,g.x] from FUNCT_2:sch 1(A2);
  A4: dom g = dom P by FUNCT_2:def 1;
  for x,y being object st x in dom g & y in dom g & g.x = g.y holds x = y
  proof
    let x,y be object;
    assume B1: x in dom g & y in dom g & g.x = g.y;
    then reconsider i = x, j = y as Nat by A4;
    B2: g.x in C by A4, B1, FUNCT_2:5;
    reconsider u = g.x as Element of G by A4, B1, FUNCT_2:5;
    u in P.i & u in P.j by A3, A4, B1;
    hence thesis by A1, A4, B1, PartUnique;
  end;
  then A5: g is one-to-one by FUNCT_1:def 4;
  reconsider Q = rng g as Subset of G;
  for u,v st u in Q & v in Q & u <> v holds u,v are_adjacent
  proof
    let u,v;
    assume B1: u in Q & v in Q & u <> v;
    then consider x being object such that
    B2: x in dom g & u = g.x by FUNCT_1:def 3;
    consider y being object such that
    B3: y in dom g & v = g.y by B1, FUNCT_1:def 3;
    reconsider i = x, j = y as Nat by A4, B2, B3;
    i <> j & u in P.i & v in P.j by A3, A4, B1, B2, B3;
    hence thesis by A1, A4, B2, B3;
  end;
  then reconsider Q as finite Clique of G by CliqueI;
  card Q = card dom g by A5, CARD_1:70
  .= card Seg len P by A4, FINSEQ_1:def 3
  .= len P by FINSEQ_1:57;
  hence thesis by CliqueLeChi;
end;

theorem Theorem1Conjecture:
  P is_cm_of G &
  (for i,j st 1 <= i & i <= j & j <= len P holds
    (Sizes P).j <= (Sizes P).i)
  implies eta G <= chromatic# G
proof
  assume A1: P is_cm_of G &
    (for i,j st 1 <= i & i <= j & j <= len P holds
    (Sizes P).j <= (Sizes P).i);
  then A2: eta G <= len P by Theorem1;
  len P <= chromatic# G by A1, CmChi;
  hence thesis by A2, XXREAL_0:2;
end;

:: Section 3. Join with complete graphs

:: u and v are true twins if N[u] = N[v]

definition
  let G, u, v;
  pred u,v are_true_twins means
  :DefTwins:
  Nb u \/ {u} = Nb v \/ {v};
end;

theorem SumClosed:
  for J being finite Subset of the carrier of G st J = Nb v \/ {v} holds
  Sum(f|J) = SumN(f,v) + f.v
proof
  let J be finite Subset of the carrier of G;
  assume A1: J = Nb v \/ {v};
  not v in Nb v by NbNotSelf;
  hence thesis by A1, SumAdd1;
end;

theorem TwinsLabels:
  f is additive & u,v are_true_twins & u <> v implies f.u <> f.v
proof
  assume A1: f is additive & u,v are_true_twins & u <> v;
  assume A2: f.u = f.v;
  A3: Nb u \/ {u} = Nb v \/ {v} by A1;
  v in {v} by TARSKI:def 1;
  then v in Nb u \/ {u} by A3, XBOOLE_0:def 3;
  then v in Nb u or v in {u} by XBOOLE_0:def 3;
  then v in Nb u by A1, TARSKI:def 1;
  then A4: u,v are_adjacent by NbIff;
  {u} c= the carrier of G by ZFMISC_1:31;
  then reconsider J = Nb u \/ {u} as finite Subset of the carrier of G
    by XBOOLE_1:8;
  Sum(f|J) = SumN(f,u) + f.u & Sum(f|J) = SumN(f,v) + f.v by A3, SumClosed;
  then SumN(f,u) = SumN(f,v) by A2;
  hence contradiction by A1, A4;
end;

:: Observation 2: a set T of pairwise true twins needs |T| labels

theorem Observation2:
  for T being Subset of G st
  for u,v st u in T & v in T holds u,v are_true_twins
  holds card T <= eta G
proof
  let T be Subset of G;
  assume A1: for u,v st u in T & v in T holds u,v are_true_twins;
  consider f such that A2: f is (eta G)-labeling additive by EtaAtt;
  per cases;
  suppose T = {};
    hence thesis;
  end;
  suppose A3: T <> {};
    A4: for x,y being object st x in T & y in T & f.x = f.y holds x = y
    proof
      let x,y be object;
      assume B1: x in T & y in T & f.x = f.y;
      then reconsider u = x, w = y as Element of G;
      u,w are_true_twins by A1, B1;
      hence thesis by A2, B1, TwinsLabels;
    end;
    for x being object st x in T holds 1 <= f.x & f.x <= eta G by A2;
    then card T + 1 <= eta G + 1 by A3, A4, SpreadF;
    hence thesis by XREAL_1:6;
  end;
end;

:: The maximum degree Delta

definition
  let G;
  func maxdeg G -> Nat means
  :DefMaxdeg:
  (ex v st it = deg v) & for v holds deg v <= it;
  existence
  proof
    defpred P[Nat] means ex v st $1 = deg v;
    A1: for k being Nat st P[k] holds k <= card the carrier of G
    proof
      let k be Nat;
      assume P[k];
      then consider v such that B1: k = deg v;
      thus thesis by B1, NAT_1:43;
    end;
    A2: ex k being Nat st P[k]
    proof
      set v = the Element of G;
      take deg v, v;
      thus thesis;
    end;
    consider M being Nat such that
    A3: P[M] & for k being Nat st P[k] holds k <= M from NAT_1:sch 6(A1, A2);
    take M;
    thus thesis by A3;
  end;
  uniqueness
  proof
    let m1,m2 be Nat;
    assume A1: ((ex v st m1 = deg v) & for v holds deg v <= m1) &
      ((ex v st m2 = deg v) & for v holds deg v <= m2);
    then consider v1 being Element of G such that A2: m1 = deg v1;
    consider v2 being Element of G such that A3: m2 = deg v2 by A1;
    m1 <= m2 & m2 <= m1 by A1, A2, A3;
    hence thesis by XXREAL_0:1;
  end;
end;

:: The join G \/ K_U of G with the complete graph on a set U of new
:: vertices

reserve H for Graph;

definition
  let G, H;
  let U be set;
  pred H is_join_of G,U means
  :DefJoin:
  the carrier of H = (the carrier of G) \/ U &
  U misses the carrier of G &
  for x,y being object holds [x,y] in the InternalRel of H iff
    [x,y] in the InternalRel of G or (x in U & y in U & x <> y) or
    (x in the carrier of G & y in U) or (x in U & y in the carrier of G);
end;

theorem JoinExists:
  for U being finite set st U misses the carrier of G holds
  ex H being strict Graph st H is_join_of G,U
proof
  let U be finite set;
  assume A1: U misses the carrier of G;
  set V = the carrier of G;
  set C = V \/ U;
  defpred R[object,object] means
    [$1,$2] in the InternalRel of G or ($1 in U & $2 in U & $1 <> $2) or
    ($1 in V & $2 in U) or ($1 in U & $2 in V);
  consider E being Relation of C such that
  A2: for x,y being object holds [x,y] in E iff x in C & y in C & R[x,y]
    from RELSET_1:sch 1;
  set H = RelStr(# C, E #);
  A3: for x,y being object st R[x,y] holds x in C & y in C
  proof
    let x,y be object;
    assume B1: R[x,y];
    per cases by B1;
    suppose [x,y] in the InternalRel of G;
      then [x,y] in [:V,V:];
      then x in V & y in V by ZFMISC_1:87;
      hence thesis by XBOOLE_0:def 3;
    end;
    suppose x in U & y in U & x <> y;
      hence thesis by XBOOLE_0:def 3;
    end;
    suppose x in V & y in U;
      hence thesis by XBOOLE_0:def 3;
    end;
    suppose x in U & y in V;
      hence thesis by XBOOLE_0:def 3;
    end;
  end;
  for x being set st x in the carrier of H holds
    not [x,x] in the InternalRel of H
  proof
    let x be set;
    assume x in the carrier of H;
    assume [x,x] in the InternalRel of H;
    then B1: R[x,x] by A2;
    per cases by B1;
    suppose B2: [x,x] in the InternalRel of G;
      then [x,x] in [:V,V:];
      then reconsider v = x as Element of G by ZFMISC_1:87;
      v,v are_adjacent by B2;
      hence contradiction;
    end;
    suppose x in U & x in U & x <> x;
      hence contradiction;
    end;
    suppose x in V & x in U;
      hence contradiction by A1, XBOOLE_0:3;
    end;
    suppose x in U & x in V;
      hence contradiction by A1, XBOOLE_0:3;
    end;
  end;
  then A4: H is irreflexive by NECKLACE:def 5;
  A5: for x,y being object st R[x,y] holds R[y,x]
  proof
    let x,y be object;
    assume B1: R[x,y];
    per cases by B1;
    suppose B2: [x,y] in the InternalRel of G;
      then [x,y] in [:V,V:];
      then reconsider v = x, w = y as Element of G by ZFMISC_1:87;
      v,w are_adjacent by B2;
      then w,v are_adjacent;
      hence thesis;
    end;
    suppose x in U & y in U & x <> y;
      hence thesis;
    end;
    suppose x in V & y in U;
      hence thesis;
    end;
    suppose x in U & y in V;
      hence thesis;
    end;
  end;
  for x,y being object st x in the carrier of H & y in the carrier of H &
    [x,y] in the InternalRel of H holds [y,x] in the InternalRel of H
  proof
    let x,y be object;
    assume x in the carrier of H & y in the carrier of H &
      [x,y] in the InternalRel of H;
    then R[x,y] by A2;
    then B1: R[y,x] by A5;
    then y in C & x in C by A3;
    hence thesis by A2, B1;
  end;
  then the InternalRel of H is_symmetric_in the carrier of H
    by RELAT_2:def 3;
  then A6: H is symmetric by NECKLACE:def 3;
  set v0 = the Element of G;
  v0 in C by XBOOLE_0:def 3;
  then reconsider H as strict Graph by A4, A6, STRUCT_0:def 1;
  take H;
  thus the carrier of H = V \/ U & U misses V by A1;
  let x,y be object;
  thus [x,y] in the InternalRel of H implies R[x,y] by A2;
  assume B1: R[x,y];
  then x in C & y in C by A3;
  then [x,y] in E by A2, B1;
  hence thesis;
end;

:: Sums over the same set with labels that agree there

theorem SumEq:
  for I1,I2 being set, f1 being Function of I1,NAT,
  f2 being Function of I2,NAT, J1 being finite Subset of I1,
  J2 being finite Subset of I2 st J1 = J2 &
  for x being object st x in J1 holds f1.x = f2.x
  holds Sum(f1|J1) = Sum(f2|J2)
proof
  let I1,I2 be set, f1 be Function of I1,NAT, f2 be Function of I2,NAT,
    J1 be finite Subset of I1, J2 be finite Subset of I2;
  assume A1: J1 = J2 & for x being object st x in J1 holds f1.x = f2.x;
  dom f1 = I1 & dom f2 = I2 by FUNCT_2:def 1;
  then A2: dom (f1|J1) = J1 & dom (f2|J2) = J2 by RELAT_1:62;
  for x being object st x in dom (f1|J1) holds (f1|J1).x = (f2|J2).x
  proof
    let x be object;
    assume B1: x in dom (f1|J1);
    then (f1|J1).x = f1.x & (f2|J2).x = f2.x by A1, A2, FUNCT_1:49;
    hence thesis by A1, A2, B1;
  end;
  then f1|J1 = f2|J2 by A1, A2, FUNCT_1:2;
  hence thesis by A1;
end;

reserve U for finite set;

theorem JoinAdj:
  H is_join_of G,U implies
  for x,y being Element of H st x = v & y = w holds
  x,y are_adjacent iff v,w are_adjacent
proof
  assume A1: H is_join_of G,U;
  let x,y be Element of H;
  assume A2: x = v & y = w;
  A3: not v in U & not w in U by A1, XBOOLE_0:3;
  x,y are_adjacent iff [x,y] in the InternalRel of H;
  then x,y are_adjacent iff [v,w] in the InternalRel of G by A1, A2, A3;
  hence thesis;
end;

theorem JoinNbV:
  H is_join_of G,U implies
  for x being Element of H st x = v holds Nb x = Nb v \/ U
proof
  assume A1: H is_join_of G,U;
  let x be Element of H;
  assume A2: x = v;
  A3: the carrier of H = (the carrier of G) \/ U by A1;
  A4: not v in U by A1, XBOOLE_0:3;
  for z being object holds z in Nb x iff z in Nb v \/ U
  proof
    let z be object;
    thus z in Nb x implies z in Nb v \/ U
    proof
      assume B1: z in Nb x;
      then reconsider y = z as Element of H;
      x,y are_adjacent by B1, NbIff;
      then [x,y] in the InternalRel of H;
      then B2: [v,y] in the InternalRel of G or y in U by A1, A2, A4;
      per cases by B2;
      suppose B3: [v,y] in the InternalRel of G;
        then [v,y] in [:the carrier of G, the carrier of G:];
        then reconsider w = y as Element of G by ZFMISC_1:87;
        v,w are_adjacent by B3;
        then w in Nb v by NbIff;
        hence thesis by XBOOLE_0:def 3;
      end;
      suppose y in U;
        hence thesis by XBOOLE_0:def 3;
      end;
    end;
    assume B1: z in Nb v \/ U;
    then B2: z in Nb v or z in U by XBOOLE_0:def 3;
    then z in the carrier of G or z in U;
    then z in the carrier of H by A3, XBOOLE_0:def 3;
    then reconsider y = z as Element of H;
    per cases by B2;
    suppose B3: z in Nb v;
      then reconsider w = z as Element of G;
      v,w are_adjacent by B3, NbIff;
      then x,y are_adjacent by A1, A2, JoinAdj;
      hence thesis by NbIff;
    end;
    suppose z in U;
      then [x,y] in the InternalRel of H by A1, A2;
      then x,y are_adjacent;
      hence thesis by NbIff;
    end;
  end;
  hence thesis by TARSKI:2;
end;

theorem JoinNbU:
  H is_join_of G,U implies
  for x being Element of H st x in U holds
  Nb x = (U \ {x}) \/ the carrier of G
proof
  assume A1: H is_join_of G,U;
  let x be Element of H;
  assume A2: x in U;
  A3: the carrier of H = (the carrier of G) \/ U by A1;
  A4: not x in the carrier of G by A1, A2, XBOOLE_0:3;
  for z being object holds z in Nb x iff z in (U \ {x}) \/ the carrier of G
  proof
    let z be object;
    thus z in Nb x implies z in (U \ {x}) \/ the carrier of G
    proof
      assume B1: z in Nb x;
      then reconsider y = z as Element of H;
      x,y are_adjacent by B1, NbIff;
      then B2: [x,y] in the InternalRel of H & x <> y;
      [x,y] in the InternalRel of G implies x in the carrier of G
      proof
        assume [x,y] in the InternalRel of G;
        then [x,y] in [:the carrier of G, the carrier of G:];
        hence thesis by ZFMISC_1:87;
      end;
      then B3: (y in U & x <> y) or y in the carrier of G by A1, A4, B2;
      per cases by B3;
      suppose y in U & x <> y;
        then not y in {x} & y in U by TARSKI:def 1;
        then y in U \ {x} by XBOOLE_0:def 5;
        hence thesis by XBOOLE_0:def 3;
      end;
      suppose y in the carrier of G;
        hence thesis by XBOOLE_0:def 3;
      end;
    end;
    assume z in (U \ {x}) \/ the carrier of G;
    then B1: z in U \ {x} or z in the carrier of G by XBOOLE_0:def 3;
    then B2: (z in U & not z in {x}) or z in the carrier of G
      by XBOOLE_0:def 5;
    then z in the carrier of H by A3, XBOOLE_0:def 3;
    then reconsider y = z as Element of H;
    (y in U & x <> y) or y in the carrier of G by B2, TARSKI:def 1;
    then [x,y] in the InternalRel of H by A1, A2;
    then x,y are_adjacent;
    hence thesis by NbIff;
  end;
  hence thesis by TARSKI:2;
end;

reserve F for Function of the carrier of H, NAT;

theorem JoinSumV:
  H is_join_of G,U implies
  for x being Element of H, NG,UU being finite Subset of the carrier of H
  st x = v & NG = Nb v & UU = U holds SumN(F,x) = Sum(F|NG) + Sum(F|UU)
proof
  assume A1: H is_join_of G,U;
  let x be Element of H, NG,UU be finite Subset of the carrier of H;
  assume A2: x = v & NG = Nb v & UU = U;
  A3: Nb x = NG \/ UU by A1, A2, JoinNbV;
  NG misses UU by A1, A2, XBOOLE_1:63;
  hence thesis by A3, SumUnion;
end;

theorem JoinSumU:
  H is_join_of G,U implies
  for x being Element of H, UU,VV being finite Subset of the carrier of H
  st x in U & UU = U & VV = the carrier of G holds
  SumN(F,x) + F.x = Sum(F|UU) + Sum(F|VV)
proof
  assume A1: H is_join_of G,U;
  then A0: U misses the carrier of G by DefJoin;
  let x be Element of H, UU,VV be finite Subset of the carrier of H;
  assume A2: x in U & UU = U & VV = the carrier of G;
  reconsider U1 = U \ {x} as finite Subset of the carrier of H
    by A2, XBOOLE_1:1;
  A3: Nb x = U1 \/ VV by A1, A2, JoinNbU;
  A6: U1 c= U by XBOOLE_1:36;
  U1 misses VV by A0, A2, A6, XBOOLE_1:63;
  then A4: SumN(F,x) = Sum(F|U1) + Sum(F|VV) by A3, SumUnion;
  A5: not x in U1 by ZFMISC_1:56;
  {x} c= U by A2, ZFMISC_1:31;
  then U = U1 \/ {x} by XBOOLE_1:45;
  then Sum(F|UU) = Sum(F|U1) + F.x by A2, A5, SumAdd1;
  hence thesis by A4;
end;

:: Theorem 2: eta(G \/ K_q) = max {eta(G), q} for q <= n - Delta - 1

theorem Theorem2:
  H is_join_of G,U & card U + maxdeg G + 1 <= card the carrier of G
  implies eta H = max(eta G, card U)
proof
  assume that
  A1: H is_join_of G,U and
  A2: card U + maxdeg G + 1 <= card the carrier of G;
  set V = the carrier of G, C = the carrier of H, q = card U;
  A3: C = V \/ U & U misses V by A1, DefJoin;
  then reconsider UU = U, VV = V as finite Subset of C by XBOOLE_1:7;
  set K = max(eta G, q);
  reconsider K as Nat by XXREAL_0:16;
  A4: eta G <= K & q <= K by XXREAL_0:25;
  :: an additive K-coloring of the join
  consider f such that A5: f is (eta G)-labeling additive by EtaAtt;
  U, card U are_equipotent by CARD_1:def 2;
  then consider h0 being Function such that
  A6: h0 is one-to-one & dom h0 = U & rng h0 = card U by WELLORD2:def 4;
  rng h0 c= NAT by A6, ORDINAL1:def 2;
  then reconsider h = h0 as Function of U, NAT by A6, FUNCT_2:2;
  A7: for x being object st x in U holds h.x < q
  proof
    let x be object;
    assume x in U;
    then B1: h.x in card U by A6, FUNCT_1:def 3;
    reconsider k = h.x as Nat;
    k in Segm q by B1, ORDINAL1:def 17;
    hence thesis by NAT_1:44;
  end;
  defpred Cu[object] means $1 in U;
  deffunc Fu(object) = h.$1 + 1;
  deffunc Fv(object) = f.$1;
  A8: for x being object st x in C holds
    (Cu[x] implies Fu(x) in NAT) & (not Cu[x] implies Fv(x) in NAT)
  proof
    let x be object;
    assume B1: x in C;
    thus Cu[x] implies Fu(x) in NAT by ORDINAL1:def 12;
    assume not Cu[x];
    then x in V by A3, B1, XBOOLE_0:def 3;
    hence thesis by FUNCT_2:5;
  end;
  consider F being Function of C, NAT such that
  A9: for x being object st x in C holds
    (Cu[x] implies F.x = Fu(x)) & (not Cu[x] implies F.x = Fv(x))
    from FUNCT_2:sch 5(A8);
  A10: for x being object st x in V holds F.x = f.x
  proof
    let x be object;
    assume B1: x in V;
    then B2: not x in U by A3, XBOOLE_0:3;
    x in C by A3, B1, XBOOLE_0:def 3;
    hence thesis by A9, B2;
  end;
  A11: for x being object st x in U holds 1 <= F.x & F.x <= q
  proof
    let x be object;
    assume B1: x in U;
    then x in C by A3, XBOOLE_0:def 3;
    then B2: F.x = h.x + 1 by A9, B1;
    h.x < q by A7, B1;
    hence thesis by B2, NAT_1:11, NAT_1:13;
  end;
  A12: F is K-labeling
  proof
    let x be Element of H;
    per cases by A3, XBOOLE_0:def 3;
    suppose B1: x in U;
      then 1 <= F.x & F.x <= q by A11;
      hence thesis by A4, XXREAL_0:2;
    end;
    suppose x in V;
      then reconsider v = x as Element of G;
      B2: F.x = f.v by A10;
      1 <= f.v & f.v <= eta G by A5;
      hence thesis by A4, B2, XXREAL_0:2;
    end;
  end;
  A13: for x being Element of H, v st x = v holds
    SumN(F,x) = SumN(f,v) + Sum(F|UU)
  proof
    let x be Element of H, v;
    assume B1: x = v;
    reconsider NG = Nb v as finite Subset of C by A3, XBOOLE_1:10;
    B2: SumN(F,x) = Sum(F|NG) + Sum(F|UU) by A1, B1, JoinSumV;
    for z being object st z in NG holds F.z = f.z by A10;
    hence thesis by B2, SumEq;
  end;
  :: an edge between V and U: the sum at the vertex of U is larger
  A14: for x,y being Element of H st x in V & y in U holds
    SumN(F,x) < SumN(F,y)
  proof
    let x,y be Element of H;
    assume B1: x in V & y in U;
    then reconsider v = x as Element of G;
    reconsider NG = Nb v as finite Subset of C by A3, XBOOLE_1:10;
    reconsider R = V \ Nb v as finite Subset of C by A3, XBOOLE_1:10;
    B2: SumN(F,x) = Sum(F|NG) + Sum(F|UU) by A1, JoinSumV;
    B3: VV \ NG = R;
    Sum(F|VV) = Sum(F|NG) + Sum(F|(VV \ NG)) by SumSplit;
    then B4: Sum(F|VV) = Sum(F|NG) + Sum(F|R) by B3;
    B5: SumN(F,y) + F.y = Sum(F|UU) + Sum(F|VV) by A1, B1, JoinSumU;
    B6: card R = card V - deg v by CARD_2:44;
    deg v <= maxdeg G by DefMaxdeg;
    then B7: card V - maxdeg G <= card V - deg v by XREAL_1:10;
    (q + 1) + maxdeg G <= card V by A2;
    then q + 1 <= card V - maxdeg G by XREAL_1:19;
    then B8: q + 1 <= card R by B6, B7, XXREAL_0:2;
    for z being object st z in R holds 1 <= F.z & F.z <= K
    proof
      let z be object;
      assume z in R;
      then reconsider w = z as Element of H by A3, XBOOLE_0:def 3;
      1 <= F.w & F.w <= K by A12;
      hence thesis;
    end;
    then 1 * card R <= Sum(F|R) by SumBounds;
    then B9: q + 1 <= Sum(F|R) by B8, XXREAL_0:2;
    F.y <= q by A11, B1;
    then F.y + 1 <= q + 1 by XREAL_1:6;
    then F.y + 1 <= Sum(F|R) by B9, XXREAL_0:2;
    then Sum(F|NG) + Sum(F|UU) + (F.y + 1) <= Sum(F|NG) + Sum(F|UU)
      + Sum(F|R) by XREAL_1:6;
    then SumN(F,x) + F.y + 1 <= SumN(F,y) + F.y by B2, B4, B5;
    then SumN(F,x) + 1 + F.y <= SumN(F,y) + F.y;
    then SumN(F,x) + 1 <= SumN(F,y) by XREAL_1:6;
    hence thesis by NAT_1:13;
  end;
  F is additive
  proof
    let x,y be Element of H;
    assume x,y are_adjacent;
    then B1: [x,y] in the InternalRel of H;
    per cases by A1, B1, DefJoin;
    suppose B2: [x,y] in the InternalRel of G;
      then [x,y] in [:V,V:];
      then reconsider v = x, w = y as Element of G by ZFMISC_1:87;
      v,w are_adjacent by B2;
      then B3: SumN(f,v) <> SumN(f,w) by A5;
      SumN(F,x) = SumN(f,v) + Sum(F|UU) & SumN(F,y) = SumN(f,w) + Sum(F|UU)
        by A13;
      hence thesis by B3;
    end;
    suppose B2: x in U & y in U & x <> y;
      then x in C & y in C by A3, XBOOLE_0:def 3;
      then B3: F.x = h.x + 1 & F.y = h.y + 1 by A9, B2;
      dom h = U by FUNCT_2:def 1;
      then B4: F.x <> F.y by A6, B2, B3, FUNCT_1:def 4;
      SumN(F,x) + F.x = Sum(F|UU) + Sum(F|VV) &
        SumN(F,y) + F.y = Sum(F|UU) + Sum(F|VV) by A1, B2, JoinSumU;
      hence thesis by B4;
    end;
    suppose x in V & y in U;
      hence thesis by A14;
    end;
    suppose x in U & y in V;
      hence thesis by A14;
    end;
  end;
  then A15: eta H <= K by A12, EtaLe;
  :: optimality: U is a set of true twins, and colorings restrict to G
  for x,y being Element of H st x in UU & y in UU holds x,y are_true_twins
  proof
    let x,y be Element of H;
    assume B1: x in UU & y in UU;
    for z being Element of H st z in U holds Nb z \/ {z} = U \/ V
    proof
      let z be Element of H;
      assume C1: z in U;
      then C2: {z} c= U by ZFMISC_1:31;
      Nb z \/ {z} = (U \ {z}) \/ V \/ {z} by A1, C1, JoinNbU
      .= (U \ {z}) \/ {z} \/ V by XBOOLE_1:4
      .= U \/ V by C2, XBOOLE_1:45;
      hence thesis;
    end;
    then Nb x \/ {x} = U \/ V & Nb y \/ {y} = U \/ V by B1;
    hence thesis;
  end;
  then A16: q <= eta H by Observation2;
  eta G <= eta H
  proof
    consider F1 being Function of C, NAT such that
    B1: F1 is (eta H)-labeling additive by EtaAtt;
    deffunc Fr(Element of V) = F1.$1;
    B2: for v holds Fr(v) in NAT
    proof
      let v;
      v in C by A3, XBOOLE_0:def 3;
      hence thesis by FUNCT_2:5;
    end;
    deffunc Fr1(Element of V) = In(F1.$1, NAT);
    consider f1 being Function of V, NAT such that
    B3: for v holds f1.v = Fr1(v) from FUNCT_2:sch 4;
    B4: for v holds f1.v = F1.v
    proof
      let v;
      F1.v in NAT by B2;
      then In(F1.v, NAT) = F1.v by SUBSET_1:def 8;
      hence thesis by B3;
    end;
    B5: f1 is (eta H)-labeling
    proof
      let v;
      v in C by A3, XBOOLE_0:def 3;
      then reconsider x = v as Element of H;
      1 <= F1.x & F1.x <= eta H by B1;
      hence thesis by B4;
    end;
    f1 is additive
    proof
      let v,w;
      assume C1: v,w are_adjacent;
      v in C & w in C by A3, XBOOLE_0:def 3;
      then reconsider x = v, y = w as Element of H;
      x,y are_adjacent by A1, C1, JoinAdj;
      then C2: SumN(F1,x) <> SumN(F1,y) by B1;
      reconsider Nv = Nb v, Nw = Nb w as finite Subset of C
        by A3, XBOOLE_1:10;
      C3: for z being object st z in Nv holds f1.z = F1.z by B4;
      C4: for z being object st z in Nw holds f1.z = F1.z by B4;
      C5: SumN(f1,v) = Sum(F1|Nv) by C3, SumEq;
      C6: SumN(f1,w) = Sum(F1|Nw) by C4, SumEq;
      SumN(F1,x) = Sum(F1|Nv) + Sum(F1|UU) &
        SumN(F1,y) = Sum(F1|Nw) + Sum(F1|UU) by A1, JoinSumV;
      hence thesis by C2, C5, C6;
    end;
    hence thesis by B5, EtaLe;
  end;
  then K <= eta H by A16, XXREAL_0:28;
  hence thesis by A15, XXREAL_0:1;
end;

:: chi(G \/ K_q) >= chi(G) + q (the paper uses equality), so the
:: conjecture is inherited by the join.

theorem JoinChi:
  H is_join_of G,U implies chromatic# G + card U <= chromatic# H
proof
  assume A1: H is_join_of G,U;
  set V = the carrier of G, W = the carrier of H;
  A2: W = V \/ U & U misses V by A1, DefJoin;
  consider C being finite Coloring of H such that
  A3: card C = chromatic# H by MYCIELSK:def 3;
  A4: union C = W & for A being set st A in C holds A <> {} &
    for B being set st B in C holds A = B or A misses B by EQREL_1:def 4;
  A5: for c being set st c in C holds c is StableSet of H
    by DILWORTH:def 12;
  :: a class meeting U contains no vertex of V
  A6: for c being set, x,y being object st c in C & x in c & y in c &
    x in U & y in V holds contradiction
  proof
    let c be set, x,y be object;
    assume B1: c in C & x in c & y in c & x in U & y in V;
    then B2: c is StableSet of H by A5;
    x in W & y in W by A2, B1, XBOOLE_0:def 3;
    then reconsider a = x, b = y as Element of H;
    a <> b by A2, B1, XBOOLE_0:3;
    then not a <= b by B1, B2, DILWORTH:def 2;
    then not [a,b] in the InternalRel of H by ORDERS_2:def 5;
    hence contradiction by A1, B1, DefJoin;
  end;
  set CV = {c where c is Subset of W: c in C & c misses U};
  A7: CV c= C
  proof
    let x be object;
    assume x in CV;
    then ex c being Subset of W st x = c & c in C & c misses U;
    hence thesis;
  end;
  A8: for c being set holds c in CV iff c in C & c misses U
  proof
    let c be set;
    thus c in CV implies c in C & c misses U
    proof
      assume c in CV;
      then ex c1 being Subset of W st c = c1 & c1 in C & c1 misses U;
      hence thesis;
    end;
    assume B1: c in C & c misses U;
    then c is Subset of W;
    hence thesis by B1;
  end;
  CV c= bool V
  proof
    let x be object;
    assume B0: x in CV;
    then x in C by A7;
    then reconsider c = x as Subset of W;
    B1: c misses U by A8, B0;
    c c= V
    proof
      let y be object;
      assume C1: y in c;
      then y in V or y in U by A2, XBOOLE_0:def 3;
      hence thesis by B1, C1, XBOOLE_0:3;
    end;
    hence thesis;
  end;
  then reconsider CV as Subset-Family of V;
  A9: union CV = V
  proof
    for y being object holds y in union CV iff y in V
    proof
      let y be object;
      thus y in union CV implies y in V
      proof
        assume y in union CV;
        then consider c being set such that C1: y in c & c in CV
          by TARSKI:def 4;
        thus thesis by C1;
      end;
      assume C1: y in V;
      then y in W by A2, XBOOLE_0:def 3;
      then consider c being set such that C2: y in c & c in C
        by A4, TARSKI:def 4;
      c misses U
      proof
        assume c meets U;
        then consider x being object such that D1: x in c & x in U
          by XBOOLE_0:3;
        thus contradiction by A6, C1, C2, D1;
      end;
      then c in CV by A8, C2;
      hence thesis by C2, TARSKI:def 4;
    end;
    hence thesis by TARSKI:2;
  end;
  for A being Subset of V st A in CV holds A <> {} &
    for B being Subset of V st B in CV holds A = B or A misses B by A4, A7;
  then reconsider CV as a_partition of V by A9, EQREL_1:def 4;
  for x being set st x in CV holds x is StableSet of G
  proof
    let x be set;
    assume B1: x in CV;
    then reconsider c = x as Subset of G;
    B2: x is StableSet of H by A5, A7, B1;
    for a,b being Element of G st a in c & b in c & a <> b holds
      not a <= b & not b <= a
    proof
      let a,b be Element of G;
      assume C1: a in c & b in c & a <> b;
      a in W & b in W by A2, XBOOLE_0:def 3;
      then reconsider a1 = a, b1 = b as Element of H;
      not a1 <= b1 & not b1 <= a1 by B2, C1, DILWORTH:def 2;
      then not [a1,b1] in the InternalRel of H &
        not [b1,a1] in the InternalRel of H by ORDERS_2:def 5;
      then not [a,b] in the InternalRel of G &
        not [b,a] in the InternalRel of G by A1, DefJoin;
      hence thesis by ORDERS_2:def 5;
    end;
    hence thesis by DILWORTH:def 2;
  end;
  then reconsider CV as finite Coloring of G by A7, DILWORTH:def 12;
  A10: chromatic# G <= card CV by MYCIELSK:def 3;
  :: the classes of the vertices of U are distinct and meet U
  set CU = C \ CV;
  defpred Q[object,object] means ex c being set st c = $2 & $1 in c;
  A11: for x being object st x in U ex y being object st y in C & Q[x,y]
  proof
    let x be object;
    assume x in U;
    then x in W by A2, XBOOLE_0:def 3;
    then consider c being set such that B1: x in c & c in C
      by A4, TARSKI:def 4;
    take c;
    thus c in C by B1;
    take c;
    thus thesis by B1;
  end;
  consider g being Function of U, C such that
  A12: for x being object st x in U holds Q[x,g.x] from FUNCT_2:sch 1(A11);
  A13: C <> {}
  proof
    set x = the Element of H;
    consider c being set such that B1: x in c & c in C
      by A4, TARSKI:def 4;
    thus thesis by B1;
  end;
  A14: dom g = U by A13, FUNCT_2:def 1;
  for x,y being object st x in dom g & y in dom g & g.x = g.y holds x = y
  proof
    let x,y be object;
    assume B1: x in dom g & y in dom g & g.x = g.y;
    then B2: g.x in C by A13, A14, FUNCT_2:5;
    then reconsider c = g.x as set;
    B3a: ex c1 being set st c1 = g.x & x in c1 by A12, A14, B1;
    ex c2 being set st c2 = g.y & y in c2 by A12, A14, B1;
    then B3: x in c & y in c by B1, B3a;
    B4: c is StableSet of H by A5, B2;
    assume B5: x <> y;
    x in W & y in W by A2, A14, B1, XBOOLE_0:def 3;
    then reconsider a = x, b = y as Element of H;
    not a <= b by B3, B4, B5, DILWORTH:def 2;
    then not [a,b] in the InternalRel of H by ORDERS_2:def 5;
    hence contradiction by A1, A14, B1, B5, DefJoin;
  end;
  then A15: g is one-to-one by FUNCT_1:def 4;
  rng g c= CU
  proof
    let y be object;
    assume y in rng g;
    then consider x being object such that
    B1: x in dom g & y = g.x by FUNCT_1:def 3;
    B2: y in C by A13, A14, B1, FUNCT_2:5;
    then reconsider c = y as set;
    ex c1 being set st c1 = g.x & x in c1 by A12, A14, B1;
    then x in c by B1;
    then c meets U by A14, B1, XBOOLE_0:3;
    then not c in CV by A8;
    hence thesis by B2, XBOOLE_0:def 5;
  end;
  then card rng g <= card CU by NAT_1:43;
  then A16: card U <= card CU by A14, A15, CARD_1:70;
  card CU = card C - card CV by A7, CARD_2:44;
  then A17: card U + card CV <= card C by A16, XREAL_1:19;
  chromatic# G + card U <= card CV + card U by A10, XREAL_1:6;
  hence thesis by A3, A17, XXREAL_0:2;
end;

theorem Theorem2Conjecture:
  H is_join_of G,U & card U + maxdeg G + 1 <= card the carrier of G &
  eta G <= chromatic# G implies eta H <= chromatic# H
proof
  assume A1: H is_join_of G,U & card U + maxdeg G + 1 <= card the carrier of G
    & eta G <= chromatic# G;
  then A2: eta H = max(eta G, card U) by Theorem2;
  A3: chromatic# G + card U <= chromatic# H by A1, JoinChi;
  chromatic# G <= chromatic# G + card U by NAT_1:11;
  then eta G <= chromatic# G + card U by A1, XXREAL_0:2;
  then A4: eta G <= chromatic# H by A3, XXREAL_0:2;
  card U <= chromatic# G + card U by NAT_1:11;
  then card U <= chromatic# H by A3, XXREAL_0:2;
  hence thesis by A2, A4, XXREAL_0:28;
end;

:: Graphs given by a symmetric irreflexive predicate on a finite set

scheme GraphEx{V() -> non empty finite set, P[object,object]}:
  ex G being strict Graph st the carrier of G = V() &
  for x,y being object holds [x,y] in the InternalRel of G iff
    x in V() & y in V() & P[x,y]
provided
A1: for x,y being object st P[x,y] holds P[y,x] and
A2: for x being object holds not P[x,x]
proof
  consider E being Relation of V() such that
  A3: for x,y being object holds [x,y] in E iff x in V() & y in V() & P[x,y]
    from RELSET_1:sch 1;
  set H = RelStr(# V(), E #);
  for x being set st x in the carrier of H holds
    not [x,x] in the InternalRel of H by A2, A3;
  then A4: H is irreflexive by NECKLACE:def 5;
  for x,y being object st x in the carrier of H & y in the carrier of H &
    [x,y] in the InternalRel of H holds [y,x] in the InternalRel of H
  proof
    let x,y be object;
    assume B1: x in the carrier of H & y in the carrier of H &
      [x,y] in the InternalRel of H;
    then P[x,y] by A3;
    then P[y,x] by A1;
    hence thesis by A3, B1;
  end;
  then the InternalRel of H is_symmetric_in the carrier of H
    by RELAT_2:def 3;
  then H is symmetric by NECKLACE:def 3;
  then reconsider H as strict Graph by A4;
  take H;
  thus thesis by A3;
end;

:: Adjacency in a graph on natural numbers

theorem AdjNat:
  for i,j being Nat st u = i & v = j holds
  u,v are_adjacent iff [i,j] in the InternalRel of G by DefAdj;

:: Two vertices of degree 2 joined by an edge force eta(G) >= 2

theorem EtaGe2:
  u,v are_adjacent & deg u = deg v implies 2 <= eta G
proof
  assume u,v are_adjacent & deg u = deg v;
  then A1: eta G <> 1 by Observation1;
  1 <= eta G by EtaPos;
  then 1 < eta G by A1, XXREAL_0:1;
  then 1 + 1 <= eta G by NAT_1:13;
  hence thesis;
end;

theorem EtaEq2:
  u,v are_adjacent & deg u = deg v & f is 2-labeling additive
  implies eta G = 2
proof
  assume A1: u,v are_adjacent & deg u = deg v & f is 2-labeling additive;
  then A2: 2 <= eta G by EtaGe2;
  eta G <= 2 by A1, EtaLe;
  hence thesis by A2, XXREAL_0:1;
end;

:: Section 3: paths and fans. P_N has vertices 1..N; the paper's P_(n+1)
:: is N = n + 1.

definition
  let G; let N be Nat;
  pred G is_path_of N means
  :DefPath:
  the carrier of G = Seg N &
  for i,j being Nat holds [i,j] in the InternalRel of G iff
    i in Seg N & j in Seg N & (j = i + 1 or i = j + 1);
end;

theorem PathExists:
  for N being Nat st 1 <= N holds ex G being strict Graph st G is_path_of N
proof
  let N be Nat;
  assume 1 <= N;
  then reconsider V = Seg N as non empty finite set by FINSEQ_1:1;
  defpred P[object,object] means ex i,j being Nat st i = $1 & j = $2 &
    (j = i + 1 or i = j + 1);
  A1: for x,y being object st P[x,y] holds P[y,x];
  A2: for x being object holds not P[x,x];
  consider G being strict Graph such that
  A3: the carrier of G = V & for x,y being object holds
    [x,y] in the InternalRel of G iff x in V & y in V & P[x,y]
    from GraphEx(A1, A2);
  take G;
  thus the carrier of G = Seg N by A3;
  let i,j be Nat;
  thus [i,j] in the InternalRel of G implies
    i in Seg N & j in Seg N & (j = i + 1 or i = j + 1)
  proof
    assume [i,j] in the InternalRel of G;
    then i in V & j in V & P[i,j] by A3;
    hence thesis;
  end;
  assume i in Seg N & j in Seg N & (j = i + 1 or i = j + 1);
  hence thesis by A3;
end;

theorem PathNb:
  for N being Nat st G is_path_of N & 2 <= N holds
  for i being Nat st v = i holds
  (i = 1 implies Nb v = {2}) &
  (1 < i & i < N implies Nb v = {i -' 1, i + 1}) &
  (i = N implies Nb v = {N -' 1})
proof
  let N be Nat;
  assume A1: G is_path_of N & 2 <= N;
  let i be Nat;
  assume A2: v = i;
  A3: the carrier of G = Seg N by A1;
  then A4: 1 <= i & i <= N by A2, FINSEQ_1:1;
  :: w in N(v) iff w = i - 1 or w = i + 1 (within 1..N)
  A5: for z being object holds z in Nb v iff
    ex j being Nat st z = j & j in Seg N & (j = i + 1 or i = j + 1)
  proof
    let z be object;
    thus z in Nb v implies
      ex j being Nat st z = j & j in Seg N & (j = i + 1 or i = j + 1)
    proof
      assume B1: z in Nb v;
      then z in Seg N by A3;
      then reconsider j = z as Nat;
      reconsider w = z as Element of G by B1;
      v,w are_adjacent by B1, NbIff;
      then [i,j] in the InternalRel of G by A2;
      then j in Seg N & (j = i + 1 or i = j + 1) by A1, DefPath;
      hence thesis;
    end;
    given j being Nat such that
    B1: z = j & j in Seg N & (j = i + 1 or i = j + 1);
    reconsider w = z as Element of G by A3, B1;
    i in Seg N by A2, A3;
    then [i,j] in the InternalRel of G by A1, B1, DefPath;
    then v,w are_adjacent by A2, B1;
    hence thesis by NbIff;
  end;
  thus i = 1 implies Nb v = {2}
  proof
    assume B1: i = 1;
    for z being object holds z in Nb v iff z = 2
    proof
      let z be object;
      thus z in Nb v implies z = 2
      proof
        assume z in Nb v;
        then consider j being Nat such that
        C1: z = j & j in Seg N & (j = i + 1 or i = j + 1) by A5;
        1 <= j by C1, FINSEQ_1:1;
        then j + 0 < j + 1 & 0 + 1 <= j by XREAL_1:6;
        then i <> j + 1 by B1;
        hence thesis by B1, C1;
      end;
      assume B2: z = 2;
      2 in Seg N by A1, FINSEQ_1:1;
      hence thesis by A5, B1, B2;
    end;
    hence thesis by TARSKI:def 1;
  end;
  thus 1 < i & i < N implies Nb v = {i -' 1, i + 1}
  proof
    assume B1: 1 < i & i < N;
    then B2: i -' 1 = i - 1 by XREAL_1:233;
    for z being object holds z in Nb v iff z = i -' 1 or z = i + 1
    proof
      let z be object;
      thus z in Nb v implies z = i -' 1 or z = i + 1
      proof
        assume z in Nb v;
        then consider j being Nat such that
        C1: z = j & j in Seg N & (j = i + 1 or i = j + 1) by A5;
        thus thesis by B2, C1;
      end;
      assume C1: z = i -' 1 or z = i + 1;
      per cases by C1;
      suppose C2: z = i -' 1;
        1 + 1 <= i by B1, NAT_1:13;
        then 1 <= i - 1 by XREAL_1:19;
        then C3a: 1 <= i -' 1 by B2;
        i - 1 <= i by XREAL_1:146;
        then i -' 1 <= N by A4, B2, XXREAL_0:2;
        then C3: i -' 1 in Seg N by C3a, FINSEQ_1:1;
        i = (i -' 1) + 1 by B2;
        hence thesis by A5, C2, C3;
      end;
      suppose C2: z = i + 1;
        C3: i + 1 <= N by B1, NAT_1:13;
        1 <= i + 1 by NAT_1:11;
        then i + 1 in Seg N by C3, FINSEQ_1:1;
        hence thesis by A5, C2;
      end;
    end;
    hence thesis by TARSKI:def 2;
  end;
  assume B1: i = N;
  then B2: N -' 1 = N - 1 by A4, XREAL_1:233;
  for z being object holds z in Nb v iff z = N -' 1
  proof
    let z be object;
    thus z in Nb v implies z = N -' 1
    proof
      assume z in Nb v;
      then consider j being Nat such that
      C1: z = j & j in Seg N & (j = i + 1 or i = j + 1) by A5;
      j <= N by C1, FINSEQ_1:1;
      then j <> N + 1 by NAT_1:13;
      hence thesis by B1, B2, C1;
    end;
    assume C1: z = N -' 1;
    1 + 1 <= N by A1;
    then C2: 1 <= N - 1 by XREAL_1:19;
    N - 1 <= N by XREAL_1:146;
    then C3: N -' 1 in Seg N by B2, C2, FINSEQ_1:1;
    i = (N -' 1) + 1 by B1, B2;
    hence thesis by A5, C1, C3;
  end;
  hence thesis by TARSKI:def 1;
end;

theorem PathSum:
  for N being Nat st G is_path_of N & 2 <= N holds
  for i being Nat st v = i holds
  (i = 1 implies SumN(f,v) = f.2) &
  (1 < i & i < N implies SumN(f,v) = f.(i -' 1) + f.(i + 1)) &
  (i = N implies SumN(f,v) = f.(N -' 1))
proof
  let N be Nat;
  assume A1: G is_path_of N & 2 <= N;
  let i be Nat;
  assume A2: v = i;
  thus i = 1 implies SumN(f,v) = f.2
  proof
    assume i = 1;
    then Nb v = {2} by A1, A2, PathNb;
    hence thesis by SumSingle;
  end;
  thus 1 < i & i < N implies SumN(f,v) = f.(i -' 1) + f.(i + 1)
  proof
    assume B1: 1 < i & i < N;
    then B2: Nb v = {i -' 1, i + 1} by A1, A2, PathNb;
    i -' 1 = i - 1 by B1, XREAL_1:233;
    then i -' 1 < i & i < i + 1 by XREAL_1:146, NAT_1:13;
    hence thesis by B2, SumPair;
  end;
  assume i = N;
  then Nb v = {N -' 1} by A1, A2, PathNb;
  hence thesis by SumSingle;
end;

theorem PathDeg:
  for N being Nat st G is_path_of N & 2 <= N holds
  for i being Nat st v = i & 1 < i & i < N holds deg v = 2
proof
  let N be Nat;
  assume A1: G is_path_of N & 2 <= N;
  let i be Nat;
  assume A2: v = i & 1 < i & i < N;
  then A3: Nb v = {i -' 1, i + 1} by A1, PathNb;
  i -' 1 = i - 1 by A2, XREAL_1:233;
  then i -' 1 < i & i < i + 1 by XREAL_1:146, NAT_1:13;
  hence thesis by A3, CARD_2:57;
end;

:: eta(P_N) = 2 for N >= 4: label 2 the odd vertices and the last one

theorem PathEta:
  for N being Nat st G is_path_of N & 4 <= N holds eta G = 2
proof
  let N be Nat;
  assume A1: G is_path_of N & 4 <= N;
  then A0: 2 <= N by XXREAL_0:2;
  set C = the carrier of G;
  A2: C = Seg N by A1;
  defpred Cd[object] means ex j being Nat st j = $1 & (j is odd or j = N);
  deffunc F2(object) = 2;
  deffunc F1(object) = 1;
  A3: for x being object st x in C holds
    (Cd[x] implies F2(x) in NAT) & (not Cd[x] implies F1(x) in NAT);
  consider f being Function of C, NAT such that
  A4: for x being object st x in C holds
    (Cd[x] implies f.x = F2(x)) & (not Cd[x] implies f.x = F1(x))
    from FUNCT_2:sch 5(A3);
  A5: for j being Nat st 1 <= j & j <= N & (j is odd or j = N) holds
    f.j = 2
  proof
    let j be Nat;
    assume B1: 1 <= j & j <= N & (j is odd or j = N);
    j in C by A2, B1, FINSEQ_1:1;
    hence thesis by A4, B1;
  end;
  A6: for j being Nat st 1 <= j & j <= N & j is even & j <> N holds
    f.j = 1
  proof
    let j be Nat;
    assume B1: 1 <= j & j <= N & j is even & j <> N;
    B2: j in C by A2, B1, FINSEQ_1:1;
    not Cd[j] by B1;
    hence thesis by A4, B2;
  end;
  A7: f is 2-labeling
  proof
    let v;
    B1: v in C;
    per cases;
    suppose Cd[v];
      then f.v = 2 by A4, B1;
      hence thesis;
    end;
    suppose not Cd[v];
      then f.v = 1 by A4, B1;
      hence thesis;
    end;
  end;
  :: the sums at a and a + 1 differ
  A8: for a being Nat, x,y being Element of G st 1 <= a & a + 1 <= N &
    x = a & y = a + 1 holds SumN(f,x) <> SumN(f,y)
  proof
    let a be Nat, x,y be Element of G;
    assume B1: 1 <= a & a + 1 <= N & x = a & y = a + 1;
    B2: a < N by B1, NAT_1:13;
    B3: 1 < a + 1 by B1, NAT_1:13;
    per cases;
    suppose B4: a is odd;
      then B5: f.a = 2 by A5, B1, B2;
      per cases by B1, XXREAL_0:1;
      suppose B6: a + 1 = N;
        then SumN(f,y) = f.(N -' 1) by A0, A1, B1, PathSum;
        then B7: SumN(f,y) = 2 by B5, B6, NAT_D:34;
        a <> 1 by A1, B6;
        then B8: 1 < a by B1, XXREAL_0:1;
        then B9: SumN(f,x) = f.(a -' 1) + f.(a + 1) by A0, A1, B1, B2,
          PathSum;
        B10: a -' 1 = a - 1 by B1, XREAL_1:233;
        1 + 1 <= a by B8, NAT_1:13;
        then 1 <= a - 1 by XREAL_1:19;
        then B11: 1 <= a -' 1 by B10;
        a - 1 <= a by XREAL_1:146;
        then B12: a -' 1 <= N by B2, B10, XXREAL_0:2;
        a - 1 < a by XREAL_1:146;
        then a -' 1 <> N by B2, B10;
        then f.(a -' 1) = 1 by A6, B4, B10, B11, B12;
        then SumN(f,x) = 1 + 2 by A5, B3, B6, B9;
        hence thesis by B7;
      end;
      suppose B6: a + 1 < N;
        then SumN(f,y) = f.(a + 1 -' 1) + f.(a + 1 + 1) by A0, A1, B1, B3,
          PathSum;
        then B7: SumN(f,y) = f.a + f.(a + 2) by NAT_D:34;
        B6a: a + 1 + 1 <= N by B6, NAT_1:13;
        a + 1 is even by B4;
        then B6b: (a + 1) + 1 is odd;
        B6c: 1 <= a + 1 + 1 by NAT_1:11;
        then f.(a + 1 + 1) = 2 by A5, B6a, B6b;
        then B8: SumN(f,y) = 4 by B5, B7;
        :: f(a - 1) = 1 and f(a + 1) = 1, or a = 1 and the sum is f(2)
        a + 1 is even by B4;
        then B9a: f.(a + 1) = 1 by A6, B3, B6;
        then B9: f.(a + 1) <= 2;
        per cases by B1, XXREAL_0:1;
        suppose C1: a = 1;
          then SumN(f,x) = f.2 by A0, A1, B1, PathSum;
          hence thesis by B8, B9a, C1;
        end;
        suppose B10: 1 < a;
          then B11: SumN(f,x) = f.(a -' 1) + f.(a + 1) by A0, A1, B1, B2,
            PathSum;
          B12: a -' 1 = a - 1 by B1, XREAL_1:233;
          1 + 1 <= a by B10, NAT_1:13;
          then 1 <= a - 1 by XREAL_1:19;
          then B13: 1 <= a -' 1 by B12;
          a - 1 < a by XREAL_1:146;
          then B14: a -' 1 < N by B2, B12, XXREAL_0:2;
          a - 1 is even by B4;
          then f.(a -' 1) = 1 by A6, B12, B13, B14;
          then SumN(f,x) <= 1 + 2 by B9, B11, XREAL_1:6;
          hence thesis by B8;
        end;
      end;
    end;
    suppose B4: a is even;
      2 * 0 is even;
      then 0 + 1 is odd;
      then a <> 1 by B4;
      then B5: 1 < a by B1, XXREAL_0:1;
      then B6: SumN(f,x) = f.(a -' 1) + f.(a + 1) by A0, A1, B1, B2,
        PathSum;
      B7: a -' 1 = a - 1 by B1, XREAL_1:233;
      1 + 1 <= a by B5, NAT_1:13;
      then 1 <= a - 1 by XREAL_1:19;
      then B8: 1 <= a -' 1 by B7;
      a - 1 < a by XREAL_1:146;
      then B8a: a -' 1 <= N by B2, B7, XXREAL_0:2;
      a - 1 is odd by B4;
      then B9: f.(a -' 1) = 2 by A5, B7, B8, B8a;
      B9a: a + 1 is odd by B4;
      1 <= a + 1 by NAT_1:11;
      then f.(a + 1) = 2 by A5, B1, B9a;
      then B10: SumN(f,x) = 4 by B6, B9;
      B11: f.a = 1 by A6, B1, B2, B4;
      per cases by B1, XXREAL_0:1;
      suppose B12: a + 1 = N;
        then SumN(f,y) = f.(N -' 1) by A0, A1, B1, PathSum;
        then SumN(f,y) = 1 by B11, B12, NAT_D:34;
        hence thesis by B10;
      end;
      suppose B12: a + 1 < N;
        then SumN(f,y) = f.(a + 1 -' 1) + f.(a + 1 + 1) by A0, A1, B1, B3,
          PathSum;
        then B13: SumN(f,y) = 1 + f.(a + 2) by B11, NAT_D:34;
        C1: a + 1 + 1 <= N by B12, NAT_1:13;
        C2: 1 <= a + 1 + 1 by NAT_1:11;
        a + 1 is odd by B4;
        then C3: a + 1 + 1 is even;
        f.(a + 1 + 1) = 2 or f.(a + 1 + 1) = 1
        proof
          per cases;
          suppose a + 1 + 1 = N;
            hence thesis by A5, C1, C2;
          end;
          suppose a + 1 + 1 <> N;
            hence thesis by A6, C1, C2, C3;
          end;
        end;
        hence thesis by B10, B13;
      end;
    end;
  end;
  A9: f is additive
  proof
    let x,y be Element of G;
    assume x,y are_adjacent;
    then B1: [x,y] in the InternalRel of G;
    x in C & y in C;
    then reconsider i = x, j = y as Nat by A2;
    B2: i in Seg N & j in Seg N & (j = i + 1 or i = j + 1)
      by A1, B1, DefPath;
    then B3: 1 <= i & i <= N & 1 <= j & j <= N by FINSEQ_1:1;
    per cases by B2;
    suppose j = i + 1;
      hence thesis by A8, B3;
    end;
    suppose i = j + 1;
      hence thesis by A8, B3;
    end;
  end;
  :: the vertices 2 and 3 are adjacent and have degree 2
  3 <= 4 & 4 <= N by A1;
  then A11: 3 <= N by XXREAL_0:2;
  then A12: 2 in Seg N & 3 in Seg N by A0, FINSEQ_1:1;
  then reconsider x2 = 2, x3 = 3 as Element of G by A2;
  3 = 2 + 1;
  then [2,3] in the InternalRel of G by A1, A12, DefPath;
  then A10: x2,x3 are_adjacent;
  3 < 4 & 4 <= N by A1;
  then A13: 3 < N by XXREAL_0:2;
  then 2 < N by XXREAL_0:2;
  then A14: deg x2 = 2 by A0, A1, PathDeg;
  deg x3 = 2 by A0, A1, A13, PathDeg;
  hence thesis by A7, A9, A10, A14, EtaEq2;
end;

theorem PathMaxdeg:
  for N being Nat st G is_path_of N & 2 <= N holds maxdeg G <= 2
proof
  let N be Nat;
  assume A1: G is_path_of N & 2 <= N;
  consider v such that A2: maxdeg G = deg v by DefMaxdeg;
  v in the carrier of G;
  then A3: v in Seg N by A1;
  then reconsider i = v as Nat;
  A4: 1 <= i & i <= N by A3, FINSEQ_1:1;
  per cases by A4, XXREAL_0:1;
  suppose i = 1;
    then Nb v = {2} by A1, PathNb;
    then maxdeg G = 1 by A2, CARD_1:30;
    hence thesis;
  end;
  suppose B1: 1 < i & i < N;
    then Nb v = {i -' 1, i + 1} by A1, PathNb;
    hence thesis by A2, CARD_2:50;
  end;
  suppose i = N;
    then Nb v = {N -' 1} by A1, PathNb;
    then maxdeg G = 1 by A2, CARD_1:30;
    hence thesis;
  end;
end;

:: Joining one vertex to a graph without universal vertices keeps eta

theorem JoinK1:
  for w being object st H is_join_of G,{w} &
  maxdeg G + 2 <= card the carrier of G holds eta H = eta G
proof
  let w be object;
  assume A1: H is_join_of G,{w} & maxdeg G + 2 <= card the carrier of G;
  A2: card {w} = 1 by CARD_1:30;
  then card {w} + maxdeg G + 1 <= card the carrier of G by A1;
  then A3: eta H = max(eta G, 1) by A1, A2, Theorem2;
  1 <= eta G by EtaPos;
  hence thesis by A3, XXREAL_0:def 10;
end;

:: The fan F_n = P_(n+1) \/ K_1 (n >= 3) has eta = 2

theorem Fan:
  for N being Nat, w being object st 4 <= N & G is_path_of N &
  H is_join_of G,{w} holds eta H = 2
proof
  let N be Nat, w be object;
  assume A1: 4 <= N & G is_path_of N & H is_join_of G,{w};
  then A2: 2 <= N by XXREAL_0:2;
  then A3: maxdeg G + 2 <= 2 + 2 by A1, PathMaxdeg, XREAL_1:6;
  card the carrier of G = card Seg N by A1
  .= N by FINSEQ_1:57;
  then maxdeg G + 2 <= card the carrier of G by A1, A3, XXREAL_0:2;
  then eta H = eta G by A1, JoinK1;
  hence thesis by A1, PathEta;
end;

:: Section 3: windmills. m K_p, m disjoint copies of K_p: the vertex [i,j]
:: is the j-th vertex of the i-th copy.

definition
  let G; let m,p be Nat;
  pred G is_copies_of m,p means
  :DefCopies:
  the carrier of G = [:Seg m, Seg p:] &
  for i,j,i1,j1 being Nat holds
    [[i,j],[i1,j1]] in the InternalRel of G iff
    i in Seg m & j in Seg p & j1 in Seg p & i1 = i & j1 <> j;
end;

theorem CopiesExists:
  for m,p being Nat st 1 <= m & 1 <= p holds
  ex G being strict Graph st G is_copies_of m,p
proof
  let m,p be Nat;
  assume 1 <= m & 1 <= p;
  then 1 in Seg m & 1 in Seg p by FINSEQ_1:1;
  then [1,1] in [:Seg m, Seg p:] by ZFMISC_1:87;
  then reconsider V = [:Seg m, Seg p:] as non empty finite set;
  defpred P[object,object] means ex i,j,j1 being Nat st
    $1 = [i,j] & $2 = [i,j1] & j <> j1;
  A1: for x,y being object st P[x,y] holds P[y,x];
  A2: for x being object holds not P[x,x]
  proof
    let x be object;
    given i,j,j1 being Nat such that B1: x = [i,j] & x = [i,j1] & j <> j1;
    thus contradiction by B1, XTUPLE_0:1;
  end;
  consider G being strict Graph such that
  A3: the carrier of G = V & for x,y being object holds
    [x,y] in the InternalRel of G iff x in V & y in V & P[x,y]
    from GraphEx(A1, A2);
  take G;
  thus the carrier of G = [:Seg m, Seg p:] by A3;
  let i,j,i1,j1 be Nat;
  thus [[i,j],[i1,j1]] in the InternalRel of G implies
    i in Seg m & j in Seg p & j1 in Seg p & i1 = i & j1 <> j
  proof
    assume [[i,j],[i1,j1]] in the InternalRel of G;
    then B1: [i,j] in V & [i1,j1] in V & P[[i,j],[i1,j1]] by A3;
    then consider a,b,b1 being Nat such that
    B2: [i,j] = [a,b] & [i1,j1] = [a,b1] & b <> b1;
    B3: i = a & j = b & i1 = a & j1 = b1 by B2, XTUPLE_0:1;
    i in Seg m & j in Seg p & j1 in Seg p by B1, ZFMISC_1:87;
    hence thesis by B2, B3;
  end;
  assume B1: i in Seg m & j in Seg p & j1 in Seg p & i1 = i & j1 <> j;
  then B2: [i,j] in V & [i1,j1] in V by ZFMISC_1:87;
  P[[i,j],[i1,j1]] by B1;
  hence thesis by A3, B2;
end;

theorem CopiesElem:
  for m,p being Nat st G is_copies_of m,p holds
  ex i,j being Nat st v = [i,j] & i in Seg m & j in Seg p
proof
  let m,p be Nat;
  assume G is_copies_of m,p;
  then the carrier of G = [:Seg m, Seg p:] by DefCopies;
  then consider x,y being object such that
  A1: x in Seg m & y in Seg p & v = [x,y] by ZFMISC_1:84;
  reconsider i = x, j = y as Nat by A1;
  take i, j;
  thus thesis by A1;
end;

theorem CopiesClosed:
  for m,p being Nat st G is_copies_of m,p holds
  for i,j being Nat st v = [i,j] holds Nb v \/ {v} = [:{i}, Seg p:]
proof
  let m,p be Nat;
  assume A1: G is_copies_of m,p;
  let i,j be Nat;
  assume A2: v = [i,j];
  A3: the carrier of G = [:Seg m, Seg p:] by A1, DefCopies;
  then A4: i in Seg m & j in Seg p by A2, ZFMISC_1:87;
  for z being object holds z in Nb v \/ {v} iff z in [:{i}, Seg p:]
  proof
    let z be object;
    thus z in Nb v \/ {v} implies z in [:{i}, Seg p:]
    proof
      assume z in Nb v \/ {v};
      then B1: z in Nb v or z in {v} by XBOOLE_0:def 3;
      per cases by B1;
      suppose B2: z in Nb v;
        then reconsider w = z as Element of G;
        consider i1,j1 being Nat such that
        B3: w = [i1,j1] & i1 in Seg m & j1 in Seg p by A1, CopiesElem;
        v,w are_adjacent by B2, NbIff;
        then [[i,j],[i1,j1]] in the InternalRel of G by A2, B3;
        then i1 = i by A1, DefCopies;
        then i1 in {i} by TARSKI:def 1;
        hence thesis by B3, ZFMISC_1:87;
      end;
      suppose z in {v};
        then B2: z = [i,j] by A2, TARSKI:def 1;
        i in {i} by TARSKI:def 1;
        hence thesis by A4, B2, ZFMISC_1:87;
      end;
    end;
    assume z in [:{i}, Seg p:];
    then consider x,y being object such that
    B1: x in {i} & y in Seg p & z = [x,y] by ZFMISC_1:84;
    reconsider j1 = y as Nat by B1;
    B2: x = i by B1, TARSKI:def 1;
    per cases;
    suppose j1 = j;
      then z in {v} by A2, B1, B2, TARSKI:def 1;
      hence thesis by XBOOLE_0:def 3;
    end;
    suppose B3: j1 <> j;
      z in the carrier of G by A3, A4, B1, B2, ZFMISC_1:87;
      then reconsider w = z as Element of G;
      [[i,j],[i,j1]] in the InternalRel of G by A1, A4, B1, B3, DefCopies;
      then v,w are_adjacent by A2, B1, B2;
      then z in Nb v by NbIff;
      hence thesis by XBOOLE_0:def 3;
    end;
  end;
  hence thesis by TARSKI:2;
end;

theorem CopiesDeg:
  for m,p being Nat st G is_copies_of m,p holds deg v + 1 = p
proof
  let m,p be Nat;
  assume A1: G is_copies_of m,p;
  then consider i,j being Nat such that
  A2: v = [i,j] & i in Seg m & j in Seg p by CopiesElem;
  A3: Nb v \/ {v} = [:{i}, Seg p:] by A1, A2, CopiesClosed;
  card [:{i}, Seg p:] = card {i} * card Seg p by CARD_2:46
  .= 1 * card Seg p by CARD_1:30
  .= p by FINSEQ_1:57;
  hence thesis by A3, NbNotSelf, CARD_2:41;
end;

:: eta(m K_p) = p

theorem CopiesEta:
  for m,p being Nat st G is_copies_of m,p holds eta G = p
proof
  let m,p be Nat;
  assume A1: G is_copies_of m,p;
  set C = the carrier of G;
  A2: C = [:Seg m, Seg p:] by A1, DefCopies;
  defpred Q[object,object] means ex i,j being Nat st $1 = [i,j] & $2 = j;
  A3: for x being object st x in C ex y being object st y in NAT & Q[x,y]
  proof
    let x be object;
    assume x in C;
    then reconsider v = x as Element of G;
    consider i,j being Nat such that B1: v = [i,j] & i in Seg m & j in Seg p
      by A1, CopiesElem;
    take j;
    thus thesis by B1, ORDINAL1:def 12;
  end;
  consider f being Function of C, NAT such that
  A4: for x being object st x in C holds Q[x,f.x] from FUNCT_2:sch 1(A3);
  A5: for i,j being Nat st [i,j] in C holds f.[i,j] = j
  proof
    let i,j be Nat;
    assume [i,j] in C;
    then consider i1,j1 being Nat such that
    B1: [i,j] = [i1,j1] & f.[i,j] = j1 by A4;
    thus thesis by B1, XTUPLE_0:1;
  end;
  A6: f is p-labeling
  proof
    let v;
    consider i,j being Nat such that B1: v = [i,j] & i in Seg m & j in Seg p
      by A1, CopiesElem;
    f.v = j by A5, B1;
    hence thesis by B1, FINSEQ_1:1;
  end;
  f is additive
  proof
    let u,w;
    assume B0: u,w are_adjacent;
    consider i,j being Nat such that B1: u = [i,j] & i in Seg m & j in Seg p
      by A1, CopiesElem;
    consider i1,j1 being Nat such that
    B2: w = [i1,j1] & i1 in Seg m & j1 in Seg p by A1, CopiesElem;
    [[i,j],[i1,j1]] in the InternalRel of G by B0, B1, B2;
    then B3: i1 = i & j1 <> j by A1, DefCopies;
    B4: Nb u \/ {u} = [:{i}, Seg p:] & Nb w \/ {w} = [:{i}, Seg p:]
      by A1, B1, B2, B3, CopiesClosed;
    {i} c= Seg m by B1, ZFMISC_1:31;
    then reconsider J = [:{i}, Seg p:] as finite Subset of C
      by A2, ZFMISC_1:95;
    Sum(f|J) = SumN(f,u) + f.u & Sum(f|J) = SumN(f,w) + f.w by B4, SumClosed;
    then B5a: SumN(f,u) + f.u = SumN(f,w) + f.w;
    B6: f.u = j by A5, B1;
    f.w = j1 by A5, B2;
    then B5: SumN(f,u) + j = SumN(f,w) + j1 by B5a, B6;
    assume SumN(f,u) = SumN(f,w);
    hence contradiction by B3, B5;
  end;
  then A7: eta G <= p by A6, EtaLe;
  :: the first copy is a set of true twins
  set v0 = the Element of G;
  consider i0,j0 being Nat such that A8: v0 = [i0,j0] & i0 in Seg m &
    j0 in Seg p by A1, CopiesElem;
  {i0} c= Seg m by A8, ZFMISC_1:31;
  then reconsider T = [:{i0}, Seg p:] as Subset of G by A2, ZFMISC_1:95;
  for u,w st u in T & w in T holds u,w are_true_twins
  proof
    let u,w;
    assume B1: u in T & w in T;
    then consider x,y being object such that
    B2: x in {i0} & y in Seg p & u = [x,y] by ZFMISC_1:84;
    consider x1,y1 being object such that
    B3: x1 in {i0} & y1 in Seg p & w = [x1,y1] by B1, ZFMISC_1:84;
    reconsider y, y1 as Nat by B2, B3;
    x = i0 & x1 = i0 by B2, B3, TARSKI:def 1;
    then Nb u \/ {u} = T & Nb w \/ {w} = T by A1, B2, B3, CopiesClosed;
    hence thesis;
  end;
  then A9: card T <= eta G by Observation2;
  card T = card {i0} * card Seg p by CARD_2:46
  .= 1 * card Seg p by CARD_1:30
  .= p by FINSEQ_1:57;
  hence thesis by A7, A9, XXREAL_0:1;
end;

:: The windmill W_n^m = m K_(n-1) \/ K_1 (n >= 3, m >= 2) has
:: eta = n - 1; here p = n - 1.

theorem Windmill:
  for m,p being Nat, w being object st 2 <= m & 2 <= p &
  G is_copies_of m,p & H is_join_of G,{w} holds eta H = p
proof
  let m,p be Nat, w be object;
  assume A1: 2 <= m & 2 <= p & G is_copies_of m,p & H is_join_of G,{w};
  consider v such that A2: maxdeg G = deg v by DefMaxdeg;
  A3: maxdeg G + 1 = p by A1, A2, CopiesDeg;
  card the carrier of G = card [:Seg m, Seg p:] by A1, DefCopies
  .= card Seg m * card Seg p by CARD_2:46
  .= m * card Seg p by FINSEQ_1:57
  .= m * p by FINSEQ_1:57;
  then A4: 2 * p <= card the carrier of G by A1, XREAL_1:64;
  1 <= p by A1, XXREAL_0:2;
  then maxdeg G + 1 + 1 <= p + p by A3, XREAL_1:6;
  then maxdeg G + 2 <= card the carrier of G by A4, XXREAL_0:2;
  then eta H = eta G by A1, JoinK1;
  hence thesis by A1, CopiesEta;
end;

:: Section 3: cycles and wheels. C_N has vertices 1..N; csucc and cpred
:: are the successor and the predecessor modulo N.

definition
  let N,i be Nat;
  func csucc(N,i) -> Nat equals
  :DefCsucc:
  i + 1 if i < N otherwise 1;
  coherence;
  consistency;
  func cpred(N,i) -> Nat equals
  :DefCpred:
  i -' 1 if 1 < i otherwise N;
  coherence;
  consistency;
end;

theorem CsuccIn:
  for N,i being Nat st i in Seg N holds csucc(N,i) in Seg N
proof
  let N,i be Nat;
  assume A1: i in Seg N;
  then A2: 1 <= i & i <= N by FINSEQ_1:1;
  per cases;
  suppose B1: i < N;
    then csucc(N,i) = i + 1 by DefCsucc;
    then 1 <= csucc(N,i) & csucc(N,i) <= N by B1, NAT_1:11, NAT_1:13;
    hence thesis by FINSEQ_1:1;
  end;
  suppose not i < N;
    then B1: csucc(N,i) = 1 by DefCsucc;
    1 <= N by A2, XXREAL_0:2;
    hence thesis by B1, FINSEQ_1:1;
  end;
end;

theorem CpredIn:
  for N,i being Nat st i in Seg N holds cpred(N,i) in Seg N
proof
  let N,i be Nat;
  assume A1: i in Seg N;
  then A2: 1 <= i & i <= N by FINSEQ_1:1;
  per cases;
  suppose B1: 1 < i;
    then B2: cpred(N,i) = i -' 1 by DefCpred;
    B3: i -' 1 = i - 1 by A2, XREAL_1:233;
    1 + 1 <= i by B1, NAT_1:13;
    then B4: 1 <= i - 1 by XREAL_1:19;
    i - 1 <= i by XREAL_1:146;
    then i - 1 <= N by A2, XXREAL_0:2;
    hence thesis by B2, B3, B4, FINSEQ_1:1;
  end;
  suppose not 1 < i;
    then B1: cpred(N,i) = N by DefCpred;
    1 <= N by A2, XXREAL_0:2;
    hence thesis by B1, FINSEQ_1:1;
  end;
end;

theorem CpredCsucc:
  for N,i being Nat st i in Seg N holds cpred(N,csucc(N,i)) = i &
  csucc(N,cpred(N,i)) = i
proof
  let N,i be Nat;
  assume A1: i in Seg N;
  then A2: 1 <= i & i <= N by FINSEQ_1:1;
  thus cpred(N,csucc(N,i)) = i
  proof
    per cases;
    suppose B1: i < N;
      then B2: csucc(N,i) = i + 1 by DefCsucc;
      1 < i + 1 by A2, NAT_1:13;
      then cpred(N,csucc(N,i)) = i + 1 -' 1 by B2, DefCpred;
      hence thesis by NAT_D:34;
    end;
    suppose not i < N;
      then B1: i = N & csucc(N,i) = 1 by A2, DefCsucc, XXREAL_0:1;
      hence thesis by DefCpred;
    end;
  end;
  per cases;
  suppose B1: 1 < i;
    then B2: cpred(N,i) = i -' 1 by DefCpred;
    B3: i -' 1 = i - 1 by A2, XREAL_1:233;
    i - 1 < N by A2, XREAL_1:146, XXREAL_0:2;
    then csucc(N,cpred(N,i)) = i -' 1 + 1 by B2, B3, DefCsucc;
    hence thesis by B3;
  end;
  suppose not 1 < i;
    then B1: i = 1 & cpred(N,i) = N by A2, DefCpred, XXREAL_0:1;
    hence thesis by DefCsucc;
  end;
end;

definition
  let G; let N be Nat;
  pred G is_cycle_of N means
  :DefCycle:
  the carrier of G = Seg N &
  for i,j being Nat holds [i,j] in the InternalRel of G iff
    i in Seg N & j in Seg N & (j = csucc(N,i) or i = csucc(N,j));
end;

theorem CycleExists:
  for N being Nat st 3 <= N holds ex G being strict Graph st G is_cycle_of N
proof
  let N be Nat;
  assume A0: 3 <= N;
  then 1 <= N by XXREAL_0:2;
  then reconsider V = Seg N as non empty finite set by FINSEQ_1:1;
  defpred P[object,object] means ex i,j being Nat st i = $1 & j = $2 &
    i in Seg N & j in Seg N & (j = csucc(N,i) or i = csucc(N,j));
  A1: for x,y being object st P[x,y] holds P[y,x];
  A2: for x being object holds not P[x,x]
  proof
    let x be object;
    given i,j being Nat such that
    B1: i = x & j = x & i in Seg N & j in Seg N &
      (j = csucc(N,i) or i = csucc(N,j));
    B2: 1 <= i & i <= N by B1, FINSEQ_1:1;
    per cases;
    suppose C1: i < N;
      then C2: csucc(N,i) = i + 1 by DefCsucc;
      j < N by B1, C1;
      then csucc(N,j) = j + 1 by DefCsucc;
      hence contradiction by B1, C2;
    end;
    suppose not i < N;
      then csucc(N,i) = 1 & i = N by B2, DefCsucc, XXREAL_0:1;
      hence contradiction by A0, B1;
    end;
  end;
  consider G being strict Graph such that
  A3: the carrier of G = V & for x,y being object holds
    [x,y] in the InternalRel of G iff x in V & y in V & P[x,y]
    from GraphEx(A1, A2);
  take G;
  thus the carrier of G = Seg N by A3;
  let i,j be Nat;
  thus [i,j] in the InternalRel of G implies
    i in Seg N & j in Seg N & (j = csucc(N,i) or i = csucc(N,j))
  proof
    assume [i,j] in the InternalRel of G;
    then P[i,j] by A3;
    hence thesis;
  end;
  assume i in Seg N & j in Seg N & (j = csucc(N,i) or i = csucc(N,j));
  hence thesis by A3;
end;

theorem CycleNb:
  for N being Nat st G is_cycle_of N holds
  for i being Nat st v = i holds Nb v = {csucc(N,i), cpred(N,i)}
proof
  let N be Nat;
  assume A1: G is_cycle_of N;
  let i be Nat;
  assume A2: v = i;
  A3: the carrier of G = Seg N by A1;
  then A4: i in Seg N by A2;
  for z being object holds z in Nb v iff z = csucc(N,i) or z = cpred(N,i)
  proof
    let z be object;
    thus z in Nb v implies z = csucc(N,i) or z = cpred(N,i)
    proof
      assume B1: z in Nb v;
      then z in Seg N by A3;
      then reconsider j = z as Nat;
      reconsider w = z as Element of G by B1;
      v,w are_adjacent by B1, NbIff;
      then [i,j] in the InternalRel of G by A2;
      then B2: j in Seg N & (j = csucc(N,i) or i = csucc(N,j))
        by A1, DefCycle;
      per cases by B2;
      suppose j = csucc(N,i);
        hence thesis;
      end;
      suppose i = csucc(N,j);
        hence thesis by B2, CpredCsucc;
      end;
    end;
    assume B1: z = csucc(N,i) or z = cpred(N,i);
    per cases by B1;
    suppose B2: z = csucc(N,i);
      then B3: z in Seg N by A4, CsuccIn;
      then reconsider w = z as Element of G by A3;
      [i,csucc(N,i)] in the InternalRel of G by A1, A4, B2, B3, DefCycle;
      then v,w are_adjacent by A2, B2;
      hence thesis by NbIff;
    end;
    suppose B2: z = cpred(N,i);
      then B3: z in Seg N by A4, CpredIn;
      then reconsider w = z as Element of G by A3;
      i = csucc(N,cpred(N,i)) by A4, CpredCsucc;
      then [i,cpred(N,i)] in the InternalRel of G by A1, A4, B2, B3,
        DefCycle;
      then v,w are_adjacent by A2, B2;
      hence thesis by NbIff;
    end;
  end;
  hence thesis by TARSKI:def 2;
end;

theorem CsuccNeCpred:
  for N,i being Nat st 3 <= N & i in Seg N holds csucc(N,i) <> cpred(N,i)
proof
  let N,i be Nat;
  assume A1: 3 <= N & i in Seg N;
  then A2: 1 <= i & i <= N by FINSEQ_1:1;
  per cases;
  suppose B1: 1 < i & i < N;
    then B2: csucc(N,i) = i + 1 & cpred(N,i) = i -' 1 by DefCsucc, DefCpred;
    i -' 1 = i - 1 by A2, XREAL_1:233;
    then i -' 1 < i & i < i + 1 by XREAL_1:146, NAT_1:13;
    hence thesis by B2;
  end;
  suppose B1: not 1 < i;
    then B2: i = 1 by A2, XXREAL_0:1;
    1 < N by A1, XXREAL_0:2;
    then csucc(N,i) = 1 + 1 & cpred(N,i) = N by B1, B2, DefCsucc, DefCpred;
    hence thesis by A1;
  end;
  suppose B1: not i < N & 1 < i;
    then B2: i = N by A2, XXREAL_0:1;
    then B3: csucc(N,i) = 1 & cpred(N,i) = N -' 1 by B1, DefCsucc, DefCpred;
    N -' 1 = N - 1 by A1, XREAL_1:233, XXREAL_0:2;
    then N -' 1 >= 3 - 1 by A1, XREAL_1:9;
    hence thesis by B3;
  end;
end;

theorem CycleSum:
  for N being Nat st 3 <= N & G is_cycle_of N holds
  for i being Nat st v = i holds
  SumN(f,v) = f.(csucc(N,i)) + f.(cpred(N,i)) & deg v = 2
proof
  let N be Nat;
  assume A1: 3 <= N & G is_cycle_of N;
  let i be Nat;
  assume A2: v = i;
  A3: Nb v = {csucc(N,i), cpred(N,i)} by A1, A2, CycleNb;
  i in the carrier of G by A2;
  then i in Seg N by A1, DefCycle;
  then A4: csucc(N,i) <> cpred(N,i) by A1, CsuccNeCpred;
  hence SumN(f,v) = f.(csucc(N,i)) + f.(cpred(N,i)) by A3, SumPair;
  thus thesis by A3, A4, CARD_2:57;
end;

theorem CsuccParity:
  for N,i being Nat st N is even & i in Seg N holds
  (csucc(N,i) is odd iff i is even)
proof
  let N,i be Nat;
  assume A1: N is even & i in Seg N;
  then A2: 1 <= i & i <= N by FINSEQ_1:1;
  per cases;
  suppose i < N;
    then csucc(N,i) = i + 1 by DefCsucc;
    hence thesis;
  end;
  suppose not i < N;
    then B1: i = N & csucc(N,i) = 1 by A2, DefCsucc, XXREAL_0:1;
    2 * 0 is even;
    then 0 + 1 is odd;
    hence thesis by A1, B1;
  end;
end;

:: Even cycles are regular bipartite, so eta(C_N) = 2 by Corollary 1

theorem CycleEven:
  for N being Nat st 3 <= N & N is even & G is_cycle_of N holds eta G = 2
proof
  let N be Nat;
  assume A1: 3 <= N & N is even & G is_cycle_of N;
  set C = the carrier of G;
  A2: C = Seg N by A1, DefCycle;
  set U = {x where x is Element of G: ex i being Nat st x = i & i is odd};
  set W = {x where x is Element of G: ex i being Nat st x = i & i is even};
  U c= C
  proof
    let z be object;
    assume z in U;
    then ex x being Element of G st z = x &
      ex i being Nat st x = i & i is odd;
    hence thesis;
  end;
  then reconsider U as Subset of G;
  W c= C
  proof
    let z be object;
    assume z in W;
    then ex x being Element of G st z = x &
      ex i being Nat st x = i & i is even;
    hence thesis;
  end;
  then reconsider W as Subset of G;
  A3: for v being Element of G, i being Nat st v = i holds
    (v in U iff i is odd) & (v in W iff i is even)
  proof
    let v be Element of G, i be Nat;
    assume B1: v = i;
    thus v in U iff i is odd
    proof
      thus v in U implies i is odd
      proof
        assume v in U;
        then ex x being Element of G st v = x &
          ex i1 being Nat st x = i1 & i1 is odd;
        hence thesis by B1;
      end;
      thus thesis by B1;
    end;
    thus v in W implies i is even
    proof
      assume v in W;
      then ex x being Element of G st v = x &
        ex i1 being Nat st x = i1 & i1 is even;
      hence thesis by B1;
    end;
    thus thesis by B1;
  end;
  A4: for v being Element of G ex i being Nat st v = i & i in Seg N
  proof
    let v be Element of G;
    v in Seg N by A2;
    then reconsider i = v as Nat;
    take i;
    thus thesis by A2;
  end;
  A5: U misses W
  proof
    assume U meets W;
    then consider z being object such that B1: z in U & z in W
      by XBOOLE_0:3;
    reconsider v = z as Element of G by B1;
    consider i being Nat such that B2: v = i & i in Seg N by A4;
    i is odd & i is even by A3, B1, B2;
    hence contradiction;
  end;
  A6: U \/ W = C
  proof
    for z being object holds z in U \/ W iff z in C
    proof
      let z be object;
      thus z in U \/ W implies z in C;
      assume z in C;
      then reconsider v = z as Element of G;
      consider i being Nat such that B1: v = i & i in Seg N by A4;
      i is odd or i is even;
      then v in U or v in W by A3, B1;
      hence thesis by XBOOLE_0:def 3;
    end;
    hence thesis by TARSKI:2;
  end;
  A7: for u,v st u,v are_adjacent holds (u in U iff v in W)
  proof
    let u,v;
    assume u,v are_adjacent;
    then B1: [u,v] in the InternalRel of G;
    consider i being Nat such that B2: u = i & i in Seg N by A4;
    consider j being Nat such that B3: v = j & j in Seg N by A4;
    B4: j = csucc(N,i) or i = csucc(N,j) by A1, B1, B2, B3, DefCycle;
    i is odd iff j is even
    proof
      per cases by B4;
      suppose j = csucc(N,i);
        hence thesis by A1, B2, CsuccParity;
      end;
      suppose i = csucc(N,j);
        hence thesis by A1, B3, CsuccParity;
      end;
    end;
    hence thesis by A3, B2, B3;
  end;
  A8: for u,v holds deg u = deg v
  proof
    let u,v;
    consider i being Nat such that B1: u = i & i in Seg N by A4;
    consider j being Nat such that B2: v = j & j in Seg N by A4;
    deg u = 2 & deg v = 2 by A1, B1, B2, CycleSum;
    hence thesis;
  end;
  ex u,v st u,v are_adjacent
  proof
    1 <= N by A1, XXREAL_0:2;
    then B1: 1 in Seg N by FINSEQ_1:1;
    then reconsider u = 1 as Element of G by A2;
    B2: csucc(N,1) in Seg N by B1, CsuccIn;
    then reconsider v = csucc(N,1) as Element of G by A2;
    take u, v;
    [1,csucc(N,1)] in the InternalRel of G by A1, B1, B2, DefCycle;
    hence thesis;
  end;
  hence thesis by A5, A6, A7, A8, Corollary1;
end;

:: Proposition 1, lower bound: an odd cycle has no additive 2-coloring.
:: If the edges i -> i+1 alternate in direction around the cycle, the
:: number of edges would be even; so two consecutive edges point the same
:: way, and the three sums at their ends, in {2,3,4}, are 2 and 4, which
:: is impossible.

theorem OddCycleLower:
  for N being Nat st 3 <= N & N is odd & G is_cycle_of N holds 3 <= eta G
proof
  let N be Nat;
  assume A1: 3 <= N & N is odd & G is_cycle_of N;
  set C = the carrier of G;
  A2: C = Seg N by A1, DefCycle;
  assume A3: eta G < 3;
  consider f such that A4: f is (eta G)-labeling additive by EtaAtt;
  eta G < 2 + 1 by A3;
  then eta G <= 2 by NAT_1:13;
  then A5: f is 2-labeling by A4, LabelingMono;
  deffunc S(Nat) = SumN(f, In($1,C));
  A6: for i being Nat st i in Seg N holds
    S(i) = f.(csucc(N,i)) + f.(cpred(N,i)) &
    1 <= f.(csucc(N,i)) & f.(csucc(N,i)) <= 2 &
    1 <= f.(cpred(N,i)) & f.(cpred(N,i)) <= 2
  proof
    let i be Nat;
    assume B1: i in Seg N;
    then B2: In(i,C) = i by A2, SUBSET_1:def 8;
    hence S(i) = f.(csucc(N,i)) + f.(cpred(N,i)) by A1, CycleSum;
    csucc(N,i) in C & cpred(N,i) in C by A2, B1, CsuccIn, CpredIn;
    then reconsider a = csucc(N,i), b = cpred(N,i) as Element of G;
    1 <= f.a & f.a <= 2 & 1 <= f.b & f.b <= 2 by A5;
    hence thesis;
  end;
  A7: for i being Nat st i in Seg N holds S(i) <> S(csucc(N,i))
  proof
    let i be Nat;
    assume B1: i in Seg N;
    then B2: csucc(N,i) in Seg N by CsuccIn;
    then reconsider u = i, w = csucc(N,i) as Element of G by A2, B1;
    [i,csucc(N,i)] in the InternalRel of G by A1, B1, B2, DefCycle;
    then u,w are_adjacent;
    then B3: SumN(f,u) <> SumN(f,w) by A4;
    In(i,C) = u & In(csucc(N,i),C) = w by A2, B1, B2, SUBSET_1:def 8;
    hence thesis by B3;
  end;
  defpred B[Nat] means S($1) < S(csucc(N,$1));
  :: two consecutive edges point the same way
  A8: ex k being Nat st k in Seg N & (B[k] iff B[csucc(N,k)])
  proof
    assume B0: not thesis;
    defpred P[Nat] means 1 <= $1 & $1 <= N implies
      (B[$1] iff (B[1] iff $1 is odd));
    B1: P[0];
    B2: for i being Nat st P[i] holds P[i+1]
    proof
      let i be Nat;
      assume C0: P[i];
      assume C1: 1 <= i + 1 & i + 1 <= N;
      per cases;
      suppose i = 0;
        then i + 1 = 2 * 0 + 1;
        hence thesis;
      end;
      suppose i <> 0;
        then C2: 1 <= i by NAT_1:14;
        C3: i < N by C1, NAT_1:13;
        then i in Seg N by C2, FINSEQ_1:1;
        then C4: not (B[i] iff B[csucc(N,i)]) by B0;
        csucc(N,i) = i + 1 by C3, DefCsucc;
        then (B[i+1] iff not B[i]) & (i + 1 is odd iff i is even) by C4;
        hence thesis by C0, C2, C3;
      end;
    end;
    B3: for i being Nat holds P[i] from NAT_1:sch 2(B1, B2);
    B5: 1 <= N by A1, XXREAL_0:2;
    then B4: B[N] iff B[1] by A1, B3;
    N in Seg N by B5, FINSEQ_1:1;
    then B6: not (B[N] iff B[csucc(N,N)]) by B0;
    csucc(N,N) = 1 by DefCsucc;
    hence contradiction by B4, B6;
  end;
  consider k being Nat such that A9: k in Seg N & (B[k] iff B[csucc(N,k)])
    by A8;
  set m = csucc(N,k), c = csucc(N,m);
  A10a: m in Seg N by A9, CsuccIn;
  then A10: m in Seg N & c in Seg N by CsuccIn;
  A11: cpred(N,c) = m by A10, CpredCsucc;
  A12: S(k) = f.m + f.(cpred(N,k)) & 1 <= f.m & f.m <= 2 &
    1 <= f.(cpred(N,k)) & f.(cpred(N,k)) <= 2 by A6, A9;
  A13: S(c) = f.(csucc(N,c)) + f.m & 1 <= f.(csucc(N,c)) &
    f.(csucc(N,c)) <= 2 by A6, A10, A11;
  A14: S(k) <> S(m) & S(m) <> S(c) by A7, A9, A10;
  :: the sums lie in {2,3,4}
  A15: 2 <= S(k) & S(c) <= 4
  proof
    1 + 1 <= S(k) by A12, XREAL_1:7;
    hence 2 <= S(k);
    S(c) <= 2 + 2 by A12, A13, XREAL_1:7;
    hence thesis;
  end;
  A16: S(k) <= 4 & 2 <= S(c)
  proof
    S(k) <= 2 + 2 by A12, XREAL_1:7;
    hence S(k) <= 4;
    1 + 1 <= S(c) by A12, A13, XREAL_1:7;
    hence thesis;
  end;
  per cases by A9;
  suppose B[k] & B[m];
    then S(k) + 1 <= S(m) & S(m) + 1 <= S(c) by NAT_1:13;
    then S(k) + 1 + 1 <= S(m) + 1 & S(m) + 1 <= S(c) by XREAL_1:6;
    then B2: S(k) + 2 <= S(c) by XXREAL_0:2;
    then S(k) + 2 <= 2 + 2 by A15, XXREAL_0:2;
    then S(k) <= 2 by XREAL_1:6;
    then B4: S(k) = 2 by A15, XXREAL_0:1;
    then B3: 2 + 2 <= S(c) by B2;
    f.m < 1 + 1
    proof
      assume 1 + 1 <= f.m;
      then 2 + 1 <= f.m + f.(cpred(N,k)) by A12, XREAL_1:7;
      hence contradiction by A12, B4;
    end;
    then f.m <= 1 by NAT_1:13;
    then f.(csucc(N,c)) + f.m <= 2 + 1 by A13, XREAL_1:7;
    hence contradiction by A13, B3, XXREAL_0:2;
  end;
  suppose B1: not B[k] & not B[m];
    then S(m) <= S(k) & S(c) <= S(m);
    then S(m) < S(k) & S(c) < S(m) by A14, XXREAL_0:1;
    then S(m) + 1 <= S(k) & S(c) + 1 <= S(m) by NAT_1:13;
    then S(c) + 1 + 1 <= S(m) + 1 & S(m) + 1 <= S(k) by XREAL_1:6;
    then B2: S(c) + 2 <= S(k) by XXREAL_0:2;
    then S(c) + 2 <= 2 + 2 by A16, XXREAL_0:2;
    then S(c) <= 2 by XREAL_1:6;
    then B4: S(c) = 2 by A16, XXREAL_0:1;
    then B3: 2 + 2 <= S(k) by B2;
    f.m < 1 + 1
    proof
      assume 1 + 1 <= f.m;
      then 1 + 2 <= f.(csucc(N,c)) + f.m by A13, XREAL_1:7;
      hence contradiction by A13, B4;
    end;
    then f.m <= 1 by NAT_1:13;
    then f.m + f.(cpred(N,k)) <= 1 + 2 by A12, XREAL_1:7;
    hence contradiction by A12, B3, XXREAL_0:2;
  end;
end;

:: Proposition 1: eta(C_N) = 3 for odd N >= 5. The labeling: 2 on v_1,
:: 1 on the even vertices and on v_5, 3 on the other odd vertices. Then
:: f(N(v_i)) is 5 for i = 2, 3 for i = N, at most 4 for i = 1, and for
:: 3 <= i < N it is 2 if i is odd and at least 4 if i is even.

theorem Proposition1:
  for N being Nat st 5 <= N & N is odd & G is_cycle_of N holds eta G = 3
proof
  let N be Nat;
  assume A1: 5 <= N & N is odd & G is_cycle_of N;
  then A0: 3 <= N by XXREAL_0:2;
  set C = the carrier of G;
  A2: C = Seg N by A1, DefCycle;
  defpred Q[object,object] means ex i being Nat st $1 = i &
    ((i = 1 & $2 = 2) or (i is odd & i <> 1 & i <> 5 & $2 = 3) or
     ((i is even or i = 5) & $2 = 1));
  A3: for x being object st x in C ex y being object st y in NAT & Q[x,y]
  proof
    let x be object;
    assume x in C;
    then reconsider i = x as Nat by A2;
    per cases;
    suppose B1: i = 1;
      take 2;
      thus thesis by B1;
    end;
    suppose B1: i is odd & i <> 1 & i <> 5;
      take 3;
      thus thesis by B1;
    end;
    suppose B1: not (i = 1) & not (i is odd & i <> 1 & i <> 5);
      take 1;
      thus thesis by B1;
    end;
  end;
  consider f being Function of C, NAT such that
  A4: for x being object st x in C holds Q[x,f.x] from FUNCT_2:sch 1(A3);
  A5: for i being Nat st i in Seg N holds
    (i = 1 implies f.i = 2) &
    (i is odd & i <> 1 & i <> 5 implies f.i = 3) &
    (i is even or i = 5 implies f.i = 1)
  proof
    let i be Nat;
    assume i in Seg N;
    then consider i1 being Nat such that
    B1: i = i1 & ((i1 = 1 & f.i = 2) or (i1 is odd & i1 <> 1 & i1 <> 5 &
      f.i = 3) or ((i1 is even or i1 = 5) & f.i = 1)) by A2, A4;
    2 * 0 is even;
    then 0 + 1 is odd;
    then B2: 1 is odd;
    2 * 2 is even;
    then 4 + 1 is odd;
    hence thesis by B1, B2;
  end;
  A6: f is 3-labeling
  proof
    let v;
    v in Seg N by A2;
    then reconsider i = v as Nat;
    B1: i in Seg N by A2;
    per cases;
    suppose i = 1;
      then f.i = 2 by A5, B1;
      hence thesis;
    end;
    suppose i is odd & i <> 1 & i <> 5;
      then f.i = 3 by A5, B1;
      hence thesis;
    end;
    suppose not (i = 1) & not (i is odd & i <> 1 & i <> 5);
      then i is even or i = 5;
      then f.i = 1 by A5, B1;
      hence thesis;
    end;
  end;
  A7: for i being Nat st i in Seg N holds 1 <= f.i
  proof
    let i be Nat;
    assume i in Seg N;
    then reconsider v = i as Element of G by A2;
    f is 3-labeling by A6;
    then 1 <= f.v;
    hence thesis;
  end;
  deffunc S(Nat) = SumN(f, In($1,C));
  A8: for i being Nat st i in Seg N holds
    S(i) = f.(csucc(N,i)) + f.(cpred(N,i))
  proof
    let i be Nat;
    assume i in Seg N;
    then In(i,C) = i by A2, SUBSET_1:def 8;
    hence thesis by A0, A1, CycleSum;
  end;
  A9: for i being Nat st 1 <= i & i <= N holds i in Seg N by FINSEQ_1:1;
  A9a: 2 <= N & 3 <= N & 1 <= N by A1, XXREAL_0:2;
  A9b: 1 in Seg N & 2 in Seg N & 3 in Seg N & N in Seg N by A9, A9a;
  :: the sums
  A10: 2 * 2 is even & 2 * 3 is even & 2 * 1 is even & 2 * 0 is even;
  then A11: 4 + 1 is odd & 0 + 1 is odd & 2 + 1 is odd;
  A12: S(1) <= 4 & S(1) <> 3
  proof
    B1: 1 in Seg N by A9b;
    1 < N by A0, XXREAL_0:2;
    then B2: csucc(N,1) = 1 + 1 & cpred(N,1) = N by DefCsucc, DefCpred;
    B3: f.2 = 1 by A5, A9b, A10;
    N <> 1 by A1;
    then B4: (N = 5 implies f.N = 1) & (N <> 5 implies f.N = 3)
      by A1, A5, A9b;
    S(1) = f.2 + f.N by A8, B1, B2;
    hence thesis by B3, B4;
  end;
  A13: S(2) = 5
  proof
    B1: 2 in Seg N by A9b;
    2 < N by A1, XXREAL_0:2;
    then B2: csucc(N,2) = 2 + 1 & cpred(N,2) = 2 -' 1 by DefCsucc, DefCpred;
    B3: 1 + 1 -' 1 = 1 by NAT_D:34;
    B4: f.3 = 3 & f.1 = 2 by A5, A9b, A11;
    B5: 2 -' 1 = 1 by B3;
    S(2) = f.(2 + 1) + f.(2 -' 1) by A8, B1, B2;
    then S(2) = 3 + 2 by B4, B5;
    hence thesis;
  end;
  A14: S(N) = 3
  proof
    B1: N in Seg N by A9b;
    B2: 1 < N by A0, XXREAL_0:2;
    then B3: csucc(N,N) = 1 & cpred(N,N) = N -' 1 by DefCsucc, DefCpred;
    B4: N -' 1 = N - 1 by B2, XREAL_1:233;
    B6: N -' 1 in Seg N by B1, B3, CpredIn;
    N -' 1 is even by A1, B4;
    then B5: f.(N -' 1) = 1 by A5, B6;
    B7: f.1 = 2 by A5, A9b;
    S(N) = f.1 + f.(N -' 1) by A8, B1, B3;
    hence thesis by B5, B7;
  end;
  A15: for i being Nat st 3 <= i & i < N holds
    (i is odd implies S(i) = 2) & (i is even implies 4 <= S(i))
  proof
    let i be Nat;
    assume B1: 3 <= i & i < N;
    then B2: 1 < i by XXREAL_0:2;
    then B3: i in Seg N by A9, B1;
    B4: csucc(N,i) = i + 1 & cpred(N,i) = i -' 1 by B1, B2, DefCsucc,
      DefCpred;
    B5: i -' 1 = i - 1 by B2, XREAL_1:233;
    B6: S(i) = f.(i + 1) + f.(i -' 1) by A8, B3, B4;
    B7: i + 1 in Seg N & i -' 1 in Seg N by B3, B4, CsuccIn, CpredIn;
    thus i is odd implies S(i) = 2
    proof
      assume i is odd;
      then i + 1 is even & i - 1 is even;
      then f.(i + 1) = 1 & f.(i -' 1) = 1 by A5, B5, B7;
      hence thesis by B6;
    end;
    assume B8: i is even;
    then B9: i + 1 is odd & i - 1 is odd;
    B10: 1 <= f.(i + 1) & 1 <= f.(i -' 1) by A7, B7;
    per cases;
    suppose i = 4;
      then f.(i -' 1) = 3 by A5, A11, B5, B7;
      then 1 + 3 <= f.(i + 1) + f.(i -' 1) by B10, XREAL_1:6;
      hence thesis by B6;
    end;
    suppose B11: i <> 4;
      i <> 3 by B8, A11;
      then 3 < i by B1, XXREAL_0:1;
      then 3 + 1 <= i by NAT_1:13;
      then 4 < i by B11, XXREAL_0:1;
      then 4 + 1 < i + 1 by XREAL_1:6;
      then i + 1 <> 1 & i + 1 <> 5 by XXREAL_0:2;
      then f.(i + 1) = 3 by A5, B7, B9;
      then 3 + 1 <= f.(i + 1) + f.(i -' 1) by B10, XREAL_1:7;
      hence thesis by B6;
    end;
  end;
  f is additive
  proof
    :: the sums at i and csucc(N,i) differ
    B1: for i being Nat st i in Seg N holds S(i) <> S(csucc(N,i))
    proof
      let i be Nat;
      assume i in Seg N;
      then C1: 1 <= i & i <= N by FINSEQ_1:1;
      per cases by C1, XXREAL_0:1;
      suppose C2: i = N;
        then csucc(N,i) = 1 by DefCsucc;
        hence thesis by A12, A14, C2;
      end;
      suppose C2: i < N;
        then C3: csucc(N,i) = i + 1 by DefCsucc;
        per cases by C1, XXREAL_0:1;
        suppose C4: i = 1;
          hence thesis by A12, A13, C3;
        end;
        suppose C4: 1 < i;
          then 1 + 1 <= i by NAT_1:13;
          then C5: i = 2 or 2 < i by XXREAL_0:1;
          per cases by C5;
          suppose C6: i = 2;
            3 < N by A1, XXREAL_0:2;
            then S(3) = 2 by A11, A15;
            hence thesis by A13, C3, C6;
          end;
          suppose 2 < i;
            then C6: 2 + 1 <= i by NAT_1:13;
            C7: i + 1 <= N by C2, NAT_1:13;
            per cases by C7, XXREAL_0:1;
            suppose C8: i + 1 = N;
              then i = N - 1;
              then i is even by A1;
              then 4 <= S(i) by A15, C2, C6;
              hence thesis by A14, C3, C8;
            end;
            suppose C8: i + 1 < N;
              C9: 3 <= i + 1 by C6, NAT_1:13, XXREAL_0:2;
              per cases;
              suppose i is odd;
                then S(i) = 2 & 4 <= S(i + 1) by A15, C2, C6, C8, C9;
                hence thesis by C3;
              end;
              suppose i is even;
                then S(i + 1) = 2 & 4 <= S(i) by A15, C2, C6, C8, C9;
                hence thesis by C3;
              end;
            end;
          end;
        end;
      end;
    end;
    let u,w;
    assume u,w are_adjacent;
    then C1: [u,w] in the InternalRel of G;
    u in Seg N & w in Seg N by A2;
    then reconsider i = u, j = w as Nat;
    C2: i in Seg N & j in Seg N & (j = csucc(N,i) or i = csucc(N,j))
      by A1, C1, DefCycle;
    C3: In(i,C) = u & In(j,C) = w by A2, C2, SUBSET_1:def 8;
    S(i) <> S(j) by B1, C2;
    hence thesis by C3;
  end;
  then A16: eta G <= 3 by A6, EtaLe;
  3 <= eta G by A0, A1, OddCycleLower;
  hence thesis by A16, XXREAL_0:1;
end;

:: The wheel W_N = C_N \/ K_1 (N >= 4): eta = 2 for even N, 3 for odd N

theorem Wheel:
  for N being Nat, w being object st 4 <= N & G is_cycle_of N &
  H is_join_of G,{w} holds
  (N is even implies eta H = 2) & (N is odd implies eta H = 3)
proof
  let N be Nat, w be object;
  assume A1: 4 <= N & G is_cycle_of N & H is_join_of G,{w};
  then A2: 3 <= N by XXREAL_0:2;
  consider v such that A3: maxdeg G = deg v by DefMaxdeg;
  v in the carrier of G;
  then v in Seg N by A1, DefCycle;
  then reconsider i = v as Nat;
  A4: maxdeg G = 2 by A1, A2, A3, CycleSum;
  card the carrier of G = card Seg N by A1, DefCycle
  .= N by FINSEQ_1:57;
  then maxdeg G + 2 <= card the carrier of G by A1, A4;
  then A5: eta H = eta G by A1, JoinK1;
  thus N is even implies eta H = 2 by A2, A1, A5, CycleEven;
  assume A6: N is odd;
  2 * 2 is even;
  then N <> 4 by A6;
  then 4 < N by A1, XXREAL_0:1;
  then 4 + 1 <= N by NAT_1:13;
  hence thesis by A1, A5, A6, Proposition1;
end;

:: Section 4. Split graphs

:: G = (Q \/ S, E) is split with clique Q and stable set S; Q is maximal:
:: no vertex of S is adjacent to all of Q.

reserve Q1,S1,T for Subset of G;

definition
  let G, Q1, S1;
  pred G is_split_by Q1,S1 means
  :DefSplit:
  Q1 \/ S1 = the carrier of G & Q1 misses S1 &
  (for u,v st u in Q1 & v in Q1 & u <> v holds u,v are_adjacent) &
  (for u,v st u in S1 & v in S1 holds not u,v are_adjacent) &
  for v st v in S1 ex u st u in Q1 & not u,v are_adjacent;
end;

theorem SplitNbS:
  G is_split_by Q1,S1 & v in S1 implies Nb v c= Q1
proof
  assume A1: G is_split_by Q1,S1 & v in S1;
  let x be object;
  assume A2: x in Nb v;
  then reconsider w = x as Element of G;
  A3: v,w are_adjacent by A2, NbIff;
  Q1 \/ S1 = the carrier of G by A1;
  then w in Q1 or w in S1 by XBOOLE_0:def 3;
  hence thesis by A1, A3;
end;

theorem SplitNbQ:
  G is_split_by Q1,S1 & u in Q1 implies
  Nb u = (Q1 \ {u}) \/ (Nb u /\ S1) & (Q1 \ {u}) misses (Nb u /\ S1)
proof
  assume A1: G is_split_by Q1,S1 & u in Q1;
  then A2: Q1 \/ S1 = the carrier of G & Q1 misses S1 by DefSplit;
  for x being object holds x in Nb u iff x in (Q1 \ {u}) \/ (Nb u /\ S1)
  proof
    let x be object;
    thus x in Nb u implies x in (Q1 \ {u}) \/ (Nb u /\ S1)
    proof
      assume B1: x in Nb u;
      then B2: x <> u by NbNotSelf;
      x in Q1 or x in S1 by A2, B1, XBOOLE_0:def 3;
      then x in Q1 \ {u} or x in Nb u /\ S1 by B1, B2, ZFMISC_1:56,
        XBOOLE_0:def 4;
      hence thesis by XBOOLE_0:def 3;
    end;
    assume x in (Q1 \ {u}) \/ (Nb u /\ S1);
    then B1: x in Q1 \ {u} or x in Nb u /\ S1 by XBOOLE_0:def 3;
    per cases by B1;
    suppose x in Q1 \ {u};
      then B2: x in Q1 & x <> u by ZFMISC_1:56;
      then reconsider w = x as Element of G;
      u,w are_adjacent by A1, B2, DefSplit;
      hence thesis by NbIff;
    end;
    suppose x in Nb u /\ S1;
      hence thesis by XBOOLE_0:def 4;
    end;
  end;
  hence Nb u = (Q1 \ {u}) \/ (Nb u /\ S1) by TARSKI:2;
  Q1 \ {u} c= Q1 & Nb u /\ S1 c= S1 by XBOOLE_1:17, XBOOLE_1:36;
  hence thesis by A2, XBOOLE_1:64;
end;

theorem SplitDegQ:
  G is_split_by Q1,S1 & u in Q1 implies deg u + 1 = card Q1 + card (Nb u /\ S1)
proof
  assume A1: G is_split_by Q1,S1 & u in Q1;
  then A2: Nb u = (Q1 \ {u}) \/ (Nb u /\ S1) &
    (Q1 \ {u}) misses (Nb u /\ S1) by SplitNbQ;
  then A3: deg u = card (Q1 \ {u}) + card (Nb u /\ S1) by CARD_2:40;
  {u} c= Q1 by A1, ZFMISC_1:31;
  then card (Q1 \ {u}) = card Q1 - card {u} by CARD_2:44
  .= card Q1 - 1 by CARD_1:30;
  hence thesis by A3;
end;

theorem SplitSumQ:
  G is_split_by Q1,S1 & u in Q1 implies
  for c being Nat st for w st w in S1 holds f.w = c holds
  SumN(f,u) + f.u = Sum(f|Q1) + c * card (Nb u /\ S1)
proof
  assume A1: G is_split_by Q1,S1 & u in Q1;
  let c be Nat;
  assume A2: for w st w in S1 holds f.w = c;
  A3: Nb u = (Q1 \ {u}) \/ (Nb u /\ S1) &
    (Q1 \ {u}) misses (Nb u /\ S1) by A1, SplitNbQ;
  reconsider R = Nb u /\ S1, Q0 = Q1 \ {u} as finite Subset of G;
  A4: SumN(f,u) = Sum(f|Q0) + Sum(f|R) by A3, SumUnion;
  for x being object st x in R holds f.x = c
  proof
    let x be object;
    assume x in R;
    then x in S1 by XBOOLE_0:def 4;
    hence thesis by A2;
  end;
  then A5: Sum(f|R) = c * card R by SumConst;
  A6: not u in Q0 by ZFMISC_1:56;
  {u} c= Q1 by A1, ZFMISC_1:31;
  then Q1 = Q0 \/ {u} by XBOOLE_1:45;
  then Sum(f|Q1) = Sum(f|Q0) + f.u by A6, SumAdd1;
  hence thesis by A4, A5;
end;

:: Theorem 3: if T is a nonempty subset of Q with pairwise distinct
:: degrees, then eta(G) <= |Q| - |T| + 1. Labels 1, ..., |Q| - |T| on
:: Q \ T and c = |Q| - |T| + 1 on T \/ S.

theorem Theorem3:
  G is_split_by Q1,S1 & T c= Q1 & T <> {} &
  (for u,w st u in T & w in T & deg u = deg w holds u = w)
  implies eta G <= card Q1 - card T + 1
proof
  assume that
  A1: G is_split_by Q1,S1 and
  A2: T c= Q1 & T <> {} and
  A3: for u,w st u in T & w in T & deg u = deg w holds u = w;
  set C = the carrier of G;
  A4: Q1 \/ S1 = C & Q1 misses S1 by A1, DefSplit;
  set D = Q1 \ T, k = card D;
  A5: k = card Q1 - card T by A2, CARD_2:44;
  set c = k + 1;
  D, card D are_equipotent by CARD_1:def 2;
  then consider h0 being Function such that
  A6: h0 is one-to-one & dom h0 = D & rng h0 = card D by WELLORD2:def 4;
  rng h0 c= NAT by A6, ORDINAL1:def 2;
  then reconsider h = h0 as Function of D, NAT by A6, FUNCT_2:2;
  A7: for x being object st x in D holds h.x < k
  proof
    let x be object;
    assume x in D;
    then B1: h.x in card D by A6, FUNCT_1:def 3;
    reconsider i = h.x as Nat;
    i in Segm k by B1, ORDINAL1:def 17;
    hence thesis by NAT_1:44;
  end;
  defpred Cd[object] means $1 in D;
  deffunc F1(object) = h.$1 + 1;
  deffunc F2(object) = c;
  A8: for x being object st x in C holds
    (Cd[x] implies F1(x) in NAT) & (not Cd[x] implies F2(x) in NAT)
    by ORDINAL1:def 12;
  consider f being Function of C, NAT such that
  A9: for x being object st x in C holds
    (Cd[x] implies f.x = F1(x)) & (not Cd[x] implies f.x = F2(x))
    from FUNCT_2:sch 5(A8);
  A10: for x being object st x in D holds 1 <= f.x & f.x <= k
  proof
    let x be object;
    assume B1: x in D;
    then B2: f.x = h.x + 1 by A9;
    h.x < k by A7, B1;
    hence thesis by B2, NAT_1:11, NAT_1:13;
  end;
  A11: for x being object st x in C & not x in D holds f.x = c by A9;
  A12: f is c-labeling
  proof
    let v;
    per cases;
    suppose v in D;
      then 1 <= f.v & f.v <= k by A10;
      hence thesis by NAT_1:13;
    end;
    suppose not v in D;
      then B1: f.v = c by A11;
      1 <= c by NAT_1:11;
      hence thesis by B1;
    end;
  end;
  A13: for w st w in S1 holds f.w = c
  proof
    let w;
    assume w in S1;
    then not w in Q1 by A4, XBOOLE_0:3;
    then not w in D by XBOOLE_0:def 5;
    hence thesis by A11;
  end;
  deffunc R(Element of G) = card (Nb $1 /\ S1);
  A14: for u st u in Q1 holds SumN(f,u) + f.u = Sum(f|Q1) + c * R(u)
    by A1, A13, SplitSumQ;
  A15: for v st v in S1 holds SumN(f,v) + 1 <= Sum(f|Q1)
  proof
    let v;
    assume B1: v in S1;
    then consider u0 being Element of G such that
    B2: u0 in Q1 & not u0,v are_adjacent by A1, DefSplit;
    reconsider Q0 = Q1 \ {u0} as finite Subset of G;
    Nb v c= Q0
    proof
      let x be object;
      assume C1: x in Nb v;
      Nb v c= Q1 by A1, B1, SplitNbS;
      then C2: x in Q1 by C1;
      x <> u0 by B2, C1, NbIff;
      hence thesis by C2, ZFMISC_1:56;
    end;
    then B3: SumN(f,v) <= Sum(f|Q0) by SumSubset;
    B4: not u0 in Q0 by ZFMISC_1:56;
    {u0} c= Q1 by B2, ZFMISC_1:31;
    then Q1 = Q0 \/ {u0} by XBOOLE_1:45;
    then B5: Sum(f|Q1) = Sum(f|Q0) + f.u0 by B4, SumAdd1;
    1 <= f.u0 by A12;
    then SumN(f,v) + 1 <= Sum(f|Q0) + f.u0 by B3, XREAL_1:7;
    hence thesis by B5;
  end;
  :: an edge between Q and S
  A16: for u,v st u in Q1 & v in S1 & u,v are_adjacent holds
    SumN(f,v) < SumN(f,u)
  proof
    let u,v;
    assume B1: u in Q1 & v in S1 & u,v are_adjacent;
    then v in Nb u by NbIff;
    then v in Nb u /\ S1 by B1, XBOOLE_0:def 4;
    then {v} c= Nb u /\ S1 by ZFMISC_1:31;
    then card {v} <= R(u) by NAT_1:43;
    then 1 <= R(u) by CARD_1:30;
    then c * 1 <= c * R(u) by XREAL_1:64;
    then B2: Sum(f|Q1) + c <= Sum(f|Q1) + c * R(u) by XREAL_1:6;
    f.u <= c by A12;
    then B2a: Sum(f|Q1) + f.u <= Sum(f|Q1) + c by XREAL_1:6;
    SumN(f,u) + f.u = Sum(f|Q1) + c * R(u) by A14, B1;
    then Sum(f|Q1) + c <= SumN(f,u) + f.u by B2;
    then Sum(f|Q1) + f.u <= SumN(f,u) + f.u by B2a, XXREAL_0:2;
    then B3: Sum(f|Q1) <= SumN(f,u) by XREAL_1:6;
    SumN(f,v) + 1 <= Sum(f|Q1) by A15, B1;
    then SumN(f,v) + 1 <= SumN(f,u) by B3, XXREAL_0:2;
    hence thesis by NAT_1:13;
  end;
  :: an edge inside Q
  A17: for u,w st u in Q1 & w in Q1 & u <> w holds SumN(f,u) <> SumN(f,w)
  proof
    let u,w;
    assume B1: u in Q1 & w in Q1 & u <> w;
    assume B2: SumN(f,u) = SumN(f,w);
    B3: SumN(f,u) + f.u = Sum(f|Q1) + c * R(u) &
      SumN(f,w) + f.w = Sum(f|Q1) + c * R(w) by A14, B1;
    B4: 1 <= f.u & f.u <= c & 1 <= f.w & f.w <= c by A12;
    per cases by XXREAL_0:1;
    suppose B5: R(u) = R(w);
      then B6: f.u = f.w by B2, B3;
      B7: u in T & w in T
      proof
        per cases;
        suppose C1: u in D;
          then C2: f.u = h.u + 1 & f.u <= k by A9, A10;
          per cases;
          suppose C3: w in D;
            then f.w = h.w + 1 by A9;
            then h.u = h.w by B6, C2;
            hence thesis by A6, B1, C1, C3, FUNCT_1:def 4;
          end;
          suppose not w in D;
            then f.w = c by A11;
            hence thesis by B6, C2, NAT_1:13;
          end;
        end;
        suppose C1: not u in D;
          then C2: f.u = c by A11;
          per cases;
          suppose w in D;
            then f.w <= k by A10;
            hence thesis by B6, C2, NAT_1:13;
          end;
          suppose not w in D;
            hence thesis by B1, C1, XBOOLE_0:def 5;
          end;
        end;
      end;
      deg u + 1 = card Q1 + R(u) & deg w + 1 = card Q1 + R(w)
        by A1, B1, SplitDegQ;
      then deg u = deg w by B5;
      hence contradiction by A3, B1, B7;
    end;
    suppose R(u) < R(w);
      then R(u) + 1 <= R(w) by NAT_1:13;
      then c * (R(u) + 1) <= c * R(w) by XREAL_1:64;
      then B5: c * R(u) + c <= c * R(w);
      f.w + c * R(u) = f.u + c * R(w) by B2, B3;
      then f.w + c * R(u) >= f.u + (c * R(u) + c) by B5, XREAL_1:6;
      then (f.u + c) + c * R(u) <= f.w + c * R(u);
      then B6: f.u + c <= f.w by XREAL_1:6;
      1 + c <= f.u + c by B4, XREAL_1:6;
      then f.w >= 1 + c by B6, XXREAL_0:2;
      hence contradiction by B4, NAT_1:13;
    end;
    suppose R(w) < R(u);
      then R(w) + 1 <= R(u) by NAT_1:13;
      then c * (R(w) + 1) <= c * R(u) by XREAL_1:64;
      then B5: c * R(w) + c <= c * R(u);
      f.u + c * R(w) = f.w + c * R(u) by B2, B3;
      then f.u + c * R(w) >= f.w + (c * R(w) + c) by B5, XREAL_1:6;
      then (f.w + c) + c * R(w) <= f.u + c * R(w);
      then B6: f.w + c <= f.u by XREAL_1:6;
      1 + c <= f.w + c by B4, XREAL_1:6;
      then f.u >= 1 + c by B6, XXREAL_0:2;
      hence contradiction by B4, NAT_1:13;
    end;
  end;
  f is additive
  proof
    let x,y be Element of G;
    assume B1: x,y are_adjacent;
    B2: (x in Q1 or x in S1) & (y in Q1 or y in S1) by A4, XBOOLE_0:def 3;
    per cases by B2;
    suppose x in Q1 & y in Q1;
      hence thesis by A17, B1;
    end;
    suppose x in Q1 & y in S1;
      hence thesis by A16, B1;
    end;
    suppose x in S1 & y in Q1;
      hence thesis by A16, B1;
    end;
    suppose x in S1 & y in S1;
      hence thesis by A1, B1, DefSplit;
    end;
  end;
  then eta G <= c by A12, EtaLe;
  hence thesis by A5;
end;

:: With |T| = 1: eta(G) <= |Q| <= chi(G); the conjecture holds for split
:: graphs.

theorem Theorem3Conjecture:
  G is_split_by Q1,S1 implies eta G <= card Q1 & eta G <= chromatic# G
proof
  assume A1: G is_split_by Q1,S1;
  A2: Q1 \/ S1 = the carrier of G by A1;
  A3: Q1 <> {}
  proof
    assume B1: Q1 = {};
    set v = the Element of G;
    v in S1 by A2, B1;
    then ex u st u in Q1 & not u,v are_adjacent by A1;
    hence contradiction by B1;
  end;
  consider x being object such that A4: x in Q1 by A3, XBOOLE_0:def 1;
  reconsider u = x as Element of G by A4;
  reconsider T1 = {u} as Subset of G by ZFMISC_1:31;
  A5: T1 c= Q1 by A4, ZFMISC_1:31;
  for u1,w being Element of G st u1 in T1 & w in T1 & deg u1 = deg w
    holds u1 = w
  proof
    let u1,w be Element of G;
    assume u1 in T1 & w in T1 & deg u1 = deg w;
    then u1 = u & w = u by TARSKI:def 1;
    hence thesis;
  end;
  then eta G <= card Q1 - card T1 + 1 by A1, A5, Theorem3;
  then eta G <= card Q1 - 1 + 1 by CARD_1:30;
  hence A6: eta G <= card Q1;
  for u1,w being Element of G st u1 in Q1 & w in Q1 & u1 <> w holds
    u1,w are_adjacent by A1;
  then reconsider Q2 = Q1 as finite Clique of G by CliqueI;
  card Q2 <= chromatic# G by CliqueLeChi;
  hence thesis by A6, XXREAL_0:2;
end;

:: Any partition into a clique and a stable set can be made maximal by
:: moving one vertex, so the conjecture holds for every split graph.

theorem SplitConjecture:
  Q1 \/ S1 = the carrier of G & Q1 misses S1 &
  (for u,v st u in Q1 & v in Q1 & u <> v holds u,v are_adjacent) &
  (for u,v st u in S1 & v in S1 holds not u,v are_adjacent)
  implies eta G <= chromatic# G
proof
  assume A1: Q1 \/ S1 = the carrier of G & Q1 misses S1 &
    (for u,v st u in Q1 & v in Q1 & u <> v holds u,v are_adjacent) &
    (for u,v st u in S1 & v in S1 holds not u,v are_adjacent);
  per cases;
  suppose for v st v in S1 ex u st u in Q1 & not u,v are_adjacent;
    then G is_split_by Q1,S1 by A1;
    hence thesis by Theorem3Conjecture;
  end;
  suppose ex v st v in S1 & for u st u in Q1 holds u,v are_adjacent;
    then consider v such that
    B1: v in S1 & for u st u in Q1 holds u,v are_adjacent;
    {v} c= the carrier of G by ZFMISC_1:31;
    then reconsider Q2 = Q1 \/ {v}, S2 = S1 \ {v} as Subset of G
      by XBOOLE_1:8;
    G is_split_by Q2,S2
    proof
      C0: {v} c= S1 by B1, ZFMISC_1:31;
      then C1: S1 = {v} \/ S2 by XBOOLE_1:45;
      Q2 \/ S2 = Q1 \/ ({v} \/ S2) by XBOOLE_1:4;
      hence Q2 \/ S2 = the carrier of G by A1, C1;
      C2: S2 c= S1 by XBOOLE_1:36;
      then C3: Q1 misses S2 by A1, XBOOLE_1:63;
      {v} misses S2 by XBOOLE_1:79;
      hence Q2 misses S2 by C3, XBOOLE_1:70;
      thus for x,y being Element of G st x in Q2 & y in Q2 & x <> y holds
        x,y are_adjacent
      proof
        let x,y be Element of G;
        assume D1: x in Q2 & y in Q2 & x <> y;
        then D2: (x in Q1 or x in {v}) & (y in Q1 or y in {v})
          by XBOOLE_0:def 3;
        per cases by D2, TARSKI:def 1;
        suppose x in Q1 & y in Q1;
          hence thesis by A1, D1;
        end;
        suppose x in Q1 & y = v;
          hence thesis by B1;
        end;
        suppose x = v & y in Q1;
          hence thesis by B1;
        end;
        suppose x = v & y = v;
          hence thesis by D1;
        end;
      end;
      thus for x,y being Element of G st x in S2 & y in S2 holds
        not x,y are_adjacent by A1, C2;
      let w be Element of G;
      assume D1: w in S2;
      take v;
      v in {v} by TARSKI:def 1;
      hence v in Q2 by XBOOLE_0:def 3;
      thus thesis by A1, B1, C2, D1;
    end;
    hence thesis by Theorem3Conjecture;
  end;
end;

:: A vertex adjacent to all others has N[w] = V

theorem ClosedAll:
  (for u st u <> w holds w,u are_adjacent) implies
  Nb w \/ {w} = the carrier of G
proof
  assume A1: for u st u <> w holds w,u are_adjacent;
  for z being object holds z in Nb w \/ {w} iff z in the carrier of G
  proof
    let z be object;
    thus z in Nb w \/ {w} implies z in the carrier of G
    proof
      assume z in Nb w \/ {w};
      then z in Nb w or z in {w} by XBOOLE_0:def 3;
      then z in Nb w or z = w by TARSKI:def 1;
      hence thesis;
    end;
    assume z in the carrier of G;
    then reconsider t = z as Element of G;
    per cases;
    suppose t = w;
      then t in {w} by TARSKI:def 1;
      hence thesis by XBOOLE_0:def 3;
    end;
    suppose t <> w;
      then w,t are_adjacent by A1;
      then t in Nb w by NbIff;
      hence thesis by XBOOLE_0:def 3;
    end;
  end;
  hence thesis by TARSKI:2;
end;

:: Proposition 2: a complete split graph (a clique Q, a stable set S with
:: |S| >= 2, and all edges between them) has eta = |Q|.

theorem Proposition2:
  Q1 \/ S1 = the carrier of G & Q1 misses S1 &
  (for u,v st u in Q1 & v in Q1 & u <> v holds u,v are_adjacent) &
  (for u,v st u in S1 & v in S1 holds not u,v are_adjacent) &
  (for u,v st u in Q1 & v in S1 holds u,v are_adjacent) &
  Q1 <> {} & 2 <= card S1
  implies eta G = card Q1
proof
  assume that
  A1: Q1 \/ S1 = the carrier of G & Q1 misses S1 and
  A2: for u,v st u in Q1 & v in Q1 & u <> v holds u,v are_adjacent and
  A3: for u,v st u in S1 & v in S1 holds not u,v are_adjacent and
  A4: for u,v st u in Q1 & v in S1 holds u,v are_adjacent and
  A5: Q1 <> {} & 2 <= card S1;
  consider x being object such that A6: x in Q1 by A5, XBOOLE_0:def 1;
  reconsider u = x as Element of G by A6;
  S1 <> {} by A5, CARD_1:27;
  then consider y being object such that A7: y in S1 by XBOOLE_0:def 1;
  reconsider v = y as Element of G by A7;
  A8: not v in Q1 by A1, A7, XBOOLE_0:3;
  A9: u <> v by A1, A6, A7, XBOOLE_0:3;
  {v} c= the carrier of G by ZFMISC_1:31;
  then reconsider Q2 = Q1 \/ {v}, S2 = S1 \ {v} as Subset of G
    by XBOOLE_1:8;
  A10: {v} c= S1 by A7, ZFMISC_1:31;
  A11: S2 c= S1 by XBOOLE_1:36;
  A12: G is_split_by Q2,S2
  proof
    S1 = {v} \/ S2 by A10, XBOOLE_1:45;
    then Q2 \/ S2 = Q1 \/ S1 by XBOOLE_1:4;
    hence Q2 \/ S2 = the carrier of G by A1;
    A11a: Q1 misses S2 by A1, A11, XBOOLE_1:63;
    {v} misses S2 by XBOOLE_1:79;
    hence Q2 misses S2 by A11a, XBOOLE_1:70;
    thus for x,y being Element of G st x in Q2 & y in Q2 & x <> y holds
      x,y are_adjacent
    proof
      let x,y be Element of G;
      assume D1: x in Q2 & y in Q2 & x <> y;
      then D2: (x in Q1 or x in {v}) & (y in Q1 or y in {v})
        by XBOOLE_0:def 3;
      per cases by D2, TARSKI:def 1;
      suppose x in Q1 & y in Q1;
        hence thesis by A2, D1;
      end;
      suppose x in Q1 & y = v;
        hence thesis by A4, A7;
      end;
      suppose x = v & y in Q1;
        hence thesis by A4, A7;
      end;
      suppose x = v & y = v;
        hence thesis by D1;
      end;
    end;
    thus for x,y being Element of G st x in S2 & y in S2 holds
      not x,y are_adjacent by A3, A11;
    let w be Element of G;
    assume D1: w in S2;
    take v;
    v in {v} by TARSKI:def 1;
    hence v in Q2 by XBOOLE_0:def 3;
    thus thesis by A3, A7, A11, D1;
  end;
  A13: card Q2 = card Q1 + 1 by A8, CARD_2:41;
  A14: card S2 = card S1 - 1
  proof
    card S2 = card S1 - card {v} by A10, CARD_2:44;
    hence thesis by CARD_1:30;
  end;
  :: deg u = |Q| + |S| - 1 and deg v = |Q|
  A16: u in Q2 by A6, XBOOLE_0:def 3;
  v in {v} by TARSKI:def 1;
  then A17: v in Q2 by XBOOLE_0:def 3;
  Nb u /\ S2 = S2
  proof
    for z being object st z in S2 holds z in Nb u
    proof
      let z be object;
      assume C1: z in S2;
      then reconsider w = z as Element of G;
      u,w are_adjacent by A4, A6, A11, C1;
      hence thesis by NbIff;
    end;
    then S2 c= Nb u by TARSKI:def 3;
    hence thesis by XBOOLE_1:28;
  end;
  then A18: deg u + 1 = card Q2 + card S2 by A12, A16, SplitDegQ;
  Nb v /\ S2 = {}
  proof
    assume Nb v /\ S2 <> {};
    then consider z being object such that C1: z in Nb v /\ S2
      by XBOOLE_0:def 1;
    C2: z in Nb v & z in S2 by C1, XBOOLE_0:def 4;
    reconsider w = z as Element of G by C1;
    v,w are_adjacent by C2, NbIff;
    hence contradiction by A3, A7, A11, C2;
  end;
  then deg v + 1 = card Q2 + 0 by A12, A17, SplitDegQ, CARD_1:27;
  then A19: deg v = card Q1 by A13;
  A20: deg u = card Q1 + card S1 - 1 by A13, A14, A18;
  1 + 1 <= card S1 by A5;
  then 1 <= card S1 - 1 by XREAL_1:19;
  then card Q1 + 1 <= card Q1 + (card S1 - 1) by XREAL_1:6;
  then deg v < deg u by A19, A20, NAT_1:13;
  then A21: deg u <> deg v;
  {u,v} c= the carrier of G by ZFMISC_1:32;
  then reconsider T1 = {u,v} as Subset of G;
  A22: T1 c= Q2 by A16, A17, ZFMISC_1:32;
  for x,y being Element of G st x in T1 & y in T1 & deg x = deg y holds
    x = y
  proof
    let x,y be Element of G;
    assume B1: x in T1 & y in T1 & deg x = deg y;
    then (x = u or x = v) & (y = u or y = v) by TARSKI:def 2;
    hence thesis by A21, B1;
  end;
  then eta G <= card Q2 - card T1 + 1 by A12, A22, Theorem3;
  then eta G <= card Q1 + 1 - 2 + 1 by A9, A13, CARD_2:57;
  then A23: eta G <= card Q1;
  :: the vertices of Q are true twins
  A24: for w st w in Q1 holds Nb w \/ {w} = the carrier of G
  proof
    let w;
    assume C1: w in Q1;
    for t being Element of G st t <> w holds w,t are_adjacent
    proof
      let t be Element of G;
      assume C2: t <> w;
      C3: t in Q1 or t in S1 by A1, XBOOLE_0:def 3;
      per cases by C3;
      suppose t in Q1;
        hence thesis by A2, C1, C2;
      end;
      suppose t in S1;
        hence thesis by A4, C1;
      end;
    end;
    hence thesis by ClosedAll;
  end;
  for x,y being Element of G st x in Q1 & y in Q1 holds x,y are_true_twins
  proof
    let x,y be Element of G;
    assume x in Q1 & y in Q1;
    then Nb x \/ {x} = the carrier of G & Nb y \/ {y} = the carrier of G
      by A24;
    hence thesis by DefTwins;
  end;
  then card Q1 <= eta G by Observation2;
  hence thesis by A23, XXREAL_0:1;
end;

:: Lemma 3 (ref. [6], Prop. 1) and Corollary 2: a lower bound from cliques

theorem CliqueNb:
  for Q being finite Clique of G st u in Q holds
  Nb u /\ Q = Q \ {u} & card Q <= deg u + 1
proof
  let Q be finite Clique of G;
  assume A1: u in Q;
  for x being object holds x in Nb u /\ Q iff x in Q \ {u}
  proof
    let x be object;
    thus x in Nb u /\ Q implies x in Q \ {u}
    proof
      assume x in Nb u /\ Q;
      then B1: x in Nb u & x in Q by XBOOLE_0:def 4;
      then x <> u by NbNotSelf;
      hence thesis by B1, ZFMISC_1:56;
    end;
    assume x in Q \ {u};
    then B1: x in Q & x <> u by ZFMISC_1:56;
    then reconsider w = x as Element of G;
    u,w are_adjacent by A1, B1, CliqueAdj;
    then w in Nb u by NbIff;
    hence thesis by B1, XBOOLE_0:def 4;
  end;
  hence A2: Nb u /\ Q = Q \ {u} by TARSKI:2;
  {u} c= Q by A1, ZFMISC_1:31;
  then card (Q \ {u}) = card Q - card {u} by CARD_2:44
  .= card Q - 1 by CARD_1:30;
  then card Q - 1 <= deg u by A2, NAT_1:43, XBOOLE_1:17;
  then card Q - 1 + 1 <= deg u + 1 by XREAL_1:6;
  hence thesis;
end;

theorem CdivMono:
  for a,a1,b,b1 being Nat st a <= a1 & 0 < b1 & b1 <= b holds
  cdiv(a,b) <= cdiv(a1,b1)
proof
  let a,a1,b,b1 be Nat;
  assume A1: a <= a1 & 0 < b1 & b1 <= b;
  then A2: a1 <= cdiv(a1,b1) * b1 by CdivMul;
  cdiv(a1,b1) * b1 <= cdiv(a1,b1) * b by A1, XREAL_1:64;
  then a1 <= cdiv(a1,b1) * b by A2, XXREAL_0:2;
  then A3: a <= cdiv(a1,b1) * b by A1, XXREAL_0:2;
  0 < b by A1, XXREAL_0:2;
  hence thesis by A3, CdivLe;
end;

:: For a clique Q, a source q_F of Q and a sink q_L of Q in D:
:: eta_t(D) >= ceil((d(q_F) + 1) / (d(q_L) - |Q| + 2)). The sums at the
:: vertices of Q are distinct and lie between those at q_F and q_L.

theorem Lemma3:
  for Q being finite Clique of G, qF,qL being Element of G st
  A is_orientation_of G & qF in Q & qL in Q &
  (for q being Element of G st q in Q & q <> qF holds [qF,q] in A) &
  (for q being Element of G st q in Q & q <> qL holds [q,qL] in A)
  holds cdiv(deg qF + 1, deg qL + 2 -' card Q) <= eta_t(G,A)
proof
  let Q be finite Clique of G, qF,qL be Element of G;
  assume that
  A1: A is_orientation_of G and
  A2: qF in Q & qL in Q and
  A3: for q being Element of G st q in Q & q <> qF holds [qF,q] in A and
  A4: for q being Element of G st q in Q & q <> qL holds [q,qL] in A;
  per cases;
  suppose eta_t(G,A) = +infty;
    hence thesis by XXREAL_0:3;
  end;
  suppose eta_t(G,A) <> +infty;
    then consider k being Nat, f such that
    A5: eta_t(G,A) = k & f is k-labeling & f is_topological_for A
      by EtaTAtt;
    set C = the carrier of G;
    :: f(N(q)) + f(q) = f(Q) + f(N(q) \ Q)
    A6: for q being Element of G st q in Q holds
      SumN(f,q) + f.q = Sum(f|Q) + Sum(f|(Nb q \ Q))
    proof
      let q be Element of G;
      assume B1: q in Q;
      reconsider Q0 = Q \ {q} as finite Subset of C;
      B2: Nb q /\ Q = Q0 by B1, CliqueNb;
      Nb q /\ Q c= Nb q by XBOOLE_1:17;
      then B3a: SumN(f,q) = Sum(f|(Nb q /\ Q)) + Sum(f|(Nb q \ (Nb q /\ Q)))
        by SumSplit;
      Nb q \ (Nb q /\ Q) = Nb q \ Q by XBOOLE_1:47;
      then B3: SumN(f,q) = Sum(f|Q0) + Sum(f|(Nb q \ Q)) by B2, B3a;
      B4: not q in Q0 by ZFMISC_1:56;
      {q} c= Q by B1, ZFMISC_1:31;
      then Q = Q0 \/ {q} by XBOOLE_1:45;
      then Sum(f|Q) = Sum(f|Q0) + f.q by B4, SumAdd1;
      hence thesis by B3;
    end;
    A7: for q being Element of G st q in Q holds
      deg q + 1 = card Q + card (Nb q \ Q)
    proof
      let q be Element of G;
      assume B1: q in Q;
      B2: Nb q /\ Q = Q \ {q} by B1, CliqueNb;
      Nb q = (Nb q /\ Q) \/ (Nb q \ Q) by XBOOLE_1:51;
      then B3: deg q = card (Q \ {q}) + card (Nb q \ Q) by B2, CARD_2:40,
        XBOOLE_1:89;
      {q} c= Q by B1, ZFMISC_1:31;
      then card (Q \ {q}) = card Q - card {q} by CARD_2:44
      .= card Q - 1 by CARD_1:30;
      hence thesis by B3;
    end;
    deffunc S(Element of C) = SumN(f,$1);
    deffunc F(Element of C) = In(SumN(f,$1), NAT);
    consider s being Function of C, NAT such that
    A8: for q being Element of C holds s.q = F(q) from FUNCT_2:sch 4;
    A9: for q being Element of G holds s.q = SumN(f,q)
    proof
      let q be Element of G;
      s.q = In(SumN(f,q), NAT) by A8;
      hence thesis by SUBSET_1:def 8;
    end;
    :: the sums on Q are distinct and lie between s(qF) and s(qL)
    A10: for x,y being object st x in Q & y in Q & s.x = s.y holds x = y
    proof
      let x,y be object;
      assume B1: x in Q & y in Q & s.x = s.y;
      then reconsider a = x, b = y as Element of G;
      assume B2: x <> y;
      then a,b are_adjacent by B1, CliqueAdj;
      then [a,b] in A or [b,a] in A by A1;
      then B3: SumN(f,a) < SumN(f,b) or SumN(f,b) < SumN(f,a) by A5;
      B4: s.a = SumN(f,a) by A9;
      s.b = SumN(f,b) by A9;
      hence contradiction by B1, B3, B4;
    end;
    A11: for x being object st x in Q holds s.qF <= s.x & s.x <= s.qL
    proof
      let x be object;
      assume B1: x in Q;
      then reconsider q = x as Element of G;
      thus s.qF <= s.x
      proof
        per cases;
        suppose q = qF;
          hence thesis;
        end;
        suppose q <> qF;
          then [qF,q] in A by A3, B1;
          then C1: SumN(f,qF) < SumN(f,q) by A5;
          C2: s.qF = SumN(f,qF) by A9;
          s.q = SumN(f,q) by A9;
          hence thesis by C1, C2;
        end;
      end;
      per cases;
      suppose q = qL;
        hence thesis;
      end;
      suppose q <> qL;
        then [q,qL] in A by A4, B1;
        then C1: SumN(f,q) < SumN(f,qL) by A5;
        C2: s.qL = SumN(f,qL) by A9;
        s.q = SumN(f,q) by A9;
        hence thesis by C1, C2;
      end;
    end;
    A12: card Q + s.qF <= s.qL + 1 by A2, A10, A11, SpreadF;
    set a = card (Nb qF \ Q), c = card (Nb qL \ Q);
    reconsider RF = Nb qF \ Q, RL = Nb qL \ Q as finite Subset of C;
    for x being object st x in RF holds 1 <= f.x & f.x <= k by A5;
    then A13: 1 * a <= Sum(f|RF) by SumBounds;
    for x being object st x in RL holds 1 <= f.x & f.x <= k by A5;
    then A13a: Sum(f|RL) <= k * c by SumBounds;
    A14: 1 <= f.qL & f.qF <= k by A5;
    A15a: s.qF = SumN(f,qF) & s.qL = SumN(f,qL) by A9;
    A15: s.qF + f.qF = Sum(f|Q) + Sum(f|RF) by A2, A6, A15a;
    A16: s.qL + f.qL = Sum(f|Q) + Sum(f|RL) by A2, A6, A15a;
    :: card Q + a <= k * (c + 1)
    Sum(f|Q) + a <= s.qF + f.qF by A13, A15, XREAL_1:6;
    then A17: Sum(f|Q) + a <= s.qF + f.qF & s.qF + f.qF <= s.qF + k
      by A14, XREAL_1:6;
    A18a: s.qL + 1 <= s.qL + f.qL by A14, XREAL_1:6;
    Sum(f|Q) + Sum(f|RL) <= Sum(f|Q) + k * c by A13a, XREAL_1:6;
    then A18: s.qL + 1 <= Sum(f|Q) + k * c by A16, A18a, XXREAL_0:2;
    Sum(f|Q) + a <= s.qF + k by A17, XXREAL_0:2;
    then card Q + (Sum(f|Q) + a) <= card Q + (s.qF + k) by XREAL_1:6;
    then A19: card Q + (Sum(f|Q) + a) <= (card Q + s.qF) + k;
    card Q + s.qF + k <= s.qL + 1 + k by A12, XREAL_1:6;
    then A20a: card Q + (Sum(f|Q) + a) <= s.qL + 1 + k by A19, XXREAL_0:2;
    s.qL + 1 + k <= Sum(f|Q) + k * c + k by A18, XREAL_1:6;
    then A20: card Q + (Sum(f|Q) + a) <= Sum(f|Q) + k * c + k
      by A20a, XXREAL_0:2;
    A21: deg qF + 1 = card Q + a by A2, A7;
    A22: deg qL + 1 = card Q + c by A2, A7;
    then deg qL + 2 = card Q + (c + 1);
    then A23: deg qL + 2 -' card Q = c + 1 by NAT_D:34;
    (card Q + a) + Sum(f|Q) <= k * (c + 1) + Sum(f|Q) by A20;
    then deg qF + 1 <= k * (c + 1) by A21, XREAL_1:6;
    then cdiv(deg qF + 1, c + 1) <= k by CdivLe;
    hence thesis by A5, A23;
  end;
end;

:: Corollary 2: if d1 <= d(q) <= d2 for every vertex q of a nonempty
:: clique Q (for example, the smallest and the largest degrees in Q), then
:: eta(G) >= ceil((d1 + 1) / (d2 - |Q| + 2)).

theorem Corollary2:
  for Q being finite Clique of G, d1,d2 being Nat st Q <> {} &
  for q being Element of G st q in Q holds d1 <= deg q & deg q <= d2
  holds cdiv(d1 + 1, d2 + 2 -' card Q) <= eta G
proof
  let Q be finite Clique of G, d1,d2 be Nat;
  assume that
  A1: Q <> {} and
  A2: for q being Element of G st q in Q holds d1 <= deg q & deg q <= d2;
  set C = the carrier of G;
  consider f such that A3: f is (eta G)-labeling additive by EtaAtt;
  consider A being Relation of C such that
  A4: A is_orientation_of G & A is acyclic & f is_topological_for A
    by A3, InducedOrientation;
  deffunc F(Element of C) = In(SumN(f,$1), NAT);
  consider s being Function of C, NAT such that
  A5: for q being Element of C holds s.q = F(q) from FUNCT_2:sch 4;
  A6: for q being Element of G holds s.q = SumN(f,q)
  proof
    let q be Element of G;
    s.q = In(SumN(f,q), NAT) by A5;
    hence thesis by SUBSET_1:def 8;
  end;
  set X = s.:Q;
  reconsider X as finite Subset of NAT;
  consider x0 being object such that A7: x0 in Q by A1, XBOOLE_0:def 1;
  A8: dom s = C by FUNCT_2:def 1;
  then s.x0 in X by A7, FUNCT_1:def 6;
  then consider M being Nat such that
  A9: M in X & for k being Nat st k in X holds k <= M by NatMax;
  consider m being Nat such that
  A10: m in X & for k being Nat st k in X holds m <= k by A9, NatMin;
  consider xL being object such that
  A11: xL in dom s & xL in Q & M = s.xL by A9, FUNCT_1:def 6;
  consider xF being object such that
  A12: xF in dom s & xF in Q & m = s.xF by A10, FUNCT_1:def 6;
  reconsider qF = xF, qL = xL as Element of G by A11, A12;
  :: an edge of Q goes from the smaller to the larger sum
  A13: for u,w being Element of G st u in Q & w in Q & u <> w &
    SumN(f,u) <= SumN(f,w) holds [u,w] in A
  proof
    let u,w be Element of G;
    assume B1: u in Q & w in Q & u <> w & SumN(f,u) <= SumN(f,w);
    then B2: u,w are_adjacent by CliqueAdj;
    then B3: SumN(f,u) <> SumN(f,w) by A3;
    B4: [u,w] in A or [w,u] in A by A4, B2;
    assume not [u,w] in A;
    then SumN(f,w) < SumN(f,u) by A4, B4;
    hence contradiction by B1;
  end;
  A14: for q being Element of G st q in Q & q <> qF holds [qF,q] in A
  proof
    let q be Element of G;
    assume B1: q in Q & q <> qF;
    s.q in X by A8, B1, FUNCT_1:def 6;
    then m <= s.q by A10;
    then SumN(f,qF) <= s.q by A6, A12;
    then SumN(f,qF) <= SumN(f,q) by A6;
    hence thesis by A12, A13, B1;
  end;
  A15: for q being Element of G st q in Q & q <> qL holds [q,qL] in A
  proof
    let q be Element of G;
    assume B1: q in Q & q <> qL;
    s.q in X by A8, B1, FUNCT_1:def 6;
    then s.q <= M by A9;
    then s.q <= SumN(f,qL) by A6, A11;
    then SumN(f,q) <= SumN(f,qL) by A6;
    hence thesis by A11, A13, B1;
  end;
  A16: cdiv(deg qF + 1, deg qL + 2 -' card Q) <= eta_t(G,A)
    by A4, A11, A12, A14, A15, Lemma3;
  eta_t(G,A) <= eta G by A3, A4, EtaTLe;
  then A17: cdiv(deg qF + 1, deg qL + 2 -' card Q) <= eta G
    by A16, XXREAL_0:2;
  :: monotonicity of the ceiling
  d1 <= deg qF by A2, A12;
  then A18: d1 + 1 <= deg qF + 1 by XREAL_1:6;
  A19: card Q <= deg qL + 1 by A11, CliqueNb;
  deg qL + 1 <= deg qL + 2 by XREAL_1:6;
  then A20: card Q <= deg qL + 2 by A19, XXREAL_0:2;
  then A21: deg qL + 2 -' card Q = deg qL + 2 - card Q by XREAL_1:233;
  card Q + 1 <= deg qL + 1 + 1 by A19, XREAL_1:6;
  then 1 <= deg qL + 2 - card Q by XREAL_1:19;
  then A22: 0 < deg qL + 2 -' card Q by A21;
  A23: deg qL <= d2 by A2, A11;
  then A24: deg qL + 2 <= d2 + 2 by XREAL_1:6;
  then card Q <= d2 + 2 by A20, XXREAL_0:2;
  then A25: d2 + 2 -' card Q = d2 + 2 - card Q by XREAL_1:233;
  deg qL + 2 - card Q <= d2 + 2 - card Q by A24, XREAL_1:9;
  then cdiv(d1 + 1, d2 + 2 -' card Q) <= cdiv(deg qF + 1, deg qL + 2 -' card Q)
    by A18, A21, A22, A25, CdivMono;
  hence thesis by A17, XXREAL_0:2;
end;

:: Vertices on two sides: u_i = [0,i] and v_i = [1,i]. A labeling is
:: given by fu.i = f(u_i) and fv.i = f(v_i).

theorem LabUV:
  for C being set st C c= [:{0,1}, NAT:]
  for fu,fv being Function of NAT, NAT
  ex f being Function of C, NAT st for i being Nat holds
  ([0,i] in C implies f.[0,i] = fu.i) & ([1,i] in C implies f.[1,i] = fv.i)
proof
  let C be set;
  assume A1: C c= [:{0,1}, NAT:];
  let fu,fv be Function of NAT, NAT;
  defpred Q[object,object] means ex i being Nat st
    ($1 = [0,i] & $2 = fu.i) or ($1 = [1,i] & $2 = fv.i);
  A2: for x being object st x in C ex y being object st y in NAT & Q[x,y]
  proof
    let x be object;
    assume x in C;
    then consider a,b being object such that
    B1: a in {0,1} & b in NAT & x = [a,b] by A1, ZFMISC_1:84;
    reconsider i = b as Nat by B1;
    B2: a = 0 or a = 1 by B1, TARSKI:def 2;
    i in NAT by ORDINAL1:def 12;
    then B3: fu.i in NAT & fv.i in NAT by FUNCT_2:5;
    per cases by B2;
    suppose B4: a = 0;
      take fu.i;
      thus thesis by B1, B3, B4;
    end;
    suppose B4: a = 1;
      take fv.i;
      thus thesis by B1, B3, B4;
    end;
  end;
  consider f being Function of C, NAT such that
  A3: for x being object st x in C holds Q[x,f.x] from FUNCT_2:sch 1(A2);
  take f;
  let i be Nat;
  thus [0,i] in C implies f.[0,i] = fu.i
  proof
    assume [0,i] in C;
    then consider j being Nat such that
    B1: ([0,i] = [0,j] & f.[0,i] = fu.j) or ([0,i] = [1,j] & f.[0,i] = fv.j)
      by A3;
    i = j & ([0,i] = [0,j] or 0 = 1) by B1, XTUPLE_0:1;
    hence thesis by B1, XTUPLE_0:1;
  end;
  assume [1,i] in C;
  then consider j being Nat such that
  B1: ([1,i] = [0,j] & f.[1,i] = fu.j) or ([1,i] = [1,j] & f.[1,i] = fv.j)
    by A3;
  i = j & ([1,i] = [1,j] or 1 = 0) by B1, XTUPLE_0:1;
  hence thesis by B1, XTUPLE_0:1;
end;

:: Sums over one side

theorem SumSide:
  for I being set, f being Function of I, NAT, a being object,
  X being finite Subset of NAT, g being Function of NAT, NAT st
  [:{a},X:] c= I & (for j being Nat st j in X holds f.[a,j] = g.j)
  holds for J being finite Subset of I st J = [:{a},X:] holds
  Sum(f|J) = Sum(g|X)
proof
  let I be set, f be Function of I, NAT, a be object,
    X be finite Subset of NAT, g be Function of NAT, NAT;
  assume A1: [:{a},X:] c= I & for j being Nat st j in X holds f.[a,j] = g.j;
  defpred P[set] means for B being finite Subset of NAT st B = $1 holds
    for J being finite Subset of I st J = [:{a},B:] holds
    Sum(f|J) = Sum(g|B);
  A2: P[{}]
  proof
    let B be finite Subset of NAT;
    assume B1: B = {};
    let J be finite Subset of I;
    assume J = [:{a},B:];
    then J = {} by B1, ZFMISC_1:90;
    then Sum(f|J) = 0 by SumEmpty;
    hence thesis by B1, SumEmpty;
  end;
  A3: for x being object, B being finite Subset of NAT st x in X & B c= X
    & not x in B & P[B] holds P[B \/ {x}]
  proof
    let x be object, B be finite Subset of NAT;
    assume B1: x in X & B c= X & not x in B & P[B];
    reconsider j = x as Nat by B1;
    let B2 be finite Subset of NAT;
    assume B3: B2 = B \/ {x};
    let J be finite Subset of I;
    assume B4: J = [:{a},B2:];
    [:{a},B:] c= [:{a},X:] by B1, ZFMISC_1:95;
    then reconsider J1 = [:{a},B:] as finite Subset of I by A1, XBOOLE_1:1;
    B5: [a,x] in [:{a},X:] by B1, ZFMISC_1:105;
    then B6: [a,x] in I by A1;
    B7: not [a,x] in J1 by B1, ZFMISC_1:87;
    [:{a},B2:] = [:{a},B:] \/ [:{a},{x}:] by B3, ZFMISC_1:97
    .= J1 \/ {[a,x]} by ZFMISC_1:29;
    then Sum(f|J) = Sum(f|J1) + f.[a,x] by B4, B6, B7, SumAdd1;
    then B8: Sum(f|J) = Sum(g|B) + f.[a,x] by B1;
    x in NAT by B1;
    then Sum(g|B2) = Sum(g|B) + g.x by B1, B3, SumAdd1;
    hence thesis by A1, B1, B8;
  end;
  A4: P[X] from SumInd(A2, A3);
  let J be finite Subset of I;
  assume J = [:{a},X:];
  hence thesis by A4;
end;

theorem SumUV:
  for I being set, f being Function of I, NAT, A,B being finite Subset of NAT,
  fu,fv being Function of NAT, NAT st
  [:{0},A:] c= I & [:{1},B:] c= I &
  (for j being Nat st j in A holds f.[0,j] = fu.j) &
  (for j being Nat st j in B holds f.[1,j] = fv.j)
  holds for J being finite Subset of I st J = [:{0},A:] \/ [:{1},B:] holds
  Sum(f|J) = Sum(fu|A) + Sum(fv|B)
proof
  let I be set, f be Function of I, NAT, A,B be finite Subset of NAT,
    fu,fv be Function of NAT, NAT;
  assume A1: [:{0},A:] c= I & [:{1},B:] c= I &
    (for j being Nat st j in A holds f.[0,j] = fu.j) &
    (for j being Nat st j in B holds f.[1,j] = fv.j);
  let J be finite Subset of I;
  assume A2: J = [:{0},A:] \/ [:{1},B:];
  reconsider JA = [:{0},A:], JB = [:{1},B:] as finite Subset of I by A1;
  {0} misses {1} by ZFMISC_1:11;
  then JA misses JB by ZFMISC_1:104;
  then A3: Sum(f|J) = Sum(f|JA) + Sum(f|JB) by A2, SumUnion;
  Sum(f|JA) = Sum(fu|A) & Sum(f|JB) = Sum(fv|B) by A1, SumSide;
  hence thesis by A3;
end;

theorem NbIR:
  for z being object holds z in Nb v iff [v,z] in the InternalRel of G
proof
  let z be object;
  thus z in Nb v implies [v,z] in the InternalRel of G
  proof
    assume A1: z in Nb v;
    then reconsider w = z as Element of G;
    v,w are_adjacent by A1, NbIff;
    hence thesis;
  end;
  assume A2: [v,z] in the InternalRel of G;
  then [v,z] in [:the carrier of G, the carrier of G:];
  then reconsider w = z as Element of G by ZFMISC_1:87;
  v,w are_adjacent by A2;
  hence thesis by NbIff;
end;

theorem SideFuncs:
  for q being Nat st the carrier of G = [:{0,1}, Seg q:] holds
  ex fu,fv being Function of NAT, NAT st for j being Nat st j in Seg q
  holds fu.j = f.[0,j] & fv.j = f.[1,j]
proof
  let q be Nat;
  assume A1: the carrier of G = [:{0,1}, Seg q:];
  A2: 0 in {0,1} & 1 in {0,1} by TARSKI:def 2;
  defpred C[object] means $1 in Seg q;
  deffunc F0(object) = f.[0,$1];
  deffunc F1(object) = f.[1,$1];
  deffunc Z(object) = 0;
  A3: for x being object st x in NAT holds
    (C[x] implies F0(x) in NAT) & (not C[x] implies Z(x) in NAT)
  proof
    let x be object;
    assume x in NAT;
    thus C[x] implies F0(x) in NAT
    proof
      assume C[x];
      then [0,x] in the carrier of G by A1, A2, ZFMISC_1:87;
      hence thesis by FUNCT_2:5;
    end;
    thus thesis;
  end;
  consider fu being Function of NAT, NAT such that
  A4: for x being object st x in NAT holds
    (C[x] implies fu.x = F0(x)) & (not C[x] implies fu.x = Z(x))
    from FUNCT_2:sch 5(A3);
  A5: for x being object st x in NAT holds
    (C[x] implies F1(x) in NAT) & (not C[x] implies Z(x) in NAT)
  proof
    let x be object;
    assume x in NAT;
    thus C[x] implies F1(x) in NAT
    proof
      assume C[x];
      then [1,x] in the carrier of G by A1, A2, ZFMISC_1:87;
      hence thesis by FUNCT_2:5;
    end;
    thus thesis;
  end;
  consider fv being Function of NAT, NAT such that
  A6: for x being object st x in NAT holds
    (C[x] implies fv.x = F1(x)) & (not C[x] implies fv.x = Z(x))
    from FUNCT_2:sch 5(A5);
  take fu, fv;
  let j be Nat;
  assume A7: j in Seg q;
  j in NAT by ORDINAL1:def 12;
  hence thesis by A4, A6, A7;
end;

:: Section 4: headless spiders of order q >= 2: the clique {u_1,...,u_q}
:: and the stable set {v_1,...,v_q}. In the thin spider u_i v_i are the
:: only other edges, in the thick spider u_i v_j for i <> j.

definition
  let G; let q be Nat;
  pred G is_thin_spider_of q means
  :DefThin:
  the carrier of G = [:{0,1}, Seg q:] &
  for x,y being object holds [x,y] in the InternalRel of G iff
  ex i,j being Nat st i in Seg q & j in Seg q &
    ((x = [0,i] & y = [0,j] & i <> j) or (x = [0,i] & y = [1,j] & i = j) or
     (x = [1,i] & y = [0,j] & i = j));
  pred G is_thick_spider_of q means
  :DefThick:
  the carrier of G = [:{0,1}, Seg q:] &
  for x,y being object holds [x,y] in the InternalRel of G iff
  ex i,j being Nat st i in Seg q & j in Seg q &
    ((x = [0,i] & y = [0,j] & i <> j) or (x = [0,i] & y = [1,j] & i <> j) or
     (x = [1,i] & y = [0,j] & i <> j));
end;

theorem SpiderExists:
  for q being Nat st 2 <= q holds
  (ex G being strict Graph st G is_thin_spider_of q) &
  (ex G being strict Graph st G is_thick_spider_of q)
proof
  let q be Nat;
  assume 2 <= q;
  then 1 <= q by XXREAL_0:2;
  then A0: 1 in Seg q by FINSEQ_1:1;
  0 in {0,1} by TARSKI:def 2;
  then [0,1] in [:{0,1}, Seg q:] by A0, ZFMISC_1:87;
  then reconsider V = [:{0,1}, Seg q:] as non empty finite set;
  defpred P1[object,object] means ex i,j being Nat st i in Seg q & j in Seg q
    & (($1 = [0,i] & $2 = [0,j] & i <> j) or ($1 = [0,i] & $2 = [1,j] & i = j)
    or ($1 = [1,i] & $2 = [0,j] & i = j));
  A1: for x,y being object st P1[x,y] holds P1[y,x];
  A2: for x being object holds not P1[x,x]
  proof
    let x be object;
    given i,j being Nat such that
    B1: i in Seg q & j in Seg q & ((x = [0,i] & x = [0,j] & i <> j) or
      (x = [0,i] & x = [1,j] & i = j) or (x = [1,i] & x = [0,j] & i = j));
    thus contradiction by B1, XTUPLE_0:1;
  end;
  consider G1 being strict Graph such that
  A3: the carrier of G1 = V & for x,y being object holds
    [x,y] in the InternalRel of G1 iff x in V & y in V & P1[x,y]
    from GraphEx(A1, A2);
  A4: for x,y being object st P1[x,y] holds x in V & y in V
  proof
    let x,y be object;
    given i,j being Nat such that
    B1: i in Seg q & j in Seg q & ((x = [0,i] & y = [0,j] & i <> j) or
      (x = [0,i] & y = [1,j] & i = j) or (x = [1,i] & y = [0,j] & i = j));
    0 in {0,1} & 1 in {0,1} by TARSKI:def 2;
    hence thesis by B1, ZFMISC_1:87;
  end;
  thus ex G being strict Graph st G is_thin_spider_of q
  proof
    take G1;
    thus the carrier of G1 = [:{0,1}, Seg q:] by A3;
    let x,y be object;
    thus [x,y] in the InternalRel of G1 implies P1[x,y] by A3;
    assume P1[x,y];
    then x in V & y in V & P1[x,y] by A4;
    hence thesis by A3;
  end;
  defpred P2[object,object] means ex i,j being Nat st i in Seg q & j in Seg q
    & (($1 = [0,i] & $2 = [0,j] & i <> j) or ($1 = [0,i] & $2 = [1,j] & i <> j)
    or ($1 = [1,i] & $2 = [0,j] & i <> j));
  A5: for x,y being object st P2[x,y] holds P2[y,x];
  A6: for x being object holds not P2[x,x]
  proof
    let x be object;
    given i,j being Nat such that
    B1: i in Seg q & j in Seg q & ((x = [0,i] & x = [0,j] & i <> j) or
      (x = [0,i] & x = [1,j] & i <> j) or (x = [1,i] & x = [0,j] & i <> j));
    thus contradiction by B1, XTUPLE_0:1;
  end;
  consider G2 being strict Graph such that
  A7: the carrier of G2 = V & for x,y being object holds
    [x,y] in the InternalRel of G2 iff x in V & y in V & P2[x,y]
    from GraphEx(A5, A6);
  A8: for x,y being object st P2[x,y] holds x in V & y in V
  proof
    let x,y be object;
    given i,j being Nat such that
    B1: i in Seg q & j in Seg q & ((x = [0,i] & y = [0,j] & i <> j) or
      (x = [0,i] & y = [1,j] & i <> j) or (x = [1,i] & y = [0,j] & i <> j));
    0 in {0,1} & 1 in {0,1} by TARSKI:def 2;
    hence thesis by B1, ZFMISC_1:87;
  end;
  take G2;
  thus the carrier of G2 = [:{0,1}, Seg q:] by A7;
  let x,y be object;
  thus [x,y] in the InternalRel of G2 implies P2[x,y] by A7;
  assume P2[x,y];
  then x in V & y in V & P2[x,y] by A8;
  hence thesis by A7;
end;

theorem PairSide:
  for a,z being object, X being set holds
  z in [:{a},X:] iff ex j being object st j in X & z = [a,j]
proof
  let a,z be object, X be set;
  thus z in [:{a},X:] implies ex j being object st j in X & z = [a,j]
  proof
    assume z in [:{a},X:];
    then consider x,y being object such that
    A1: x in {a} & y in X & z = [x,y] by ZFMISC_1:84;
    take y;
    thus thesis by A1, TARSKI:def 1;
  end;
  given j being object such that A2: j in X & z = [a,j];
  a in {a} by TARSKI:def 1;
  hence thesis by A2, ZFMISC_1:87;
end;

theorem ThinNb:
  for q,i being Nat st G is_thin_spider_of q & i in Seg q holds
  (for x being Element of G st x = [0,i] holds
    Nb x = [:{0}, Seg q \ {i}:] \/ [:{1},{i}:]) &
  (for x being Element of G st x = [1,i] holds Nb x = [:{0},{i}:])
proof
  let q,i be Nat;
  assume A1: G is_thin_spider_of q & i in Seg q;
  thus for x being Element of G st x = [0,i] holds
    Nb x = [:{0}, Seg q \ {i}:] \/ [:{1},{i}:]
  proof
    let x be Element of G;
    assume B1: x = [0,i];
    for z being object holds z in Nb x iff
      z in [:{0}, Seg q \ {i}:] \/ [:{1},{i}:]
    proof
      let z be object;
      thus z in Nb x implies z in [:{0}, Seg q \ {i}:] \/ [:{1},{i}:]
      proof
        assume z in Nb x;
        then [x,z] in the InternalRel of G by NbIR;
        then consider i1,j being Nat such that
        C1: i1 in Seg q & j in Seg q &
          ((x = [0,i1] & z = [0,j] & i1 <> j) or
           (x = [0,i1] & z = [1,j] & i1 = j) or
           (x = [1,i1] & z = [0,j] & i1 = j)) by A1, DefThin;
        C2: i1 = i by B1, C1, XTUPLE_0:1;
        per cases by B1, C1, XTUPLE_0:1;
        suppose C3: z = [0,j] & i1 <> j;
          then j in Seg q \ {i} by C1, C2, ZFMISC_1:56;
          then z in [:{0}, Seg q \ {i}:] by C3, PairSide;
          hence thesis by XBOOLE_0:def 3;
        end;
        suppose C3: z = [1,j] & i1 = j;
          j in {i} by C2, C3, TARSKI:def 1;
          then z in [:{1},{i}:] by C3, PairSide;
          hence thesis by XBOOLE_0:def 3;
        end;
      end;
      assume z in [:{0}, Seg q \ {i}:] \/ [:{1},{i}:];
      then C1: z in [:{0}, Seg q \ {i}:] or z in [:{1},{i}:]
        by XBOOLE_0:def 3;
      per cases by C1;
      suppose z in [:{0}, Seg q \ {i}:];
        then consider j being object such that
        C2: j in Seg q \ {i} & z = [0,j] by PairSide;
        C3: j in Seg q & j <> i by C2, ZFMISC_1:56;
        reconsider j as Nat by C2;
        [x,z] in the InternalRel of G by A1, B1, C2, C3, DefThin;
        hence thesis by NbIR;
      end;
      suppose z in [:{1},{i}:];
        then consider j being object such that
        C2: j in {i} & z = [1,j] by PairSide;
        j = i by C2, TARSKI:def 1;
        then [x,z] in the InternalRel of G by A1, B1, C2, DefThin;
        hence thesis by NbIR;
      end;
    end;
    hence thesis by TARSKI:2;
  end;
  let x be Element of G;
  assume B1: x = [1,i];
  for z being object holds z in Nb x iff z in [:{0},{i}:]
  proof
    let z be object;
    thus z in Nb x implies z in [:{0},{i}:]
    proof
      assume z in Nb x;
      then [x,z] in the InternalRel of G by NbIR;
      then consider i1,j being Nat such that
      C1: i1 in Seg q & j in Seg q &
        ((x = [0,i1] & z = [0,j] & i1 <> j) or
         (x = [0,i1] & z = [1,j] & i1 = j) or
         (x = [1,i1] & z = [0,j] & i1 = j)) by A1, DefThin;
      C2: x = [1,i1] & z = [0,j] & i1 = j by B1, C1, XTUPLE_0:1;
      then i1 = i by B1, XTUPLE_0:1;
      then j in {i} by C2, TARSKI:def 1;
      hence thesis by C2, PairSide;
    end;
    assume z in [:{0},{i}:];
    then consider j being object such that
    C2: j in {i} & z = [0,j] by PairSide;
    j = i by C2, TARSKI:def 1;
    then [x,z] in the InternalRel of G by A1, B1, C2, DefThin;
    hence thesis by NbIR;
  end;
  hence thesis by TARSKI:2;
end;

theorem ThickNb:
  for q,i being Nat st G is_thick_spider_of q & i in Seg q holds
  (for x being Element of G st x = [0,i] holds
    Nb x = [:{0}, Seg q \ {i}:] \/ [:{1}, Seg q \ {i}:]) &
  (for x being Element of G st x = [1,i] holds Nb x = [:{0}, Seg q \ {i}:])
proof
  let q,i be Nat;
  assume A1: G is_thick_spider_of q & i in Seg q;
  thus for x being Element of G st x = [0,i] holds
    Nb x = [:{0}, Seg q \ {i}:] \/ [:{1}, Seg q \ {i}:]
  proof
    let x be Element of G;
    assume B1: x = [0,i];
    for z being object holds z in Nb x iff
      z in [:{0}, Seg q \ {i}:] \/ [:{1}, Seg q \ {i}:]
    proof
      let z be object;
      thus z in Nb x implies
        z in [:{0}, Seg q \ {i}:] \/ [:{1}, Seg q \ {i}:]
      proof
        assume z in Nb x;
        then [x,z] in the InternalRel of G by NbIR;
        then consider i1,j being Nat such that
        C1: i1 in Seg q & j in Seg q &
          ((x = [0,i1] & z = [0,j] & i1 <> j) or
           (x = [0,i1] & z = [1,j] & i1 <> j) or
           (x = [1,i1] & z = [0,j] & i1 <> j)) by A1, DefThick;
        C2: i1 = i by B1, C1, XTUPLE_0:1;
        per cases by B1, C1, XTUPLE_0:1;
        suppose C3: z = [0,j] & i1 <> j;
          then j in Seg q \ {i} by C1, C2, ZFMISC_1:56;
          then z in [:{0}, Seg q \ {i}:] by C3, PairSide;
          hence thesis by XBOOLE_0:def 3;
        end;
        suppose C3: z = [1,j] & i1 <> j;
          then j in Seg q \ {i} by C1, C2, ZFMISC_1:56;
          then z in [:{1}, Seg q \ {i}:] by C3, PairSide;
          hence thesis by XBOOLE_0:def 3;
        end;
      end;
      assume z in [:{0}, Seg q \ {i}:] \/ [:{1}, Seg q \ {i}:];
      then C1: z in [:{0}, Seg q \ {i}:] or z in [:{1}, Seg q \ {i}:]
        by XBOOLE_0:def 3;
      per cases by C1;
      suppose z in [:{0}, Seg q \ {i}:];
        then consider j being object such that
        C2: j in Seg q \ {i} & z = [0,j] by PairSide;
        C3: j in Seg q & j <> i by C2, ZFMISC_1:56;
        reconsider j as Nat by C2;
        [x,z] in the InternalRel of G by A1, B1, C2, C3, DefThick;
        hence thesis by NbIR;
      end;
      suppose z in [:{1}, Seg q \ {i}:];
        then consider j being object such that
        C2: j in Seg q \ {i} & z = [1,j] by PairSide;
        C3: j in Seg q & j <> i by C2, ZFMISC_1:56;
        reconsider j as Nat by C2;
        [x,z] in the InternalRel of G by A1, B1, C2, C3, DefThick;
        hence thesis by NbIR;
      end;
    end;
    hence thesis by TARSKI:2;
  end;
  let x be Element of G;
  assume B1: x = [1,i];
  for z being object holds z in Nb x iff z in [:{0}, Seg q \ {i}:]
  proof
    let z be object;
    thus z in Nb x implies z in [:{0}, Seg q \ {i}:]
    proof
      assume z in Nb x;
      then [x,z] in the InternalRel of G by NbIR;
      then consider i1,j being Nat such that
      C1: i1 in Seg q & j in Seg q &
        ((x = [0,i1] & z = [0,j] & i1 <> j) or
         (x = [0,i1] & z = [1,j] & i1 <> j) or
         (x = [1,i1] & z = [0,j] & i1 <> j)) by A1, DefThick;
      C2: x = [1,i1] & z = [0,j] & i1 <> j by B1, C1, XTUPLE_0:1;
      then i1 = i by B1, XTUPLE_0:1;
      then j in Seg q \ {i} by C1, C2, ZFMISC_1:56;
      hence thesis by C2, PairSide;
    end;
    assume z in [:{0}, Seg q \ {i}:];
    then consider j being object such that
    C2: j in Seg q \ {i} & z = [0,j] by PairSide;
    C3: j in Seg q & j <> i by C2, ZFMISC_1:56;
    reconsider j as Nat by C2;
    [x,z] in the InternalRel of G by A1, B1, C2, C3, DefThick;
    hence thesis by NbIR;
  end;
  hence thesis by TARSKI:2;
end;

theorem SegRemove:
  for q,i being Nat, g being Function of NAT, NAT,
  S,S0 being finite Subset of NAT st i in Seg q & S = Seg q &
  S0 = Seg q \ {i} holds Sum(g|S) = Sum(g|S0) + g.i
proof
  let q,i be Nat, g be Function of NAT, NAT, S,S0 be finite Subset of NAT;
  assume A1: i in Seg q & S = Seg q & S0 = Seg q \ {i};
  A2: not i in S0 by A1, ZFMISC_1:56;
  {i} c= Seg q by A1, ZFMISC_1:31;
  then A3: S = S0 \/ {i} by A1, XBOOLE_1:45;
  i in NAT by ORDINAL1:def 12;
  hence thesis by A2, A3, SumAdd1;
end;

theorem SidesSub:
  for q being Nat, A being Subset of Seg q, a being object st
  the carrier of G = [:{0,1}, Seg q:] & (a = 0 or a = 1) holds
  [:{a},A:] c= the carrier of G
proof
  let q be Nat, A be Subset of Seg q, a be object;
  assume A1: the carrier of G = [:{0,1}, Seg q:] & (a = 0 or a = 1);
  then a in {0,1} by TARSKI:def 2;
  then {a} c= {0,1} by ZFMISC_1:31;
  hence thesis by A1, ZFMISC_1:96;
end;

theorem ThinSums:
  for q,i being Nat, fu,fv being Function of NAT, NAT st
  G is_thin_spider_of q & i in Seg q &
  (for j being Nat st j in Seg q holds f.[0,j] = fu.j & f.[1,j] = fv.j)
  holds for S being finite Subset of NAT st S = Seg q holds
  (for x being Element of G st x = [0,i] holds
    SumN(f,x) + fu.i = Sum(fu|S) + fv.i) &
  (for y being Element of G st y = [1,i] holds SumN(f,y) = fu.i)
proof
  let q,i be Nat, fu,fv be Function of NAT, NAT;
  assume A1: G is_thin_spider_of q & i in Seg q &
    for j being Nat st j in Seg q holds f.[0,j] = fu.j & f.[1,j] = fv.j;
  let S be finite Subset of NAT;
  assume A2: S = Seg q;
  A3: the carrier of G = [:{0,1}, Seg q:] by A1, DefThin;
  reconsider S0 = Seg q \ {i} as finite Subset of NAT by A2, XBOOLE_1:1;
  reconsider I1 = {i} as finite Subset of NAT by A2, A1, ZFMISC_1:31;
  A4: S0 c= Seg q & I1 c= Seg q by A1, XBOOLE_1:36, ZFMISC_1:31;
  then A5: [:{0},S0:] c= the carrier of G & [:{1},I1:] c= the carrier of G &
    [:{0},I1:] c= the carrier of G by A3, SidesSub;
  A6: for j being Nat st j in S0 holds f.[0,j] = fu.j by A1, A4;
  A7: for j being Nat st j in I1 holds f.[1,j] = fv.j by A1, A4;
  A7a: for j being Nat st j in I1 holds f.[0,j] = fu.j by A1, A4;
  i in NAT by ORDINAL1:def 12;
  then A8: Sum(fv|I1) = fv.i & Sum(fu|I1) = fu.i by SumSingle;
  thus for x being Element of G st x = [0,i] holds
    SumN(f,x) + fu.i = Sum(fu|S) + fv.i
  proof
    let x be Element of G;
    assume x = [0,i];
    then Nb x = [:{0}, S0:] \/ [:{1}, I1:] by A1, ThinNb;
    then SumN(f,x) = Sum(fu|S0) + Sum(fv|I1) by A5, A6, A7, SumUV;
    then SumN(f,x) + fu.i = Sum(fu|S0) + fu.i + fv.i by A8;
    hence thesis by A1, A2, SegRemove;
  end;
  let y be Element of G;
  assume y = [1,i];
  then Nb y = [:{0}, I1:] by A1, ThinNb;
  then SumN(f,y) = Sum(fu|I1) by A5, A7a, SumSide;
  hence thesis by A8;
end;

theorem ThickSums:
  for q,i being Nat, fu,fv being Function of NAT, NAT st
  G is_thick_spider_of q & i in Seg q &
  (for j being Nat st j in Seg q holds f.[0,j] = fu.j & f.[1,j] = fv.j)
  holds for S being finite Subset of NAT st S = Seg q holds
  (for x being Element of G st x = [0,i] holds
    SumN(f,x) + fu.i + fv.i = Sum(fu|S) + Sum(fv|S)) &
  (for y being Element of G st y = [1,i] holds
    SumN(f,y) + fu.i = Sum(fu|S))
proof
  let q,i be Nat, fu,fv be Function of NAT, NAT;
  assume A1: G is_thick_spider_of q & i in Seg q &
    for j being Nat st j in Seg q holds f.[0,j] = fu.j & f.[1,j] = fv.j;
  let S be finite Subset of NAT;
  assume A2: S = Seg q;
  A3: the carrier of G = [:{0,1}, Seg q:] by A1, DefThick;
  reconsider S0 = Seg q \ {i} as finite Subset of NAT by A2, XBOOLE_1:1;
  A4: S0 c= Seg q by XBOOLE_1:36;
  then A5: [:{0},S0:] c= the carrier of G & [:{1},S0:] c= the carrier of G
    by A3, SidesSub;
  A6: for j being Nat st j in S0 holds f.[0,j] = fu.j by A1, A4;
  A6a: for j being Nat st j in S0 holds f.[1,j] = fv.j by A1, A4;
  A7: Sum(fu|S) = Sum(fu|S0) + fu.i & Sum(fv|S) = Sum(fv|S0) + fv.i
    by A1, A2, SegRemove;
  thus for x being Element of G st x = [0,i] holds
    SumN(f,x) + fu.i + fv.i = Sum(fu|S) + Sum(fv|S)
  proof
    let x be Element of G;
    assume x = [0,i];
    then Nb x = [:{0}, S0:] \/ [:{1}, S0:] by A1, ThickNb;
    then SumN(f,x) = Sum(fu|S0) + Sum(fv|S0) by A5, A6, A6a, SumUV;
    hence thesis by A7;
  end;
  let y be Element of G;
  assume y = [1,i];
  then Nb y = [:{0}, S0:] by A1, ThickNb;
  then SumN(f,y) = Sum(fu|S0) by A5, A6, SumSide;
  hence thesis by A7;
end;

theorem Half:
  for q being Nat holds q + 1 <= 2 * cdiv(q+1,2) & 2 * cdiv(q+1,2) <= q + 2
proof
  let q be Nat;
  set r = cdiv(q+1,2);
  q + 1 <= r * 2 by CdivMul;
  hence q + 1 <= 2 * r;
  assume A1: 2 * r > q + 2;
  2 <= q + 2 by NAT_1:11;
  then A2: 2 * r > 2 by A1, XXREAL_0:2;
  r <> 0 by A2;
  then 1 <= r by NAT_1:14;
  then reconsider r1 = r - 1 as Nat by NAT_1:21;
  2 * r - 2 > q + 2 - 2 by A1, XREAL_1:9;
  then q + 1 <= 2 * r1 by NAT_1:13;
  then r <= r1 by CdivLe;
  then r <= r - 1;
  hence contradiction by XREAL_1:146;
end;

scheme NatCases{P[Nat], F,H(Nat) -> Nat}:
  ex g being Function of NAT, NAT st for i being Nat holds
  (P[i] implies g.i = F(i)) & (not P[i] implies g.i = H(i))
proof
  defpred Q[object,object] means ex i being Nat st $1 = i &
    (P[i] implies $2 = F(i)) & (not P[i] implies $2 = H(i));
  A1: for x being object st x in NAT ex y being object st y in NAT & Q[x,y]
  proof
    let x be object;
    assume x in NAT;
    then reconsider i = x as Nat;
    per cases;
    suppose B1: P[i];
      take F(i);
      thus thesis by B1, ORDINAL1:def 12;
    end;
    suppose B1: not P[i];
      take H(i);
      thus thesis by B1, ORDINAL1:def 12;
    end;
  end;
  consider g being Function of NAT, NAT such that
  A2: for x being object st x in NAT holds Q[x,g.x] from FUNCT_2:sch 1(A1);
  take g;
  let i be Nat;
  i in NAT by ORDINAL1:def 12;
  then ex j being Nat st i = j & (P[j] implies g.i = F(j)) &
    (not P[j] implies g.i = H(j)) by A2;
  hence thesis;
end;

theorem SpiderElem:
  for q being Nat st the carrier of G = [:{0,1}, Seg q:] holds
  ex i being Nat st i in Seg q & (v = [0,i] or v = [1,i])
proof
  let q be Nat;
  assume the carrier of G = [:{0,1}, Seg q:];
  then consider a,b being object such that
  A1: a in {0,1} & b in Seg q & v = [a,b] by ZFMISC_1:84;
  reconsider i = b as Nat by A1;
  take i;
  thus thesis by A1, TARSKI:def 2;
end;

theorem CardSide:
  for a being object, X being finite set holds card [:{a},X:] = card X
proof
  let a be object, X be finite set;
  thus card [:{a},X:] = card {a} * card X by CARD_2:46
  .= 1 * card X by CARD_1:30
  .= card X;
end;

:: Additivity on spiders reduces to the edges u_i u_j and u_i v_j

theorem SpiderAdditive:
  for q being Nat st (G is_thin_spider_of q or G is_thick_spider_of q) &
  (for x,y being Element of G, i,j being Nat st i in Seg q & j in Seg q &
    i <> j & x = [0,i] & y = [0,j] holds SumN(f,x) <> SumN(f,y)) &
  (for x,y being Element of G, i,j being Nat st i in Seg q & j in Seg q &
    [x,y] in the InternalRel of G & x = [0,i] & y = [1,j] holds
    SumN(f,x) <> SumN(f,y))
  holds f is additive
proof
  let q be Nat;
  assume that
  A1: G is_thin_spider_of q or G is_thick_spider_of q and
  A2: for x,y being Element of G, i,j being Nat st i in Seg q & j in Seg q &
    i <> j & x = [0,i] & y = [0,j] holds SumN(f,x) <> SumN(f,y) and
  A3: for x,y being Element of G, i,j being Nat st i in Seg q & j in Seg q &
    [x,y] in the InternalRel of G & x = [0,i] & y = [1,j] holds
    SumN(f,x) <> SumN(f,y);
  let x,y be Element of G;
  assume x,y are_adjacent;
  then A4: [x,y] in the InternalRel of G & [y,x] in the InternalRel of G
    by DefAdj;
  A5: ex i,j being Nat st i in Seg q & j in Seg q &
    ((x = [0,i] & y = [0,j] & i <> j) or (x = [0,i] & y = [1,j]) or
     (x = [1,i] & y = [0,j]))
  proof
    per cases by A1;
    suppose G is_thin_spider_of q;
      then consider i,j being Nat such that
      B1: i in Seg q & j in Seg q &
        ((x = [0,i] & y = [0,j] & i <> j) or (x = [0,i] & y = [1,j] & i = j)
        or (x = [1,i] & y = [0,j] & i = j)) by A4, DefThin;
      take i,j;
      thus thesis by B1;
    end;
    suppose G is_thick_spider_of q;
      then consider i,j being Nat such that
      B1: i in Seg q & j in Seg q &
        ((x = [0,i] & y = [0,j] & i <> j) or (x = [0,i] & y = [1,j] & i <> j)
        or (x = [1,i] & y = [0,j] & i <> j)) by A4, DefThick;
      take i,j;
      thus thesis by B1;
    end;
  end;
  consider i,j being Nat such that
  A6: i in Seg q & j in Seg q &
    ((x = [0,i] & y = [0,j] & i <> j) or (x = [0,i] & y = [1,j]) or
     (x = [1,i] & y = [0,j])) by A5;
  per cases by A6;
  suppose x = [0,i] & y = [0,j] & i <> j;
    hence thesis by A2, A6;
  end;
  suppose x = [0,i] & y = [1,j];
    hence thesis by A3, A4, A6;
  end;
  suppose x = [1,i] & y = [0,j];
    hence thesis by A3, A4, A6;
  end;
end;

theorem SpiderLab:
  for q being Nat, fu,fv being Function of NAT, NAT st
  the carrier of G = [:{0,1}, Seg q:] holds
  ex f st for j being Nat st j in Seg q holds f.[0,j] = fu.j & f.[1,j] = fv.j
proof
  let q be Nat, fu,fv be Function of NAT, NAT;
  assume A1: the carrier of G = [:{0,1}, Seg q:];
  Seg q c= NAT;
  then the carrier of G c= [:{0,1}, NAT:] by A1, ZFMISC_1:95;
  then consider f being Function of the carrier of G, NAT such that
  A2: for i being Nat holds ([0,i] in the carrier of G implies
    f.[0,i] = fu.i) & ([1,i] in the carrier of G implies f.[1,i] = fv.i)
    by LabUV;
  take f;
  let j be Nat;
  assume A3: j in Seg q;
  0 in {0,1} & 1 in {0,1} by TARSKI:def 2;
  then [0,j] in the carrier of G & [1,j] in the carrier of G
    by A1, A3, ZFMISC_1:87;
  hence thesis by A2;
end;

theorem SpiderLabeling:
  for q,k being Nat, fu,fv being Function of NAT, NAT st
  the carrier of G = [:{0,1}, Seg q:] &
  (for j being Nat st j in Seg q holds f.[0,j] = fu.j & f.[1,j] = fv.j) &
  (for j being Nat st j in Seg q holds
    1 <= fu.j & fu.j <= k & 1 <= fv.j & fv.j <= k)
  holds f is k-labeling
proof
  let q,k be Nat, fu,fv be Function of NAT, NAT;
  assume A1: the carrier of G = [:{0,1}, Seg q:] &
    (for j being Nat st j in Seg q holds f.[0,j] = fu.j & f.[1,j] = fv.j) &
    (for j being Nat st j in Seg q holds
    1 <= fu.j & fu.j <= k & 1 <= fv.j & fv.j <= k);
  let v;
  consider i being Nat such that A2: i in Seg q & (v = [0,i] or v = [1,i])
    by A1, SpiderElem;
  per cases by A2;
  suppose v = [0,i];
    then f.v = fu.i by A1, A2;
    hence thesis by A1, A2;
  end;
  suppose v = [1,i];
    then f.v = fv.i by A1, A2;
    hence thesis by A1, A2;
  end;
end;

:: Proposition 3, thin spiders, lower bound: Corollary 2 on the clique
:: {u_1,...,u_q}, whose vertices have degree q

theorem ThinLower:
  for q being Nat st 2 <= q & G is_thin_spider_of q holds
  cdiv(q+1,2) <= eta G
proof
  let q be Nat;
  assume A1: 2 <= q & G is_thin_spider_of q;
  set C = the carrier of G;
  A2: C = [:{0,1}, Seg q:] by A1, DefThin;
  reconsider A0 = Seg q as Subset of Seg q by XBOOLE_0:def 10;
  reconsider U = [:{0}, A0:] as Subset of G by A2, SidesSub;
  for x,y being Element of G st x in U & y in U & x <> y holds
    x,y are_adjacent
  proof
    let x,y be Element of G;
    assume B1: x in U & y in U & x <> y;
    then consider i being object such that B2: i in Seg q & x = [0,i]
      by PairSide;
    consider j being object such that B3: j in Seg q & y = [0,j]
      by B1, PairSide;
    reconsider i, j as Nat by B2, B3;
    [x,y] in the InternalRel of G by A1, B1, B2, B3, DefThin;
    hence thesis;
  end;
  then reconsider U as finite Clique of G by CliqueI;
  1 <= q by A1, XXREAL_0:2;
  then 1 in Seg q by FINSEQ_1:1;
  then A3: U <> {} by PairSide;
  A4: card U = card Seg q by CardSide
  .= q by FINSEQ_1:57;
  A5: for x being Element of G st x in U holds q <= deg x & deg x <= q
  proof
    let x be Element of G;
    assume x in U;
    then consider i being object such that B1: i in Seg q & x = [0,i]
      by PairSide;
    reconsider i as Nat by B1;
    reconsider S0 = Seg q \ {i}, I1 = {i} as finite set;
    B2: Nb x = [:{0}, S0:] \/ [:{1}, I1:] by A1, B1, ThinNb;
    {0} misses {1} by ZFMISC_1:11;
    then [:{0}, S0:] misses [:{1}, I1:] by ZFMISC_1:104;
    then B3: deg x = card [:{0}, S0:] + card [:{1}, I1:] by B2, CARD_2:40;
    B4: card [:{0}, S0:] = card S0 by CardSide;
    B5: card [:{1}, I1:] = card I1 by CardSide
    .= 1 by CARD_1:30;
    {i} c= Seg q by B1, ZFMISC_1:31;
    then card S0 = card Seg q - card {i} by CARD_2:44
    .= q - card {i} by FINSEQ_1:57
    .= q - 1 by CARD_1:30;
    hence thesis by B3, B4, B5;
  end;
  A6: q + 2 -' card U = 2 by A4, NAT_D:34;
  cdiv(q + 1, q + 2 -' card U) <= eta G by A3, A5, Corollary2;
  hence thesis by A6;
end;

theorem ThinUpper:
  for q being Nat st 2 <= q & G is_thin_spider_of q holds
  eta G <= cdiv(q+1,2)
proof
  let q be Nat;
  assume A1: 2 <= q & G is_thin_spider_of q;
  set C = the carrier of G, r = cdiv(q+1,2);
  A2: C = [:{0,1}, Seg q:] by A1, DefThin;
  A3: q + 1 <= 2 * r & 2 * r <= q + 2 by Half;
  reconsider SQ = Seg q as finite Subset of NAT;
  per cases by A1, XXREAL_0:1;
  suppose B0: q = 2;
    :: f = 1 on U, f(v_2) = 2, f(v_1) = 1
    deffunc F1(Nat) = 1;
    deffunc F2(Nat) = 2;
    defpred T[Nat] means $1 = 2;
    consider fu being Function of NAT, NAT such that
    B1: for i being Nat holds (T[i] implies fu.i = F1(i)) &
      (not T[i] implies fu.i = F1(i)) from NatCases;
    consider fv being Function of NAT, NAT such that
    B2: for i being Nat holds (T[i] implies fv.i = F2(i)) &
      (not T[i] implies fv.i = F1(i)) from NatCases;
    consider f such that
    B3: for j being Nat st j in Seg q holds f.[0,j] = fu.j & f.[1,j] = fv.j
      by A2, SpiderLab;
    B4: 2 <= r
    proof
      assume r < 2;
      then r < 1 + 1;
      then r <= 1 by NAT_1:13;
      then 2 * r <= 2 * 1 by XREAL_1:64;
      then q + 1 <= 2 by A3, XXREAL_0:2;
      hence contradiction by B0;
    end;
    B6: for j being Nat holds fu.j = 1 by B1;
    B6a: for j being Nat holds fv.j = 1 or fv.j = 2 by B2;
    B6b: for j being Nat holds 1 <= fv.j & fv.j <= 2
    proof
      let j be Nat;
      fv.j = 1 or fv.j = 2 by B6a;
      hence thesis;
    end;
    for j being Nat st j in Seg q holds
      1 <= fu.j & fu.j <= 2 & 1 <= fv.j & fv.j <= 2
    proof
      let j be Nat;
      fu.j = 1 by B6;
      hence thesis by B6b;
    end;
    then B5: f is 2-labeling by A2, B3, SpiderLabeling;
    for x being object st x in SQ holds fu.x = 1 by B6;
    then Sum(fu|SQ) = 1 * card SQ by SumConst;
    then B7: Sum(fu|SQ) = 2 by B0, FINSEQ_1:57;
    B8: for x being Element of G, i being Nat st i in Seg q & x = [0,i] holds
      SumN(f,x) = fv.i + 1
    proof
      let x be Element of G, i be Nat;
      assume C1: i in Seg q & x = [0,i];
      then C2: SumN(f,x) + fu.i = Sum(fu|SQ) + fv.i by A1, B3, ThinSums;
      fu.i = 1 by B6;
      then SumN(f,x) + 1 = 1 + 1 + fv.i by B7, C2;
      hence thesis;
    end;
    B9: for x,y being Element of G, i,j being Nat st i in Seg q &
      j in Seg q & i <> j & x = [0,i] & y = [0,j] holds
      SumN(f,x) <> SumN(f,y)
    proof
      let x,y be Element of G, i,j be Nat;
      assume C1: i in Seg q & j in Seg q & i <> j & x = [0,i] & y = [0,j];
      then C2: (i = 1 or i = 2) & (j = 1 or j = 2) by B0, FINSEQ_1:2,
        TARSKI:def 2;
      C3: SumN(f,x) = fv.i + 1 & SumN(f,y) = fv.j + 1 by B8, C1;
      fv.1 = 1 & fv.2 = 2 by B2;
      hence thesis by C1, C2, C3;
    end;
    for x,y being Element of G, i,j being Nat st i in Seg q &
      j in Seg q & [x,y] in the InternalRel of G & x = [0,i] & y = [1,j]
      holds SumN(f,x) <> SumN(f,y)
    proof
      let x,y be Element of G, i,j be Nat;
      assume C1: i in Seg q & j in Seg q & [x,y] in the InternalRel of G &
        x = [0,i] & y = [1,j];
      then SumN(f,y) = fu.j by A1, B3, ThinSums;
      then C2: SumN(f,y) = 1 by B6;
      SumN(f,x) = fv.i + 1 by B8, C1;
      then SumN(f,x) >= 1 + 1 by B6b, XREAL_1:6;
      hence thesis by C2;
    end;
    then f is additive by A1, B9, SpiderAdditive;
    then eta G <= 2 by B5, EtaLe;
    hence thesis by B4, XXREAL_0:2;
  end;
  suppose B0: 2 < q;
    then B0a: 2 + 1 <= q by NAT_1:13;
    :: r < q and 2 <= r
    q + 2 < q + q by B0, XREAL_1:6;
    then 2 * r < 2 * q by A3, XXREAL_0:2;
    then B1: r < q by XREAL_1:64;
    B2: 2 <= r
    proof
      assume r < 2;
      then r < 1 + 1;
      then r <= 1 by NAT_1:13;
      then 2 * r <= 2 * 1 by XREAL_1:64;
      then q + 1 <= 2 by A3, XXREAL_0:2;
      then q + 1 <= 1 + 1;
      then q <= 1 by XREAL_1:6;
      hence contradiction by B0a, XXREAL_0:2;
    end;
    :: f(u_i) = r - i + 1 and f(v_i) = 1 for i <= r,
    :: f(u_i) = q - i + 1 and f(v_i) = q + 1 - r for i > r
    defpred T[Nat] means $1 <= r;
    deffunc FU1(Nat) = r + 1 -' $1;
    deffunc FU2(Nat) = q + 1 -' $1;
    deffunc FV1(Nat) = 1;
    deffunc FV2(Nat) = q + 1 -' r;
    consider fu being Function of NAT, NAT such that
    B3: for i being Nat holds (T[i] implies fu.i = FU1(i)) &
      (not T[i] implies fu.i = FU2(i)) from NatCases;
    consider fv being Function of NAT, NAT such that
    B4: for i being Nat holds (T[i] implies fv.i = FV1(i)) &
      (not T[i] implies fv.i = FV2(i)) from NatCases;
    consider f such that
    B5: for j being Nat st j in Seg q holds f.[0,j] = fu.j & f.[1,j] = fv.j
      by A2, SpiderLab;
    B6a: r <= q + 1 by B1, NAT_1:13, XXREAL_0:2;
    then B6: q + 1 -' r = q + 1 - r by XREAL_1:233;
    :: the key identity f(u_i) + i = f(v_i) + r, and the labels
    B7: for i being Nat st i in Seg q holds fu.i + i = fv.i + r &
      1 <= fu.i & fu.i <= r & 1 <= fv.i & fv.i <= r
    proof
      let i be Nat;
      assume i in Seg q;
      then C1: 1 <= i & i <= q by FINSEQ_1:1;
      per cases;
      suppose C2: i <= r;
        then C3: fu.i = r + 1 -' i & fv.i = 1 by B3, B4;
        i <= r + 1 by C2, NAT_1:13, XXREAL_0:2;
        then C4: r + 1 -' i = r + 1 - i by XREAL_1:233;
        hence fu.i + i = fv.i + r by C3;
        r + 1 - r <= r + 1 - i by C2, XREAL_1:10;
        hence 1 <= fu.i by C3, C4;
        r + 1 - i <= r + 1 - 1 by C1, XREAL_1:10;
        hence fu.i <= r by C3, C4;
        thus thesis by B2, C3, XXREAL_0:2;
      end;
      suppose C2: not i <= r;
        then C3: fu.i = q + 1 -' i & fv.i = q + 1 -' r by B3, B4;
        i <= q + 1 by C1, NAT_1:13, XXREAL_0:2;
        then C4: q + 1 -' i = q + 1 - i by XREAL_1:233;
        hence fu.i + i = fv.i + r by B6, C3;
        q + 1 - q <= q + 1 - i by C1, XREAL_1:10;
        hence 1 <= fu.i by C3, C4;
        r + 1 <= i by C2, NAT_1:13;
        then C5: q + 1 - i <= q + 1 - (r + 1) by XREAL_1:10;
        q + 1 - 2 * r <= 0 by A3, XREAL_1:47;
        then q + 1 - 2 * r + (r - 1) <= 0 + (r - 1) by XREAL_1:6;
        then q + 1 - (r + 1) <= r - 1;
        then q + 1 - i <= r - 1 by C5, XXREAL_0:2;
        then q + 1 - i <= r by XREAL_1:146, XXREAL_0:2;
        hence fu.i <= r by C3, C4;
        q + 1 - q <= q + 1 - r by B1, XREAL_1:10;
        hence 1 <= fv.i by B6, C3;
        q + 1 - r <= 2 * r - r by A3, XREAL_1:9;
        hence thesis by B6, C3;
      end;
    end;
    for j being Nat st j in Seg q holds
      1 <= fu.j & fu.j <= r & 1 <= fv.j & fv.j <= r by B7;
    then B8: f is r-labeling by A2, B5, SpiderLabeling;
    :: f(U) >= 2r, from f(u_1) = r, f(u_2) = r - 1 and f(u_q) = 1
    B9: 2 * r <= Sum(fu|SQ)
    proof
      C1: fu.1 = r + 1 -' 1 & fu.2 = r + 1 -' 2 by B2, B3, XXREAL_0:2;
      then C2: fu.1 = r by NAT_D:34;
      2 <= r + 1 by B2, NAT_1:13, XXREAL_0:2;
      then C3: fu.2 = r + 1 - 2 by C1, XREAL_1:233;
      fu.q = q + 1 -' q by B1, B3;
      then C4: fu.q = 1 by NAT_D:34;
      C8: 1 in NAT & 2 in NAT & q in NAT by ORDINAL1:def 12;
      then reconsider X2 = {1,2} as finite Subset of NAT by ZFMISC_1:32;
      C5: Sum(fu|X2) = fu.1 + fu.2 by SumPair;
      q <> 1 & q <> 2 by B0a;
      then C6: not q in X2 by TARSKI:def 2;
      {q} c= NAT by C8, ZFMISC_1:31;
      then reconsider X3 = X2 \/ {q} as finite Subset of NAT by XBOOLE_1:8;
        C7: Sum(fu|X3) = Sum(fu|X2) + fu.q by C6, C8, SumAdd1;
      1 <= q & 2 <= q by B0a, XXREAL_0:2;
      then 1 in Seg q & 2 in Seg q & q in Seg q by FINSEQ_1:1;
      then X2 c= SQ & {q} c= SQ by ZFMISC_1:31, ZFMISC_1:32;
      then X3 c= SQ by XBOOLE_1:8;
      then Sum(fu|X3) <= Sum(fu|SQ) by SumSubset;
      hence thesis by C2, C3, C4, C5, C7;
    end;
    B10: for x being Element of G, i being Nat st i in Seg q & x = [0,i]
      holds SumN(f,x) + r = Sum(fu|SQ) + i
    proof
      let x be Element of G, i be Nat;
      assume C1: i in Seg q & x = [0,i];
      then SumN(f,x) + fu.i = Sum(fu|SQ) + fv.i by A1, B5, ThinSums;
      then C2: SumN(f,x) + fu.i + r = Sum(fu|SQ) + (fv.i + r);
      fv.i + r = fu.i + i by B7, C1;
      then SumN(f,x) + r + fu.i = Sum(fu|SQ) + i + fu.i by C2;
      hence thesis by XCMPLX_1:2;
    end;
    B11: for x,y being Element of G, i,j being Nat st i in Seg q &
      j in Seg q & i <> j & x = [0,i] & y = [0,j] holds
      SumN(f,x) <> SumN(f,y)
    proof
      let x,y be Element of G, i,j be Nat;
      assume C1: i in Seg q & j in Seg q & i <> j & x = [0,i] & y = [0,j];
      then SumN(f,x) + r = Sum(fu|SQ) + i & SumN(f,y) + r = Sum(fu|SQ) + j
        by B10;
      hence thesis by C1;
    end;
    for x,y being Element of G, i,j being Nat st i in Seg q &
      j in Seg q & [x,y] in the InternalRel of G & x = [0,i] & y = [1,j]
      holds SumN(f,x) <> SumN(f,y)
    proof
      let x,y be Element of G, i,j be Nat;
      assume C1: i in Seg q & j in Seg q & [x,y] in the InternalRel of G &
        x = [0,i] & y = [1,j];
      then C2: SumN(f,y) = fu.j by A1, B5, ThinSums;
      1 <= i by C1, FINSEQ_1:1;
      then 2 * r + 1 <= Sum(fu|SQ) + i by B9, XREAL_1:7;
      then 2 * r + 1 <= SumN(f,x) + r by B10, C1;
      then r + 1 + r <= SumN(f,x) + r;
      then C3: r + 1 <= SumN(f,x) by XREAL_1:6;
      fu.j <= r by B7, C1;
      hence thesis by C2, C3, NAT_1:13;
    end;
    then f is additive by A1, B11, SpiderAdditive;
    hence thesis by B8, EtaLe;
  end;
end;

:: Proposition 3, thin spiders: eta = ceil((q+1)/2) for q >= 2

theorem Proposition3Thin:
  for q being Nat st 2 <= q & G is_thin_spider_of q holds
  eta G = cdiv(q+1,2)
proof
  let q be Nat;
  assume A1: 2 <= q & G is_thin_spider_of q;
  then A2: eta G <= cdiv(q+1,2) by ThinUpper;
  cdiv(q+1,2) <= eta G by A1, ThinLower;
  hence thesis by A2, XXREAL_0:1;
end;

:: Proposition 3, thick spiders, lower bound: f(u_i) + f(v_i) takes q
:: distinct values in [2, 2k]

theorem ThickLower:
  for q being Nat st 2 <= q & G is_thick_spider_of q holds
  cdiv(q+1,2) <= eta G
proof
  let q be Nat;
  assume A1: 2 <= q & G is_thick_spider_of q;
  set C = the carrier of G, k = eta G;
  A2: C = [:{0,1}, Seg q:] by A1, DefThick;
  consider f such that A3: f is k-labeling additive by EtaAtt;
  consider fu,fv being Function of NAT, NAT such that
  A4: for j being Nat st j in Seg q holds fu.j = f.[0,j] & fv.j = f.[1,j]
    by A2, SideFuncs;
  deffunc FG(Element of NAT) = fu.$1 + fv.$1;
  consider g being Function of NAT, NAT such that
  A5: for j being Element of NAT holds g.j = FG(j) from FUNCT_2:sch 4;
  reconsider SQ = Seg q as finite Subset of NAT;
  A6: 0 in {0,1} & 1 in {0,1} by TARSKI:def 2;
  A7: for j being Nat st j in Seg q holds f.[0,j] = fu.j & f.[1,j] = fv.j
    by A4;
  A8: for j being Nat st j in Seg q holds
    g.j = f.[0,j] + f.[1,j] & 2 <= g.j & g.j <= 2 * k
  proof
    let j be Nat;
    assume B1: j in Seg q;
    j in NAT by ORDINAL1:def 12;
    then B2: g.j = fu.j + fv.j by A5;
    B2a: fu.j = f.[0,j] & fv.j = f.[1,j] by A4, B1;
    hence g.j = f.[0,j] + f.[1,j] by B2;
    [0,j] in C & [1,j] in C by A2, A6, B1, ZFMISC_1:87;
    then reconsider x = [0,j], y = [1,j] as Element of G;
    B3: 1 <= f.x & f.x <= k & 1 <= f.y & f.y <= k by A3;
    then 1 + 1 <= f.x + f.y by XREAL_1:7;
    hence 2 <= g.j by B2, B2a;
    f.x + f.y <= k + k by B3, XREAL_1:7;
    hence thesis by B2, B2a;
  end;
  A9: for x,y being object st x in SQ & y in SQ & g.x = g.y holds x = y
  proof
    let x,y be object;
    assume B1: x in SQ & y in SQ & g.x = g.y;
    then reconsider i = x, j = y as Nat;
    assume B2: x <> y;
    [0,i] in C & [0,j] in C by A2, A6, B1, ZFMISC_1:87;
    then reconsider a = [0,i], b = [0,j] as Element of G;
    [a,b] in the InternalRel of G by A1, B1, B2, DefThick;
    then a,b are_adjacent;
    then B3: SumN(f,a) <> SumN(f,b) by A3;
    SumN(f,a) + fu.i + fv.i = Sum(fu|SQ) + Sum(fv|SQ) &
      SumN(f,b) + fu.j + fv.j = Sum(fu|SQ) + Sum(fv|SQ) by A1, A7, B1,
      ThickSums;
    then SumN(f,a) + (fu.i + fv.i) = SumN(f,b) + (fu.j + fv.j);
    then SumN(f,a) + g.i = SumN(f,b) + (fu.j + fv.j) by A5, B1;
    then B4: SumN(f,a) + g.i = SumN(f,b) + g.j by A5, B1;
    g.i = g.j by B1;
    hence contradiction by B3, B4;
  end;
  1 <= q by A1, XXREAL_0:2;
  then 1 in Seg q by FINSEQ_1:1;
  then A10: SQ <> {};
  for x being object st x in SQ holds 2 <= g.x & g.x <= 2 * k by A8;
  then card SQ + 2 <= 2 * k + 1 by A9, A10, SpreadF;
  then q + 2 <= 2 * k + 1 by FINSEQ_1:57;
  then q + 1 + 1 <= 2 * k + 1;
  then q + 1 <= k * 2 by XREAL_1:6;
  hence thesis by CdivLe;
end;

theorem ThickUpper:
  for q being Nat st 2 <= q & G is_thick_spider_of q holds
  eta G <= cdiv(q+1,2)
proof
  let q be Nat;
  assume A1: 2 <= q & G is_thick_spider_of q;
  set C = the carrier of G, r = cdiv(q+1,2);
  A2: C = [:{0,1}, Seg q:] by A1, DefThick;
  A3: q + 1 <= 2 * r & 2 * r <= q + 2 by Half;
  reconsider SQ = Seg q as finite Subset of NAT;
  per cases by A1, XXREAL_0:1;
  suppose B0: q = 2;
    :: f = 1 on U, f(v_1) = 2, f(v_2) = 1
    deffunc F1(Nat) = 1;
    deffunc F2(Nat) = 2;
    defpred T[Nat] means $1 = 1;
    consider fu being Function of NAT, NAT such that
    B1: for i being Nat holds (T[i] implies fu.i = F1(i)) &
      (not T[i] implies fu.i = F1(i)) from NatCases;
    consider fv being Function of NAT, NAT such that
    B2: for i being Nat holds (T[i] implies fv.i = F2(i)) &
      (not T[i] implies fv.i = F1(i)) from NatCases;
    consider f such that
    B3: for j being Nat st j in Seg q holds f.[0,j] = fu.j & f.[1,j] = fv.j
      by A2, SpiderLab;
    B4: 2 <= r
    proof
      assume r < 2;
      then r < 1 + 1;
      then r <= 1 by NAT_1:13;
      then 2 * r <= 2 * 1 by XREAL_1:64;
      then q + 1 <= 2 by A3, XXREAL_0:2;
      hence contradiction by B0;
    end;
    B6: for j being Nat holds fu.j = 1
    proof
      let j be Nat;
      T[j] or not T[j];
      hence thesis by B1;
    end;
    B6b: for j being Nat holds 1 <= fv.j & fv.j <= 2
    proof
      let j be Nat;
      per cases;
      suppose T[j];
        then fv.j = 2 by B2;
        hence thesis;
      end;
      suppose not T[j];
        then fv.j = 1 by B2;
        hence thesis;
      end;
    end;
    for j being Nat st j in Seg q holds
      1 <= fu.j & fu.j <= 2 & 1 <= fv.j & fv.j <= 2
    proof
      let j be Nat;
      fu.j = 1 by B6;
      hence thesis by B6b;
    end;
    then B5: f is 2-labeling by A2, B3, SpiderLabeling;
    for x being object st x in SQ holds fu.x = 1 by B6;
    then Sum(fu|SQ) = 1 * card SQ by SumConst;
    then B7: Sum(fu|SQ) = 2 by B0, FINSEQ_1:57;
    B8: fv.1 = 2 & fv.2 = 1 by B2;
    Sum(fv|SQ) = fv.1 + fv.2 by B0, FINSEQ_1:2, SumPair;
    then B9: Sum(fu|SQ) + Sum(fv|SQ) = 5 by B7, B8;
    B10: for x being Element of G, i being Nat st i in Seg q & x = [0,i]
      holds SumN(f,x) + fv.i = 4
    proof
      let x be Element of G, i be Nat;
      assume C1: i in Seg q & x = [0,i];
      then C2: SumN(f,x) + fu.i + fv.i = 5 by A1, B3, B9, ThickSums;
      fu.i = 1 by B6;
      then SumN(f,x) + fv.i + 1 = 4 + 1 by C2;
      hence thesis;
    end;
    B11: for x,y being Element of G, i,j being Nat st i in Seg q &
      j in Seg q & i <> j & x = [0,i] & y = [0,j] holds
      SumN(f,x) <> SumN(f,y)
    proof
      let x,y be Element of G, i,j be Nat;
      assume C1: i in Seg q & j in Seg q & i <> j & x = [0,i] & y = [0,j];
      then C2: (i = 1 or i = 2) & (j = 1 or j = 2) by B0, FINSEQ_1:2,
        TARSKI:def 2;
      SumN(f,x) + fv.i = 4 & SumN(f,y) + fv.j = 4 by B10, C1;
      hence thesis by B8, C1, C2;
    end;
    for x,y being Element of G, i,j being Nat st i in Seg q &
      j in Seg q & [x,y] in the InternalRel of G & x = [0,i] & y = [1,j]
      holds SumN(f,x) <> SumN(f,y)
    proof
      let x,y be Element of G, i,j be Nat;
      assume C1: i in Seg q & j in Seg q & [x,y] in the InternalRel of G &
        x = [0,i] & y = [1,j];
      then SumN(f,y) + fu.j = Sum(fu|SQ) by A1, B3, ThickSums;
      then SumN(f,y) + 1 = 1 + 1 by B6, B7;
      then C2: SumN(f,y) = 1;
      C3: SumN(f,x) + fv.i = 2 + 2 by B10, C1;
      fv.i <= 2 by B6b;
      then 2 + 2 <= SumN(f,x) + 2 by C3, XREAL_1:6;
      then 2 <= SumN(f,x) by XREAL_1:6;
      hence thesis by C2;
    end;
    then f is additive by A1, B11, SpiderAdditive;
    then eta G <= 2 by B5, EtaLe;
    hence thesis by B4, XXREAL_0:2;
  end;
  suppose B0: 2 < q;
    then B0a: 2 + 1 <= q by NAT_1:13;
    q + 2 < q + q by B0, XREAL_1:6;
    then 2 * r < 2 * q by A3, XXREAL_0:2;
    then B1: r < q by XREAL_1:64;
    B2: 1 <= r
    proof
      assume r < 1;
      then r = 0 by NAT_1:14;
      hence contradiction by A3;
    end;
    :: f(u_i) = min(i,r), f(v_i) = 1 for i <= r and i + 1 - r for i > r
    defpred T[Nat] means $1 <= r;
    deffunc FU1(Nat) = $1;
    deffunc FU2(Nat) = r;
    deffunc FV1(Nat) = 1;
    deffunc FV2(Nat) = $1 + 1 -' r;
    consider fu being Function of NAT, NAT such that
    B3: for i being Nat holds (T[i] implies fu.i = FU1(i)) &
      (not T[i] implies fu.i = FU2(i)) from NatCases;
    consider fv being Function of NAT, NAT such that
    B4: for i being Nat holds (T[i] implies fv.i = FV1(i)) &
      (not T[i] implies fv.i = FV2(i)) from NatCases;
    consider f such that
    B5: for j being Nat st j in Seg q holds f.[0,j] = fu.j & f.[1,j] = fv.j
      by A2, SpiderLab;
    B7: for i being Nat st i in Seg q holds fu.i + fv.i = i + 1 &
      1 <= fu.i & fu.i <= r & 1 <= fv.i & fv.i <= r
    proof
      let i be Nat;
      assume i in Seg q;
      then C1: 1 <= i & i <= q by FINSEQ_1:1;
      per cases;
      suppose C2: i <= r;
        then fu.i = i & fv.i = 1 by B3, B4;
        hence thesis by B2, C1, C2;
      end;
      suppose C2: not i <= r;
        then C3: fu.i = r & fv.i = i + 1 -' r by B3, B4;
        r <= i + 1 by C2, NAT_1:13;
        then C4: i + 1 -' r = i + 1 - r by XREAL_1:233;
        hence fu.i + fv.i = i + 1 by C3;
        thus 1 <= fu.i & fu.i <= r by B2, C3;
        r + 1 <= i + 1 by C2, XREAL_1:6;
        then r + 1 - r <= i + 1 - r by XREAL_1:9;
        hence 1 <= fv.i by C3, C4;
        i + 1 <= q + 1 by C1, XREAL_1:6;
        then i + 1 <= 2 * r by A3, XXREAL_0:2;
        then i + 1 - r <= 2 * r - r by XREAL_1:9;
        hence thesis by C3, C4;
      end;
    end;
    for j being Nat st j in Seg q holds
      1 <= fu.j & fu.j <= r & 1 <= fv.j & fv.j <= r by B7;
    then B8: f is r-labeling by A2, B5, SpiderLabeling;
    :: f(V) >= q + 1, since f(v_q) = q + 1 - r >= 2
    B9: q + 1 <= Sum(fv|SQ)
    proof
      reconsider S0 = Seg q \ {q} as finite Subset of NAT by XBOOLE_1:1;
      1 <= q by B0a, XXREAL_0:2;
      then C1: q in Seg q by FINSEQ_1:1;
      then C2: Sum(fv|SQ) = Sum(fv|S0) + fv.q by SegRemove;
      for x being object st x in S0 holds 1 <= fv.x & fv.x <= r
      proof
        let x be object;
        assume x in S0;
        then x in Seg q by XBOOLE_0:def 5;
        hence thesis by B7;
      end;
      then C3: 1 * card S0 <= Sum(fv|S0) by SumBounds;
      {q} c= Seg q by C1, ZFMISC_1:31;
      then card S0 = card Seg q - card {q} by CARD_2:44
      .= q - card {q} by FINSEQ_1:57
      .= q - 1 by CARD_1:30;
      then C4: q - 1 <= Sum(fv|S0) by C3;
      C5a: fv.q = q + 1 -' r by B1, B4;
      r <= q + 1 by B1, NAT_1:13, XXREAL_0:2;
      then C5: fv.q = q + 1 - r by C5a, XREAL_1:233;
      r + 1 <= q by B1, NAT_1:13;
      then r + 1 + 1 <= q + 1 by XREAL_1:6;
      then r + 2 - r <= q + 1 - r by XREAL_1:9;
      then q - 1 + 2 <= Sum(fv|S0) + fv.q by C4, C5, XREAL_1:7;
      hence thesis by C2;
    end;
    B10: for x being Element of G, i being Nat st i in Seg q & x = [0,i]
      holds SumN(f,x) + i + 1 = Sum(fu|SQ) + Sum(fv|SQ)
    proof
      let x be Element of G, i be Nat;
      assume C1: i in Seg q & x = [0,i];
      then C2: SumN(f,x) + fu.i + fv.i = Sum(fu|SQ) + Sum(fv|SQ)
        by A1, B5, ThickSums;
      fu.i + fv.i = i + 1 by B7, C1;
      hence thesis by C2;
    end;
    B11: for x,y being Element of G, i,j being Nat st i in Seg q &
      j in Seg q & i <> j & x = [0,i] & y = [0,j] holds
      SumN(f,x) <> SumN(f,y)
    proof
      let x,y be Element of G, i,j be Nat;
      assume C1: i in Seg q & j in Seg q & i <> j & x = [0,i] & y = [0,j];
      then SumN(f,x) + i + 1 = Sum(fu|SQ) + Sum(fv|SQ) &
        SumN(f,y) + j + 1 = Sum(fu|SQ) + Sum(fv|SQ) by B10;
      hence thesis by C1;
    end;
    for x,y being Element of G, i,j being Nat st i in Seg q &
      j in Seg q & [x,y] in the InternalRel of G & x = [0,i] & y = [1,j]
      holds SumN(f,x) <> SumN(f,y)
    proof
      let x,y be Element of G, i,j be Nat;
      assume C1: i in Seg q & j in Seg q & [x,y] in the InternalRel of G &
        x = [0,i] & y = [1,j];
      then C2: SumN(f,y) + fu.j = Sum(fu|SQ) by A1, B5, ThickSums;
      C3: SumN(f,x) + i + 1 = Sum(fu|SQ) + Sum(fv|SQ) by B10, C1;
      i <= q by C1, FINSEQ_1:1;
      then i + 1 <= q + 1 by XREAL_1:6;
      then i + 1 <= Sum(fv|SQ) by B9, XXREAL_0:2;
      then Sum(fu|SQ) + (i + 1) <= Sum(fu|SQ) + Sum(fv|SQ) by XREAL_1:6;
      then SumN(f,y) + fu.j + (i + 1) <= SumN(f,x) + (i + 1) by C2, C3;
      then C4a: SumN(f,y) + fu.j <= SumN(f,x) by XREAL_1:6;
      1 <= fu.j by B7, C1;
      then SumN(f,y) + 1 <= SumN(f,y) + fu.j by XREAL_1:6;
      then C4: SumN(f,y) + 1 <= SumN(f,x) by C4a, XXREAL_0:2;
      assume SumN(f,x) = SumN(f,y);
      hence contradiction by C4, NAT_1:13;
    end;
    then f is additive by A1, B11, SpiderAdditive;
    hence thesis by B8, EtaLe;
  end;
end;

:: Proposition 3, thick spiders: eta = ceil((q+1)/2) for q >= 2

theorem Proposition3Thick:
  for q being Nat st 2 <= q & G is_thick_spider_of q holds
  eta G = cdiv(q+1,2)
proof
  let q be Nat;
  assume A1: 2 <= q & G is_thick_spider_of q;
  then A2: eta G <= cdiv(q+1,2) by ThickUpper;
  cdiv(q+1,2) <= eta G by A1, ThickLower;
  hence thesis by A2, XXREAL_0:1;
end;

:: Suns. From a base graph on the vertices u_i = [0,i], i in B (with
:: 1..m included in B), whose edges are given by a symmetric irreflexive
:: relation R on B, add v_j = [1,j] (1 <= j <= m) and the edges u_i v_i
:: and u_i v_(i-1) (with v_0 = v_m).

definition
  let G; let m be Nat; let B be set; let R be Relation;
  pred G is_sun_of m,B,R means
  :DefSun:
  the carrier of G = [:{0},B:] \/ [:{1},Seg m:] &
  for x,y being object holds [x,y] in the InternalRel of G iff
    (ex i,j being Nat st x = [0,i] & y = [0,j] & [i,j] in R) or
    (ex i,j being Nat st i in Seg m & (j = i or j = cpred(m,i)) &
      ((x = [0,i] & y = [1,j]) or (x = [1,j] & y = [0,i])));
end;

theorem SunExists:
  for m being Nat, B being finite Subset of NAT, R being Relation st
  3 <= m & Seg m c= B & R c= [:B,B:] &
  (for i,j being object st [i,j] in R holds [j,i] in R) &
  (for i being object holds not [i,i] in R)
  holds ex G being strict Graph st G is_sun_of m,B,R
proof
  let m be Nat, B be finite Subset of NAT, R be Relation;
  assume A1: 3 <= m & Seg m c= B & R c= [:B,B:] &
    (for i,j being object st [i,j] in R holds [j,i] in R) &
    (for i being object holds not [i,i] in R);
  1 <= m by A1, XXREAL_0:2;
  then A2: 1 in Seg m by FINSEQ_1:1;
  0 in {0} by TARSKI:def 1;
  then [0,1] in [:{0},B:] by A1, A2, ZFMISC_1:87;
  then reconsider V = [:{0},B:] \/ [:{1},Seg m:] as non empty finite set
    by XBOOLE_0:def 3;
  defpred P[object,object] means
    (ex i,j being Nat st $1 = [0,i] & $2 = [0,j] & [i,j] in R) or
    (ex i,j being Nat st i in Seg m & (j = i or j = cpred(m,i)) &
      (($1 = [0,i] & $2 = [1,j]) or ($1 = [1,j] & $2 = [0,i])));
  A3: for x,y being object st P[x,y] holds P[y,x]
  proof
    let x,y be object;
    assume B1: P[x,y];
    per cases by B1;
    suppose ex i,j being Nat st x = [0,i] & y = [0,j] & [i,j] in R;
      then consider i,j being Nat such that
      C1: x = [0,i] & y = [0,j] & [i,j] in R;
      [j,i] in R by A1, C1;
      hence thesis by C1;
    end;
    suppose ex i,j being Nat st i in Seg m & (j = i or j = cpred(m,i)) &
      ((x = [0,i] & y = [1,j]) or (x = [1,j] & y = [0,i]));
      hence thesis;
    end;
  end;
  A4: for x being object holds not P[x,x]
  proof
    let x be object;
    assume B1: P[x,x];
    per cases by B1;
    suppose ex i,j being Nat st x = [0,i] & x = [0,j] & [i,j] in R;
      then consider i,j being Nat such that
      C1: x = [0,i] & x = [0,j] & [i,j] in R;
      i = j by C1, XTUPLE_0:1;
      hence contradiction by A1, C1;
    end;
    suppose ex i,j being Nat st i in Seg m & (j = i or j = cpred(m,i)) &
      ((x = [0,i] & x = [1,j]) or (x = [1,j] & x = [0,i]));
      then consider i,j being Nat such that
      C1: i in Seg m & (j = i or j = cpred(m,i)) &
        ((x = [0,i] & x = [1,j]) or (x = [1,j] & x = [0,i]));
      thus contradiction by C1, XTUPLE_0:1;
    end;
  end;
  consider G being strict Graph such that
  A5: the carrier of G = V & for x,y being object holds
    [x,y] in the InternalRel of G iff x in V & y in V & P[x,y]
    from GraphEx(A3, A4);
  take G;
  thus the carrier of G = [:{0},B:] \/ [:{1},Seg m:] by A5;
  let x,y be object;
  thus [x,y] in the InternalRel of G implies P[x,y] by A5;
  assume B1: P[x,y];
  x in V & y in V
  proof
    per cases by B1;
    suppose ex i,j being Nat st x = [0,i] & y = [0,j] & [i,j] in R;
      then consider i,j being Nat such that
      C1: x = [0,i] & y = [0,j] & [i,j] in R;
      i in B & j in B by A1, C1, ZFMISC_1:87;
      then x in [:{0},B:] & y in [:{0},B:] by C1, PairSide;
      hence thesis by XBOOLE_0:def 3;
    end;
    suppose ex i,j being Nat st i in Seg m & (j = i or j = cpred(m,i)) &
      ((x = [0,i] & y = [1,j]) or (x = [1,j] & y = [0,i]));
      then consider i,j being Nat such that
      C1: i in Seg m & (j = i or j = cpred(m,i)) &
        ((x = [0,i] & y = [1,j]) or (x = [1,j] & y = [0,i]));
      j in Seg m by C1, CpredIn;
      then C2: [0,i] in [:{0},B:] & [1,j] in [:{1},Seg m:] by A1, C1,
        PairSide;
      then [0,i] in V & [1,j] in V by XBOOLE_0:def 3;
      hence thesis by C1;
    end;
  end;
  hence thesis by A5, B1;
end;

theorem CsuccNe:
  for m,j being Nat st 2 <= m & j in Seg m holds csucc(m,j) <> j &
  cpred(m,j) <> j
proof
  let m,j be Nat;
  assume A1: 2 <= m & j in Seg m;
  then A2: 1 <= j & j <= m by FINSEQ_1:1;
  thus csucc(m,j) <> j
  proof
    per cases;
    suppose j < m;
      then csucc(m,j) = j + 1 by DefCsucc;
      hence thesis;
    end;
    suppose not j < m;
      then csucc(m,j) = 1 & j = m by A2, DefCsucc, XXREAL_0:1;
      hence thesis by A1;
    end;
  end;
  per cases;
  suppose B1: 1 < j;
    then cpred(m,j) = j -' 1 by DefCpred;
    then cpred(m,j) = j - 1 by B1, XREAL_1:233;
    hence thesis;
  end;
  suppose not 1 < j;
    then cpred(m,j) = m & j = 1 by A2, DefCpred, XXREAL_0:1;
    hence thesis by A1;
  end;
end;

reserve B for Subset of NAT, R for Relation;

theorem SunNbV:
  for m,j being Nat st G is_sun_of m,B,R & j in Seg m holds
  for x being Element of G st x = [1,j] holds
  Nb x = {[0,j], [0,csucc(m,j)]}
proof
  let m,j be Nat;
  assume A1: G is_sun_of m,B,R & j in Seg m;
  let x be Element of G;
  assume A2: x = [1,j];
  for z being object holds z in Nb x iff z = [0,j] or z = [0,csucc(m,j)]
  proof
    let z be object;
    thus z in Nb x implies z = [0,j] or z = [0,csucc(m,j)]
    proof
      assume z in Nb x;
      then [x,z] in the InternalRel of G by NbIR;
      then B1: (ex i,j1 being Nat st x = [0,i] & z = [0,j1] & [i,j1] in R) or
        (ex i,j1 being Nat st i in Seg m & (j1 = i or j1 = cpred(m,i)) &
        ((x = [0,i] & z = [1,j1]) or (x = [1,j1] & z = [0,i]))) by A1, DefSun;
      per cases by B1;
      suppose ex i,j1 being Nat st x = [0,i] & z = [0,j1] & [i,j1] in R;
        hence thesis by A2, XTUPLE_0:1;
      end;
      suppose ex i,j1 being Nat st i in Seg m & (j1 = i or j1 = cpred(m,i)) &
        ((x = [0,i] & z = [1,j1]) or (x = [1,j1] & z = [0,i]));
        then consider i,j1 being Nat such that
        C1: i in Seg m & (j1 = i or j1 = cpred(m,i)) &
          ((x = [0,i] & z = [1,j1]) or (x = [1,j1] & z = [0,i]));
        C2: x = [1,j1] & z = [0,i] by A2, C1, XTUPLE_0:1;
        then C3: j1 = j by A2, XTUPLE_0:1;
        per cases by C1;
        suppose j1 = i;
          hence thesis by C2, C3;
        end;
        suppose j1 = cpred(m,i);
          then csucc(m,j) = i by C1, C3, CpredCsucc;
          hence thesis by C2;
        end;
      end;
    end;
    assume B1: z = [0,j] or z = [0,csucc(m,j)];
    per cases by B1;
    suppose z = [0,j];
      then [x,z] in the InternalRel of G by A1, A2, DefSun;
      hence thesis by NbIR;
    end;
    suppose B2: z = [0,csucc(m,j)];
      set i = csucc(m,j);
      i in Seg m & j = cpred(m,i) by A1, CsuccIn, CpredCsucc;
      then [x,z] in the InternalRel of G by A1, A2, B2, DefSun;
      hence thesis by NbIR;
    end;
  end;
  hence thesis by TARSKI:def 2;
end;

theorem SunNbU:
  for m,i being Nat st G is_sun_of m,B,R & R c= [:B,B:] holds
  for x being Element of G st x = [0,i] holds
  Nb x = [:{0}, R.:{i}:] \/ [:{1}, {j where j is Nat: i in Seg m &
    (j = i or j = cpred(m,i))}:]
proof
  let m,i be Nat;
  assume A1: G is_sun_of m,B,R & R c= [:B,B:];
  let x be Element of G;
  assume A2: x = [0,i];
  set D = {j where j is Nat: i in Seg m & (j = i or j = cpred(m,i))};
  for z being object holds z in Nb x iff z in [:{0}, R.:{i}:] \/ [:{1},D:]
  proof
    let z be object;
    thus z in Nb x implies z in [:{0}, R.:{i}:] \/ [:{1},D:]
    proof
      assume z in Nb x;
      then [x,z] in the InternalRel of G by NbIR;
      then B1: (ex i1,j1 being Nat st x = [0,i1] & z = [0,j1] & [i1,j1] in R)
        or (ex i1,j1 being Nat st i1 in Seg m & (j1 = i1 or j1 = cpred(m,i1))
        & ((x = [0,i1] & z = [1,j1]) or (x = [1,j1] & z = [0,i1])))
        by A1, DefSun;
      per cases by B1;
      suppose ex i1,j1 being Nat st x = [0,i1] & z = [0,j1] &
        [i1,j1] in R;
        then consider i1,j1 being Nat such that
        C1: x = [0,i1] & z = [0,j1] & [i1,j1] in R;
        i1 = i by A2, C1, XTUPLE_0:1;
        then i in {i} & [i,j1] in R by C1, TARSKI:def 1;
        then j1 in R.:{i} by RELAT_1:def 13;
        then z in [:{0}, R.:{i}:] by C1, PairSide;
        hence thesis by XBOOLE_0:def 3;
      end;
      suppose ex i1,j1 being Nat st i1 in Seg m &
        (j1 = i1 or j1 = cpred(m,i1)) &
        ((x = [0,i1] & z = [1,j1]) or (x = [1,j1] & z = [0,i1]));
        then consider i1,j1 being Nat such that
        C1: i1 in Seg m & (j1 = i1 or j1 = cpred(m,i1)) &
          ((x = [0,i1] & z = [1,j1]) or (x = [1,j1] & z = [0,i1]));
        C2: x = [0,i1] & z = [1,j1] by A2, C1, XTUPLE_0:1;
        then i1 = i by A2, XTUPLE_0:1;
        then j1 in D by C1;
        then z in [:{1},D:] by C2, PairSide;
        hence thesis by XBOOLE_0:def 3;
      end;
    end;
    assume z in [:{0}, R.:{i}:] \/ [:{1},D:];
    then B1: z in [:{0}, R.:{i}:] or z in [:{1},D:] by XBOOLE_0:def 3;
    per cases by B1;
    suppose z in [:{0}, R.:{i}:];
      then consider j being object such that
      C1: j in R.:{i} & z = [0,j] by PairSide;
      consider y being object such that
      C2: [y,j] in R & y in {i} by C1, RELAT_1:def 13;
      C3: [i,j] in R by C2, TARSKI:def 1;
      then j in B by A1, ZFMISC_1:87;
      then reconsider j as Nat;
      [x,z] in the InternalRel of G by A1, A2, C1, C3, DefSun;
      hence thesis by NbIR;
    end;
    suppose z in [:{1},D:];
      then consider j being object such that
      C1: j in D & z = [1,j] by PairSide;
      consider j1 being Nat such that
      C2: j = j1 & i in Seg m & (j1 = i or j1 = cpred(m,i)) by C1;
      [x,z] in the InternalRel of G by A1, A2, C1, C2, DefSun;
      hence thesis by NbIR;
    end;
  end;
  hence thesis by TARSKI:2;
end;

theorem SunD:
  for m,i being Nat holds
  (i in Seg m implies {j where j is Nat: i in Seg m &
    (j = i or j = cpred(m,i))} = {i, cpred(m,i)}) &
  (not i in Seg m implies {j where j is Nat: i in Seg m &
    (j = i or j = cpred(m,i))} = {})
proof
  let m,i be Nat;
  set D = {j where j is Nat: i in Seg m & (j = i or j = cpred(m,i))};
  thus i in Seg m implies D = {i, cpred(m,i)}
  proof
    assume B1: i in Seg m;
    for z being object holds z in D iff z = i or z = cpred(m,i)
    proof
      let z be object;
      thus z in D implies z = i or z = cpred(m,i)
      proof
        assume z in D;
        then ex j being Nat st z = j & i in Seg m & (j = i or j = cpred(m,i));
        hence thesis;
      end;
      assume z = i or z = cpred(m,i);
      hence thesis by B1;
    end;
    hence thesis by TARSKI:def 2;
  end;
  assume B1: not i in Seg m;
  assume D <> {};
  then consider z being object such that B2: z in D by XBOOLE_0:def 1;
  ex j being Nat st z = j & i in Seg m & (j = i or j = cpred(m,i)) by B2;
  hence contradiction by B1;
end;

theorem SunSums:
  for m being Nat, fu,fv being Function of NAT, NAT st
  G is_sun_of m,B,R & R c= [:B,B:] & 3 <= m & Seg m c= B &
  (for j being Nat st j in B holds f.[0,j] = fu.j) &
  (for j being Nat st j in Seg m holds f.[1,j] = fv.j)
  holds
  (for j being Nat, y being Element of G st j in Seg m & y = [1,j] holds
    SumN(f,y) = fu.j + fu.(csucc(m,j))) &
  (for i being Nat, x being Element of G, Ri being finite Subset of NAT st
    i in Seg m & x = [0,i] & Ri = R.:{i} holds
    SumN(f,x) = Sum(fu|Ri) + fv.i + fv.(cpred(m,i))) &
  (for i being Nat, x being Element of G, Ri being finite Subset of NAT st
    not i in Seg m & x = [0,i] & Ri = R.:{i} holds SumN(f,x) = Sum(fu|Ri))
proof
  let m be Nat, fu,fv be Function of NAT, NAT;
  assume that
  A1: G is_sun_of m,B,R & R c= [:B,B:] & 3 <= m & Seg m c= B and
  A2: for j being Nat st j in B holds f.[0,j] = fu.j and
  A3: for j being Nat st j in Seg m holds f.[1,j] = fv.j;
  set C = the carrier of G;
  A4: C = [:{0},B:] \/ [:{1},Seg m:] by A1, DefSun;
  A5: 2 <= m by A1, XXREAL_0:2;
  thus for j being Nat, y being Element of G st j in Seg m & y = [1,j] holds
    SumN(f,y) = fu.j + fu.(csucc(m,j))
  proof
    let j be Nat, y be Element of G;
    assume B1: j in Seg m & y = [1,j];
    then B2: Nb y = {[0,j], [0,csucc(m,j)]} by A1, SunNbV;
    csucc(m,j) <> j by A5, B1, CsuccNe;
    then B3: [0,j] <> [0,csucc(m,j)] by XTUPLE_0:1;
    B4: csucc(m,j) in Seg m by B1, CsuccIn;
    SumN(f,y) = f.[0,j] + f.[0,csucc(m,j)] by B2, B3, SumPair;
    then SumN(f,y) = fu.j + f.[0,csucc(m,j)] by A1, A2, B1;
    hence thesis by A1, A2, B4;
  end;
  A6: for i being Nat, Ri being finite Subset of NAT st Ri = R.:{i} holds
    [:{0},Ri:] c= C & for j being Nat st j in Ri holds f.[0,j] = fu.j
  proof
    let i be Nat, Ri be finite Subset of NAT;
    assume B1: Ri = R.:{i};
    B2: Ri c= B
    proof
      let j be object;
      assume j in Ri;
      then consider y being object such that
      C1: [y,j] in R & y in {i} by B1, RELAT_1:def 13;
      thus thesis by A1, C1, ZFMISC_1:87;
    end;
    then [:{0},Ri:] c= [:{0},B:] by ZFMISC_1:95;
    hence [:{0},Ri:] c= C by A4, XBOOLE_1:10;
    let j be Nat;
    assume j in Ri;
    hence thesis by A2, B2;
  end;
  thus for i being Nat, x being Element of G, Ri being finite Subset of NAT st
    i in Seg m & x = [0,i] & Ri = R.:{i} holds
    SumN(f,x) = Sum(fu|Ri) + fv.i + fv.(cpred(m,i))
  proof
    let i be Nat, x be Element of G, Ri be finite Subset of NAT;
    assume B1: i in Seg m & x = [0,i] & Ri = R.:{i};
    B2: cpred(m,i) in Seg m by B1, CpredIn;
    then reconsider D = {i, cpred(m,i)} as finite Subset of NAT
      by B1, ZFMISC_1:32;
    B3: Nb x = [:{0}, R.:{i}:] \/ [:{1}, {j where j is Nat: i in Seg m &
      (j = i or j = cpred(m,i))}:] by A1, B1, SunNbU;
    {j where j is Nat: i in Seg m & (j = i or j = cpred(m,i))} = D
      by B1, SunD;
    then B4: Nb x = [:{0},Ri:] \/ [:{1},D:] by B1, B3;
    D c= Seg m by B1, B2, ZFMISC_1:32;
    then [:{1},D:] c= [:{1},Seg m:] by ZFMISC_1:95;
    then B5: [:{1},D:] c= C by A4, XBOOLE_1:10;
    B6: for j being Nat st j in D holds f.[1,j] = fv.j
    proof
      let j be Nat;
      assume j in D;
      then j = i or j = cpred(m,i) by TARSKI:def 2;
      hence thesis by A3, B1, B2;
    end;
    B7: [:{0},Ri:] c= C & for j being Nat st j in Ri holds f.[0,j] = fu.j
      by A6, B1;
    B8: SumN(f,x) = Sum(fu|Ri) + Sum(fv|D) by B4, B5, B6, B7, SumUV;
    cpred(m,i) <> i by A5, B1, CsuccNe;
    then Sum(fv|D) = fv.i + fv.(cpred(m,i)) by SumPair;
    hence thesis by B8;
  end;
  let i be Nat, x be Element of G, Ri be finite Subset of NAT;
  assume B1: not i in Seg m & x = [0,i] & Ri = R.:{i};
  reconsider E = {} as finite Subset of NAT by XBOOLE_1:2;
  B3: Nb x = [:{0}, R.:{i}:] \/ [:{1}, {j where j is Nat: i in Seg m &
    (j = i or j = cpred(m,i))}:] by A1, B1, SunNbU;
  {j where j is Nat: i in Seg m & (j = i or j = cpred(m,i))} = {}
    by B1, SunD;
  then [:{1}, {j where j is Nat: i in Seg m &
    (j = i or j = cpred(m,i))}:] = {} by ZFMISC_1:90;
  then B4: Nb x = [:{0},Ri:] by B1, B3;
  B5: [:{0},Ri:] c= the carrier of G & for j being Nat st j in Ri holds
    f.[0,j] = fu.j by A6, B1;
  reconsider N = Nb x as finite Subset of the carrier of G;
  Sum(f|N) = Sum(fu|Ri) by B4, B5, SumSide;
  hence thesis;
end;

theorem SunLab:
  for m being Nat, fu,fv being Function of NAT, NAT st
  G is_sun_of m,B,R holds
  ex f st (for j being Nat st j in B holds f.[0,j] = fu.j) &
  (for j being Nat st j in Seg m holds f.[1,j] = fv.j)
proof
  let m be Nat, fu,fv be Function of NAT, NAT;
  assume A1: G is_sun_of m,B,R;
  A2: the carrier of G = [:{0},B:] \/ [:{1},Seg m:] by A1, DefSun;
  A3: 0 in {0,1} & 1 in {0,1} by TARSKI:def 2;
  then {0} c= {0,1} & {1} c= {0,1} by ZFMISC_1:31;
  then [:{0},B:] c= [:{0,1},NAT:] & [:{1},Seg m:] c= [:{0,1},NAT:]
    by ZFMISC_1:96;
  then the carrier of G c= [:{0,1}, NAT:] by A2, XBOOLE_1:8;
  then consider f being Function of the carrier of G, NAT such that
  A4: for i being Nat holds ([0,i] in the carrier of G implies
    f.[0,i] = fu.i) & ([1,i] in the carrier of G implies f.[1,i] = fv.i)
    by LabUV;
  take f;
  thus for j being Nat st j in B holds f.[0,j] = fu.j
  proof
    let j be Nat;
    assume j in B;
    then [0,j] in [:{0},B:] by PairSide;
    then [0,j] in the carrier of G by A2, XBOOLE_0:def 3;
    hence thesis by A4;
  end;
  let j be Nat;
  assume j in Seg m;
  then [1,j] in [:{1},Seg m:] by PairSide;
  then [1,j] in the carrier of G by A2, XBOOLE_0:def 3;
  hence thesis by A4;
end;

theorem SunElem:
  for m being Nat st G is_sun_of m,B,R holds
  ex i being Nat st (i in B & v = [0,i]) or (i in Seg m & v = [1,i])
proof
  let m be Nat;
  assume G is_sun_of m,B,R;
  then v in [:{0},B:] \/ [:{1},Seg m:] by DefSun;
  then A1: v in [:{0},B:] or v in [:{1},Seg m:] by XBOOLE_0:def 3;
  per cases by A1;
  suppose v in [:{0},B:];
    then consider j being object such that B1: j in B & v = [0,j]
      by PairSide;
    reconsider j as Nat by B1;
    take j;
    thus thesis by B1;
  end;
  suppose v in [:{1},Seg m:];
    then consider j being object such that B1: j in Seg m & v = [1,j]
      by PairSide;
    reconsider j as Nat by B1;
    take j;
    thus thesis by B1;
  end;
end;

theorem SunLabeling:
  for m,k being Nat, fu,fv being Function of NAT, NAT st
  G is_sun_of m,B,R &
  (for j being Nat st j in B holds f.[0,j] = fu.j & 1 <= fu.j & fu.j <= k) &
  (for j being Nat st j in Seg m holds f.[1,j] = fv.j & 1 <= fv.j & fv.j <= k)
  holds f is k-labeling
proof
  let m,k be Nat, fu,fv be Function of NAT, NAT;
  assume A1: G is_sun_of m,B,R &
    (for j being Nat st j in B holds f.[0,j] = fu.j & 1 <= fu.j & fu.j <= k)
    & (for j being Nat st j in Seg m holds f.[1,j] = fv.j & 1 <= fv.j &
    fv.j <= k);
  let v;
  consider i being Nat such that
  A2: (i in B & v = [0,i]) or (i in Seg m & v = [1,i]) by A1, SunElem;
  per cases by A2;
  suppose B1: i in B & v = [0,i];
    then f.v = fu.i by A1;
    hence thesis by A1, B1;
  end;
  suppose B1: i in Seg m & v = [1,i];
    then f.v = fv.i by A1;
    hence thesis by A1, B1;
  end;
end;

theorem SunAdditive:
  for m being Nat st G is_sun_of m,B,R &
  (for x,y being Element of G, i,j being Nat st [i,j] in R &
    x = [0,i] & y = [0,j] holds SumN(f,x) <> SumN(f,y)) &
  (for x,y being Element of G, i,j being Nat st i in Seg m &
    (j = i or j = cpred(m,i)) & x = [0,i] & y = [1,j] holds
    SumN(f,x) <> SumN(f,y))
  holds f is additive
proof
  let m be Nat;
  assume that
  A1: G is_sun_of m,B,R and
  A2: for x,y being Element of G, i,j being Nat st [i,j] in R &
    x = [0,i] & y = [0,j] holds SumN(f,x) <> SumN(f,y) and
  A3: for x,y being Element of G, i,j being Nat st i in Seg m &
    (j = i or j = cpred(m,i)) & x = [0,i] & y = [1,j] holds
    SumN(f,x) <> SumN(f,y);
  let x,y be Element of G;
  assume x,y are_adjacent;
  then [x,y] in the InternalRel of G;
  then A4: (ex i,j being Nat st x = [0,i] & y = [0,j] & [i,j] in R) or
    (ex i,j being Nat st i in Seg m & (j = i or j = cpred(m,i)) &
    ((x = [0,i] & y = [1,j]) or (x = [1,j] & y = [0,i]))) by A1, DefSun;
  per cases by A4;
  suppose ex i,j being Nat st x = [0,i] & y = [0,j] & [i,j] in R;
    hence thesis by A2;
  end;
  suppose ex i,j being Nat st i in Seg m & (j = i or j = cpred(m,i)) &
    ((x = [0,i] & y = [1,j]) or (x = [1,j] & y = [0,i]));
    then consider i,j being Nat such that
    B1: i in Seg m & (j = i or j = cpred(m,i)) &
      ((x = [0,i] & y = [1,j]) or (x = [1,j] & y = [0,i]));
    per cases by B1;
    suppose x = [0,i] & y = [1,j];
      hence thesis by A3, B1;
    end;
    suppose x = [1,j] & y = [0,i];
      hence thesis by A3, B1;
    end;
  end;
end;

:: The bases of the complete sun KS_m (K_m on u_1..u_m), the cycle sun
:: CS_m (C_m) and the wheel sun WS_m (W_m, with hub u_0)

definition
  let m be Nat;
  func KRel m -> Relation of Seg m means
  :DefKRel:
  for i,j being Nat holds [i,j] in it iff i in Seg m & j in Seg m & i <> j;
  existence
  proof
    defpred P[object,object] means $1 <> $2;
    consider R being Relation of Seg m, Seg m such that
    A1: for x,y being object holds [x,y] in R iff x in Seg m & y in Seg m &
      P[x,y] from RELSET_1:sch 1;
    reconsider R as Relation of Seg m;
    take R;
    thus thesis by A1;
  end;
  uniqueness
  proof
    let R1,R2 be Relation of Seg m;
    assume A1: (for i,j being Nat holds [i,j] in R1 iff i in Seg m &
      j in Seg m & i <> j) & (for i,j being Nat holds [i,j] in R2 iff
      i in Seg m & j in Seg m & i <> j);
    for x,y being object holds [x,y] in R1 iff [x,y] in R2
    proof
      let x,y be object;
      thus [x,y] in R1 implies [x,y] in R2
      proof
        assume B1: [x,y] in R1;
        then x in Seg m & y in Seg m by ZFMISC_1:87;
        then reconsider i = x, j = y as Nat;
        [i,j] in R1 by B1;
        then i in Seg m & j in Seg m & i <> j by A1;
        hence thesis by A1;
      end;
      assume B1: [x,y] in R2;
      then x in Seg m & y in Seg m by ZFMISC_1:87;
      then reconsider i = x, j = y as Nat;
      [i,j] in R2 by B1;
      then i in Seg m & j in Seg m & i <> j by A1;
      hence thesis by A1;
    end;
    hence thesis by RELAT_1:def 2;
  end;
  func CycRel m -> Relation of Seg m means
  :DefCycRel:
  for i,j being Nat holds [i,j] in it iff i in Seg m & j in Seg m &
    (j = csucc(m,i) or i = csucc(m,j));
  existence
  proof
    defpred P[object,object] means ex i,j being Nat st i = $1 & j = $2 &
      (j = csucc(m,i) or i = csucc(m,j));
    consider R being Relation of Seg m, Seg m such that
    A1: for x,y being object holds [x,y] in R iff x in Seg m & y in Seg m &
      P[x,y] from RELSET_1:sch 1;
    reconsider R as Relation of Seg m;
    take R;
    let i,j be Nat;
    thus [i,j] in R implies i in Seg m & j in Seg m &
      (j = csucc(m,i) or i = csucc(m,j))
    proof
      assume [i,j] in R;
      then i in Seg m & j in Seg m & P[i,j] by A1;
      hence thesis;
    end;
    thus thesis by A1;
  end;
  uniqueness
  proof
    let R1,R2 be Relation of Seg m;
    assume A1: (for i,j being Nat holds [i,j] in R1 iff i in Seg m &
      j in Seg m & (j = csucc(m,i) or i = csucc(m,j))) &
      (for i,j being Nat holds [i,j] in R2 iff i in Seg m &
      j in Seg m & (j = csucc(m,i) or i = csucc(m,j)));
    for x,y being object holds [x,y] in R1 iff [x,y] in R2
    proof
      let x,y be object;
      thus [x,y] in R1 implies [x,y] in R2
      proof
        assume B1: [x,y] in R1;
        then x in Seg m & y in Seg m by ZFMISC_1:87;
        then reconsider i = x, j = y as Nat;
        [i,j] in R1 by B1;
        then i in Seg m & j in Seg m & (j = csucc(m,i) or i = csucc(m,j))
          by A1;
        hence thesis by A1;
      end;
      assume B1: [x,y] in R2;
      then x in Seg m & y in Seg m by ZFMISC_1:87;
      then reconsider i = x, j = y as Nat;
      [i,j] in R2 by B1;
      then i in Seg m & j in Seg m & (j = csucc(m,i) or i = csucc(m,j))
        by A1;
      hence thesis by A1;
    end;
    hence thesis by RELAT_1:def 2;
  end;
end;

definition
  let m be Nat;
  func WRel m -> Relation of {0} \/ Seg m means
  :DefWRel:
  for i,j being Nat holds [i,j] in it iff
    (i in Seg m & j in Seg m & (j = csucc(m,i) or i = csucc(m,j))) or
    (i = 0 & j in Seg m) or (j = 0 & i in Seg m);
  existence
  proof
    set W = {0} \/ Seg m;
    defpred P[object,object] means ex i,j being Nat st i = $1 & j = $2 &
      ((i in Seg m & j in Seg m & (j = csucc(m,i) or i = csucc(m,j))) or
      (i = 0 & j in Seg m) or (j = 0 & i in Seg m));
    consider R being Relation of W, W such that
    A1: for x,y being object holds [x,y] in R iff x in W & y in W &
      P[x,y] from RELSET_1:sch 1;
    reconsider R as Relation of W;
    take R;
    let i,j be Nat;
    thus [i,j] in R implies
      (i in Seg m & j in Seg m & (j = csucc(m,i) or i = csucc(m,j))) or
      (i = 0 & j in Seg m) or (j = 0 & i in Seg m)
    proof
      assume [i,j] in R;
      then P[i,j] by A1;
      hence thesis;
    end;
    assume B1: (i in Seg m & j in Seg m & (j = csucc(m,i) or i = csucc(m,j)))
      or (i = 0 & j in Seg m) or (j = 0 & i in Seg m);
    0 in {0} by TARSKI:def 1;
    then i in W & j in W by B1, XBOOLE_0:def 3;
    hence thesis by A1, B1;
  end;
  uniqueness
  proof
    let R1,R2 be Relation of {0} \/ Seg m;
    assume A1: (for i,j being Nat holds [i,j] in R1 iff
      (i in Seg m & j in Seg m & (j = csucc(m,i) or i = csucc(m,j))) or
      (i = 0 & j in Seg m) or (j = 0 & i in Seg m)) &
      (for i,j being Nat holds [i,j] in R2 iff
      (i in Seg m & j in Seg m & (j = csucc(m,i) or i = csucc(m,j))) or
      (i = 0 & j in Seg m) or (j = 0 & i in Seg m));
    for x,y being object holds [x,y] in R1 iff [x,y] in R2
    proof
      let x,y be object;
      thus [x,y] in R1 implies [x,y] in R2
      proof
        assume B1: [x,y] in R1;
        then x in {0} \/ Seg m & y in {0} \/ Seg m by ZFMISC_1:87;
        then reconsider i = x, j = y as Nat;
        [i,j] in R1 by B1;
        then (i in Seg m & j in Seg m & (j = csucc(m,i) or i = csucc(m,j))) or
          (i = 0 & j in Seg m) or (j = 0 & i in Seg m) by A1;
        hence thesis by A1;
      end;
      assume B1: [x,y] in R2;
      then x in {0} \/ Seg m & y in {0} \/ Seg m by ZFMISC_1:87;
      then reconsider i = x, j = y as Nat;
      [i,j] in R2 by B1;
      then (i in Seg m & j in Seg m & (j = csucc(m,i) or i = csucc(m,j))) or
        (i = 0 & j in Seg m) or (j = 0 & i in Seg m) by A1;
      hence thesis by A1;
    end;
    hence thesis by RELAT_1:def 2;
  end;
end;

theorem ImgIff:
  for R being Relation, i,j being object holds j in R.:{i} iff [i,j] in R
proof
  let R be Relation, i,j be object;
  thus j in R.:{i} implies [i,j] in R
  proof
    assume j in R.:{i};
    then consider y being object such that A1: [y,j] in R & y in {i}
      by RELAT_1:def 13;
    thus thesis by A1, TARSKI:def 1;
  end;
  assume A2: [i,j] in R;
  i in {i} by TARSKI:def 1;
  hence thesis by A2, RELAT_1:def 13;
end;

theorem KImg:
  for m,i being Nat st i in Seg m holds (KRel m).:{i} = Seg m \ {i}
proof
  let m,i be Nat;
  assume A1: i in Seg m;
  for z being object holds z in (KRel m).:{i} iff z in Seg m \ {i}
  proof
    let z be object;
    thus z in (KRel m).:{i} implies z in Seg m \ {i}
    proof
      assume z in (KRel m).:{i};
      then B1: [i,z] in KRel m by ImgIff;
      then z in Seg m by ZFMISC_1:87;
      then reconsider j = z as Nat;
      j in Seg m & i <> j by B1, DefKRel;
      hence thesis by ZFMISC_1:56;
    end;
    assume B1: z in Seg m \ {i};
    then B2: z in Seg m & z <> i by ZFMISC_1:56;
    reconsider j = z as Nat by B1;
    [i,j] in KRel m by A1, B2, DefKRel;
    hence thesis by ImgIff;
  end;
  hence thesis by TARSKI:2;
end;

theorem CycImg:
  for m,i being Nat st i in Seg m holds
  (CycRel m).:{i} = {csucc(m,i), cpred(m,i)}
proof
  let m,i be Nat;
  assume A1: i in Seg m;
  for z being object holds z in (CycRel m).:{i} iff
    z = csucc(m,i) or z = cpred(m,i)
  proof
    let z be object;
    thus z in (CycRel m).:{i} implies z = csucc(m,i) or z = cpred(m,i)
    proof
      assume z in (CycRel m).:{i};
      then B1: [i,z] in CycRel m by ImgIff;
      then z in Seg m by ZFMISC_1:87;
      then reconsider j = z as Nat;
      B2: j in Seg m & (j = csucc(m,i) or i = csucc(m,j)) by B1, DefCycRel;
      per cases by B2;
      suppose j = csucc(m,i);
        hence thesis;
      end;
      suppose i = csucc(m,j);
        hence thesis by B2, CpredCsucc;
      end;
    end;
    assume B1: z = csucc(m,i) or z = cpred(m,i);
    per cases by B1;
    suppose B2: z = csucc(m,i);
      csucc(m,i) in Seg m by A1, CsuccIn;
      then [i,csucc(m,i)] in CycRel m by A1, DefCycRel;
      hence thesis by B2, ImgIff;
    end;
    suppose B2: z = cpred(m,i);
      B3: cpred(m,i) in Seg m by A1, CpredIn;
      i = csucc(m,cpred(m,i)) by A1, CpredCsucc;
      then [i,cpred(m,i)] in CycRel m by A1, B3, DefCycRel;
      hence thesis by B2, ImgIff;
    end;
  end;
  hence thesis by TARSKI:def 2;
end;

theorem WImg:
  for m,i being Nat st i in Seg m holds
  (WRel m).:{i} = {csucc(m,i), cpred(m,i)} \/ {0} & (WRel m).:{0} = Seg m
proof
  let m,i be Nat;
  assume A1: i in Seg m;
  A0: not 0 in Seg m by FINSEQ_1:1;
  A2: for z being object holds z in (WRel m).:{i} iff
    z = csucc(m,i) or z = cpred(m,i) or z = 0
  proof
    let z be object;
    thus z in (WRel m).:{i} implies z = csucc(m,i) or z = cpred(m,i) or z = 0
    proof
      assume z in (WRel m).:{i};
      then B1: [i,z] in WRel m by ImgIff;
      then z in {0} \/ Seg m by ZFMISC_1:87;
      then reconsider j = z as Nat;
      [i,j] in WRel m by B1;
      then B2: (i in Seg m & j in Seg m & (j = csucc(m,i) or
        i = csucc(m,j))) or (i = 0 & j in Seg m) or (j = 0 & i in Seg m)
        by DefWRel;
      per cases by A0, A1, B2;
      suppose j = csucc(m,i);
        hence thesis;
      end;
      suppose j in Seg m & i = csucc(m,j);
        hence thesis by CpredCsucc;
      end;
      suppose j = 0;
        hence thesis;
      end;
    end;
    assume B1: z = csucc(m,i) or z = cpred(m,i) or z = 0;
    per cases by B1;
    suppose B2: z = csucc(m,i);
      csucc(m,i) in Seg m by A1, CsuccIn;
      then [i,csucc(m,i)] in WRel m by A1, DefWRel;
      hence thesis by B2, ImgIff;
    end;
    suppose B2: z = cpred(m,i);
      B3: cpred(m,i) in Seg m by A1, CpredIn;
      i = csucc(m,cpred(m,i)) by A1, CpredCsucc;
      then [i,cpred(m,i)] in WRel m by A1, B3, DefWRel;
      hence thesis by B2, ImgIff;
    end;
    suppose B2: z = 0;
      [i,0] in WRel m by A1, DefWRel;
      hence thesis by B2, ImgIff;
    end;
  end;
  for z being object holds z in (WRel m).:{i} iff
    z in {csucc(m,i), cpred(m,i)} \/ {0}
  proof
    let z be object;
    z in {csucc(m,i), cpred(m,i)} \/ {0} iff
      z in {csucc(m,i), cpred(m,i)} or z in {0} by XBOOLE_0:def 3;
    then z in {csucc(m,i), cpred(m,i)} \/ {0} iff
      z = csucc(m,i) or z = cpred(m,i) or z = 0 by TARSKI:def 1,
      TARSKI:def 2;
    hence thesis by A2;
  end;
  hence (WRel m).:{i} = {csucc(m,i), cpred(m,i)} \/ {0} by TARSKI:2;
  for z being object holds z in (WRel m).:{0} iff z in Seg m
  proof
    let z be object;
    thus z in (WRel m).:{0} implies z in Seg m
    proof
      assume z in (WRel m).:{0};
      then B1: [0,z] in WRel m by ImgIff;
      then z in {0} \/ Seg m by ZFMISC_1:87;
      then reconsider j = z as Nat;
      [0,j] in WRel m by B1;
      then (0 in Seg m & j in Seg m & (j = csucc(m,0) or 0 = csucc(m,j))) or
        (0 = 0 & j in Seg m) or (j = 0 & 0 in Seg m) by DefWRel;
      hence thesis by A0;
    end;
    assume B1: z in Seg m;
    then reconsider j = z as Nat;
    [0,j] in WRel m by B1, DefWRel;
    hence thesis by ImgIff;
  end;
  hence thesis by TARSKI:2;
end;

:: Section 5: cycle suns and wheel suns. The labeling of the appendix:
:: f(u_i) = 2 for odd i, 1 for even i; f(v_1) = 2 if m is odd, all other
:: f(v_j) = 1.

theorem OddEven:
  for i being Nat holds (i is odd implies i + 1 is even) &
  (i is even implies i + 1 is odd) & 1 is odd & 2 is even
proof
  let i be Nat;
  2 * 0 is even & 2 * 1 is even;
  then 0 + 1 is odd & 2 is even;
  hence thesis;
end;

theorem CsuccPar:
  for m,i being Nat st i in Seg m holds
  (i < m implies csucc(m,i) = i + 1) & (i = m implies csucc(m,i) = 1) &
  (1 < i implies cpred(m,i) = i - 1) & (i = 1 implies cpred(m,i) = m)
proof
  let m,i be Nat;
  assume i in Seg m;
  then A1: 1 <= i & i <= m by FINSEQ_1:1;
  thus i < m implies csucc(m,i) = i + 1 by DefCsucc;
  thus i = m implies csucc(m,i) = 1 by DefCsucc;
  thus 1 < i implies cpred(m,i) = i - 1
  proof
    assume B1: 1 < i;
    then cpred(m,i) = i -' 1 by DefCpred;
    hence thesis by B1, XREAL_1:233;
  end;
  thus thesis by DefCpred;
end;

theorem SunDegU:
  for m,i being Nat st G is_sun_of m,B,R & R c= [:B,B:] & 3 <= m &
  i in Seg m holds
  for Ri being finite set st Ri = R.:{i} holds
  for x being Element of G st x = [0,i] holds deg x = card Ri + 2
proof
  let m,i be Nat;
  assume A1: G is_sun_of m,B,R & R c= [:B,B:] & 3 <= m & i in Seg m;
  let Ri be finite set;
  assume A2: Ri = R.:{i};
  let x be Element of G;
  assume A3: x = [0,i];
  set D = {i, cpred(m,i)};
  A4: {j where j is Nat: i in Seg m & (j = i or j = cpred(m,i))} = D
    by A1, SunD;
  A5: Nb x = [:{0},Ri:] \/ [:{1},D:] by A1, A2, A3, A4, SunNbU;
  {0} misses {1} by ZFMISC_1:11;
  then [:{0},Ri:] misses [:{1},D:] by ZFMISC_1:104;
  then A6: deg x = card [:{0},Ri:] + card [:{1},D:] by A5, CARD_2:40;
  A7: card [:{0},Ri:] = card Ri by CardSide;
  2 <= m by A1, XXREAL_0:2;
  then cpred(m,i) <> i by A1, CsuccNe;
  then card D = 2 by CARD_2:57;
  hence thesis by A6, A7, CardSide;
end;

:: Proposition 5, cycle suns: eta(CS_m) = 2 for m >= 4

theorem CsFacts:
  for m being Nat, fu,fv being Function of NAT, NAT st 4 <= m &
  (for i being Nat holds (i is odd implies fu.i = 2) &
    (not i is odd implies fu.i = 1)) &
  (for i being Nat holds (i = 1 & m is odd implies fv.i = 2) &
    (not (i = 1 & m is odd) implies fv.i = 1))
  holds
  (for i being Nat st i in Seg m holds
    fu.(csucc(m,i)) + fu.(cpred(m,i)) + fv.i + fv.(cpred(m,i)) <>
    fu.(csucc(m,csucc(m,i))) + fu.(cpred(m,csucc(m,i))) + fv.(csucc(m,i)) +
    fv.(cpred(m,csucc(m,i)))) &
  (for i being Nat st i in Seg m holds
    4 <= fu.(csucc(m,i)) + fu.(cpred(m,i)) + fv.i + fv.(cpred(m,i)) &
    fu.(csucc(m,i)) + fu.(cpred(m,i)) + fv.i + fv.(cpred(m,i)) <= 7) &
  (for i being Nat st i in Seg m & m is even holds
    fu.(csucc(m,i)) + fu.(cpred(m,i)) + fv.i + fv.(cpred(m,i)) = 4 or
    fu.(csucc(m,i)) + fu.(cpred(m,i)) + fv.i + fv.(cpred(m,i)) = 6) &
  (for j being Nat st j in Seg m holds
    fu.j + fu.(csucc(m,j)) <
      fu.(csucc(m,j)) + fu.(cpred(m,j)) + fv.j + fv.(cpred(m,j)) &
    fu.j + fu.(csucc(m,j)) <
      fu.(csucc(m,csucc(m,j))) + fu.(cpred(m,csucc(m,j))) +
      fv.(csucc(m,j)) + fv.(cpred(m,csucc(m,j))))
proof
  let m be Nat, fu,fv be Function of NAT, NAT;
  defpred Po[Nat] means $1 is odd;
  defpred Pv[Nat] means $1 = 1 & m is odd;
  assume that
  A1: 4 <= m and
  A2: for i being Nat holds (Po[i] implies fu.i = 2) &
    (not Po[i] implies fu.i = 1) and
  A3: for i being Nat holds (Pv[i] implies fv.i = 2) &
    (not Pv[i] implies fv.i = 1);
  A0: 3 <= m by A1, XXREAL_0:2;
  A7: 1 is odd & 2 is even & m - 1 <> 1 by A1, OddEven;
  :: the sums: SU(i) = f(N(u_i)) and SV(j) = f(N(v_j))
  deffunc SU(Nat) = fu.(csucc(m,$1)) + fu.(cpred(m,$1)) + fv.$1 +
    fv.(cpred(m,$1));
  deffunc SV(Nat) = fu.$1 + fu.(csucc(m,$1));
  :: values of SU
  A10: for i being Nat st 1 < i & i < m holds
    (i is odd implies SU(i) = 4) &
    (i is even & not (i = 2 & m is odd) implies SU(i) = 6) &
    (i = 2 & m is odd implies SU(i) = 7)
  proof
    let i be Nat;
    assume B1: 1 < i & i < m;
    then i in Seg m by FINSEQ_1:1;
    then B2: csucc(m,i) = i + 1 & cpred(m,i) = i - 1 by B1, CsuccPar;
    reconsider k = i - 1 as Nat by B1, NAT_1:21;
    B3: i = k + 1;
    B4: fv.i = 1 by A3, B1;
    thus i is odd implies SU(i) = 4
    proof
      assume i is odd;
      then i + 1 is even & k is even by B3, OddEven;
      then B5: fu.(i + 1) = 1 & fu.k = 1 & k <> 1 by A2, A7;
      then fv.k = 1 by A3;
      hence thesis by B2, B4, B5;
    end;
    thus i is even & not (i = 2 & m is odd) implies SU(i) = 6
    proof
      assume B5: i is even & not (i = 2 & m is odd);
      then i + 1 is odd & k is odd by B3, OddEven;
      then B6: fu.(i + 1) = 2 & fu.k = 2 by A2;
      not (k = 1 & m is odd) by B3, B5;
      then fv.k = 1 by A3;
      hence thesis by B2, B4, B6;
    end;
    assume B5: i = 2 & m is odd;
    then fu.(i + 1) = 2 & fu.k = 2 & fv.k = 2 by A2, A3, A7;
    hence thesis by B2, B4;
  end;
  A11: (m is odd implies SU(1) = 6) & (m is even implies SU(1) = 4)
  proof
    1 <= m by A0, XXREAL_0:2;
    then B1: 1 in Seg m by FINSEQ_1:1;
    1 < m by A0, XXREAL_0:2;
    then B2: csucc(m,1) = 1 + 1 & cpred(m,1) = m by B1, CsuccPar;
    not Po[2] & not Pv[m] by A0, A7;
    then B3: fu.2 = 1 & fv.m = 1 by A2, A3;
    thus m is odd implies SU(1) = 6
    proof
      assume m is odd;
      then fu.m = 2 & fv.1 = 2 by A2, A3;
      hence thesis by B2, B3;
    end;
    assume m is even;
    then fu.m = 1 & fv.1 = 1 by A2, A3;
    hence thesis by B2, B3;
  end;
  A12: (m is odd implies SU(m) = 5) & (m is even implies SU(m) = 6)
  proof
    1 <= m by A0, XXREAL_0:2;
    then B1: m in Seg m by FINSEQ_1:1;
    1 < m by A0, XXREAL_0:2;
    then B2: csucc(m,m) = 1 & cpred(m,m) = m - 1 by B1, CsuccPar;
    reconsider k = m - 1 as Nat by A0, NAT_1:21, XXREAL_0:2;
    B3: m = k + 1;
    Po[1] & not Pv[m] & not Pv[k] by A0, A7;
    then B4: fu.1 = 2 & fv.m = 1 & fv.k = 1 by A2, A3;
    thus m is odd implies SU(m) = 5
    proof
      assume m is odd;
      then k is even by B3, OddEven;
      then fu.k = 1 by A2;
      hence thesis by B2, B4;
    end;
    assume m is even;
    then k is odd by B3, OddEven;
    then fu.k = 2 by A2;
    hence thesis by B2, B4;
  end;
  A13: 1 < m & 1 + 1 < m by A0, XXREAL_0:2;
  A13a: 2 is even & not (2 = 1) by OddEven;
  A10b: for i being Nat st 1 < i & i < m & i is even holds
    SU(i) = 6 or SU(i) = 7
  proof
    let i be Nat;
    assume B1: 1 < i & i < m & i is even;
    per cases;
    suppose i = 2 & m is odd;
      hence thesis by A10, B1;
    end;
    suppose not (i = 2 & m is odd);
      hence thesis by A10, B1;
    end;
  end;
  :: f(N(u_i)) differs from f(N(u_(i+1)))
  A14: for i being Nat st i in Seg m holds SU(i) <> SU(csucc(m,i))
  proof
    let i be Nat;
    assume B1: i in Seg m;
    then B2: 1 <= i & i <= m by FINSEQ_1:1;
    per cases by B2, XXREAL_0:1;
    suppose B3: i = m;
      then csucc(m,i) = 1 by B1, CsuccPar;
      hence thesis by A11, A12, B3;
    end;
    suppose B3: i < m;
      then B4: csucc(m,i) = i + 1 by B1, CsuccPar;
      per cases by B2, XXREAL_0:1;
      suppose B5: i = 1;
        per cases;
        suppose B6: m is odd;
          then SU(1 + 1) = 7 by A10, A13;
          hence thesis by A11, B4, B5, B6;
        end;
        suppose B6: m is even;
          then SU(1 + 1) = 6 by A10, A13, A13a;
          hence thesis by A11, B4, B5, B6;
        end;
      end;
      suppose B5: 1 < i;
        B6: i + 1 <= m by B3, NAT_1:13;
        per cases by B6, XXREAL_0:1;
        suppose B7: i + 1 = m;
          per cases;
          suppose B8: m is odd;
            then B9: i is even by B7, OddEven;
            i <> 2 by A1, B7;
            then not (i = 2 & m is odd);
            then SU(i) = 6 by A10, B3, B5, B9;
            hence thesis by A12, B4, B7, B8;
          end;
          suppose B8: m is even;
            then i is odd by B7, OddEven;
            then SU(i) = 4 by A10, B3, B5;
            hence thesis by A12, B4, B7, B8;
          end;
        end;
        suppose B7: i + 1 < m;
          B8: 1 < i + 1 by B5, NAT_1:13;
          per cases;
          suppose i is odd;
            then B9: SU(i) = 4 & i + 1 is even by A10, B3, B5, OddEven;
            then SU(i + 1) = 6 or SU(i + 1) = 7 by A10b, B7, B8;
            hence thesis by B4, B9;
          end;
          suppose B10: i is even;
            then i + 1 is odd by OddEven;
            then B9: SU(i + 1) = 4 by A10, B7, B8;
            SU(i) = 6 or SU(i) = 7 by A10b, B3, B5, B10;
            hence thesis by B4, B9;
          end;
        end;
      end;
    end;
  end;
  :: f(N(u_i)) >= 4, and f(N(v_j)) is 3, or 4 at v_m when m is odd
  A15: for i being Nat st i in Seg m holds 4 <= SU(i)
  proof
    let i be Nat;
    assume i in Seg m;
    then B1: 1 <= i & i <= m by FINSEQ_1:1;
    per cases by B1, XXREAL_0:1;
    suppose i = 1;
      then SU(i) = 6 or SU(i) = 4 by A11;
      hence thesis;
    end;
    suppose i = m;
      then SU(i) = 5 or SU(i) = 6 by A12;
      hence thesis;
    end;
    suppose B2: 1 < i & i < m;
      i is odd or (i is even & not (i = 2 & m is odd)) or
        (i = 2 & m is odd);
      then SU(i) = 4 or SU(i) = 6 or SU(i) = 7 by A10, B2;
      hence thesis;
    end;
  end;
  A16: for j being Nat st j in Seg m holds
    SV(j) < SU(j) & SV(j) < SU(csucc(m,j))
  proof
    let j be Nat;
    assume B1: j in Seg m;
    then B2: 1 <= j & j <= m by FINSEQ_1:1;
    B3: csucc(m,j) in Seg m by B1, CsuccIn;
    per cases by B2, XXREAL_0:1;
    suppose B4: j < m;
      then B5: csucc(m,j) = j + 1 by B1, CsuccPar;
      B6: SV(j) = 3
      proof
        per cases;
        suppose C1: j is odd;
          then j + 1 is even by OddEven;
          then C2: fu.(j + 1) = 1 by A2;
          fu.j = 2 by A2, C1;
          hence thesis by B5, C2;
        end;
        suppose C1: j is even;
          then j + 1 is odd by OddEven;
          then C2: fu.(j + 1) = 2 by A2;
          fu.j = 1 by A2, C1;
          hence thesis by B5, C2;
        end;
      end;
      4 <= SU(j) & 4 <= SU(csucc(m,j)) by A15, B1, B3;
      hence thesis by B6, XXREAL_0:2;
    end;
    suppose B4: j = m;
      then B5: csucc(m,j) = 1 by B1, CsuccPar;
      B6: fu.1 = 2 by A2, A7;
      per cases;
      suppose B7: m is odd;
        then SV(j) = 2 + 2 by A2, B4, B5, B6;
        hence thesis by A11, A12, B4, B5, B7;
      end;
      suppose B7: m is even;
        then SV(j) = 1 + 2 by A2, B4, B5, B6;
        then SV(j) < 4 & 4 <= SU(j) & 4 <= SU(csucc(m,j)) by A15, B1, B3;
        hence thesis by XXREAL_0:2;
      end;
    end;
  end;
  thus for i being Nat st i in Seg m holds SU(i) <> SU(csucc(m,i)) by A14;
  thus for i being Nat st i in Seg m holds 4 <= SU(i) & SU(i) <= 7
  proof
    let i be Nat;
    assume B0: i in Seg m;
    then B1: 1 <= i & i <= m by FINSEQ_1:1;
    thus 4 <= SU(i) by A15, B0;
    per cases by B1, XXREAL_0:1;
    suppose i = 1;
      then SU(i) = 6 or SU(i) = 4 by A11;
      hence thesis;
    end;
    suppose i = m;
      then SU(i) = 5 or SU(i) = 6 by A12;
      hence thesis;
    end;
    suppose B2: 1 < i & i < m;
      i is odd or (i is even & not (i = 2 & m is odd)) or
        (i = 2 & m is odd);
      then SU(i) = 4 or SU(i) = 6 or SU(i) = 7 by A10, B2;
      hence thesis;
    end;
  end;
  thus for i being Nat st i in Seg m & m is even holds SU(i) = 4 or SU(i) = 6
  proof
    let i be Nat;
    assume B0: i in Seg m & m is even;
    then B1: 1 <= i & i <= m by FINSEQ_1:1;
    per cases by B1, XXREAL_0:1;
    suppose i = 1;
      hence thesis by A11, B0;
    end;
    suppose i = m;
      hence thesis by A12, B0;
    end;
    suppose B2: 1 < i & i < m;
      i is odd or (i is even & not (i = 2 & m is odd)) by B0;
      hence thesis by A10, B2;
    end;
  end;
  thus thesis by A16;
end;

theorem Proposition5Cycle:
  for m being Nat st 4 <= m & G is_sun_of m, Seg m, CycRel m holds
  eta G = 2
proof
  let m be Nat;
  assume A1: 4 <= m & G is_sun_of m, Seg m, CycRel m;
  set C = the carrier of G, R = CycRel m;
  reconsider B = Seg m as Subset of NAT;
  A0: 3 <= m by A1, XXREAL_0:2;
  A0a: R c= [:B,B:];
  defpred Po[Nat] means $1 is odd;
  defpred Pv[Nat] means $1 = 1 & m is odd;
  deffunc F2(Nat) = 2;
  deffunc F1(Nat) = 1;
  consider fu being Function of NAT, NAT such that
  A2: for i being Nat holds (Po[i] implies fu.i = F2(i)) &
    (not Po[i] implies fu.i = F1(i)) from NatCases;
  consider fv being Function of NAT, NAT such that
  A3: for i being Nat holds (Pv[i] implies fv.i = F2(i)) &
    (not Pv[i] implies fv.i = F1(i)) from NatCases;
  consider f such that
  A4: (for j being Nat st j in B holds f.[0,j] = fu.j) &
    (for j being Nat st j in Seg m holds f.[1,j] = fv.j) by A1, SunLab;
  A5: for j being Nat holds 1 <= fu.j & fu.j <= 2 & 1 <= fv.j & fv.j <= 2
  proof
    let j be Nat;
    B1: fu.j = 2 or fu.j = 1
    proof
      Po[j] or not Po[j];
      hence thesis by A2;
    end;
    fv.j = 2 or fv.j = 1
    proof
      Pv[j] or not Pv[j];
      hence thesis by A3;
    end;
    hence thesis by B1;
  end;
  A6a: for j being Nat st j in B holds f.[0,j] = fu.j & 1 <= fu.j &
    fu.j <= 2 by A4, A5;
  for j being Nat st j in Seg m holds f.[1,j] = fv.j & 1 <= fv.j &
    fv.j <= 2 by A4, A5;
  then A6: f is 2-labeling by A1, A6a, SunLabeling;
  A7: 1 is odd & 2 is even & m - 1 <> 1 by A1, OddEven;
  :: the sums: SU(i) = f(N(u_i)) and SV(j) = f(N(v_j))
  deffunc SU(Nat) = fu.(csucc(m,$1)) + fu.(cpred(m,$1)) + fv.$1 +
    fv.(cpred(m,$1));
  deffunc SV(Nat) = fu.$1 + fu.(csucc(m,$1));
  A8: for i being Nat, x being Element of G st i in Seg m & x = [0,i] holds
    SumN(f,x) = SU(i)
  proof
    let i be Nat, x be Element of G;
    assume B1: i in Seg m & x = [0,i];
    csucc(m,i) in NAT & cpred(m,i) in NAT by ORDINAL1:def 12;
    then reconsider Ri = {csucc(m,i), cpred(m,i)} as finite Subset of NAT
      by ZFMISC_1:32;
    B2: Ri = R.:{i} by B1, CycImg;
    B3: SumN(f,x) = Sum(fu|Ri) + fv.i + fv.(cpred(m,i))
      by A0, A1, A4, B1, B2, SunSums;
    csucc(m,i) <> cpred(m,i) by A0, B1, CsuccNeCpred;
    then Sum(fu|Ri) = fu.(csucc(m,i)) + fu.(cpred(m,i)) by SumPair;
    hence thesis by B3;
  end;
  A9: for j being Nat, y being Element of G st j in Seg m & y = [1,j] holds
    SumN(f,y) = SV(j) by A0, A1, A4, SunSums;
  A14a: (for i being Nat st i in Seg m holds
    fu.(csucc(m,i)) + fu.(cpred(m,i)) + fv.i + fv.(cpred(m,i)) <>
    fu.(csucc(m,csucc(m,i))) + fu.(cpred(m,csucc(m,i))) +
    fv.(csucc(m,i)) + fv.(cpred(m,csucc(m,i)))) &
    (for i being Nat st i in Seg m holds
    4 <= fu.(csucc(m,i)) + fu.(cpred(m,i)) + fv.i + fv.(cpred(m,i)) &
    fu.(csucc(m,i)) + fu.(cpred(m,i)) + fv.i + fv.(cpred(m,i)) <= 7) &
    (for i being Nat st i in Seg m & m is even holds
    fu.(csucc(m,i)) + fu.(cpred(m,i)) + fv.i + fv.(cpred(m,i)) = 4 or
    fu.(csucc(m,i)) + fu.(cpred(m,i)) + fv.i + fv.(cpred(m,i)) = 6) &
    (for j being Nat st j in Seg m holds
    fu.j + fu.(csucc(m,j)) <
    fu.(csucc(m,j)) + fu.(cpred(m,j)) + fv.j + fv.(cpred(m,j)) &
    fu.j + fu.(csucc(m,j)) <
    fu.(csucc(m,csucc(m,j))) + fu.(cpred(m,csucc(m,j))) +
    fv.(csucc(m,j)) + fv.(cpred(m,csucc(m,j)))) by A1, A2, A3, CsFacts;
  A13: 1 < m & 1 + 1 < m by A0, XXREAL_0:2;
  A14: for i being Nat st i in Seg m holds SU(i) <> SU(csucc(m,i))
    by A14a;
  A16: for j being Nat st j in Seg m holds
    SV(j) < SU(j) & SV(j) < SU(csucc(m,j)) by A14a;
  for x,y being Element of G, i,j being Nat st [i,j] in R &
    x = [0,i] & y = [0,j] holds SumN(f,x) <> SumN(f,y)
  proof
    let x,y be Element of G, i,j be Nat;
    assume B1: [i,j] in R & x = [0,i] & y = [0,j];
    then B2: i in Seg m & j in Seg m & (j = csucc(m,i) or i = csucc(m,j))
      by DefCycRel;
    B3: SumN(f,x) = SU(i) & SumN(f,y) = SU(j) by A8, B1, B2;
    SU(i) <> SU(j) by A14, B2;
    hence thesis by B3;
  end;
  then A17: for x,y being Element of G, i,j being Nat st [i,j] in R &
    x = [0,i] & y = [0,j] holds SumN(f,x) <> SumN(f,y);
  for x,y being Element of G, i,j being Nat st i in Seg m &
    (j = i or j = cpred(m,i)) & x = [0,i] & y = [1,j] holds
    SumN(f,x) <> SumN(f,y)
  proof
    let x,y be Element of G, i,j be Nat;
    assume B1: i in Seg m & (j = i or j = cpred(m,i)) & x = [0,i] &
      y = [1,j];
    then B2: j in Seg m by CpredIn;
    B3: SumN(f,x) = SU(i) & SumN(f,y) = SV(j) by A8, A9, B1, B2;
    per cases by B1;
    suppose j = i;
      hence thesis by A16, B1, B3;
    end;
    suppose j = cpred(m,i);
      then i = csucc(m,j) by B1, CpredCsucc;
      hence thesis by A16, B2, B3;
    end;
  end;
  then A18: f is additive by A1, A17, SunAdditive;
  :: u_1 and u_2 are adjacent and have degree 4
  1 <= m by A0, XXREAL_0:2;
  then A19: 1 in Seg m & 2 in Seg m by A13, FINSEQ_1:1;
  then [0,1] in [:{0},B:] & [0,2] in [:{0},B:] by PairSide;
  then [0,1] in [:{0},B:] \/ [:{1},Seg m:] &
    [0,2] in [:{0},B:] \/ [:{1},Seg m:] by XBOOLE_0:def 3;
  then reconsider u1 = [0,1], u2 = [0,2] as Element of G by A1, DefSun;
  csucc(m,1) = 1 + 1 by A13, A19, CsuccPar;
  then [1,2] in R by A19, DefCycRel;
  then [u1,u2] in the InternalRel of G by A1, DefSun;
  then A20: u1,u2 are_adjacent;
  A21: for i being Nat, x being Element of G st i in Seg m & x = [0,i] holds
    deg x = 4
  proof
    let i be Nat, x be Element of G;
    assume B1: i in Seg m & x = [0,i];
    reconsider Ri = {csucc(m,i), cpred(m,i)} as finite set;
    B2: Ri = R.:{i} by B1, CycImg;
    csucc(m,i) <> cpred(m,i) by A0, B1, CsuccNeCpred;
    then card Ri = 2 by CARD_2:57;
    then deg x = 2 + 2 by A0, A0a, A1, B1, B2, SunDegU;
    hence thesis;
  end;
  deg u1 = 4 & deg u2 = 4 by A19, A21;
  hence thesis by A6, A18, A20, EtaEq2;
end;

:: Wheel suns: the hub is u_0 = [0,0]

theorem WheelSums:
  for m being Nat, fu,fv being Function of NAT, NAT st 4 <= m &
  G is_sun_of m, {0} \/ Seg m, WRel m &
  (for j being Nat st j in {0} \/ Seg m holds f.[0,j] = fu.j) &
  (for j being Nat st j in Seg m holds f.[1,j] = fv.j)
  holds
  (for i being Nat, x being Element of G st i in Seg m & x = [0,i] holds
    SumN(f,x) = fu.(csucc(m,i)) + fu.(cpred(m,i)) + fu.0 + fv.i +
    fv.(cpred(m,i)) & deg x = 5) &
  (for x being Element of G st x = [0,0] holds
    for S being finite Subset of NAT st S = Seg m holds SumN(f,x) = Sum(fu|S))
  & (for j being Nat, y being Element of G st j in Seg m & y = [1,j] holds
    SumN(f,y) = fu.j + fu.(csucc(m,j)))
proof
  let m be Nat, fu,fv be Function of NAT, NAT;
  assume that
  A1: 4 <= m & G is_sun_of m, {0} \/ Seg m, WRel m and
  A2: for j being Nat st j in {0} \/ Seg m holds f.[0,j] = fu.j and
  A3: for j being Nat st j in Seg m holds f.[1,j] = fv.j;
  0 in NAT;
  then {0} c= NAT by ZFMISC_1:31;
  then reconsider B = {0} \/ Seg m as Subset of NAT by XBOOLE_1:8;
  A0: 3 <= m by A1, XXREAL_0:2;
  A4: WRel m c= [:B,B:];
  Seg m c= B by XBOOLE_1:7;
  then A5: (for j being Nat, y being Element of G st j in Seg m & y = [1,j]
    holds SumN(f,y) = fu.j + fu.(csucc(m,j))) &
    (for i being Nat, x being Element of G, Ri being finite Subset of NAT st
    i in Seg m & x = [0,i] & Ri = (WRel m).:{i} holds
    SumN(f,x) = Sum(fu|Ri) + fv.i + fv.(cpred(m,i))) &
    (for i being Nat, x being Element of G, Ri being finite Subset of NAT st
    not i in Seg m & x = [0,i] & Ri = (WRel m).:{i} holds
    SumN(f,x) = Sum(fu|Ri)) by A0, A1, A2, A3, A4, SunSums;
  A6: not 0 in Seg m by FINSEQ_1:1;
  thus for i being Nat, x being Element of G st i in Seg m & x = [0,i] holds
    SumN(f,x) = fu.(csucc(m,i)) + fu.(cpred(m,i)) + fu.0 + fv.i +
    fv.(cpred(m,i)) & deg x = 5
  proof
    let i be Nat, x be Element of G;
    assume B1: i in Seg m & x = [0,i];
    B2: csucc(m,i) in Seg m & cpred(m,i) in Seg m by B1, CsuccIn, CpredIn;
    then csucc(m,i) in NAT & cpred(m,i) in NAT;
    then reconsider P2 = {csucc(m,i), cpred(m,i)} as finite Subset of NAT
      by ZFMISC_1:32;
    0 in NAT;
    then {0} c= NAT by ZFMISC_1:31;
    then reconsider Ri = P2 \/ {0} as finite Subset of NAT by XBOOLE_1:8;
    B3: Ri = (WRel m).:{i} by B1, WImg;
    B4: csucc(m,i) <> cpred(m,i) by A0, B1, CsuccNeCpred;
    B5: not 0 in P2 by A6, B2, TARSKI:def 2;
    0 in NAT;
    then B6: Sum(fu|Ri) = Sum(fu|P2) + fu.0 by B5, SumAdd1;
    Sum(fu|P2) = fu.(csucc(m,i)) + fu.(cpred(m,i)) by B4, SumPair;
    hence SumN(f,x) = fu.(csucc(m,i)) + fu.(cpred(m,i)) + fu.0 + fv.i +
      fv.(cpred(m,i)) by A5, B1, B3, B6;
    card P2 = 2 by B4, CARD_2:57;
    then card Ri = 2 + 1 by B5, CARD_2:41;
    then deg x = 3 + 2 by A0, A1, A4, B1, B3, SunDegU;
    hence thesis;
  end;
  thus for x being Element of G st x = [0,0] holds
    for S being finite Subset of NAT st S = Seg m holds SumN(f,x) = Sum(fu|S)
  proof
    let x be Element of G;
    assume B1: x = [0,0];
    let S be finite Subset of NAT;
    assume B2: S = Seg m;
    1 <= m by A0, XXREAL_0:2;
    then 1 in Seg m by FINSEQ_1:1;
    then (WRel m).:{0} = Seg m by WImg;
    hence thesis by A5, A6, B1, B2;
  end;
  thus thesis by A5;
end;

theorem SumParity:
  for fu being Function of NAT, NAT st
  (for i being Nat holds (i is odd implies fu.i = 2) &
    (not i is odd implies fu.i = 1))
  holds for n being Nat, S being finite Subset of NAT st S = Seg n holds
  (n is even implies 2 * Sum(fu|S) = 3 * n) &
  (n is odd implies 2 * Sum(fu|S) = 3 * n + 1)
proof
  let fu be Function of NAT, NAT;
  assume A1: for i being Nat holds (i is odd implies fu.i = 2) &
    (not i is odd implies fu.i = 1);
  defpred P[Nat] means for S being finite Subset of NAT st S = Seg $1 holds
    ($1 is even implies 2 * Sum(fu|S) = 3 * $1) &
    ($1 is odd implies 2 * Sum(fu|S) = 3 * $1 + 1);
  A2: P[0]
  proof
    let S be finite Subset of NAT;
    assume S = Seg 0;
    then B1: Sum(fu|S) = 0 by SumEmpty;
    2 * 0 is even;
    hence thesis by B1;
  end;
  A3: for n being Nat st P[n] holds P[n+1]
  proof
    let n be Nat;
    assume B0: P[n];
    let S be finite Subset of NAT;
    assume B1: S = Seg (n+1);
    reconsider Sn = Seg n as finite Subset of NAT;
    B2: S = Sn \/ {n+1} by B1, FINSEQ_1:9;
    n + 1 > n by NAT_1:13;
    then B3: not n + 1 in Sn by FINSEQ_1:1;
    n + 1 in NAT by ORDINAL1:def 12;
    then B4: Sum(fu|S) = Sum(fu|Sn) + fu.(n+1) by B2, B3, SumAdd1;
    per cases;
    suppose B5: n is even;
      then B6: n + 1 is odd by OddEven;
      then fu.(n+1) = 2 by A1;
      then 2 * Sum(fu|S) = 2 * Sum(fu|Sn) + 4 by B4
      .= 3 * n + 4 by B0, B5;
      hence thesis by B6;
    end;
    suppose B5: n is odd;
      then B6: n + 1 is even by OddEven;
      then fu.(n+1) = 1 by A1;
      then 2 * Sum(fu|S) = 2 * Sum(fu|Sn) + 2 by B4
      .= 3 * n + 1 + 2 by B0, B5;
      hence thesis by B6;
    end;
  end;
  A4: for n being Nat holds P[n] from NAT_1:sch 2(A2, A3);
  let n be Nat, S be finite Subset of NAT;
  assume S = Seg n;
  hence thesis by A4;
end;

theorem Seg5:
  for i being Nat st i in Seg 5 holds i = 1 or i = 2 or i = 3 or i = 4 or
  i = 5
proof
  let i be Nat;
  assume i in Seg 5;
  then A1: 1 <= i & i <= 5 by FINSEQ_1:1;
  assume A2: not thesis;
  then i < 4 + 1 by A1, XXREAL_0:1;
  then i <= 4 by NAT_1:13;
  then i < 3 + 1 by A2, XXREAL_0:1;
  then i <= 3 by NAT_1:13;
  then i < 2 + 1 by A2, XXREAL_0:1;
  then i <= 2 by NAT_1:13;
  then i < 1 + 1 by A2, XXREAL_0:1;
  then i <= 1 by NAT_1:13;
  hence contradiction by A1, A2, XXREAL_0:1;
end;

theorem WheelAdj:
  for m being Nat st 4 <= m & G is_sun_of m, {0} \/ Seg m, WRel m holds
  ex u1,u2 being Element of G st u1 = [0,1] & u2 = [0,2] &
  u1,u2 are_adjacent & deg u1 = 5 & deg u2 = 5
proof
  let m be Nat;
  assume A1: 4 <= m & G is_sun_of m, {0} \/ Seg m, WRel m;
  0 in NAT;
  then {0} c= NAT by ZFMISC_1:31;
  then reconsider B = {0} \/ Seg m as Subset of NAT by XBOOLE_1:8;
  A0: 3 <= m by A1, XXREAL_0:2;
  A2: WRel m c= [:B,B:];
  A3: not 0 in Seg m by FINSEQ_1:1;
  A4: 1 < m & 1 + 1 < m by A0, XXREAL_0:2;
  1 <= m by A0, XXREAL_0:2;
  then A5: 1 in Seg m & 2 in Seg m by A4, FINSEQ_1:1;
  then 1 in B & 2 in B by XBOOLE_0:def 3;
  then [0,1] in [:{0},B:] & [0,2] in [:{0},B:] by PairSide;
  then [0,1] in [:{0},B:] \/ [:{1},Seg m:] &
    [0,2] in [:{0},B:] \/ [:{1},Seg m:] by XBOOLE_0:def 3;
  then reconsider u1 = [0,1], u2 = [0,2] as Element of G by A1, DefSun;
  A6: for i being Nat, x being Element of G st i in Seg m & x = [0,i] holds
    deg x = 5
  proof
    let i be Nat, x be Element of G;
    assume B1: i in Seg m & x = [0,i];
    B2: csucc(m,i) in Seg m & cpred(m,i) in Seg m by B1, CsuccIn, CpredIn;
    reconsider P2 = {csucc(m,i), cpred(m,i)} as finite set;
    reconsider Ri = P2 \/ {0} as finite set;
    B3: Ri = (WRel m).:{i} by B1, WImg;
    B4: csucc(m,i) <> cpred(m,i) by A0, B1, CsuccNeCpred;
    B5: not 0 in P2 by A3, B2, TARSKI:def 2;
    card P2 = 2 by B4, CARD_2:57;
    then card Ri = 2 + 1 by B5, CARD_2:41;
    then deg x = 3 + 2 by A0, A1, A2, B1, B3, SunDegU;
    hence thesis;
  end;
  take u1, u2;
  csucc(m,1) = 1 + 1 by A4, A5, CsuccPar;
  then [1,2] in WRel m by A5, DefWRel;
  then [u1,u2] in the InternalRel of G by A1, DefSun;
  hence thesis by A5, A6;
end;

theorem SumSegSucc:
  for g being Function of NAT, NAT, n being Nat,
  S,S1 being finite Subset of NAT st S = Seg n & S1 = Seg (n+1) holds
  Sum(g|S1) = Sum(g|S) + g.(n+1)
proof
  let g be Function of NAT, NAT, n be Nat, S,S1 be finite Subset of NAT;
  assume A1: S = Seg n & S1 = Seg (n+1);
  then A2: S1 = S \/ {n+1} by FINSEQ_1:9;
  n + 1 > n by NAT_1:13;
  then A3: not n + 1 in S by A1, FINSEQ_1:1;
  n + 1 in NAT by ORDINAL1:def 12;
  hence thesis by A2, A3, SumAdd1;
end;

:: Proposition 5, wheel suns: eta(WS_m) = 2 for m >= 4. For m <> 5 the
:: labeling of CS_m with f(w) = 1; for m = 5 a special labeling.

theorem Proposition5Wheel:
  for m being Nat st 4 <= m & G is_sun_of m, {0} \/ Seg m, WRel m holds
  eta G = 2
proof
  let m be Nat;
  assume A1: 4 <= m & G is_sun_of m, {0} \/ Seg m, WRel m;
  set C = the carrier of G, R = WRel m;
  0 in NAT;
  then {0} c= NAT by ZFMISC_1:31;
  then reconsider B = {0} \/ Seg m as Subset of NAT by XBOOLE_1:8;
  A0: 3 <= m by A1, XXREAL_0:2;
  consider u1,u2 being Element of G such that
  A2: u1 = [0,1] & u2 = [0,2] & u1,u2 are_adjacent & deg u1 = 5 &
    deg u2 = 5 by A1, WheelAdj;
  A3: 1 is odd & 2 is even & 2 * 0 is even by OddEven;
  A5: Seg m c= B by XBOOLE_1:7;
  A6: not 0 in Seg m by FINSEQ_1:1;
  A1b: G is_sun_of m,B,R by A1;
  reconsider SQ = Seg m as finite Subset of NAT;
  per cases;
  suppose B0: m <> 5;
    defpred Po[Nat] means $1 is odd;
    defpred Pv[Nat] means $1 = 1 & m is odd;
    deffunc F2(Nat) = 2;
    deffunc F1(Nat) = 1;
    consider fu being Function of NAT, NAT such that
    B1: for i being Nat holds (Po[i] implies fu.i = F2(i)) &
      (not Po[i] implies fu.i = F1(i)) from NatCases;
    consider fv being Function of NAT, NAT such that
    B2: for i being Nat holds (Pv[i] implies fv.i = F2(i)) &
      (not Pv[i] implies fv.i = F1(i)) from NatCases;
    consider f such that
    B3: (for j being Nat st j in B holds f.[0,j] = fu.j) &
      (for j being Nat st j in Seg m holds f.[1,j] = fv.j) by A1, SunLab;
    B4: for j being Nat holds 1 <= fu.j & fu.j <= 2 & 1 <= fv.j & fv.j <= 2
    proof
      let j be Nat;
      C1: fu.j = 2 or fu.j = 1
      proof
        Po[j] or not Po[j];
        hence thesis by B1;
      end;
      fv.j = 2 or fv.j = 1
      proof
        Pv[j] or not Pv[j];
        hence thesis by B2;
      end;
      hence thesis by C1;
    end;
    B5a: for j being Nat st j in B holds f.[0,j] = fu.j & 1 <= fu.j &
      fu.j <= 2 by B3, B4;
    for j being Nat st j in Seg m holds f.[1,j] = fv.j & 1 <= fv.j &
      fv.j <= 2 by B3, B4;
    then B5: f is 2-labeling by A1, B5a, SunLabeling;
    B6: (for i being Nat st i in Seg m holds
      fu.(csucc(m,i)) + fu.(cpred(m,i)) + fv.i + fv.(cpred(m,i)) <>
      fu.(csucc(m,csucc(m,i))) + fu.(cpred(m,csucc(m,i))) +
      fv.(csucc(m,i)) + fv.(cpred(m,csucc(m,i)))) &
      (for i being Nat st i in Seg m holds
      4 <= fu.(csucc(m,i)) + fu.(cpred(m,i)) + fv.i + fv.(cpred(m,i)) &
      fu.(csucc(m,i)) + fu.(cpred(m,i)) + fv.i + fv.(cpred(m,i)) <= 7) &
      (for i being Nat st i in Seg m & m is even holds
      fu.(csucc(m,i)) + fu.(cpred(m,i)) + fv.i + fv.(cpred(m,i)) = 4 or
      fu.(csucc(m,i)) + fu.(cpred(m,i)) + fv.i + fv.(cpred(m,i)) = 6) &
      (for j being Nat st j in Seg m holds
      fu.j + fu.(csucc(m,j)) <
      fu.(csucc(m,j)) + fu.(cpred(m,j)) + fv.j + fv.(cpred(m,j)) &
      fu.j + fu.(csucc(m,j)) <
      fu.(csucc(m,csucc(m,j))) + fu.(cpred(m,csucc(m,j))) +
      fv.(csucc(m,j)) + fv.(cpred(m,csucc(m,j)))) by A1, B1, B2, CsFacts;
    deffunc SU(Nat) = fu.(csucc(m,$1)) + fu.(cpred(m,$1)) + fv.$1 +
      fv.(cpred(m,$1));
    B7: fu.0 = 1 by A3, B1;
    B8: (for i being Nat, x being Element of G st i in Seg m & x = [0,i] holds
      SumN(f,x) = fu.(csucc(m,i)) + fu.(cpred(m,i)) + fu.0 + fv.i +
      fv.(cpred(m,i)) & deg x = 5) &
      (for x being Element of G st x = [0,0] holds
      for S being finite Subset of NAT st S = Seg m holds
      SumN(f,x) = Sum(fu|S)) &
      (for j being Nat, y being Element of G st j in Seg m & y = [1,j] holds
      SumN(f,y) = fu.j + fu.(csucc(m,j))) by A1, B3, WheelSums;
    B9: for i being Nat, x being Element of G st i in Seg m & x = [0,i]
      holds SumN(f,x) = SU(i) + 1
    proof
      let i be Nat, x be Element of G;
      assume i in Seg m & x = [0,i];
      then SumN(f,x) = fu.(csucc(m,i)) + fu.(cpred(m,i)) + fu.0 + fv.i +
        fv.(cpred(m,i)) by B8;
      hence thesis by B7;
    end;
    :: the hub: 2 f(N(w)) = 3m or 3m + 1, which differs from the sums at
    :: the u_i
    set W = Sum(fu|SQ);
    B10: (m is even implies 2 * W = 3 * m) &
      (m is odd implies 2 * W = 3 * m + 1) by B1, SumParity;
    B11: for i being Nat st i in Seg m holds W <> SU(i) + 1
    proof
      let i be Nat;
      assume C1: i in Seg m;
      C2: SU(i) <= 7 by B6, C1;
      per cases;
      suppose C3: m = 4;
        2 * 2 is even;
        then C6: m is even by C3;
        then 2 * W = 3 * 4 by B10, C3;
        then C4: W = 6;
        SU(i) = 4 or SU(i) = 6 by B6, C1, C6;
        hence thesis by C4;
      end;
      suppose C3: m <> 4;
        then 4 < m by A1, XXREAL_0:1;
        then 4 + 1 <= m by NAT_1:13;
        then 5 < m by B0, XXREAL_0:1;
        then 5 + 1 <= m by NAT_1:13;
        then C4: 3 * 6 <= 3 * m by XREAL_1:64;
        3 * m <= 2 * W
        proof
          m is even or m is odd;
          then 2 * W = 3 * m or 2 * W = 3 * m + 1 by B10;
          hence thesis by NAT_1:11;
        end;
        then 2 * 9 <= 2 * W by C4, XXREAL_0:2;
        then C5: 9 <= W by XREAL_1:68;
        SU(i) + 1 <= 7 + 1 by C2, XREAL_1:6;
        then SU(i) + 1 < 9 by XXREAL_0:2;
        hence thesis by C5;
      end;
    end;
    B12: for x,y being Element of G, i,j being Nat st [i,j] in R &
      x = [0,i] & y = [0,j] holds SumN(f,x) <> SumN(f,y)
    proof
      let x,y be Element of G, i,j be Nat;
      assume C1: [i,j] in R & x = [0,i] & y = [0,j];
      then C2: (i in Seg m & j in Seg m & (j = csucc(m,i) or i = csucc(m,j)))
        or (i = 0 & j in Seg m) or (j = 0 & i in Seg m) by DefWRel;
      per cases by C2;
      suppose C3: i in Seg m & j in Seg m & (j = csucc(m,i) or
        i = csucc(m,j));
        then C4: SumN(f,x) = SU(i) + 1 & SumN(f,y) = SU(j) + 1 by B9, C1;
        SU(i) <> SU(j)
        proof
          per cases by C3;
          suppose j = csucc(m,i);
            hence thesis by B6, C3;
          end;
          suppose i = csucc(m,j);
            hence thesis by B6, C3;
          end;
        end;
        hence thesis by C4;
      end;
      suppose C3: i = 0 & j in Seg m;
        then SumN(f,x) = W & SumN(f,y) = SU(j) + 1 by B8, B9, C1;
        hence thesis by B11, C3;
      end;
      suppose C3: j = 0 & i in Seg m;
        then SumN(f,y) = W & SumN(f,x) = SU(i) + 1 by B8, B9, C1;
        hence thesis by B11, C3;
      end;
    end;
    for x,y being Element of G, i,j being Nat st i in Seg m &
      (j = i or j = cpred(m,i)) & x = [0,i] & y = [1,j] holds
      SumN(f,x) <> SumN(f,y)
    proof
      let x,y be Element of G, i,j be Nat;
      assume C1: i in Seg m & (j = i or j = cpred(m,i)) & x = [0,i] &
        y = [1,j];
      then C2: j in Seg m by CpredIn;
      C3: SumN(f,x) = SU(i) + 1 & SumN(f,y) = fu.j + fu.(csucc(m,j))
        by B8, B9, C1, C2;
      SU(i) <= SU(i) + 1 by NAT_1:11;
      then C4: fu.j + fu.(csucc(m,j)) < SU(i) implies thesis
        by C3, XXREAL_0:2;
      per cases by C1;
      suppose j = i;
        hence thesis by B6, C1, C4;
      end;
      suppose j = cpred(m,i);
        then i = csucc(m,j) by C1, CpredCsucc;
        hence thesis by B6, C2, C4;
      end;
    end;
    then f is additive by A1b, B12, SunAdditive;
    hence thesis by A2, B5, EtaEq2;
  end;
  suppose B0: m = 5;
    :: f(u_0) = f(u_3) = f(u_5) = 2, f(v_1) = f(v_2) = f(v_3) = 2, others 1
    defpred Pu[Nat] means $1 = 0 or $1 = 3 or $1 = 5;
    defpred Pv[Nat] means $1 <= 3;
    deffunc F2(Nat) = 2;
    deffunc F1(Nat) = 1;
    consider fu being Function of NAT, NAT such that
    B1: for i being Nat holds (Pu[i] implies fu.i = F2(i)) &
      (not Pu[i] implies fu.i = F1(i)) from NatCases;
    consider fv being Function of NAT, NAT such that
    B2: for i being Nat holds (Pv[i] implies fv.i = F2(i)) &
      (not Pv[i] implies fv.i = F1(i)) from NatCases;
    consider f such that
    B3: (for j being Nat st j in B holds f.[0,j] = fu.j) &
      (for j being Nat st j in Seg m holds f.[1,j] = fv.j) by A1, SunLab;
    B4: for j being Nat holds 1 <= fu.j & fu.j <= 2 & 1 <= fv.j & fv.j <= 2
    proof
      let j be Nat;
      C1: fu.j = 2 or fu.j = 1
      proof
        Pu[j] or not Pu[j];
        hence thesis by B1;
      end;
      fv.j = 2 or fv.j = 1
      proof
        Pv[j] or not Pv[j];
        hence thesis by B2;
      end;
      hence thesis by C1;
    end;
    B5a: for j being Nat st j in B holds f.[0,j] = fu.j & 1 <= fu.j &
      fu.j <= 2 by B3, B4;
    for j being Nat st j in Seg m holds f.[1,j] = fv.j & 1 <= fv.j &
      fv.j <= 2 by B3, B4;
    then B5: f is 2-labeling by A1, B5a, SunLabeling;
    B6: fu.0 = 2 & fu.1 = 1 & fu.2 = 1 & fu.3 = 2 & fu.4 = 1 & fu.5 = 2
      by B1;
    B7: fv.1 = 2 & fv.2 = 2 & fv.3 = 2 & fv.4 = 1 & fv.5 = 1 by B2;
    1 in Seg 5 & 2 in Seg 5 & 3 in Seg 5 & 4 in Seg 5 & 5 in Seg 5
      by FINSEQ_1:1;
    then B8: csucc(5,1) = 1 + 1 & csucc(5,2) = 2 + 1 & csucc(5,3) = 3 + 1 &
      csucc(5,4) = 4 + 1 & csucc(5,5) = 1 & cpred(5,1) = 5 &
      cpred(5,2) = 2 - 1 & cpred(5,3) = 3 - 1 & cpred(5,4) = 4 - 1 &
      cpred(5,5) = 5 - 1 by CsuccPar;
    B9: (for i being Nat, x being Element of G st i in Seg m & x = [0,i] holds
      SumN(f,x) = fu.(csucc(m,i)) + fu.(cpred(m,i)) + fu.0 + fv.i +
      fv.(cpred(m,i)) & deg x = 5) &
      (for x being Element of G st x = [0,0] holds
      for S being finite Subset of NAT st S = Seg m holds
      SumN(f,x) = Sum(fu|S)) &
      (for j being Nat, y being Element of G st j in Seg m & y = [1,j] holds
      SumN(f,y) = fu.j + fu.(csucc(m,j))) by A1, B3, WheelSums;
    :: the sums at u_1, ..., u_5 are 8, 9, 8, 9, 6
    deffunc T(Nat) = fu.(csucc(5,$1)) + fu.(cpred(5,$1)) + fu.0 + fv.$1 +
      fv.(cpred(5,$1));
    B10: T(1) = 8 & T(2) = 9 & T(3) = 8 & T(4) = 9 & T(5) = 6 by B6, B7, B8;
    B11: for i being Nat st i in Seg 5 holds 6 <= T(i) & T(i) <> 7 &
      T(i) <> T(csucc(5,i))
    proof
      let i be Nat;
      assume i in Seg 5;
      then i = 1 or i = 2 or i = 3 or i = 4 or i = 5 by Seg5;
      hence thesis by B8, B10;
    end;
    :: the hub has sum 7
    B12: Sum(fu|SQ) = 7
    proof
      reconsider S0 = Seg 0, S1 = Seg 1, S2 = Seg 2, S3 = Seg 3, S4 = Seg 4
        as finite Subset of NAT;
      C0: Sum(fu|S0) = 0 by SumEmpty;
      C1: Sum(fu|S1) = Sum(fu|S0) + fu.(0+1) by SumSegSucc;
      C2: Sum(fu|S2) = Sum(fu|S1) + fu.(1+1) by SumSegSucc;
      C3: Sum(fu|S3) = Sum(fu|S2) + fu.(2+1) by SumSegSucc;
      C4: Sum(fu|S4) = Sum(fu|S3) + fu.(3+1) by SumSegSucc;
      Sum(fu|SQ) = Sum(fu|S4) + fu.(4+1) by B0, SumSegSucc;
      hence thesis by B6, C0, C1, C2, C3, C4;
    end;
    B13: for x,y being Element of G, i,j being Nat st [i,j] in R &
      x = [0,i] & y = [0,j] holds SumN(f,x) <> SumN(f,y)
    proof
      let x,y be Element of G, i,j be Nat;
      assume C1: [i,j] in R & x = [0,i] & y = [0,j];
      then C2: (i in Seg m & j in Seg m & (j = csucc(m,i) or i = csucc(m,j)))
        or (i = 0 & j in Seg m) or (j = 0 & i in Seg m) by DefWRel;
      per cases by C2;
      suppose C3: i in Seg m & j in Seg m & (j = csucc(m,i) or
        i = csucc(m,j));
        then C4: SumN(f,x) = T(i) & SumN(f,y) = T(j) by B0, B9, C1;
        per cases by C3;
        suppose j = csucc(m,i);
          hence thesis by B0, B11, C3, C4;
        end;
        suppose i = csucc(m,j);
          hence thesis by B0, B11, C3, C4;
        end;
      end;
      suppose C3: i = 0 & j in Seg m;
        then SumN(f,x) = 7 & SumN(f,y) = T(j) by B0, B9, B12, C1;
        hence thesis by B0, B11, C3;
      end;
      suppose C3: j = 0 & i in Seg m;
        then SumN(f,y) = 7 & SumN(f,x) = T(i) by B0, B9, B12, C1;
        hence thesis by B0, B11, C3;
      end;
    end;
    for x,y being Element of G, i,j being Nat st i in Seg m &
      (j = i or j = cpred(m,i)) & x = [0,i] & y = [1,j] holds
      SumN(f,x) <> SumN(f,y)
    proof
      let x,y be Element of G, i,j be Nat;
      assume C1: i in Seg m & (j = i or j = cpred(m,i)) & x = [0,i] &
        y = [1,j];
      then C2: j in Seg m by CpredIn;
      C3: SumN(f,x) = T(i) & SumN(f,y) = fu.j + fu.(csucc(m,j))
        by B0, B9, C1, C2;
      fu.j <= 2 & fu.(csucc(m,j)) <= 2 by B4;
      then C4: fu.j + fu.(csucc(m,j)) <= 2 + 2 by XREAL_1:7;
      6 <= T(i) by B0, B11, C1;
      hence thesis by C3, C4, XXREAL_0:2;
    end;
    then f is additive by A1b, B13, SunAdditive;
    hence thesis by A2, B5, EtaEq2;
  end;
end;

:: Section 4: complete suns (Proposition 4). The labeling of the appendix.
:: With r = ceil((m+2)/3) = (m + 4) div 3 and h = m div 2, ksq(m,i) is the
:: paper's permutation q, ksu(m,i) = f(u_i) and ksv(m,i) = f(v_i).

theorem Div3:
  for x,t,c being Nat st x = 3 * t + c & c < 3 holds x div 3 = t
by NAT_D:def 1;

theorem Lt3:
  for c being Nat st c < 3 holds c = 0 or c = 1 or c = 2
proof
  let c be Nat;
  assume A1: c < 3;
  assume A2: not thesis;
  c < 2 + 1 by A1;
  then c <= 2 by NAT_1:13;
  then c < 1 + 1 by A2, XXREAL_0:1;
  then c <= 1 by NAT_1:13;
  hence contradiction by A2, NAT_1:25;
end;

theorem Lt6:
  for c being Nat st c < 6 holds c = 0 or c = 1 or c = 2 or c = 3 or
  c = 4 or c = 5
proof
  let c be Nat;
  assume A1: c < 6;
  assume A2: not thesis;
  c < 5 + 1 by A1;
  then c <= 5 by NAT_1:13;
  then c < 4 + 1 by A2, XXREAL_0:1;
  then c <= 4 by NAT_1:13;
  then c < 3 + 1 by A2, XXREAL_0:1;
  then c <= 3 by NAT_1:13;
  then c < 3 by A2, XXREAL_0:1;
  hence contradiction by A2, Lt3;
end;

theorem Hermite3:
  for x being Nat holds (x div 3) + ((x + 2) div 3) + ((x + 4) div 3) = x + 1
proof
  let x be Nat;
  set t = x div 3, c = x mod 3;
  A1: x = 3 * t + c by NAT_D:2;
  c < 3 by NAT_D:1;
  then A2: c = 0 or c = 1 or c = 2 by Lt3;
  per cases by A2;
  suppose B1: c = 0;
    then B2a: x + 2 = 3 * t + 2 & x + 4 = 3 * (t + 1) + 1 by A1;
    then B2b: (x + 2) div 3 = t by Div3;
    (x + 4) div 3 = t + 1 by B2a, Div3;
    then B2: (x + 2) div 3 = t & (x + 4) div 3 = t + 1 by B2b;
    B3: x = 3 * t + 0 by A1, B1;
    thus (x div 3) + ((x + 2) div 3) + ((x + 4) div 3)
      = t + (t) + (t + 1) by B2
    .= x + 1 by B3;
  end;
  suppose B1: c = 1;
    then B2a: x + 2 = 3 * (t + 1) + 0 & x + 4 = 3 * (t + 1) + 2 by A1;
    then B2b: (x + 2) div 3 = t + 1 by Div3;
    (x + 4) div 3 = t + 1 by B2a, Div3;
    then B2: (x + 2) div 3 = t + 1 & (x + 4) div 3 = t + 1 by B2b;
    B3: x = 3 * t + 1 by A1, B1;
    thus (x div 3) + ((x + 2) div 3) + ((x + 4) div 3)
      = t + (t + 1) + (t + 1) by B2
    .= x + 1 by B3;
  end;
  suppose B1: c = 2;
    then B2a: x + 2 = 3 * (t + 1) + 1 & x + 4 = 3 * (t + 2) + 0 by A1;
    then B2b: (x + 2) div 3 = t + 1 by Div3;
    (x + 4) div 3 = t + 2 by B2a, Div3;
    then B2: (x + 2) div 3 = t + 1 & (x + 4) div 3 = t + 2 by B2b;
    B3: x = 3 * t + 2 by A1, B1;
    thus (x div 3) + ((x + 2) div 3) + ((x + 4) div 3)
      = t + (t + 1) + (t + 2) by B2
    .= x + 1 by B3;
  end;
end;

definition
  let m,i be Nat;
  func ksq(m,i) -> Nat equals
  :DefKsq:
  1 if i = 1,
  2 * (i -' 1) if i <> 1 & i <= (m div 2) + 1
  otherwise 3 + 2 * (m -' i);
  coherence;
  consistency;
end;

definition
  let m,i be Nat;
  func ksu(m,i) -> Nat equals
  :DefKsu:
  cdiv(m+2,3) if (m mod 3) = 2 & i = ((m + 1) div 2) + 1
  otherwise (ksq(m,i) div 3) + 1;
  coherence;
  consistency;
  func ksa(m,i) -> Nat equals
  :DefKsa:
  (ksq(m,i) + 2) div 3 if i = 1 or (m div 2) + 2 <= i,
  cdiv(m+2,3) -' 1 if not (i = 1 or (m div 2) + 2 <= i) &
    (m mod 6) = 2 & i = ((m + 1) div 2) + 1
  otherwise (ksq(m,i) + 4) div 3;
  coherence;
  consistency;
end;

definition
  let m,i be Nat;
  func ksv(m,i) -> Nat equals
  (cdiv(m+2,3) + 1) -' ksa(m,i);
  coherence;
end;

:: Basic arithmetic of m: h = m div 2, r = (m + 4) div 3, the special
:: index pm = (m + 1) div 2 + 1

theorem Mod3:
  for x,t,c being Nat st x = 3 * t + c & c < 3 holds x mod 3 = c
by NAT_D:def 2;

theorem Div2:
  for x,t,c being Nat st x = 2 * t + c & c < 2 holds
  x div 2 = t & x mod 2 = c by NAT_D:def 1, NAT_D:def 2;

theorem Mod6:
  for m being Nat holds ex t being Nat st
  ((m mod 6) = 0 & m = 6 * t & (m mod 3) = 0 & m is even) or
  ((m mod 6) = 1 & m = 6 * t + 1 & (m mod 3) = 1 & m is odd) or
  ((m mod 6) = 2 & m = 6 * t + 2 & (m mod 3) = 2 & m is even) or
  ((m mod 6) = 3 & m = 6 * t + 3 & (m mod 3) = 0 & m is odd) or
  ((m mod 6) = 4 & m = 6 * t + 4 & (m mod 3) = 1 & m is even) or
  ((m mod 6) = 5 & m = 6 * t + 5 & (m mod 3) = 2 & m is odd)
proof
  let m be Nat;
  set t = m div 6, c = m mod 6;
  A1: m = 6 * t + c by NAT_D:2;
  c < 6 by NAT_D:1;
  then A2: c = 0 or c = 1 or c = 2 or c = 3 or c = 4 or c = 5 by Lt6;
  take t;
  per cases by A2;
  suppose B1: c = 0;
    then m = 3 * (2 * t) + 0 & m = 2 * (3 * t) by A1;
    hence thesis by B1, A1, Mod3;
  end;
  suppose B1: c = 1;
    then m = 3 * (2 * t) + 1 & m = 2 * (3 * t) + 1 by A1;
    hence thesis by B1, A1, Mod3;
  end;
  suppose B1: c = 2;
    then m = 3 * (2 * t) + 2 & m = 2 * (3 * t + 1) by A1;
    hence thesis by B1, A1, Mod3;
  end;
  suppose B1: c = 3;
    then m = 3 * (2 * t + 1) + 0 & m = 2 * (3 * t + 1) + 1 by A1;
    hence thesis by B1, A1, Mod3;
  end;
  suppose B1: c = 4;
    then m = 3 * (2 * t + 1) + 1 & m = 2 * (3 * t + 2) by A1;
    hence thesis by B1, A1, Mod3;
  end;
  suppose B1: c = 5;
    then m = 3 * (2 * t + 1) + 2 & m = 2 * (3 * t + 2) + 1 by A1;
    hence thesis by B1, A1, Mod3;
  end;
end;

theorem KsBasic:
  for m being Nat st 3 <= m holds
  cdiv(m+2,3) = (m + 4) div 3 &
  3 * cdiv(m+2,3) <= m + 4 & m + 4 < 3 * cdiv(m+2,3) + 3 &
  2 <= cdiv(m+2,3) & cdiv(m+2,3) < m &
  2 * (m div 2) <= m & m <= 2 * (m div 2) + 1 & 1 <= m div 2 &
  (m is even implies m = 2 * (m div 2) &
    ((m + 1) div 2) + 1 = (m div 2) + 1) &
  (m is odd implies m = 2 * (m div 2) + 1 &
    ((m + 1) div 2) + 1 = (m div 2) + 2) &
  3 <= ((m + 1) div 2) + 1 &
  ((m mod 6) = 2 implies m is even & (m mod 3) = 2) &
  ((m mod 3) = 2 & m is even implies (m mod 6) = 2) &
  ((m mod 3) = 2 & m is odd implies (m mod 6) = 5)
proof
  let m be Nat;
  assume A1: 3 <= m;
  set r = cdiv(m+2,3), h = m div 2;
  m + 2 + 3 -' 1 = (m + 4) + 1 -' 1
  .= m + 4 by NAT_D:34;
  hence A2: r = (m + 4) div 3;
  set c3 = (m + 4) mod 3;
  A3: m + 4 = 3 * r + c3 by A2, NAT_D:2;
  A4: c3 < 3 by NAT_D:1;
  then A5: 3 * r <= m + 4 by A3, NAT_1:11;
  thus 3 * r <= m + 4 by A3, NAT_1:11;
  3 * r + c3 < 3 * r + 3 by A4, XREAL_1:6;
  hence m + 4 < 3 * r + 3 by A3;
  A6: m + 4 < 3 * r + 3
  proof
    3 * r + c3 < 3 * r + 3 by A4, XREAL_1:6;
    hence thesis by A3;
  end;
  thus 2 <= r
  proof
    assume r < 2;
    then r < 1 + 1;
    then r <= 1 by NAT_1:13;
    then 3 * r <= 3 * 1 by XREAL_1:64;
    then 3 * r + 3 <= 3 + 3 by XREAL_1:6;
    then B1: m + 4 < 6 by A6, XXREAL_0:2;
    3 + 4 <= m + 4 by A1, XREAL_1:6;
    hence contradiction by B1, XXREAL_0:2;
  end;
  thus r < m
  proof
    2 * 3 <= 2 * m by A1, XREAL_1:64;
    then 4 < 2 * m by XXREAL_0:2;
    then B1: 4 + m < 2 * m + m by XREAL_1:8;
    assume m <= r;
    then 3 * m <= 3 * r by XREAL_1:64;
    then 3 * m <= m + 4 by A5, XXREAL_0:2;
    hence contradiction by B1;
  end;
  set e = m mod 2;
  A7: m = 2 * h + e by NAT_D:2;
  A8: e < 2 by NAT_D:1;
  then e < 1 + 1;
  then A9: e <= 1 by NAT_1:13;
  thus 2 * h <= m by A7, NAT_1:11;
  2 * h + e <= 2 * h + 1 by A9, XREAL_1:6;
  hence m <= 2 * h + 1 by A7;
  thus 1 <= h
  proof
    assume h < 1;
    then h = 0 by NAT_1:14;
    then m <= 1 by A7, A9;
    hence contradiction by A1, XXREAL_0:2;
  end;
  then A10: 1 <= h;
  thus A11: m is even implies m = 2 * h & ((m + 1) div 2) + 1 = h + 1
  proof
    assume m is even;
    then e = 0 by NAT_2:21;
    then B1: m = 2 * h by A7;
    hence m = 2 * h;
    m + 1 = 2 * h + 1 by B1;
    hence thesis by Div2;
  end;
  thus A12: m is odd implies m = 2 * h + 1 & ((m + 1) div 2) + 1 = h + 2
  proof
    assume m is odd;
    then e = 1 by NAT_2:22;
    then B1: m = 2 * h + 1 by A7;
    hence m = 2 * h + 1;
    m + 1 = 2 * (h + 1) + 0 by B1;
    then (m + 1) div 2 = h + 1 by Div2;
    hence thesis;
  end;
  thus 3 <= ((m + 1) div 2) + 1
  proof
    per cases;
    suppose B1: m is even;
      then B2: m = 2 * h by A11;
      h <> 1 by A1, B2;
      then 1 < h by A10, XXREAL_0:1;
      then 1 + 1 <= h by NAT_1:13;
      then 2 + 1 <= h + 1 by XREAL_1:6;
      hence thesis by A11, B1;
    end;
    suppose B1: m is odd;
      1 + 2 <= h + 2 by A10, XREAL_1:6;
      hence thesis by A12, B1;
    end;
  end;
  consider t being Nat such that
  A13: ((m mod 6) = 0 & m = 6 * t & (m mod 3) = 0 & m is even) or
    ((m mod 6) = 1 & m = 6 * t + 1 & (m mod 3) = 1 & m is odd) or
    ((m mod 6) = 2 & m = 6 * t + 2 & (m mod 3) = 2 & m is even) or
    ((m mod 6) = 3 & m = 6 * t + 3 & (m mod 3) = 0 & m is odd) or
    ((m mod 6) = 4 & m = 6 * t + 4 & (m mod 3) = 1 & m is even) or
    ((m mod 6) = 5 & m = 6 * t + 5 & (m mod 3) = 2 & m is odd) by Mod6;
  thus thesis by A13;
end;

theorem KsVals:
  for m,i being Nat st 3 <= m holds
  (i = 1 implies ksq(m,i) = 1) &
  (2 <= i & i <= (m div 2) + 1 implies ksq(m,i) + 2 = 2 * i) &
  ((m div 2) + 2 <= i & i <= m implies ksq(m,i) + 2 * i = 2 * m + 3) &
  (not ((m mod 3) = 2 & i = ((m + 1) div 2) + 1) implies
    ksu(m,i) = (ksq(m,i) div 3) + 1) &
  ((m mod 3) = 2 & i = ((m + 1) div 2) + 1 implies ksu(m,i) = cdiv(m+2,3)) &
  (i = 1 or (m div 2) + 2 <= i implies ksa(m,i) = (ksq(m,i) + 2) div 3) &
  (2 <= i & i <= (m div 2) + 1 & (m mod 6) = 2 &
    i = ((m + 1) div 2) + 1 implies ksa(m,i) = cdiv(m+2,3) -' 1) &
  (2 <= i & i <= (m div 2) + 1 &
    not ((m mod 6) = 2 & i = ((m + 1) div 2) + 1) implies
    ksa(m,i) = (ksq(m,i) + 4) div 3)
proof
  let m,i be Nat;
  assume 3 <= m;
  set h = m div 2;
  thus i = 1 implies ksq(m,i) = 1 by DefKsq;
  thus 2 <= i & i <= h + 1 implies ksq(m,i) + 2 = 2 * i
  proof
    assume B1: 2 <= i & i <= h + 1;
    then B2: i <> 1;
    1 <= i by B1, XXREAL_0:2;
    then B3: i -' 1 = i - 1 by XREAL_1:233;
    ksq(m,i) = 2 * (i -' 1) by B1, B2, DefKsq;
    hence thesis by B3;
  end;
  thus h + 2 <= i & i <= m implies ksq(m,i) + 2 * i = 2 * m + 3
  proof
    assume B1: h + 2 <= i & i <= m;
    h + 1 < h + 2 by XREAL_1:6;
    then B2: not i <= h + 1 by B1, XXREAL_0:2;
    1 <= 2 & 2 <= h + 2 by NAT_1:11;
    1 + 0 < 2 + h by XREAL_1:8;
    then i <> 1 by B1;
    then B3: ksq(m,i) = 3 + 2 * (m -' i) by B2, DefKsq;
    m -' i = m - i by B1, XREAL_1:233;
    hence thesis by B3;
  end;
  thus not ((m mod 3) = 2 & i = ((m + 1) div 2) + 1) implies
    ksu(m,i) = (ksq(m,i) div 3) + 1 by DefKsu;
  thus (m mod 3) = 2 & i = ((m + 1) div 2) + 1 implies ksu(m,i) = cdiv(m+2,3)
    by DefKsu;
  thus i = 1 or h + 2 <= i implies ksa(m,i) = (ksq(m,i) + 2) div 3 by DefKsa;
  A1: 2 <= i & i <= h + 1 implies not (i = 1 or h + 2 <= i)
  proof
    assume B1: 2 <= i & i <= h + 1;
    h + 1 < h + 2 by XREAL_1:6;
    hence thesis by B1, XXREAL_0:2;
  end;
  thus 2 <= i & i <= h + 1 & (m mod 6) = 2 & i = ((m + 1) div 2) + 1 implies
    ksa(m,i) = cdiv(m+2,3) -' 1 by A1, DefKsa;
  thus thesis by A1, DefKsa;
end;

theorem KsS:
  for m being Nat st 3 <= m holds
  ((m mod 6) = 2 implies m + 3 = 2 * cdiv(m+2,3) + ((m + 2) div 3) &
    m + 1 = cdiv(m+2,3) + ((m + 1) div 3) + ((m -' 1) div 3)) &
  ((m mod 6) = 5 implies
    m + 2 = cdiv(m+2,3) + ((m + 2) div 3) + ((m + 3) div 3)) &
  ((m mod 6) = 0 or (m mod 6) = 4 implies
    m = ((m + 1) div 3) + ((m + 4) div 3) + ((m -' 1) div 3)) &
  ((m mod 6) = 1 or (m mod 6) = 3 implies
    m + 1 = ((m + 2) div 3) + ((m + 3) div 3) + (m div 3))
proof
  let m be Nat;
  assume A1: 3 <= m;
  A2: cdiv(m+2,3) = (m + 4) div 3 by A1, KsBasic;
  A3: 1 <= m by A1, XXREAL_0:2;
  then A4: m -' 1 = m - 1 by XREAL_1:233;
  consider t being Nat such that
  A5: ((m mod 6) = 0 & m = 6 * t & (m mod 3) = 0 & m is even) or
    ((m mod 6) = 1 & m = 6 * t + 1 & (m mod 3) = 1 & m is odd) or
    ((m mod 6) = 2 & m = 6 * t + 2 & (m mod 3) = 2 & m is even) or
    ((m mod 6) = 3 & m = 6 * t + 3 & (m mod 3) = 0 & m is odd) or
    ((m mod 6) = 4 & m = 6 * t + 4 & (m mod 3) = 1 & m is even) or
    ((m mod 6) = 5 & m = 6 * t + 5 & (m mod 3) = 2 & m is odd) by Mod6;
  thus (m mod 6) = 2 implies m + 3 = 2 * cdiv(m+2,3) + ((m + 2) div 3) &
    m + 1 = cdiv(m+2,3) + ((m + 1) div 3) + ((m -' 1) div 3)
  proof
    assume (m mod 6) = 2;
    then B1: m = 6 * t + 2 by A5;
    then m + 4 = 3 * (2 * t + 2) + 0;
    then B2: (m + 4) div 3 = 2 * t + 2 by Div3;
    m + 2 = 3 * (2 * t + 1) + 1 by B1;
    then B3: (m + 2) div 3 = 2 * t + 1 by Div3;
    m + 1 = 3 * (2 * t + 1) + 0 by B1;
    then B4: (m + 1) div 3 = 2 * t + 1 by Div3;
    m -' 1 = 3 * (2 * t) + 1 by A4, B1;
    then (m -' 1) div 3 = 2 * t by Div3;
    hence thesis by A2, B1, B2, B3, B4;
  end;
  thus (m mod 6) = 5 implies
    m + 2 = cdiv(m+2,3) + ((m + 2) div 3) + ((m + 3) div 3)
  proof
    assume (m mod 6) = 5;
    then B1: m = 6 * t + 5 by A5;
    then m + 4 = 3 * (2 * t + 3) + 0;
    then B2: (m + 4) div 3 = 2 * t + 3 by Div3;
    m + 2 = 3 * (2 * t + 2) + 1 by B1;
    then B3: (m + 2) div 3 = 2 * t + 2 by Div3;
    m + 3 = 3 * (2 * t + 2) + 2 by B1;
    then (m + 3) div 3 = 2 * t + 2 by Div3;
    hence thesis by A2, B1, B2, B3;
  end;
  thus (m mod 6) = 0 or (m mod 6) = 4 implies
    m = ((m + 1) div 3) + ((m + 4) div 3) + ((m -' 1) div 3)
  proof
    assume B0: (m mod 6) = 0 or (m mod 6) = 4;
    per cases by B0;
    suppose (m mod 6) = 0;
      then B1: m = 6 * t by A5;
      then t <> 0 by A1;
      then 1 <= t by NAT_1:14;
      then reconsider t1 = t - 1 as Nat by NAT_1:21;
      m + 1 = 3 * (2 * t) + 1 by B1;
      then B2: (m + 1) div 3 = 2 * t by Div3;
      m + 4 = 3 * (2 * t + 1) + 1 by B1;
      then B3: (m + 4) div 3 = 2 * t + 1 by Div3;
      m -' 1 = 3 * (2 * t1 + 1) + 2 by A4, B1;
      then (m -' 1) div 3 = 2 * t1 + 1 by Div3;
      hence thesis by B1, B2, B3;
    end;
    suppose (m mod 6) = 4;
      then B1: m = 6 * t + 4 by A5;
      then m + 1 = 3 * (2 * t + 1) + 2;
      then B2: (m + 1) div 3 = 2 * t + 1 by Div3;
      m + 4 = 3 * (2 * t + 2) + 2 by B1;
      then B3: (m + 4) div 3 = 2 * t + 2 by Div3;
      m -' 1 = 3 * (2 * t + 1) + 0 by A4, B1;
      then (m -' 1) div 3 = 2 * t + 1 by Div3;
      hence thesis by B1, B2, B3;
    end;
  end;
  assume B0: (m mod 6) = 1 or (m mod 6) = 3;
  per cases by B0;
  suppose (m mod 6) = 1;
    then B1: m = 6 * t + 1 by A5;
    then m + 2 = 3 * (2 * t + 1) + 0;
    then B2: (m + 2) div 3 = 2 * t + 1 by Div3;
    m + 3 = 3 * (2 * t + 1) + 1 by B1;
    then B3: (m + 3) div 3 = 2 * t + 1 by Div3;
    m = 3 * (2 * t) + 1 by B1;
    then m div 3 = 2 * t by Div3;
    hence thesis by B1, B2, B3;
  end;
  suppose (m mod 6) = 3;
    then B1: m = 6 * t + 3 by A5;
    then m + 2 = 3 * (2 * t + 1) + 2;
    then B2: (m + 2) div 3 = 2 * t + 1 by Div3;
    m + 3 = 3 * (2 * t + 2) + 0 by B1;
    then B3: (m + 3) div 3 = 2 * t + 2 by Div3;
    m = 3 * (2 * t + 1) + 0 by B1;
    then m div 3 = 2 * t + 1 by Div3;
    hence thesis by B1, B2, B3;
  end;
end;

:: The claim of the appendix, f(v_i) + f(v_(i-1)) + q(i) = 2r + f(u_i), in
:: the form q(i) + 2 = a(i) + a(i-1) + f(u_i) with f(v_i) = r + 1 - a(i)

theorem KsClaim:
  for m,i being Nat st 3 <= m & i in Seg m holds
  ksq(m,i) + 2 = ksa(m,i) + ksa(m,cpred(m,i)) + ksu(m,i)
proof
  let m,i be Nat;
  assume A1: 3 <= m & i in Seg m;
  set h = m div 2, r = cdiv(m+2,3), pm = ((m + 1) div 2) + 1;
  A2: 1 <= i & i <= m by A1, FINSEQ_1:1;
  A3: r = (m + 4) div 3 & 2 <= r & 2 * h <= m & m <= 2 * h + 1 & 1 <= h &
    (m is even implies m = 2 * h & pm = h + 1) &
    (m is odd implies m = 2 * h + 1 & pm = h + 2) & 3 <= pm &
    ((m mod 6) = 2 implies m is even & (m mod 3) = 2) &
    ((m mod 3) = 2 & m is even implies (m mod 6) = 2) &
    ((m mod 3) = 2 & m is odd implies (m mod 6) = 5) by A1, KsBasic;
  A4: h + 1 <= pm
  proof
    m is even or m is odd;
    hence thesis by A3, XREAL_1:6;
  end;
  :: h + 2 <= m
  A5: h + 2 <= m
  proof
    per cases by A3, XXREAL_0:1;
    suppose h = 1;
      hence thesis by A1;
    end;
    suppose 1 < h;
      then 1 + 1 <= h by NAT_1:13;
      then h + 2 <= h + h by XREAL_1:6;
      hence thesis by A3, XXREAL_0:2;
    end;
  end;
  A6: for j being Nat holds
    (j = 1 implies ksq(m,j) = 1) &
    (2 <= j & j <= h + 1 implies ksq(m,j) + 2 = 2 * j) &
    (h + 2 <= j & j <= m implies ksq(m,j) + 2 * j = 2 * m + 3) &
    (not ((m mod 3) = 2 & j = pm) implies ksu(m,j) = (ksq(m,j) div 3) + 1) &
    ((m mod 3) = 2 & j = pm implies ksu(m,j) = r) &
    (j = 1 or h + 2 <= j implies ksa(m,j) = (ksq(m,j) + 2) div 3) &
    (2 <= j & j <= h + 1 & (m mod 6) = 2 & j = pm implies
      ksa(m,j) = r -' 1) &
    (2 <= j & j <= h + 1 & not ((m mod 6) = 2 & j = pm) implies
      ksa(m,j) = (ksq(m,j) + 4) div 3) by A1, KsVals;
  A7: 1 < m by A1, XXREAL_0:2;
  A8: 1 div 3 = 0 & 2 div 3 = 0 & 3 div 3 = 1 & 5 div 3 = 1 & 6 div 3 = 2
  proof
    1 = 3 * 0 + 1 & 2 = 3 * 0 + 2 & 3 = 3 * 1 + 0 & 5 = 3 * 1 + 2 &
      6 = 3 * 2 + 0;
    hence thesis by Div3;
  end;
  per cases by A2, XXREAL_0:1;
  suppose B1: i = 1;
    then B2: cpred(m,i) = m by A1, CsuccPar;
    B3: ksq(m,1) = 1 by A6;
    ksq(m,m) + 2 * m = 2 * m + 3 by A5, A6;
    then B4: ksq(m,m) = 3;
    B5: ksa(m,1) = (1 + 2) div 3 by A6, B3
    .= 1 by A8;
    B6: ksa(m,m) = (3 + 2) div 3 by A5, A6, B4
    .= 1 by A8;
    1 <> pm by A3;
    then ksu(m,1) = (1 div 3) + 1 by A6, B3
    .= 0 + 1 by A8;
    hence thesis by B1, B2, B3, B5, B6;
  end;
  suppose B1: 1 < i;
    then B2: cpred(m,i) = i - 1 by A1, CsuccPar;
    reconsider p = i - 1 as Nat by B1, NAT_1:21;
    B3: i = p + 1;
    1 + 1 <= i by B1, NAT_1:13;
    then B5: 1 <= p by B3, XREAL_1:6;
    per cases;
    suppose C1: i <= h + 1;
      B6: 1 + 1 <= i by B1, NAT_1:13;
      then C2: ksq(m,i) + 2 = 2 * i by A6, C1;
      per cases by B5, XXREAL_0:1;
      suppose C3: p = 1;
        then C4: i = 2 by B3;
        then C5: ksq(m,2) = 2 by C2;
        2 <> pm by A3;
        then C6: ksa(m,2) = (2 + 4) div 3 by A6, C1, C4, C5
        .= 2 by A8;
        C7: ksa(m,1) = (ksq(m,1) + 2) div 3 by A6
        .= (1 + 2) div 3 by A6
        .= 1 by A8;
        2 <> pm by A3;
        then ksu(m,2) = (2 div 3) + 1 by A6, C5
        .= 0 + 1 by A8;
        hence thesis by B2, C3, C4, C5, C6, C7;
      end;
      suppose C3: 1 < p;
        then C4: 1 + 1 <= p by NAT_1:13;
        p + 1 <= h + 1 by B3, C1;
        then C5: p <= h by XREAL_1:6;
        h <= h + 1 by NAT_1:11;
        then p <= h + 1 by C5, XXREAL_0:2;
        then C6: ksq(m,p) + 2 = 2 * p by A6, C4;
        set x = ksq(m,i);
        C7: ksq(m,p) + 4 = x + 2 by B3, C2, C6;
        p < h + 1 by C5, NAT_1:13;
        then p < pm by A4, XXREAL_0:2;
        then not ((m mod 6) = 2 & p = pm);
        then C8a: not ((m mod 6) = 2 & p = pm);
        p <= h + 1 by C5, NAT_1:12;
        then ksa(m,p) = (ksq(m,p) + 4) div 3 by A6, C4, C8a;
        then C8: ksa(m,p) = (x + 2) div 3 by C7;
        per cases;
        suppose C9: not ((m mod 6) = 2 & i = pm);
          then C10: ksa(m,i) = (x + 4) div 3 by A6, B6, C1;
          not ((m mod 3) = 2 & i = pm)
          proof
            assume D1: (m mod 3) = 2 & i = pm;
            per cases;
            suppose m is even;
              hence contradiction by A3, C9, D1;
            end;
            suppose m is odd;
              then pm = h + 2 by A3;
              then h + 2 <= h + 1 by C1, D1;
              hence contradiction by XREAL_1:6;
            end;
          end;
          then ksu(m,i) = (x div 3) + 1 by A6;
          then ksa(m,i) + ksa(m,cpred(m,i)) + ksu(m,i)
            = ((x div 3) + ((x + 2) div 3) + ((x + 4) div 3)) + 1
            by B2, C8, C10
          .= x + 1 + 1 by Hermite3;
          hence thesis;
        end;
        suppose C9: (m mod 6) = 2 & i = pm;
          then C10: ksa(m,i) = r -' 1 by A6, B6, C1;
          C11: m is even & (m mod 3) = 2 by A3, C9;
          then C12: m = 2 * h & pm = h + 1 by A3;
          C13: ksu(m,i) = r by A6, C9, C11;
          C14: x = m by B3, C2, C9, C12;
          r -' 1 = r - 1 by A3, XREAL_1:233, XXREAL_0:2;
          then ksa(m,i) + ksa(m,cpred(m,i)) + ksu(m,i)
            = 2 * r + ((m + 2) div 3) - 1 by B2, C8, C10, C13, C14
          .= m + 3 - 1 by A1, C9, KsS;
          hence thesis by C14;
        end;
      end;
    end;
    suppose C1: not i <= h + 1;
      then h + 1 < i;
      then C2: h + 1 + 1 <= i by NAT_1:13;
      set x = ksq(m,i);
      C3: x + 2 * i = 2 * m + 3 by A2, A6, C2;
      C4: ksa(m,i) = (x + 2) div 3 by A6, C2;
      per cases by C2, XXREAL_0:1;
      suppose C5: i = h + 2;
        then C6: p = h + 1 by B3;
        C7a: 1 + 1 <= h + 1 by A3, XREAL_1:6;
        then C7: ksq(m,p) + 2 = 2 * p by A6, C6;
        then C8: ksq(m,p) = 2 * h by C6;
        C9: x = 2 * m - 2 * h - 1 by C3, C5;
        C10: 2 <= p & p <= h + 1 by C6, C7a;
        consider t being Nat such that
        C11: ((m mod 6) = 0 & m = 6 * t & (m mod 3) = 0 & m is even) or
          ((m mod 6) = 1 & m = 6 * t + 1 & (m mod 3) = 1 & m is odd) or
          ((m mod 6) = 2 & m = 6 * t + 2 & (m mod 3) = 2 & m is even) or
          ((m mod 6) = 3 & m = 6 * t + 3 & (m mod 3) = 0 & m is odd) or
          ((m mod 6) = 4 & m = 6 * t + 4 & (m mod 3) = 1 & m is even) or
          ((m mod 6) = 5 & m = 6 * t + 5 & (m mod 3) = 2 & m is odd)
          by Mod6;
        A9: m -' 1 = m - 1 by A7, XREAL_1:233;
        per cases;
        suppose D1: (m mod 6) = 2;
          then D2: m is even & (m mod 3) = 2 by A3;
          then D3: m = 2 * h & pm = h + 1 by A3;
          then D4: ksa(m,p) = r -' 1 by A6, C6, C10, D1;
          D5: x = m -' 1 by A9, C9, D3;
          i <> pm by C5, D3;
          then D6: ksu(m,i) = (x div 3) + 1 by A6;
          r -' 1 = r - 1 by A3, XREAL_1:233, XXREAL_0:2;
          then ksa(m,i) + ksa(m,cpred(m,i)) + ksu(m,i)
            = r + ((m + 1) div 3) + ((m -' 1) div 3) by A9, B2, C4, D4,
              D5, D6
          .= m + 1 by A1, D1, KsS;
          hence thesis by A9, D5;
        end;
        suppose D1: (m mod 6) = 5;
          then D2: m is odd & (m mod 3) = 2 by C11;
          then D3: m = 2 * h + 1 & pm = h + 2 by A3;
          then D4: x = m by C9;
          p <> pm by C6, D3;
          then ksa(m,p) = (ksq(m,p) + 4) div 3 by A6, C10;
          then D5: ksa(m,p) = (m + 3) div 3 by C8, D3;
          D6: ksu(m,i) = r by A6, C5, D2, D3;
          ksa(m,i) + ksa(m,cpred(m,i)) + ksu(m,i)
            = r + ((m + 2) div 3) + ((m + 3) div 3) by B2, C4, D4, D5, D6
          .= m + 2 by A1, D1, KsS;
          hence thesis by D4;
        end;
        suppose D1: (m mod 6) <> 2 & (m mod 6) <> 5;
          then D2: (m mod 3) <> 2 by C11;
          not ((m mod 6) = 2 & p = pm) by D1;
          then D3: ksa(m,p) = (2 * h + 4) div 3 by A6, C8, C10;
          D4: ksu(m,i) = (x div 3) + 1 by A6, D2;
          per cases;
          suppose E1: m is even;
            then E2: m = 2 * h by A3;
            then E3: x = m -' 1 by A9, C9;
            E4: (m mod 6) = 0 or (m mod 6) = 4 by C11, E1, D1;
            ksa(m,i) + ksa(m,cpred(m,i)) + ksu(m,i)
              = ((m + 1) div 3) + ((m + 4) div 3) + ((m -' 1) div 3) + 1
              by A9, B2, C4, D3, D4, E2, E3
            .= m + 1 by A1, E4, KsS;
            hence thesis by A9, E3;
          end;
          suppose E1: m is odd;
            then E2: m = 2 * h + 1 by A3;
            then E3: x = m by C9;
            E4: (m mod 6) = 1 or (m mod 6) = 3 by C11, E1, D1;
            ksa(m,i) + ksa(m,cpred(m,i)) + ksu(m,i)
              = ((m + 2) div 3) + ((m + 3) div 3) + (m div 3) + 1
              by B2, C4, D3, D4, E2, E3
            .= m + 1 + 1 by A1, E4, KsS;
            hence thesis by E3;
          end;
        end;
      end;
      suppose C5: h + 2 < i;
        then h + 2 + 1 <= i by NAT_1:13;
        then C6: h + 2 <= p by B3, XREAL_1:6;
        p <= p + 1 by NAT_1:11;
        then p <= m by A2, B3, XXREAL_0:2;
        then ksq(m,p) + 2 * p = 2 * m + 3 by A6, C6;
        then C7: ksq(m,p) = x + 2 by B3, C3;
        C8: ksa(m,p) = (ksq(m,p) + 2) div 3 by A6, C6
        .= (x + 4) div 3 by C7;
        pm <> i
        proof
          assume D1: pm = i;
          pm <= h + 2
          proof
            per cases;
            suppose m is even;
              then pm = h + 1 by A3;
              hence thesis by XREAL_1:6;
            end;
            suppose m is odd;
              hence thesis by A3;
            end;
          end;
          hence contradiction by C5, D1;
        end;
        then ksu(m,i) = (x div 3) + 1 by A6;
        then ksa(m,i) + ksa(m,cpred(m,i)) + ksu(m,i)
          = ((x div 3) + ((x + 2) div 3) + ((x + 4) div 3)) + 1 by B2, C4, C8
        .= x + 1 + 1 by Hermite3;
        hence thesis;
      end;
    end;
  end;
end;

theorem Div3Plus:
  for x being Nat holds (x + 3) div 3 = (x div 3) + 1
proof
  let x be Nat;
  set t = x div 3, c = x mod 3;
  A1: x = 3 * t + c by NAT_D:2;
  A2: c < 3 by NAT_D:1;
  x + 3 = 3 * (t + 1) + c by A1;
  hence thesis by A2, Div3;
end;

theorem KsRanges:
  for m,i being Nat st 3 <= m & i in Seg m holds
  1 <= ksq(m,i) & ksq(m,i) <= m &
  1 <= ksu(m,i) & ksu(m,i) <= cdiv(m+2,3) &
  1 <= ksa(m,i) & ksa(m,i) <= cdiv(m+2,3) &
  ksv(m,i) + ksa(m,i) = cdiv(m+2,3) + 1 &
  1 <= ksv(m,i) & ksv(m,i) <= cdiv(m+2,3)
proof
  let m,i be Nat;
  assume A1: 3 <= m & i in Seg m;
  set h = m div 2, r = cdiv(m+2,3), pm = ((m + 1) div 2) + 1;
  A2: 1 <= i & i <= m by A1, FINSEQ_1:1;
  A3: r = (m + 4) div 3 & 2 <= r & 2 * h <= m & m <= 2 * h + 1 & 1 <= h
    by A1, KsBasic;
  A6: (i = 1 implies ksq(m,i) = 1) &
    (2 <= i & i <= h + 1 implies ksq(m,i) + 2 = 2 * i) &
    (h + 2 <= i & i <= m implies ksq(m,i) + 2 * i = 2 * m + 3) &
    (not ((m mod 3) = 2 & i = pm) implies ksu(m,i) = (ksq(m,i) div 3) + 1) &
    ((m mod 3) = 2 & i = pm implies ksu(m,i) = r) &
    (i = 1 or h + 2 <= i implies ksa(m,i) = (ksq(m,i) + 2) div 3) &
    (2 <= i & i <= h + 1 & (m mod 6) = 2 & i = pm implies
      ksa(m,i) = r -' 1) &
    (2 <= i & i <= h + 1 & not ((m mod 6) = 2 & i = pm) implies
      ksa(m,i) = (ksq(m,i) + 4) div 3) by A1, KsVals;
  A7: 3 div 3 = 1
  proof
    3 = 3 * 1 + 0;
    hence thesis by Div3;
  end;
  set x = ksq(m,i);
  A8: 1 <= x & x <= m
  proof
    per cases by A2, XXREAL_0:1;
    suppose i = 1;
      hence thesis by A1, A6, XXREAL_0:2;
    end;
    suppose B1: 1 < i & i <= h + 1;
      then B3: 1 + 1 <= i by NAT_1:13;
      then B2: x + 2 = 2 * i by A6, B1;
      2 * 2 <= 2 * i by B3, XREAL_1:64;
      then 2 + 2 <= x + 2 by B2;
      then 2 <= x by XREAL_1:6;
      hence 1 <= x by XXREAL_0:2;
      2 * i <= 2 * (h + 1) by B1, XREAL_1:64;
      then x + 2 <= 2 * h + 2 by B2;
      then x <= 2 * h by XREAL_1:6;
      hence thesis by A3, XXREAL_0:2;
    end;
    suppose B1: 1 < i & not i <= h + 1;
      then h + 1 < i;
      then B3: h + 1 + 1 <= i by NAT_1:13;
      then B2: x + 2 * i = 2 * m + 3 by A2, A6;
      2 * i <= 2 * m by A2, XREAL_1:64;
      then x + 2 * i <= x + 2 * m by XREAL_1:6;
      then 3 + 2 * m <= x + 2 * m by B2;
      then 3 <= x by XREAL_1:6;
      hence 1 <= x by XXREAL_0:2;
      2 * (h + 2) <= 2 * i by B3, XREAL_1:64;
      then x + 2 * (h + 2) <= x + 2 * i by XREAL_1:6;
      then B4: x + 2 * h + 4 <= 2 * m + 3 by B2;
      m + m <= m + (2 * h + 1) by A3, XREAL_1:6;
      then m + m + 3 <= m + (2 * h + 1) + 3 by XREAL_1:6;
      then x + 2 * h + 4 <= m + (2 * h + 1) + 3 by B4, XXREAL_0:2;
      then x + (2 * h + 4) <= m + (2 * h + 4);
      hence thesis by XREAL_1:6;
    end;
  end;
  thus 1 <= x & x <= m by A8;
  A9: for y being Nat st y <= m + 4 holds y div 3 <= r by A3, NAT_2:24;
  A10: for y being Nat st 3 <= y holds 1 <= y div 3 by A7, NAT_2:24;
  thus 1 <= ksu(m,i) & ksu(m,i) <= r
  proof
    per cases;
    suppose (m mod 3) = 2 & i = pm;
      then ksu(m,i) = r by A6;
      hence thesis by A3, XXREAL_0:2;
    end;
    suppose not ((m mod 3) = 2 & i = pm);
      then B1: ksu(m,i) = (x div 3) + 1 by A6;
      hence 1 <= ksu(m,i) by NAT_1:11;
      x + 3 <= m + 4 by A8, XREAL_1:7;
      then (x + 3) div 3 <= r by A9;
      hence thesis by B1, Div3Plus;
    end;
  end;
  A11: 1 <= ksa(m,i) & ksa(m,i) <= r
  proof
    per cases by A2, XXREAL_0:1;
    suppose B1: i = 1 or h + 2 <= i;
      then B2: ksa(m,i) = (x + 2) div 3 by A6;
      1 + 2 <= x + 2 by A8, XREAL_1:6;
      hence 1 <= ksa(m,i) by A10, B2;
      x + 2 <= m + 4 by A8, XREAL_1:7;
      hence thesis by A9, B2;
    end;
    suppose B1: not (i = 1 or h + 2 <= i);
      then 1 < i by A2, XXREAL_0:1;
      then B2: 1 + 1 <= i by NAT_1:13;
      i < h + 1 + 1 by B1;
      then B3: i <= h + 1 by NAT_1:13;
      per cases;
      suppose (m mod 6) = 2 & i = pm;
        then B4: ksa(m,i) = r -' 1 by A6, B2, B3;
        B5: r -' 1 = r - 1 by A3, XREAL_1:233, XXREAL_0:2;
        1 + 1 <= r by A3;
        hence 1 <= ksa(m,i) by B4, B5, XREAL_1:19;
        thus thesis by B4, B5, XREAL_1:146;
      end;
      suppose not ((m mod 6) = 2 & i = pm);
        then B4: ksa(m,i) = (x + 4) div 3 by A6, B2, B3;
        3 <= 3 + (x + 1) by NAT_1:11;
        hence 1 <= ksa(m,i) by A10, B4;
        x + 4 <= m + 4 by A8, XREAL_1:6;
        hence thesis by A9, B4;
      end;
    end;
  end;
  thus 1 <= ksa(m,i) & ksa(m,i) <= r by A11;
  ksa(m,i) <= r + 1 by A11, NAT_1:13;
  then B1: ksv(m,i) = r + 1 - ksa(m,i) by XREAL_1:233;
  hence ksv(m,i) + ksa(m,i) = r + 1;
  r + 1 - r <= r + 1 - ksa(m,i) by A11, XREAL_1:10;
  hence 1 <= ksv(m,i) by B1;
  r + 1 - ksa(m,i) <= r + 1 - 1 by A11, XREAL_1:10;
  hence thesis by B1;
end;

theorem EvenNeOdd:
  for a,b being Nat holds 2 * a <> 2 * b + 1
proof
  let a,b be Nat;
  2 * a is even & 2 * b is even;
  then 2 * a is even & 2 * b + 1 is odd by OddEven;
  hence thesis;
end;

theorem KsqInj:
  for m,i,j being Nat st 3 <= m & i in Seg m & j in Seg m &
  ksq(m,i) = ksq(m,j) holds i = j
proof
  let m,i,j be Nat;
  assume A1: 3 <= m & i in Seg m & j in Seg m & ksq(m,i) = ksq(m,j);
  set h = m div 2;
  A2: 1 <= i & i <= m & 1 <= j & j <= m by A1, FINSEQ_1:1;
  A3: for k being Nat holds
    (k = 1 implies ksq(m,k) = 1) &
    (2 <= k & k <= h + 1 implies ksq(m,k) + 2 = 2 * k) &
    (h + 2 <= k & k <= m implies ksq(m,k) + 2 * k = 2 * m + 3)
    by A1, KsVals;
  :: every index is 1, in the middle range, or in the last range
  A4: for k being Nat st 1 <= k & k <= m holds
    k = 1 or (2 <= k & k <= h + 1) or h + 2 <= k
  proof
    let k be Nat;
    assume B1: 1 <= k & k <= m;
    assume B2: not thesis;
    then 1 < k by B1, XXREAL_0:1;
    then 1 + 1 <= k by NAT_1:13;
    then not k <= h + 1 by B2;
    then h + 1 < k;
    then h + 1 + 1 <= k by NAT_1:13;
    hence contradiction by B2;
  end;
  set x = ksq(m,i);
  per cases by A2, A4;
  suppose B1: i = 1;
    then B2: x = 1 by A3;
    per cases by A2, A4;
    suppose j = 1;
      hence thesis by B1;
    end;
    suppose C1: 2 <= j & j <= h + 1;
      then x + 2 = 2 * j by A1, A3;
      then 2 * j = 2 * 1 + 1 by B2;
      hence thesis by EvenNeOdd;
    end;
    suppose C1: h + 2 <= j;
      then x + 2 * j = 2 * m + 3 by A1, A2, A3;
      then 2 * j = 2 * m + 2 by B2;
      then j = m + 1;
      hence thesis by A2, NAT_1:13;
    end;
  end;
  suppose B1: 2 <= i & i <= h + 1;
    then B2: x + 2 = 2 * i by A3;
    per cases by A2, A4;
    suppose j = 1;
      then x = 1 by A1, A3;
      then 2 * i = 2 * 1 + 1 by B2;
      hence thesis by EvenNeOdd;
    end;
    suppose C1: 2 <= j & j <= h + 1;
      then x + 2 = 2 * j by A1, A3;
      hence thesis by B2;
    end;
    suppose C1: h + 2 <= j;
      then x + 2 * j = 2 * m + 3 by A1, A2, A3;
      then x + 2 + 2 * j = 2 * m + 3 + 2;
      then 2 * (i + j) = 2 * (m + 2) + 1 by B2;
      hence thesis by EvenNeOdd;
    end;
  end;
  suppose B1: h + 2 <= i;
    then B2: x + 2 * i = 2 * m + 3 by A2, A3;
    per cases by A2, A4;
    suppose j = 1;
      then x = 1 by A1, A3;
      then 2 * i = 2 * m + 2 by B2;
      then i = m + 1;
      hence thesis by A2, NAT_1:13;
    end;
    suppose C1: 2 <= j & j <= h + 1;
      then C2: x + 2 = 2 * j by A1, A3;
      x + 2 + 2 * i = 2 * m + 3 + 2 by B2;
      then 2 * (i + j) = 2 * (m + 2) + 1 by C2;
      hence thesis by EvenNeOdd;
    end;
    suppose C1: h + 2 <= j;
      then x + 2 * j = 2 * m + 3 by A1, A2, A3;
      hence thesis by B2;
    end;
  end;
end;

theorem KsuM:
  for m being Nat st 3 <= m holds ksq(m,m) = 3 & ksu(m,m) = 2
proof
  let m be Nat;
  assume A1: 3 <= m;
  set h = m div 2, pm = ((m + 1) div 2) + 1;
  A2: 2 * h <= m & m <= 2 * h + 1 & 1 <= h &
    (m is even implies m = 2 * h & pm = h + 1) &
    (m is odd implies m = 2 * h + 1 & pm = h + 2) by A1, KsBasic;
  A3: h + 2 <= m
  proof
    per cases by A2, XXREAL_0:1;
    suppose h = 1;
      hence thesis by A1;
    end;
    suppose 1 < h;
      then 1 + 1 <= h by NAT_1:13;
      then h + 2 <= h + h by XREAL_1:6;
      hence thesis by A2, XXREAL_0:2;
    end;
  end;
  ksq(m,m) + 2 * m = 2 * m + 3 by A1, A3, KsVals;
  hence A4: ksq(m,m) = 3;
  not ((m mod 3) = 2 & m = pm)
  proof
    assume B1: (m mod 3) = 2 & m = pm;
    per cases;
    suppose m is even;
      then pm = h + 1 by A2;
      then m < h + 2 by B1, XREAL_1:6;
      hence contradiction by A3;
    end;
    suppose m is odd;
      then B2: m = 2 * h + 1 & pm = h + 2 by A2;
      then h = 1 by B1;
      then m = 3 * 1 + 0 by B2;
      hence contradiction by B1, Mod3;
    end;
  end;
  then ksu(m,m) = (ksq(m,m) div 3) + 1 by A1, KsVals;
  then B5: ksu(m,m) = (3 div 3) + 1 by A4;
  3 = 3 * 1 + 0;
  then 3 div 3 = 1 by Div3;
  hence thesis by B5;
end;

:: Proposition 4: eta(KS_m) = ceil((m+2)/3) for m >= 3

theorem Proposition4:
  for m being Nat st 3 <= m & G is_sun_of m, Seg m, KRel m holds
  eta G = cdiv(m+2,3)
proof
  let m be Nat;
  assume A1: 3 <= m & G is_sun_of m, Seg m, KRel m;
  set C = the carrier of G, R = KRel m, r = cdiv(m+2,3);
  reconsider B = Seg m as Subset of NAT;
  A1b: G is_sun_of m,B,R by A1;
  A0: R c= [:B,B:];
  A2: C = [:{0},B:] \/ [:{1},Seg m:] by A1, DefSun;
  1 <= m by A1, XXREAL_0:2;
  then A3: 1 in Seg m by FINSEQ_1:1;
  A4: for i being Nat st i in Seg m holds
    for x being Element of G st x = [0,i] holds deg x = m + 1
  proof
    let i be Nat;
    assume B1: i in Seg m;
    reconsider Ri = Seg m \ {i} as finite set;
    B2: Ri = R.:{i} by B1, KImg;
    {i} c= Seg m by B1, ZFMISC_1:31;
    then card Ri = card Seg m - card {i} by CARD_2:44
    .= m - card {i} by FINSEQ_1:57
    .= m - 1 by CARD_1:30;
    then B3: card Ri + 2 = m + 1;
    let x be Element of G;
    assume x = [0,i];
    then deg x = card Ri + 2 by A1, A1b, A0, B1, B2, SunDegU;
    hence thesis by B3;
  end;
  :: lower bound: Corollary 2 on the clique {u_1,...,u_m}
  [:{0},B:] c= C by A2, XBOOLE_1:7;
  then reconsider Q = [:{0},B:] as Subset of G;
  for x,y being Element of G st x in Q & y in Q & x <> y holds
    x,y are_adjacent
  proof
    let x,y be Element of G;
    assume B1: x in Q & y in Q & x <> y;
    then consider i being object such that B2: i in Seg m & x = [0,i]
      by PairSide;
    consider j being object such that B3: j in Seg m & y = [0,j]
      by B1, PairSide;
    reconsider i, j as Nat by B2, B3;
    [i,j] in R by B1, B2, B3, DefKRel;
    then [x,y] in the InternalRel of G by A1, B2, B3, DefSun;
    hence thesis;
  end;
  then reconsider Q as finite Clique of G by CliqueI;
  A5: Q <> {} by A3, PairSide;
  A6: card Q = card Seg m by CardSide
  .= m by FINSEQ_1:57;
  for x being Element of G st x in Q holds m + 1 <= deg x & deg x <= m + 1
  proof
    let x be Element of G;
    assume x in Q;
    then consider i being object such that B1: i in Seg m & x = [0,i]
      by PairSide;
    reconsider i as Nat by B1;
    thus thesis by A4, B1;
  end;
  then A7: cdiv(m + 1 + 1, m + 1 + 2 -' card Q) <= eta G by A5, Corollary2;
  m + 1 + 2 = m + 3;
  then m + 1 + 2 -' card Q = 3 by A6, NAT_D:34;
  then A8: r <= eta G by A7;
  :: upper bound: the labeling of the appendix
  defpred T[Nat] means $1 = 0;
  deffunc FU(Nat) = ksu(m,$1);
  deffunc FV(Nat) = ksv(m,$1);
  consider fu being Function of NAT, NAT such that
  A9: for i being Nat holds (T[i] implies fu.i = FU(i)) &
    (not T[i] implies fu.i = FU(i)) from NatCases;
  consider fv being Function of NAT, NAT such that
  A10: for i being Nat holds (T[i] implies fv.i = FV(i)) &
    (not T[i] implies fv.i = FV(i)) from NatCases;
  A11: for i being Nat holds fu.i = ksu(m,i) & fv.i = ksv(m,i)
  proof
    let i be Nat;
    T[i] or not T[i];
    hence thesis by A9, A10;
  end;
  consider f such that
  A12: (for j being Nat st j in B holds f.[0,j] = fu.j) &
    (for j being Nat st j in Seg m holds f.[1,j] = fv.j) by A1, SunLab;
  A13: for j being Nat st j in Seg m holds
    1 <= ksq(m,j) & ksq(m,j) <= m &
    1 <= ksu(m,j) & ksu(m,j) <= r & 1 <= ksa(m,j) & ksa(m,j) <= r &
    ksv(m,j) + ksa(m,j) = r + 1 & 1 <= ksv(m,j) & ksv(m,j) <= r
    by A1, KsRanges;
  A14a: for j being Nat st j in B holds f.[0,j] = fu.j & 1 <= fu.j &
    fu.j <= r
  proof
    let j be Nat;
    assume B1: j in B;
    fu.j = ksu(m,j) by A11;
    hence thesis by A12, A13, B1;
  end;
  for j being Nat st j in Seg m holds f.[1,j] = fv.j & 1 <= fv.j &
    fv.j <= r
  proof
    let j be Nat;
    assume B1: j in Seg m;
    fv.j = ksv(m,j) by A11;
    hence thesis by A12, A13, B1;
  end;
  then A14: f is r-labeling by A1b, A14a, SunLabeling;
  reconsider SQ = Seg m as finite Subset of NAT;
  set S = Sum(fu|SQ);
  :: f(N(u_i)) + q(i) = f(U) + 2r
  A15: for i being Nat, x being Element of G st i in Seg m & x = [0,i]
    holds SumN(f,x) + ksq(m,i) = S + 2 * r
  proof
    let i be Nat, x be Element of G;
    assume B1: i in Seg m & x = [0,i];
    reconsider Ri = Seg m \ {i} as finite Subset of NAT by XBOOLE_1:1;
    B2: Ri = R.:{i} by B1, KImg;
    B3: Seg m c= B;
    B4: SumN(f,x) = Sum(fu|Ri) + fv.i + fv.(cpred(m,i))
      by A1, A0, A12, B1, B2, B3, SunSums;
    B5: S = Sum(fu|Ri) + fu.i by B1, SegRemove;
    set p = cpred(m,i);
    B6: p in Seg m by B1, CpredIn;
    fv.i = ksv(m,i) by A11;
    then B7: fv.i + ksa(m,i) = r + 1 by A13, B1;
    fv.p = ksv(m,p) by A11;
    then B8: fv.p + ksa(m,p) = r + 1 by A13, B6;
    B9: ksq(m,i) + 2 = ksa(m,i) + ksa(m,p) + ksu(m,i) by A1, B1, KsClaim;
    B10: fu.i = ksu(m,i) by A11;
    SumN(f,x) + fu.i + ksa(m,i) + ksa(m,p) = S + (fv.i + ksa(m,i)) +
      (fv.p + ksa(m,p)) by B4, B5;
    then SumN(f,x) + (ksa(m,i) + ksa(m,p) + ksu(m,i)) =
      S + (r + 1) + (r + 1) by B7, B8, B10;
    then SumN(f,x) + (ksq(m,i) + 2) = S + (r + 1) + (r + 1) by B9;
    hence thesis;
  end;
  :: f(U) >= m + 1, since f(u_m) = 2
  A16: m + 1 <= S
  proof
    reconsider S0 = Seg m \ {m} as finite Subset of NAT by XBOOLE_1:1;
    1 <= m by A1, XXREAL_0:2;
    then B1: m in Seg m by FINSEQ_1:1;
    then B2: S = Sum(fu|S0) + fu.m by SegRemove;
    fu.m = ksu(m,m) by A11;
    then B3: fu.m = 2 by A1, KsuM;
    for x being object st x in S0 holds 1 <= fu.x & fu.x <= r
    proof
      let x be object;
      assume x in S0;
      then C1: x in Seg m by XBOOLE_0:def 5;
      then reconsider j = x as Nat;
      fu.j = ksu(m,j) by A11;
      hence thesis by A13, C1;
    end;
    then B4: 1 * card S0 <= Sum(fu|S0) by SumBounds;
    {m} c= Seg m by B1, ZFMISC_1:31;
    then card S0 = card Seg m - card {m} by CARD_2:44
    .= m - card {m} by FINSEQ_1:57
    .= m - 1 by CARD_1:30;
    then m - 1 + 2 <= Sum(fu|S0) + fu.m by B3, B4, XREAL_1:6;
    hence thesis by B2;
  end;
  A17: for i being Nat, x being Element of G st i in Seg m & x = [0,i]
    holds 2 * r + 1 <= SumN(f,x)
  proof
    let i be Nat, x be Element of G;
    assume B1: i in Seg m & x = [0,i];
    then B2: SumN(f,x) + ksq(m,i) = S + 2 * r by A15;
    ksq(m,i) <= m by A13, B1;
    then ksq(m,i) + (m + 1) <= m + S by A16, XREAL_1:7;
    then SumN(f,x) + (ksq(m,i) + (m + 1)) <= SumN(f,x) + (m + S)
      by XREAL_1:6;
    then S + 2 * r + (m + 1) <= SumN(f,x) + (m + S) by B2;
    then 2 * r + 1 + (S + m) <= SumN(f,x) + (S + m);
    hence thesis by XREAL_1:6;
  end;
  A18: for j being Nat, y being Element of G st j in Seg m & y = [1,j]
    holds SumN(f,y) <= 2 * r
  proof
    let j be Nat, y be Element of G;
    assume B1: j in Seg m & y = [1,j];
    then B2: SumN(f,y) = fu.j + fu.(csucc(m,j)) by A1, A1b, A0, A12, SunSums;
    B3: csucc(m,j) in Seg m by B1, CsuccIn;
    fu.j = ksu(m,j) & fu.(csucc(m,j)) = ksu(m,csucc(m,j)) by A11;
    then fu.j <= r & fu.(csucc(m,j)) <= r by A13, B1, B3;
    then fu.j + fu.(csucc(m,j)) <= r + r by XREAL_1:7;
    hence thesis by B2;
  end;
  A19: for x,y being Element of G, i,j being Nat st [i,j] in R &
    x = [0,i] & y = [0,j] holds SumN(f,x) <> SumN(f,y)
  proof
    let x,y be Element of G, i,j be Nat;
    assume B1: [i,j] in R & x = [0,i] & y = [0,j];
    then B2: i in Seg m & j in Seg m & i <> j by DefKRel;
    then B3: ksq(m,i) <> ksq(m,j) by A1, KsqInj;
    SumN(f,x) + ksq(m,i) = S + 2 * r & SumN(f,y) + ksq(m,j) = S + 2 * r
      by A15, B1, B2;
    hence thesis by B3;
  end;
  for x,y being Element of G, i,j being Nat st i in Seg m &
    (j = i or j = cpred(m,i)) & x = [0,i] & y = [1,j] holds
    SumN(f,x) <> SumN(f,y)
  proof
    let x,y be Element of G, i,j be Nat;
    assume B1: i in Seg m & (j = i or j = cpred(m,i)) & x = [0,i] &
      y = [1,j];
    then j in Seg m by CpredIn;
    then B2: SumN(f,y) <= 2 * r by A18, B1;
    2 * r + 1 <= SumN(f,x) by A17, B1;
    then 2 * r < SumN(f,x) by NAT_1:13;
    hence thesis by B2;
  end;
  then f is additive by A1b, A19, SunAdditive;
  then eta G <= r by A14, EtaLe;
  hence thesis by A8, XXREAL_0:1;
end;

:: cdiv(a,b) is the ceiling of a/b, as written in the paper

theorem CdivCeil:
  for a,b being Nat st 0 < b holds cdiv(a,b) = [/ a / b \]
proof
  let a,b be Nat;
  assume A1: 0 < b;
  set c = cdiv(a,b);
  a <= c * b by A1, CdivMul;
  then A2: a / b <= c by A1, XREAL_1:79;
  c < a / b + 1
  proof
    per cases;
    suppose c = 0;
      hence thesis by A1;
    end;
    suppose c <> 0;
      then 1 <= c by NAT_1:14;
      then reconsider k = c - 1 as Nat by NAT_1:21;
      not c <= k by XREAL_1:146;
      then not a <= k * b by A1, CdivLe;
      then k < a / b by A1, XREAL_1:81;
      then k + 1 < a / b + 1 by XREAL_1:6;
      hence thesis;
    end;
  end;
  hence thesis by A2, INT_1:def 7;
end;

:: The three suns exist

theorem SunsExist:
  for m being Nat st 3 <= m holds
  (ex G being strict Graph st G is_sun_of m, Seg m, KRel m) &
  (ex G being strict Graph st G is_sun_of m, Seg m, CycRel m) &
  (ex G being strict Graph st G is_sun_of m, {0} \/ Seg m, WRel m)
proof
  let m be Nat;
  assume A1: 3 <= m;
  A1a: 2 <= m by A1, XXREAL_0:2;
  reconsider B = Seg m as finite Subset of NAT;
  thus ex G being strict Graph st G is_sun_of m, Seg m, KRel m
  proof
    A2: for i,j being object st [i,j] in KRel m holds [j,i] in KRel m
    proof
      let i,j be object;
      assume B1: [i,j] in KRel m;
      then i in Seg m & j in Seg m by ZFMISC_1:87;
      then reconsider a = i, b = j as Nat;
      [a,b] in KRel m by B1;
      then a in Seg m & b in Seg m & a <> b by DefKRel;
      hence thesis by DefKRel;
    end;
    for i being object holds not [i,i] in KRel m
    proof
      let i be object;
      assume B1: [i,i] in KRel m;
      then i in Seg m by ZFMISC_1:87;
      then reconsider a = i as Nat;
      [a,a] in KRel m by B1;
      hence contradiction by DefKRel;
    end;
    hence thesis by A1, A2, SunExists;
  end;
  thus ex G being strict Graph st G is_sun_of m, Seg m, CycRel m
  proof
    A2: for i,j being object st [i,j] in CycRel m holds [j,i] in CycRel m
    proof
      let i,j be object;
      assume B1: [i,j] in CycRel m;
      then i in Seg m & j in Seg m by ZFMISC_1:87;
      then reconsider a = i, b = j as Nat;
      [a,b] in CycRel m by B1;
      then a in Seg m & b in Seg m & (b = csucc(m,a) or a = csucc(m,b))
        by DefCycRel;
      hence thesis by DefCycRel;
    end;
    for i being object holds not [i,i] in CycRel m
    proof
      let i be object;
      assume B1: [i,i] in CycRel m;
      then B2: i in Seg m by ZFMISC_1:87;
      then reconsider a = i as Nat;
      [a,a] in CycRel m by B1;
      then a = csucc(m,a) by DefCycRel;
      hence contradiction by A1a, B2, CsuccNe;
    end;
    hence thesis by A1, A2, SunExists;
  end;
  0 in NAT;
  then {0} c= NAT by ZFMISC_1:31;
  then reconsider W = {0} \/ Seg m as finite Subset of NAT by XBOOLE_1:8;
  A2: for i,j being object st [i,j] in WRel m holds [j,i] in WRel m
  proof
    let i,j be object;
    assume B1: [i,j] in WRel m;
    then i in W & j in W by ZFMISC_1:87;
    then reconsider a = i, b = j as Nat;
    [a,b] in WRel m by B1;
    then (a in Seg m & b in Seg m & (b = csucc(m,a) or a = csucc(m,b))) or
      (a = 0 & b in Seg m) or (b = 0 & a in Seg m) by DefWRel;
    hence thesis by DefWRel;
  end;
  A3: for i being object holds not [i,i] in WRel m
  proof
    let i be object;
    assume B1: [i,i] in WRel m;
    then i in W by ZFMISC_1:87;
    then reconsider a = i as Nat;
    B2: (a in Seg m & a in Seg m & (a = csucc(m,a) or a = csucc(m,a))) or
      (a = 0 & a in Seg m) or (a = 0 & a in Seg m) by B1, DefWRel;
    not 0 in Seg m by FINSEQ_1:1;
    then a in Seg m & a = csucc(m,a) by B2;
    hence contradiction by A1a, CsuccNe;
  end;
  Seg m c= W by XBOOLE_1:7;
  hence thesis by A1, A2, A3, SunExists;
end;
